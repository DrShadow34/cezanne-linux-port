+/* Early ZS / forward pixel kill state of a fragment shader; with the clip /
+ * cull distance discard also the state without it (draws whose vertex
+ * shader writes no distances: the discard cannot happen). */
+static void
+fs_init_earlyzs(struct panvk_shader_variant *shader)
+{
+   shader->fs.earlyzs_lut = pan_earlyzs_analyze(&shader->info, PAN_ARCH);
+   if (!shader->fs.clip_cull_discard)
+      return;
+
+   struct pan_shader_info no_clip = shader->info;
+   no_clip.fs.can_discard = shader->fs.can_discard_no_clip;
+   no_clip.fs.can_fpk = !no_clip.fs.writes_depth && !no_clip.fs.writes_stencil &&
+                        !no_clip.fs.writes_coverage && !no_clip.fs.can_discard &&
+                        !no_clip.fs.outputs_read;
+   shader->fs.can_fpk_no_clip = no_clip.fs.can_fpk;
+   shader->fs.earlyzs_lut_no_clip = pan_earlyzs_analyze(&no_clip, PAN_ARCH);
+}
+
+#if PAN_ARCH == 9
+/* The v9 rasterizer has no clip / cull distances. The vertex shader writes
+ * them as ordinary varyings, the fragment shader interpolates them and
+ * discards where an enabled one is negative. Cull distances the same way:
+ * per fragment, not per primitive (a primitive with every vertex negative
+ * goes entirely, one partly negative is cut instead of kept). Which
+ * distances the vertex shader writes comes at draw time (fs.clip_cull_mask:
+ * clip bits 0-7, cull 8-15); with a linked vertex shader only the slots it
+ * writes are read, and nothing is added when it writes none. */
+static bool
+lower_clip_cull_fs(nir_shader *nir, const struct pan_varying_layout *vs_layout)
+{
+   static const gl_varying_slot base[2] = {VARYING_SLOT_CLIP_DIST0,
+                                          VARYING_SLOT_CULL_DIST0};
+   static const char *const names[2] = {"panvk_clip_dist", "panvk_cull_dist"};
+   unsigned sizes[2] = {8, 8};
+
+   if (vs_layout) {
+      for (unsigned i = 0; i < 2; i++) {
+         const struct pan_varying_slot *s0 =
+            pan_varying_layout_find_slot(vs_layout, base[i]);
+         const struct pan_varying_slot *s1 =
+            pan_varying_layout_find_slot(vs_layout, base[i] + 1);
+         sizes[i] = s0 ? (s1 ? 4 + s1->ncomps : s0->ncomps) : 0;
+      }
+      if (!sizes[0] && !sizes[1])
+         return false;
+   }
+
+   nir_variable *vars[2] = {NULL, NULL};
+   for (unsigned i = 0; i < 2; i++) {
+      if (!sizes[i])
+         continue;
+      vars[i] = nir_find_variable_with_location(nir, nir_var_shader_in, base[i]);
+      if (vars[i]) {
+         sizes[i] = MIN2(sizes[i], glsl_get_length(vars[i]->type));
+      } else {
+         vars[i] = nir_variable_create(
+            nir, nir_var_shader_in,
+            glsl_array_type(glsl_float_type(), sizes[i], 0), names[i]);
+         vars[i]->data.location = base[i];
+         vars[i]->data.compact = true;
+         vars[i]->data.interpolation = INTERP_MODE_SMOOTH;
+      }
+   }
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *mask = load_sysval(&b, graphics, 32, fs.clip_cull_mask);
+   nir_push_if(&b, nir_ine_imm(&b, mask, 0));
+   {
+      nir_def *kill = nir_imm_false(&b);
+      for (unsigned i = 0; i < 2; i++) {
+         for (unsigned j = 0; j < sizes[i]; j++) {
+            nir_def *d = nir_load_deref(
+               &b, nir_build_deref_array_imm(
+                      &b, nir_build_deref_var(&b, vars[i]), j));
+            nir_def *on =
+               nir_ine_imm(&b, nir_iand_imm(&b, mask, 1u << (8 * i + j)), 0);
+            kill = nir_ior(&b, kill, nir_iand(&b, on, nir_flt_imm(&b, d, 0.0)));
+         }
+      }
+      nir_discard_if(&b, kill);
+   }
+   nir_pop_if(&b, NULL);
+
+   nir->info.fs.uses_discard = true;
+   return nir_progress(true, impl, nir_metadata_none);
+}
+#endif
