+      break;
+
    case MESA_SHADER_FRAGMENT:
-      shader->fs.earlyzs_lut = pan_earlyzs_analyze(&shader->info, PAN_ARCH);
+      blob_copy_bytes(blob, &shader->fs.clip_cull_discard,
+                      sizeof(shader->fs.clip_cull_discard));
+      blob_copy_bytes(blob, &shader->fs.can_discard_no_clip,
+                      sizeof(shader->fs.can_discard_no_clip));
+      fs_init_earlyzs(shader);
       blob_copy_bytes(blob, &shader->fs.input_attachment_read,
                       sizeof(shader->fs.input_attachment_read));
       blob_copy_bytes(blob, &shader->fs.tile_image_color_read,
@@ -2067,7 +2154,16 @@ panvk_shader_serialize_variant(struct vk_device *vk_dev,
                        sizeof(shader->cs.local_size));
       break;
 
+   case MESA_SHADER_VERTEX:
+      blob_write_bytes(blob, &shader->vs.clip_cull_mask,
