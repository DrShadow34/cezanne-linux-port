+         const bool own_discard = nir->info.fs.uses_discard;
+         if (lower_clip_cull_fs(nir, vs_varying_layout)) {
+            variant->fs.clip_cull_discard = true;
+            variant->fs.can_discard_no_clip = own_discard;
+         }
