-            pan_earlyzs_get(fs->fs.earlyzs_lut, writes_z || writes_s || oq,
+            pan_earlyzs_get(*lut, writes_z || writes_s || oq,
                             alpha_to_coverage, ds_test_always_passes(cmdbuf),
                             zs_read);
 
