 src/panfrost/vulkan/panvk_shader.h            |  17 ++
 src/panfrost/vulkan/panvk_vX_cmd_draw.c       |   5 +
 .../vulkan/panvk_vX_physical_device.c         |  14 +-
 src/panfrost/vulkan/panvk_vX_shader.c         | 154 ++++++++++++++----
 5 files changed, 171 insertions(+), 40 deletions(-)

