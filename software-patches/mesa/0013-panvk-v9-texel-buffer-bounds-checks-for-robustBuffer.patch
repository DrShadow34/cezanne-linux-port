    /* Our OpenCL compiler (src/panfrost/clc/pan_compile.c) has a very weird and
@@ -1092,6 +1097,11 @@ bifrost_postprocess_nir(nir_shader *nir,
    bi_optimize_loop(nir, gpu_id, false /* allow_copies */);
 }
 
