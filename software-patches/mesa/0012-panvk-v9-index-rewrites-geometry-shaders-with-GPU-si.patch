diff --git a/src/panfrost/libpan/draw_helper.cl b/src/panfrost/libpan/draw_helper.cl
index 4966348..fc82559 100644
--- a/src/panfrost/libpan/draw_helper.cl
+++ b/src/panfrost/libpan/draw_helper.cl
@@ -144,6 +144,213 @@ panlib_draw_indirect_v9_helper(global uint32_t *cmd, global uint32_t *count_buf,
       *offset += (int32_t)(first_instance * attrib_patches[2 * i + 1]);
    }
 }
+
+/*
+ * v9: what the tiler cannot draw, as a 32-bit index list: triangles with
+ * VK_POLYGON_MODE_LINE (the three edges of each, a line list) and
+ * adjacency topologies without a geometry shader (the primitives without
+ * their adjacent vertices; both for triangles with adjacency in LINE mode).
+ * One invocation per input primitive, 64 per workgroup. The indices come
+ * from the draw's index buffer (index_size != 0, clamped to index_avail)
+ * or are the vertex's number in the draw.
+ */
+KERNEL(64)
+panlib_rewrite_indices_v9(global uint32_t *out, uint64_t index_buffer,
+                          uint32_t index_avail, uint32_t index_size,
+                          uint32_t num_prims, uint32_t flatshade_first,
+                          uint32_t lines_from_tris,
+                          uint32_t compact_prim__11)
+{
+   uint32_t prim = cl_global_id.x;
+   if (prim >= num_prims)
+      return;
+
+   enum mesa_prim mode = poly_uncompact_prim(compact_prim__11);
+   bool adj = mesa_prim_has_adjacency(mode);
+   bool tris = u_reduced_prim(mode) == MESA_PRIM_TRIANGLES;
+   uint32_t nv = tris ? 3 : 2;
+   uint32_t v[3];
+
+   for (uint32_t k = 0; k < nv; k++) {
+      /* adjacency: lines are vertices 1, 2 of 4, triangles 0, 2, 4 of 6 */
+      uint32_t vert = adj ? (tris ? 2 * k : k + 1) : k;
+      uint32_t id = poly_vertex_id_for_topology(mode, flatshade_first, prim,
+                                                vert, num_prims);
+      v[k] = poly_load_index(index_buffer, index_avail, id, index_size);
+   }
+
+   if (lines_from_tris) {
+      global uint32_t *o = out + prim * 6;
+      o[0] = v[0];
+      o[1] = v[1];
+      o[2] = v[1];
+      o[3] = v[2];
+      o[4] = v[2];
+      o[5] = v[0];
+   } else {
+      for (uint32_t k = 0; k < nv; k++)
+         out[prim * nv + k] = v[k];
+   }
+}
+
+/*
+ * v9 geometry shaders (src/poly) whose input counts are known on the GPU
+ * only: indirect draws and primitive restart. poly's heap (a device BO,
+ * the poly_heap header first) is reset by the first such draw of a batch;
+ * the draws of a batch then bump-allocate from it.
+ */
+KERNEL(1)
+panlib_poly_heap_reset_v9(global struct poly_heap *heap, uint64_t base,
+                          uint32_t size)
+{
+   heap->base = (global uchar *)base;
+   heap->bottom = 0;
+   heap->size = size;
+}
+
+/* primitive restart: strips (or lists) to a list without restarts, as an
+ * indexed indirect draw (out_draw) whose indices live in the heap */
+KERNEL(256)
+panlib_unroll_restart_v9(global uint32_t *out_draw,
+                         global struct poly_heap *heap,
+                         constant uint32_t *in_draw, uint64_t index_buffer,
+                         uint32_t index_buffer_range_el,
+                         uint32_t flatshade_first, uint32_t index_size_log2__3,
+                         uint32_t mode__11)
+{
+   uint32_t index_size_B = 1 << index_size_log2__3;
+   uint32_t restart_index =
+      index_size_B == 4 ? ~0u : (1u << (index_size_B * 8)) - 1;
+
+   POLY_DECL_UNROLL_RESTART_SCRATCH(scratch, 256);
+   poly_unroll_restart(out_draw, heap, in_draw, index_buffer,
+                       index_buffer_range_el, index_size_B, restart_index,
+                       flatshade_first, poly_uncompact_prim(mode__11), scratch);
+}
+
+/* Compute job queued as MALI_JOB_TYPE_NOT_STARTED: compute or null job */
+static void
+panlib_patch_compute_job(global uint8_t *job, uint32_t x, uint32_t y)
+{
+   const bool run = x != 0 && y != 0;
+   struct mali_job_header_packed job_header;
+
+   pan_pack(&job_header, JOB_HEADER, cfg) {
+      cfg.type = run ? MALI_JOB_TYPE_COMPUTE : MALI_JOB_TYPE_NULL;
+   }
+   pan_merge((global struct mali_job_header_packed *)job, &job_header,
+             JOB_HEADER);
+
+   if (!run)
+      return;
+
+   global struct mali_compute_payload_packed *payload =
+      (global struct mali_compute_payload_packed *)(job +
+                                                    pan_section_offset(
+                                                       COMPUTE_JOB, PAYLOAD));
+
+   pan_unpack(payload, COMPUTE_PAYLOAD, unpacked);
+   pan_pack(payload, COMPUTE_PAYLOAD, cfg) {
+      memcpy(&cfg, &unpacked, sizeof(cfg));
+      cfg.workgroup_count_x = x;
+      cfg.workgroup_count_y = y;
+   }
+}
+
+/*
+ * poly's indirect geometry shader setup (poly_gs_setup_indirect) for one
+ * draw of an indirect command, then what the CPU does for direct draws:
+ * the workgroup counts of the vertex shader / main geometry shader compute
+ * jobs (64 invocations per workgroup), the counts and index buffer of the
+ * rasterization draw's MALLOC_VERTEX_JOBs (one per layer), and, as
+ * panlib_draw_indirect_v9_helper(), the vertex shader's base vertex /
+ * instance / draw ID sysvals and per-instance attribute offsets. Draws past
+ * the count buffer value get zero vertices.
+ */
+KERNEL(1)
+panlib_gs_setup_indirect_v9(
+   constant uint32_t *cmd, global uint32_t *count_buf, uint32_t draw_id,
+   uint32_t max_draw_count, uint64_t index_buffer, uint32_t index_size,
+   uint32_t index_avail, global struct poly_vertex_params *vp,
+   global struct poly_geometry_params *p, global struct poly_heap *heap,
+   uint64_t vs_outputs, uint32_t prim, uint32_t max_indices, uint32_t shape,
+   global uint8_t *vs_job, global uint8_t *gs_job,
+   global uint64_t *idvs_jobs, uint32_t idvs_job_count,
+   uint64_t rast_index_buffer, global uint8_t *vs_fau,
+   uint32_t first_vertex_off, uint32_t base_instance_off,
+   uint32_t draw_id_off, global uint8_t *vs_attribs,
+   global uint32_t *attrib_patches, uint32_t patch_attrib_count)
+{
+   uint32_t draw_count =
+      count_buf ? min(*count_buf, max_draw_count) : max_draw_count;
+   bool indexed = index_size != 0;
+   uint32_t vertex_count = cmd[0];
+   uint32_t instance_count = cmd[1];
+   uint32_t first_index = indexed ? cmd[2] : 0;
+   int32_t vertex_offset = (int32_t)(indexed ? cmd[3] : cmd[2]);
+   uint32_t first_instance = indexed ? cmd[4] : cmd[3];
+
+   if (draw_id >= draw_count) {
+      vertex_count = 0;
+      instance_count = 0;
+   }
+
+   poly_vertex_params_set_draw(vp, vertex_count, instance_count);
+   poly_geometry_params_set_draw(p, prim, shape, max_indices, vertex_count,
+                                 instance_count);
+
+   if (indexed) {
+      vp->index_buffer =
+         poly_index_buffer(index_buffer, index_avail, first_index, index_size);
+      vp->index_buffer_range_el =
+         poly_index_buffer_range_el(index_avail, first_index);
+   }
+
+   vp->output_buffer = (uintptr_t)poly_heap_alloc(
+      heap, poly_tcs_in_size(vertex_count * instance_count, vs_outputs));
+   vp->outputs = vs_outputs;
+
+   if (shape == POLY_GS_SHAPE_DYNAMIC_INDEXED) {
+      p->output_index_buffer =
+         (global uint *)poly_heap_alloc(heap, p->draw.index_count * 4);
+      rast_index_buffer = (uintptr_t)p->output_index_buffer;
+   }
+
+   /* no vertex shader job if it stores nothing */
+   if (vs_job)
+      panlib_patch_compute_job(vs_job, DIV_ROUND_UP(vertex_count, 64),
+                               instance_count);
+   if (gs_job)
+      panlib_patch_compute_job(gs_job, DIV_ROUND_UP(p->grid[0], 64),
+                               instance_count);
+
+   /* MALLOC_VERTEX_JOB: PRIMITIVE @32 (base vertex offset, instance
+    * offset, index count), INSTANCE_COUNT @48, INDICES @120 */
+   for (uint32_t i = 0; i < idvs_job_count; i++) {
+      global uint8_t *job = (global uint8_t *)idvs_jobs[i];
+
+      *(global uint32_t *)(job + 44) = p->draw.index_count;
+      *(global uint32_t *)(job + 48) = p->draw.instance_count;
+      if (rast_index_buffer)
+         *(global uint64_t *)(job + 120) = rast_index_buffer;
+   }
+
+   if (!vs_job)
+      return;
+
+   if (first_vertex_off != ~0u)
+      *(global int32_t *)(vs_fau + first_vertex_off) = vertex_offset;
+   if (base_instance_off != ~0u)
+      *(global uint32_t *)(vs_fau + base_instance_off) = first_instance;
+   if (draw_id_off != ~0u)
+      *(global uint32_t *)(vs_fau + draw_id_off) = draw_id;
+
+   for (uint32_t i = 0; i < patch_attrib_count; i++) {
+      global int32_t *offset = (global int32_t *)
+         (vs_attribs + attrib_patches[2 * i] * 32 + 8);
+      *offset += (int32_t)(first_instance * attrib_patches[2 * i + 1]);
+   }
+}
 #endif
 
