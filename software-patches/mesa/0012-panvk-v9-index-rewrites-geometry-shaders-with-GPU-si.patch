 }
 
+/* Adds a compute job after job dep (if not 0). GPU-patched ones are queued
+ * as NOT_STARTED, panlib_patch_compute_job() makes them compute or null
+ * jobs, and are restored before the batch is issued again. */
+static unsigned
+add_poly_compute_job(struct panvk_cmd_buffer *cmdbuf, struct pan_ptr *job,
+                     bool gpu_patched, unsigned dep)
+{
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+   unsigned index = pan_jc_add_job(
+      &batch->vtc_jc,
+      gpu_patched ? MALI_JOB_TYPE_NOT_STARTED : MALI_JOB_TYPE_COMPUTE, false,
+      false, dep, 0, job, false);
+
+   if (gpu_patched) {
+      struct panvk_compute_job_copy copy = {.job = job->cpu};
+      memcpy(&copy.data, job->cpu, sizeof(copy.data));
+      util_dynarray_append(&batch->compute_job_copies, copy);
+   }
+
+   return index;
+}
