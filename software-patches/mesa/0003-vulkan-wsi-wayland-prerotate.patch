+static VkResult
+wsi_rotate_init(struct wsi_swapchain *chain)
+{
+   const struct wsi_device *wsi = chain->wsi;
+   VkResult result;
+
+   const VkShaderModuleCreateInfo module_info = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = sizeof(wsi_rotate_spv),
+      .pCode = wsi_rotate_spv,
+   };
+   result = wsi->CreateShaderModule(chain->device, &module_info, &chain->alloc,
+                                    &chain->rotate.module);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkSamplerCreateInfo sampler_info = {
+      .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+      .magFilter = VK_FILTER_NEAREST,
+      .minFilter = VK_FILTER_NEAREST,
+      .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+      .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+      .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+   };
+   result = wsi->CreateSampler(chain->device, &sampler_info, &chain->alloc,
+                               &chain->rotate.sampler);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkDescriptorSetLayoutBinding bindings[] = {
+      {
+         .binding = 0,
+         .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+         .descriptorCount = 1,
+         .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+         .pImmutableSamplers = &chain->rotate.sampler,
+      },
+      {
+         .binding = 1,
+         .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+         .descriptorCount = 1,
+         .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+      },
+   };
+   const VkDescriptorSetLayoutCreateInfo set_layout_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .bindingCount = ARRAY_SIZE(bindings),
+      .pBindings = bindings,
+   };
+   result = wsi->CreateDescriptorSetLayout(chain->device, &set_layout_info,
+                                           &chain->alloc,
+                                           &chain->rotate.set_layout);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkPushConstantRange push_range = {
+      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+      .size = 4 * sizeof(uint32_t),
+   };
+   const VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+      .setLayoutCount = 1,
+      .pSetLayouts = &chain->rotate.set_layout,
+      .pushConstantRangeCount = 1,
+      .pPushConstantRanges = &push_range,
+   };
+   result = wsi->CreatePipelineLayout(chain->device, &layout_info,
+                                      &chain->alloc, &chain->rotate.layout);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkComputePipelineCreateInfo pipeline_info = {
+      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+      .stage = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+         .module = chain->rotate.module,
+         .pName = "main",
+      },
+      .layout = chain->rotate.layout,
+   };
+   return wsi->CreateComputePipelines(chain->device, VK_NULL_HANDLE, 1,
+                                      &pipeline_info, &chain->alloc,
+                                      &chain->rotate.pipeline);
+}
+
+static void
+wsi_rotate_finish(struct wsi_swapchain *chain)
+{
+   const struct wsi_device *wsi = chain->wsi;
+
+   wsi->DestroyPipeline(chain->device, chain->rotate.pipeline, &chain->alloc);
+   wsi->DestroyPipelineLayout(chain->device, chain->rotate.layout, &chain->alloc);
+   wsi->DestroyDescriptorSetLayout(chain->device, chain->rotate.set_layout,
+                                   &chain->alloc);
+   wsi->DestroySampler(chain->device, chain->rotate.sampler, &chain->alloc);
+   wsi->DestroyShaderModule(chain->device, chain->rotate.module, &chain->alloc);
+}
