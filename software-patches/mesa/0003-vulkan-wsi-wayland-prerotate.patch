+/* pre-rotation: rotate the image into the blit buffer (wsi_rotate.comp) */
+static VkResult
+wsi_rotate_init_image(const struct wsi_swapchain *chain,
+                      const struct wsi_image_info *info,
+                      struct wsi_image *image)
+{
+   const struct wsi_device *wsi = chain->wsi;
+   VkResult result;
+
+   const VkImageViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = image->image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = info->create.format,
+      .subresourceRange = {
+         .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .levelCount = 1,
+         .layerCount = 1,
+      },
+   };
+   result = wsi->CreateImageView(chain->device, &view_info, &chain->alloc,
+                                 &image->rotate.view);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkDescriptorPoolSize pool_sizes[] = {
+      { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1 },
+      { VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1 },
+   };
+   const VkDescriptorPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+      .maxSets = 1,
+      .poolSizeCount = ARRAY_SIZE(pool_sizes),
+      .pPoolSizes = pool_sizes,
+   };
+   result = wsi->CreateDescriptorPool(chain->device, &pool_info, &chain->alloc,
+                                      &image->rotate.pool);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkDescriptorSetAllocateInfo set_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+      .descriptorPool = image->rotate.pool,
+      .descriptorSetCount = 1,
+      .pSetLayouts = &chain->rotate.set_layout,
+   };
+   result = wsi->AllocateDescriptorSets(chain->device, &set_info,
+                                        &image->rotate.set);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkDescriptorImageInfo image_desc = {
+      .imageView = image->rotate.view,
+      .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+   };
+   const VkDescriptorBufferInfo buffer_desc = {
+      .buffer = image->blit.buffer,
+      .range = VK_WHOLE_SIZE,
+   };
+   const VkWriteDescriptorSet writes[] = {
+      {
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstSet = image->rotate.set,
+         .dstBinding = 0,
+         .descriptorCount = 1,
+         .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+         .pImageInfo = &image_desc,
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+         .dstSet = image->rotate.set,
+         .dstBinding = 1,
+         .descriptorCount = 1,
+         .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+         .pBufferInfo = &buffer_desc,
+      },
+   };
+   wsi->UpdateDescriptorSets(chain->device, ARRAY_SIZE(writes), writes, 0,
+                             NULL);
+   return VK_SUCCESS;
+}
+
+static void
+wsi_cmd_rotate_image_to_buffer(VkCommandBuffer cmd_buffer,
+                               const struct wsi_swapchain *chain,
+                               const struct wsi_image_info *info,
+                               struct wsi_image *image,
+                               uint32_t qfi)
+{
+   const struct wsi_device *wsi = chain->wsi;
+   const uint32_t w = info->create.extent.width;
+   const uint32_t h = info->create.extent.height;
+
+   VkImageMemoryBarrier img_mem_barrier = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = 0,
+      .dstAccessMask = VK_ACCESS_SHADER_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+      .newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image->image,
+      .subresourceRange = {
+         .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .levelCount = 1,
+         .layerCount = 1,
+      },
+   };
+   wsi->CmdPipelineBarrier(cmd_buffer,
+                           VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           0, 0, NULL, 0, NULL, 1, &img_mem_barrier);
+
+   const VkFormat format = info->create.format;
+   const uint32_t push[4] = {
+      w, h,
+      info->linear_stride / vk_format_get_blocksize(format),
+      (chain->rotate.transform == 1 /* WL_OUTPUT_TRANSFORM_90 */ ? 1 : 0) |
+      (format == VK_FORMAT_B8G8R8A8_UNORM ||
+       format == VK_FORMAT_B8G8R8A8_SRGB ? 2 : 0) |
+      (vk_format_is_srgb(format) ? 4 : 0),
+   };
+   wsi->CmdBindPipeline(cmd_buffer, VK_PIPELINE_BIND_POINT_COMPUTE,
+                        chain->rotate.pipeline);
+   wsi->CmdBindDescriptorSets(cmd_buffer, VK_PIPELINE_BIND_POINT_COMPUTE,
+                              chain->rotate.layout, 0, 1, &image->rotate.set,
+                              0, NULL);
+   wsi->CmdPushConstants(cmd_buffer, chain->rotate.layout,
+                         VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), push);
+   /* one invocation per destination (h x w) pixel, 16x16 workgroups */
+   wsi->CmdDispatch(cmd_buffer, DIV_ROUND_UP(h, 16), DIV_ROUND_UP(w, 16), 1);
+
+   img_mem_barrier.srcAccessMask = VK_ACCESS_SHADER_READ_BIT;
+   img_mem_barrier.dstAccessMask = 0;
+   img_mem_barrier.oldLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+   img_mem_barrier.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+
+   const VkBufferMemoryBarrier buf_mem_barrier = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+      .srcQueueFamilyIndex =
+         image->blit.to_foreign_queue ? qfi : VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = image->blit.to_foreign_queue
+                                ? VK_QUEUE_FAMILY_FOREIGN_EXT
+                                : VK_QUEUE_FAMILY_IGNORED,
+      .buffer = image->blit.buffer,
+      .offset = 0,
+      .size = VK_WHOLE_SIZE,
+   };
+   wsi->CmdPipelineBarrier(cmd_buffer,
+                           VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                           image->blit.to_foreign_queue
+                              ? VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT
+                              : VK_PIPELINE_STAGE_HOST_BIT,
+                           0, 0, NULL, 1, &buf_mem_barrier,
+                           1, &img_mem_barrier);
+}
