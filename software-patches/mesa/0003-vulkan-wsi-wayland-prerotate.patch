+static int32_t
+wsi_wl_single_output_transform(void)
+{
+   struct wsi_wl_output_query query = { .transform = -1 };
+   struct wl_display *dpy = wl_display_connect(NULL);
+   if (!dpy)
+      return -1;
+
+   struct wl_registry *registry = wl_display_get_registry(dpy);
+   wl_registry_add_listener(registry, &output_query_registry_listener, &query);
+   /* globals, then the output's geometry */
+   wl_display_roundtrip(dpy);
+   wl_display_roundtrip(dpy);
+   wl_display_disconnect(dpy);
+
+   return query.count == 1 ? query.transform : -1;
+}
