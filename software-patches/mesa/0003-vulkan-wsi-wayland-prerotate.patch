+static void
+output_query_global(void *data, struct wl_registry *registry, uint32_t name,
+                    const char *interface, uint32_t version)
+{
+   struct wsi_wl_output_query *query = data;
+
+   if (strcmp(interface, wl_output_interface.name) != 0)
+      return;
