+/*
+ * Valhall job manager draws (v9: Mali-G57/G68/G77/G78).
+ *
+ * v9 has the Valhall descriptors of the CSF GPUs (resource tables, shader
+ * program descriptors, DCD flags, varyings allocated by the hardware) but the
+ * job manager of Bifrost: every draw is one MALLOC_VERTEX_JOB (IDVS) in the
+ * batch's vertex/tiler job chain. The descriptor preparation follows
+ * csf/panvk_vX_cmd_draw.c, the job layout gallium's pan_jm.c (v9).
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "genxml/gen_macros.h"
+
+#if PAN_ARCH == 9
+
