+#if PAN_ARCH == 9
+/*
+ * v9 job manager: the MALLOC_VERTEX_JOB of an indirect draw is emitted with
+ * placeholder counts, then this patches it (and the vertex shader FAU and
+ * per-instance attributes of this draw's own descriptor copies) from the
+ * VkDraw(Indexed)IndirectCommand before the job runs. Draws past the count
+ * buffer value get zero instances.
+ *
+ * attrib_patches: patch_attrib_count pairs of (attribute index, stride).
+ * The *_off FAU offsets are ~0 when the shader doesn't use that sysval.
+ */
+KERNEL(1)
+panlib_draw_indirect_v9_helper(global uint32_t *cmd, global uint32_t *count_buf,
+                               global uint8_t *job, global uint8_t *vs_fau,
+                               global uint8_t *vs_attribs,
+                               global uint32_t *attrib_patches,
+                               uint64_t index_base, uint32_t draw_id,
+                               uint32_t max_draw_count, uint32_t index_size,
+                               uint32_t index_avail,
+                               uint32_t first_vertex_off,
+                               uint32_t base_instance_off, uint32_t draw_id_off,
+                               uint32_t last_vertex_off,
+                               uint32_t vb_last_vertex,
+                               uint32_t patch_attrib_count)
+{
+   uint32_t draw_count =
+      count_buf ? min(*count_buf, max_draw_count) : max_draw_count;
+   bool indexed = index_size != 0;
+   uint32_t count = cmd[0];
+   uint32_t instance_count = cmd[1];
+   uint32_t first_index = indexed ? cmd[2] : 0;
+   int32_t vertex_offset = (int32_t)(indexed ? cmd[3] : cmd[2]);
+   uint32_t first_instance = indexed ? cmd[4] : cmd[3];
+
+   if (draw_id >= draw_count) {
+      count = 0;
+      instance_count = 0;
+   }
+
+   /* v9 has no index buffer size: clamp to the bound range */
+   if (indexed)
+      count = first_index >= index_avail ? 0 : min(count, index_avail - first_index);
+
+   /* MALLOC_VERTEX_JOB: PRIMITIVE @32 (base vertex offset, instance
+    * offset, index count), INSTANCE_COUNT @48, INDICES @120 */
+   *(global int32_t *)(job + 36) = vertex_offset;
+   *(global uint32_t *)(job + 40) = 0;
+   *(global uint32_t *)(job + 44) = count;
+   *(global uint32_t *)(job + 48) = instance_count;
+   if (indexed)
+      *(global uint64_t *)(job + 120) =
+         index_base + (uint64_t)first_index * index_size;
+
+   if (first_vertex_off != ~0u)
+      *(global int32_t *)(vs_fau + first_vertex_off) = vertex_offset;
+   if (base_instance_off != ~0u)
+      *(global uint32_t *)(vs_fau + base_instance_off) = first_instance;
+   if (draw_id_off != ~0u)
+      *(global uint32_t *)(vs_fau + draw_id_off) = draw_id;
+   if (last_vertex_off != ~0u)
+      *(global uint32_t *)(vs_fau + last_vertex_off) =
+         indexed || !count ? vb_last_vertex
+                           : min(vb_last_vertex,
+                                 (uint32_t)vertex_offset + count - 1);
+
+   /* Valhall instancing is zero-based: fold firstInstance into the
+    * per-instance attribute offsets (ATTRIBUTE word 2) */
+   for (uint32_t i = 0; i < patch_attrib_count; i++) {
+      global int32_t *offset = (global int32_t *)
+         (vs_attribs + attrib_patches[2 * i] * 32 + 8);
+      *offset += (int32_t)(first_instance * attrib_patches[2 * i + 1]);
+   }
+}
+#endif
