+/* See panvk_shader_variant::vs.reads_memory. Conservative: any texture
+ * instruction, any image / SSBO / global / buffer intrinsic, any deref
+ * access that may be one of those; UBOs, push constants and vertex
+ * attributes don't count. */
+static bool
+vs_reads_memory(nir_shader *nir)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_tex)
+               return true;
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            const char *name = nir_intrinsic_infos[intr->intrinsic].name;
+
+            if (strstr(name, "image") || strstr(name, "ssbo") ||
+                strstr(name, "global") || strstr(name, "buf"))
+               return true;
+
+            switch (intr->intrinsic) {
+            case nir_intrinsic_load_deref:
+            case nir_intrinsic_store_deref:
+            case nir_intrinsic_deref_atomic:
+            case nir_intrinsic_deref_atomic_swap:
+            case nir_intrinsic_copy_deref:
+               if (nir_deref_mode_may_be(nir_src_as_deref(intr->src[0]),
+                                         nir_var_mem_ssbo | nir_var_mem_global |
+                                            nir_var_image | nir_var_uniform))
+                  return true;
+               break;
+            default:
+               break;
+            }
+         }
+      }
+   }
+   return false;
+}
