diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index fcad5d2..ab06b41 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -102,8 +102,53 @@ struct panvk_batch {
    /* has timestamp writes: run with the GPU cycle/timestamp counters on */
    bool needs_cycle_count;
    bool issued;
+   /* v9 render-pass overlap (jm/panvk_vX_gpu_queue.c): the vertex/tiler/
+    * compute jobs wait for every earlier fragment job (query commands,
+    * timestamps) */
+   bool wait_frag;
+   /* a pipeline barrier from work that may run in fragment jobs to work that
+    * may run in vertex/tiler/compute jobs precedes the batch's commands: they
+    * wait for the earlier fragment jobs if they can access what those wrote
+    * or read (vtc_reads_mem, or fragment jobs that wrote memory) */
+   bool barrier_frag;
+   /* the vertex/tiler/compute chain accesses memory beyond vertex / index
+    * buffers and UBOs: compute jobs (dispatches, copies, helper kernels) or
+    * vertex shaders with textures, images, storage / texel buffers */
+   bool vtc_reads_mem;
+   /* a fragment shader of the batch writes memory (storage buffers, images,
+    * atomics) */
+   bool frag_writes_mem;
+   /* device tiler heap the batch tiles into */
+   uint8_t tiler_heap;
 };
 
+/* Pipeline stages whose work only runs in vertex/tiler/compute jobs (JS1) /
+ * only in fragment jobs (JS0), for the v9 render-pass overlap. Transfers are
+ * in neither: vk_meta blits, clears, resolves and MSAA copies are fragment
+ * jobs, the other copies compute jobs. TOP_OF_PIPE / BOTTOM_OF_PIPE /
+ * HOST: no device work in a first / second synchronization scope. */
+#define PANVK_JM_VTC_ONLY_STAGES                                               \
+   (VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT | VK_PIPELINE_STAGE_2_HOST_BIT |       \
+    VK_PIPELINE_STAGE_2_DRAW_INDIRECT_BIT |                                    \
+    VK_PIPELINE_STAGE_2_VERTEX_INPUT_BIT |                                     \
+    VK_PIPELINE_STAGE_2_INDEX_INPUT_BIT |                                      \
+    VK_PIPELINE_STAGE_2_VERTEX_ATTRIBUTE_INPUT_BIT |                           \
+    VK_PIPELINE_STAGE_2_PRE_RASTERIZATION_SHADERS_BIT |                        \
+    VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT |                                    \
+    VK_PIPELINE_STAGE_2_TESSELLATION_CONTROL_SHADER_BIT |                      \
+    VK_PIPELINE_STAGE_2_TESSELLATION_EVALUATION_SHADER_BIT |                   \
+    VK_PIPELINE_STAGE_2_GEOMETRY_SHADER_BIT |                                  \
+    VK_PIPELINE_STAGE_2_TRANSFORM_FEEDBACK_BIT_EXT |                           \
+    VK_PIPELINE_STAGE_2_CONDITIONAL_RENDERING_BIT_EXT |                        \
+    VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT)
+#define PANVK_JM_FRAG_ONLY_STAGES                                              \
+   (VK_PIPELINE_STAGE_2_BOTTOM_OF_PIPE_BIT | VK_PIPELINE_STAGE_2_HOST_BIT |    \
+    VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |                                  \
+    VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |                             \
+    VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |                              \
+    VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |                          \
+    VK_PIPELINE_STAGE_2_FRAGMENT_SHADING_RATE_ATTACHMENT_BIT_KHR)
+
 enum panvk_cmd_event_op_type {
    PANVK_EVENT_OP_SET,
    PANVK_EVENT_OP_RESET,
@@ -125,6 +170,10 @@ struct panvk_cmd_buffer {
    struct list_head push_sets;
    struct panvk_batch *cur_batch;
    VkCommandBufferUsageFlags flags;
+   /* a barrier since the last batch: the next one gets barrier_frag */
+   bool barrier_frag;
+   /* tiler heap of the next batch that tiles (alternating) */
+   uint8_t next_tiler_heap;
 
    struct {
       struct panvk_cmd_graphics_state gfx;
diff --git a/src/panfrost/vulkan/jm/panvk_queue.h b/src/panfrost/vulkan/jm/panvk_queue.h
index 89b63a2..664e24a 100644
--- a/src/panfrost/vulkan/jm/panvk_queue.h
+++ b/src/panfrost/vulkan/jm/panvk_queue.h
@@ -18,7 +18,35 @@
 
 struct panvk_gpu_queue {
    struct vk_queue vk;
+   /* everything submitted so far */
    uint32_t sync;
+#if PAN_ARCH == 9
+   /* Render-pass overlap: the kernel takes implicit dependencies on shared
+    * BOs only (PANFROST_JD_REQ_SHARED_IMPLICIT_SYNC) and the queue orders
+    * its chains itself, so the vertex/tiler/compute jobs of a batch (JS1)
+    * run while earlier fragment jobs (JS0) still do. Off: every chain
+    * waits for the previous one. */
+   bool overlap;
+   /* last vertex/tiler/compute chain */
+   uint32_t vtc_sync;
+   /* last fragment chain of a batch tiling into heap 0 / 1, or without a
+    * tiler (2): the next batch tiling into a heap waits for its reader */
+   uint32_t frag_sync[3];
+   /* frag_sync slot of the last fragment chain; fragment chains run in
+    * order, so it stands for all of them */
+   unsigned last_frag;
+   /* a wait_frag batch had no vertex/tiler/compute chain: the next one
+    * waits instead */
+   bool carry_wait_frag;
+   /* a barrier from fragment to vertex/tiler/compute work whose wait was
+    * skipped (the chains after it didn't access memory): the first chain
+    * that does still waits */
+   bool barrier_pending;
+   /* fragment jobs not waited for yet wrote memory (storage buffers,
+    * images): after a barrier, vertex / index / indirect buffer reads count
+    * too */
+   bool frag_dirty;
+#endif
 };
 
 VK_DEFINE_HANDLE_CASTS(panvk_gpu_queue, vk.base, VkQueue, VK_OBJECT_TYPE_QUEUE)
