    return vk_command_buffer_end(&cmdbuf->vk);
 }
 
+/* Whether a barrier orders work that may run in fragment jobs (src) before
+ * work that may run in vertex/tiler/compute jobs (dst). The queue runs the
+ * two kinds of chains on their own slots, in order within each slot: only
+ * such a barrier needs the later vertex/tiler/compute jobs to wait for the
+ * earlier fragment ones. Transfers count on both sides (vk_meta blits,
+ * clears, resolves and MSAA copies are fragment jobs, the other copies
+ * compute jobs). */
+static bool
+barrier_waits_frag(const VkDependencyInfo *info)
+{
+   VkPipelineStageFlags2 src = 0, dst = 0;
+
+   for (uint32_t i = 0; i < info->memoryBarrierCount; i++) {
+      src |= info->pMemoryBarriers[i].srcStageMask;
+      dst |= info->pMemoryBarriers[i].dstStageMask;
+   }
+   for (uint32_t i = 0; i < info->bufferMemoryBarrierCount; i++) {
+      src |= info->pBufferMemoryBarriers[i].srcStageMask;
+      dst |= info->pBufferMemoryBarriers[i].dstStageMask;
+   }
+   for (uint32_t i = 0; i < info->imageMemoryBarrierCount; i++) {
+      src |= info->pImageMemoryBarriers[i].srcStageMask;
+      dst |= info->pImageMemoryBarriers[i].dstStageMask;
+   }
+
+   /* BOTTOM_OF_PIPE as source / TOP_OF_PIPE as destination mean all
+    * commands; ALL_COMMANDS / ALL_GRAPHICS / ALL_TRANSFER stay set and
+    * count on both sides */
+   src = vk_expand_src_stage_flags2(src);
+   dst = vk_expand_dst_stage_flags2(dst);
+
+   return (src & ~PANVK_JM_VTC_ONLY_STAGES) &&
+          (dst & ~PANVK_JM_FRAG_ONLY_STAGES);
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
                                     const VkDependencyInfo *pDependencyInfo)
 {
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
+   bool frag = PAN_ARCH == 9 && barrier_waits_frag(pDependencyInfo);
 
    /* Caches are flushed/invalidated at batch boundaries for now, nothing to do
     * for memory barriers assuming we implement barriers with the creation of a
@@ -379,12 +425,18 @@ panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
     */
 #if PAN_ARCH == 9
    /* Compute-only batch: keep the chain, the next dispatch gets a cache
-    * flush job with the barrier flag (jobs in a chain already run in order). */
-   if (cmdbuf->cur_batch && cmdbuf->cur_batch->compute_only) {
+    * flush job with the barrier flag (jobs in a chain already run in order).
+    * No fragment job can come between the batch's start and the barrier: a
+    * batch that already waits for them (compute jobs access memory) needs no
+    * new one. */
+   if (cmdbuf->cur_batch && cmdbuf->cur_batch->compute_only &&
+       (!frag || cmdbuf->cur_batch->barrier_frag ||
+        cmdbuf->cur_batch->wait_frag)) {
       cmdbuf->cur_batch->needs_cache_flush = true;
       return;
    }
 #endif
+   cmdbuf->barrier_frag |= frag;
    if (cmdbuf->cur_batch) {
       panvk_per_arch(cmd_close_batch)(cmdbuf);
       panvk_per_arch(cmd_open_batch)(cmdbuf);
@@ -418,6 +470,8 @@ panvk_reset_cmdbuf(struct vk_command_buffer *vk_cmdbuf,
    panvk_cmd_buffer_obj_list_reset(cmdbuf, push_sets);
 
    memset(&cmdbuf->state, 0, sizeof(cmdbuf->state));
+   cmdbuf->barrier_frag = false;
+   cmdbuf->next_tiler_heap = 0;
 }
 
