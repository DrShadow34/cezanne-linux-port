+/* ---- geometry shaders (src/poly) ---- */
+
+/* A compute job of a vertex or geometry shader variant in the draw's
+ * vertex/tiler chain: count_x invocations (rounded up to workgroups, the
+ * shader skips the rest) by count_y, after job dep if not 0. */
+static VkResult
+emit_poly_compute_job(struct panvk_cmd_buffer *cmdbuf,
+                      const struct panvk_shader_variant *shader,
+                      uint64_t res_table, uint32_t count_x, uint32_t count_y,
+                      unsigned dep, unsigned *job_index)
+{
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+   struct pan_ptr push_uniforms;
+
+   assert(!shader->info.wls_size);
+   batch->tlsinfo.tls.size =
+      MAX2(batch->tlsinfo.tls.size, shader->info.tls_size);
+
+   VkResult result = panvk_per_arch(cmd_prepare_gfx_push_uniforms)(
+      cmdbuf, shader, &push_uniforms, 1);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct pan_ptr job = panvk_cmd_alloc_desc(cmdbuf, COMPUTE_JOB);
+   if (!job.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   pan_section_pack(job.cpu, COMPUTE_JOB, PAYLOAD, cfg) {
+      cfg.workgroup_size_x = shader->cs.local_size.x;
+      cfg.workgroup_size_y = shader->cs.local_size.y;
+      cfg.workgroup_size_z = shader->cs.local_size.z;
+      cfg.workgroup_count_x = DIV_ROUND_UP(count_x, shader->cs.local_size.x);
+      cfg.workgroup_count_y = count_y;
+      cfg.workgroup_count_z = 1;
+
+      cfg.compute.resources = res_table;
+      cfg.compute.shader = panvk_priv_mem_dev_addr(shader->spd);
+      cfg.compute.thread_storage = batch->tls.gpu;
+      cfg.compute.fau = push_uniforms.gpu;
+      cfg.compute.fau_count = shader->fau.total_count;
+
+      cfg.task_increment = 1;
+      cfg.task_axis = MALI_TASK_AXIS_X;
+   }
+
+   util_dynarray_append(&batch->jobs, job.cpu);
+   *job_index = pan_jc_add_job(&batch->vtc_jc, MALI_JOB_TYPE_COMPUTE, false,
+                               false, dep, 0, &job, false);
+   return VK_SUCCESS;
+}
+
+/*
+ * Parameters of a draw with a geometry shader, and the draw the hardware
+ * does instead (rast): poly's vertex parameters (index buffer, the buffer
+ * the vertex shader stores its outputs to) and geometry parameters (counts,
+ * output index buffer), as Honeykrisp's hk_upload_vertex_params() /
+ * hk_upload_geometry_params() for direct draws without transform feedback.
+ */
+static VkResult
+prepare_poly_draw(struct panvk_cmd_buffer *cmdbuf,
+                  struct panvk_draw_info *draw, struct panvk_draw_info *rast)
+{
+   const struct panvk_shader *vs = cmdbuf->state.gfx.vs.shader;
+   const struct panvk_shader *gs = cmdbuf->state.gfx.gs.shader;
+   const struct poly_gs_info *gsi = &gs->poly.gs_info;
+   const struct panvk_shader_variant *vs_sw =
+      panvk_shader_variant(vs, PANVK_VS_VARIANT_SW);
+   const uint32_t wg_size[3] = {
+      vs_sw->cs.local_size.x,
+      vs_sw->cs.local_size.y,
+      vs_sw->cs.local_size.z,
+   };
+   const uint32_t verts = draw->vertex.count;
+   const uint32_t instances = draw->instance.count;
+
+   struct poly_vertex_params vp;
+   poly_vertex_params_init(&vp, vs->poly.vs_sw_outputs, wg_size);
+   poly_vertex_params_set_draw(&vp, verts, instances);
+
+   if (draw->index.index_size) {
+      uint32_t avail = draw->index.buffer_size / draw->index.index_size;
+
+      vp.index_size_B = draw->index.index_size;
+      vp.index_buffer_range_el =
+         poly_index_buffer_range_el(avail, draw->index.offset);
+      vp.index_buffer = vp.index_buffer_range_el
+                           ? draw->index.buffer_dev_addr +
+                                (uint64_t)draw->index.offset *
+                                   draw->index.index_size
+                           : PAN_SHADER_OOB_ADDRESS;
+   }
+
+   uint32_t out_size = poly_tcs_in_size(verts * instances, vp.outputs);
+   if (out_size) {
+      struct pan_ptr out = panvk_cmd_alloc_dev_mem(cmdbuf, desc, out_size, 16);
+      if (!out.gpu)
+         return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+      vp.output_buffer = out.gpu;
+   } else {
+      vp.output_buffer = PAN_SHADER_OOB_ADDRESS;
+   }
+
+   struct poly_geometry_params gp;
+   poly_geometry_params_init(&gp, draw->prim, wg_size);
+   poly_geometry_params_set_draw(&gp, draw->prim, gsi->shape,
+                                 gsi->max_indices, verts, instances);
+   gp.count_buffer_stride = gsi->count_words * 4;
+
+   *rast = (struct panvk_draw_info){
+      .vertex.count = gp.draw.index_count,
+      .instance.count = gp.draw.instance_count,
+      .prim = gsi->mode,
+      .draw_id = draw->draw_id,
+   };
+
+   if (gsi->shape == POLY_GS_SHAPE_DYNAMIC_INDEXED ||
+       gsi->shape == POLY_GS_SHAPE_STATIC_INDEXED) {
+      const uint32_t index_size = poly_gs_index_size(gsi->shape);
+      const uint32_t size = rast->vertex.count * index_size;
+      struct pan_ptr ib;
+
+      if (gsi->shape == POLY_GS_SHAPE_DYNAMIC_INDEXED) {
+         ib = panvk_cmd_alloc_dev_mem(cmdbuf, desc, MAX2(size, 4), 4);
+         gp.output_index_buffer = ib.gpu;
+      } else {
+         ib = panvk_cmd_alloc_dev_mem(cmdbuf, desc, MAX2(size, 4), 4);
+         if (ib.cpu)
+            memcpy(ib.cpu, gsi->topology, size);
+      }
+      if (!ib.gpu)
+         return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+      /* strips separated by restart indices (all ones) */
+      rast->index.buffer_dev_addr = ib.gpu;
+      rast->index.buffer_size = size;
+      rast->index.index_size = index_size;
+      rast->index.restart_enable = gsi->mode != MESA_PRIM_POINTS;
+   }
+
+   struct pan_ptr params = panvk_cmd_alloc_dev_mem(
+      cmdbuf, desc, sizeof(vp) + sizeof(gp), 16);
+   if (!params.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   memcpy(params.cpu, &vp, sizeof(vp));
+   memcpy((uint8_t *)params.cpu + sizeof(vp), &gp, sizeof(gp));
+   draw->poly.vertex_params = params.gpu;
+   draw->poly.geometry_params = params.gpu + sizeof(vp);
+   draw->poly.rast_last_vertex =
+      rast->index.index_size || !rast->vertex.count ? UINT32_MAX
+                                                    : rast->vertex.count - 1;
+   return VK_SUCCESS;
+}
+
+/* The vertex shader, then the geometry shader's main variant (dynamic
+ * topologies: writes the index buffer), as compute jobs ahead of the draw.
+ * Returns the index of the last one, the draw's dependency. */
+static VkResult
+emit_poly_jobs(struct panvk_cmd_buffer *cmdbuf,
+               const struct panvk_draw_info *draw, unsigned *last_job)
+{
+   const struct panvk_shader *vs = cmdbuf->state.gfx.vs.shader;
+   const struct panvk_shader *gs = cmdbuf->state.gfx.gs.shader;
+   const struct panvk_shader_variant *vs_sw =
+      panvk_shader_variant(vs, PANVK_VS_VARIANT_SW);
+   const struct panvk_shader_variant *gs_main =
+      panvk_shader_variant(gs, PANVK_GS_VARIANT_MAIN);
+   VkResult result;
+
+   *last_job = 0;
+   if (panvk_priv_mem_check_alloc(vs_sw->spd)) {
+      result = emit_poly_compute_job(
+         cmdbuf, vs_sw, cmdbuf->state.gfx.vs.desc.res_table,
+         draw->vertex.count, draw->instance.count, 0, last_job);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   if (panvk_priv_mem_check_alloc(gs_main->spd)) {
+      uint32_t prims =
+         u_decomposed_prims_for_vertices(draw->prim, draw->vertex.count);
+
+      result = emit_poly_compute_job(cmdbuf, gs_main,
+                                     cmdbuf->state.gfx.gs.desc.res_table,
+                                     prims, draw->instance.count, *last_job,
+                                     last_job);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   return VK_SUCCESS;
+}
+
 static void
 panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info *draw)
 {
-   const struct panvk_shader_variant *vs =
-      panvk_shader_hw_variant(cmdbuf->state.gfx.vs.shader);
+   const struct panvk_shader *gs = cmdbuf->state.gfx.gs.shader;
+   const struct panvk_shader_variant *vs = get_hw_vs(cmdbuf);
    const struct vk_rasterization_state *rs =
       &cmdbuf->vk.dynamic_graphics_state.rs;
    VkResult result;
@@ -998,6 +1247,36 @@ panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info *draw)
    if (!panvk_priv_mem_check_alloc(vs->spds.pos_triangles))
