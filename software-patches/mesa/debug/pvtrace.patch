+/*
+ * Temporary render pass trace for profiling (not for upstream).
+ * Active while /tmp/pvtrace exists; lines go to /tmp/pvtrace.log.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef PANVK_PVTRACE_H
+#define PANVK_PVTRACE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+
+bool panvk_pvtrace_on(void);
+bool panvk_pvtrace_img_on(void);
+FILE *panvk_pvtrace_file(void);
+uint64_t panvk_pvtrace_ms(void);
+/* caller offset inside libvulkan_panfrost.so, for addr2line */
+uintptr_t panvk_pvtrace_offset(const void *addr);
+
+#endif
