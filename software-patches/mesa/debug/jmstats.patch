+#if PAN_ARCH == 9
+/* debug (jmstats.patch): while /tmp/panvk-serial exists, submit serially;
+ * checked once a second, for A/B runs in one session (the device must have
+ * overlap on: two tiler heaps, the queue's syncobjs) */
+static void
+panvk_jm_stats_toggle(struct panvk_gpu_queue *queue)
+{
+   static uint64_t last;
+   uint64_t now = os_time_get_nano();
+   struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
+
+   if (!dev->jm_overlap || now - last < 1000000000ull)
+      return;
+   last = now;
+
+   bool serial = access("/tmp/panvk-serial", F_OK) == 0;
+
+   if (serial && queue->overlap) {
+      panvk_queue_join(queue);
+      queue->overlap = false;
+   } else if (!serial && !queue->overlap) {
+      panvk_queue_transfer_sync(queue, queue->vtc_sync);
+      for (unsigned i = 0; i < ARRAY_SIZE(queue->frag_sync); i++)
+         panvk_queue_transfer_sync(queue, queue->frag_sync[i]);
+      queue->carry_wait_frag = queue->barrier_pending = false;
+      queue->frag_dirty = false;
+      queue->overlap = true;
+   }
+   panvk_jm_stats.serial = !queue->overlap;
+}
+#endif
