new file mode 100644
index 0000000..bac34d8
--- /dev/null
+++ b/src/panfrost/vulkan/jm/panvk_jm_stats.h
@@ -0,0 +1,178 @@
+/*
+ * Debug only (mainline/mesa-g77/debug/jmstats.patch, not in the package):
+ * render-pass overlap statistics. PANVK_JM_STATS=<file> appends every 3 s:
+ * batches by kind, which vertex/tiler/compute chains waited for fragment
+ * chains and why, skipped barrier waits, and the stage masks of the barriers
+ * from fragment work. While /tmp/panvk-serial exists, submission is serial
+ * (A/B in one session; needs PANVK_JM_OVERLAP=1).
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef PANVK_JM_STATS_H
+#define PANVK_JM_STATS_H
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "util/os_time.h"
+#include "util/simple_mtx.h"
+
+#include <vulkan/vulkan_core.h>
+
+#define JM_STATS_PAIRS 64
+
+struct panvk_jm_stats {
+   simple_mtx_t lock;
+   int state; /* 0 unknown, 1 on, -1 off */
+   FILE *f;
+   uint64_t last_ns;
+   bool serial;
+   /* submit side */
+   uint64_t vk_submits, batches, vtc, frag, tiling;
+   uint64_t wait_forced, wait_barrier_reads, wait_barrier_dirty, skipped,
+      heap_prev;
+   /* record side */
+   uint64_t barriers, barriers_frag, draws, draws_vs_mem, draws_fs_writes;
+   struct {
+      VkPipelineStageFlags2 src, dst;
+      uint64_t count;
+      bool frag;
+   } pairs[JM_STATS_PAIRS];
+};
+
+/* one instance for every translation unit (and per-arch copy) of the .so */
+__attribute__((weak)) struct panvk_jm_stats panvk_jm_stats = {
+   .lock = SIMPLE_MTX_INITIALIZER,
+};
+
+static inline bool
+panvk_jm_stats_on(void)
+{
+   if (panvk_jm_stats.state == 0) {
+      const char *path = getenv("PANVK_JM_STATS");
+      panvk_jm_stats.f = path ? fopen(path, "a") : NULL;
+      panvk_jm_stats.state = panvk_jm_stats.f ? 1 : -1;
+   }
+   return panvk_jm_stats.state > 0;
+}
+
+static inline void
+panvk_jm_stats_barrier(const VkDependencyInfo *info, bool frag)
+{
+   if (!panvk_jm_stats_on())
+      return;
+
+   VkPipelineStageFlags2 src = 0, dst = 0;
+   for (uint32_t i = 0; i < info->memoryBarrierCount; i++) {
+      src |= info->pMemoryBarriers[i].srcStageMask;
+      dst |= info->pMemoryBarriers[i].dstStageMask;
+   }
+   for (uint32_t i = 0; i < info->bufferMemoryBarrierCount; i++) {
+      src |= info->pBufferMemoryBarriers[i].srcStageMask;
+      dst |= info->pBufferMemoryBarriers[i].dstStageMask;
+   }
+   for (uint32_t i = 0; i < info->imageMemoryBarrierCount; i++) {
+      src |= info->pImageMemoryBarriers[i].srcStageMask;
+      dst |= info->pImageMemoryBarriers[i].dstStageMask;
+   }
+
+   simple_mtx_lock(&panvk_jm_stats.lock);
+   panvk_jm_stats.barriers++;
+   panvk_jm_stats.barriers_frag += frag;
+   for (unsigned i = 0; frag && i < JM_STATS_PAIRS; i++) {
+      if (!panvk_jm_stats.pairs[i].count) {
+         panvk_jm_stats.pairs[i].src = src;
+         panvk_jm_stats.pairs[i].dst = dst;
+      }
+      if (panvk_jm_stats.pairs[i].src == src &&
+          panvk_jm_stats.pairs[i].dst == dst) {
+         panvk_jm_stats.pairs[i].count++;
+         break;
+      }
+   }
+   simple_mtx_unlock(&panvk_jm_stats.lock);
+}
+
+static inline void
+panvk_jm_stats_draw(bool vs_mem, bool fs_writes)
+{
+   if (!panvk_jm_stats_on())
+      return;
+   simple_mtx_lock(&panvk_jm_stats.lock);
+   panvk_jm_stats.draws++;
+   panvk_jm_stats.draws_vs_mem += vs_mem;
+   panvk_jm_stats.draws_fs_writes += fs_writes;
+   simple_mtx_unlock(&panvk_jm_stats.lock);
+}
+
+static inline void
+panvk_jm_stats_count(uint64_t *counter)
+{
+   if (!panvk_jm_stats_on())
+      return;
+   simple_mtx_lock(&panvk_jm_stats.lock);
+   (*counter)++;
+   simple_mtx_unlock(&panvk_jm_stats.lock);
+}
+
+/* one submitted batch; forced / barrier / reads / dirty as the queue saw
+ * them, waited = its vertex/tiler/compute chain waited for fragment chains */
+static inline void
+panvk_jm_stats_batch(bool vtc, bool frag, bool tiling, bool waited,
+                     bool forced, bool barrier, bool reads, bool dirty,
+                     bool heap_prev)
+{
+   if (!panvk_jm_stats_on())
+      return;
+
+   struct panvk_jm_stats *s = &panvk_jm_stats;
+   simple_mtx_lock(&s->lock);
+   s->batches++;
+   s->vtc += vtc;
+   s->frag += frag;
+   s->tiling += tiling;
+   if (vtc && waited) {
+      if (forced)
+         s->wait_forced++;
+      else if (reads)
+         s->wait_barrier_reads++;
+      else if (dirty)
+         s->wait_barrier_dirty++;
+   }
+   s->skipped += vtc && barrier && !waited;
+   s->heap_prev += vtc && heap_prev;
+
+   uint64_t now = os_time_get_nano();
+   if (now - s->last_ns > 3000000000ull) {
+      fprintf(s->f,
+              "%.1f s %s: %" PRIu64 " vkQueueSubmit, %" PRIu64
+              " batches (vtc %" PRIu64 ", frag %" PRIu64 ", tiling %" PRIu64
+              "); vtc waited for frag: forced %" PRIu64
+              ", barrier+access %" PRIu64 ", barrier+frag stores %" PRIu64
+              "; barrier waits skipped %" PRIu64 "; heap of the previous frag %" PRIu64
+              "; recorded: %" PRIu64 " barriers (%" PRIu64 " frag->vtc), %" PRIu64
+              " draws (vs memory %" PRIu64 ", fs stores %" PRIu64 ")\n",
+              now / 1e9, s->serial ? "SERIAL" : "overlap", s->vk_submits,
+              s->batches, s->vtc, s->frag, s->tiling, s->wait_forced,
+              s->wait_barrier_reads, s->wait_barrier_dirty, s->skipped,
+              s->heap_prev, s->barriers, s->barriers_frag, s->draws,
+              s->draws_vs_mem, s->draws_fs_writes);
+      for (unsigned i = 0; i < JM_STATS_PAIRS && s->pairs[i].count; i++)
+         fprintf(s->f, "  barrier src 0x%" PRIx64 " dst 0x%" PRIx64 ": %" PRIu64 "\n",
+                 (uint64_t)s->pairs[i].src, (uint64_t)s->pairs[i].dst,
+                 s->pairs[i].count);
+      fflush(s->f);
+      s->last_ns = now;
+      s->vk_submits = s->batches = s->vtc = s->frag = s->tiling = 0;
+      s->wait_forced = s->wait_barrier_reads = s->wait_barrier_dirty = 0;
+      s->skipped = s->heap_prev = 0;
+      s->barriers = s->barriers_frag = s->draws = s->draws_vs_mem = 0;
+      s->draws_fs_writes = 0;
+      for (unsigned i = 0; i < JM_STATS_PAIRS; i++)
+         s->pairs[i].count = 0;
+   }
+   simple_mtx_unlock(&s->lock);
+}
+
+#endif
