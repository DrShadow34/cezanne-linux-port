+static const char *
+cr_string_str (CRString *string)
+{
+  return string && string->stryng ? string->stryng->str : NULL;
+}
+
+static void
+sheet_index_add_selector (SheetIndex          *index,
+                          CRSimpleSel         *simple_sel,
+                          const SelectorEntry *entry)
+{
+  CRSimpleSel *last;
+  CRAdditionalSel *add_sel;
+  const char *class_name = NULL;
+
+  for (last = simple_sel; last->next; last = last->next)
+    ;
+
+  for (add_sel = last->add_sel; add_sel; add_sel = add_sel->next)
+    {
+      if (add_sel->type == ID_ADD_SELECTOR && cr_string_str (add_sel->content.id_name))
         {
-        case RULESET_STMT:
-          if (cur_stmt->kind.ruleset && cur_stmt->kind.ruleset->sel_list)
+          entry_table_add (index->by_id, cr_string_str (add_sel->content.id_name), entry);
+          return;
+        }
+      if (add_sel->type == CLASS_ADD_SELECTOR && !class_name)
+        class_name = cr_string_str (add_sel->content.class_name);
+    }
+
+  if (class_name)
+    entry_table_add (index->by_class, class_name, entry);
+  else if ((last->type_mask & TYPE_SELECTOR) &&
+           !(last->type_mask & UNIVERSAL_SELECTOR) &&
+           cr_string_str (last->name))
+    entry_table_add (index->by_type, cr_string_str (last->name), entry);
+  else
+    g_array_append_val (index->other, *entry);
+}
