+static void
+add_matched_properties (StTheme      *a_this,
+                        CRStyleSheet *a_nodesheet,
+                        StThemeNode  *a_node,
+                        GPtrArray    *props)
+{
+  SheetIndex *index = sheet_get_index (a_nodesheet);
+  g_autoptr (GArray) candidates = g_array_new (FALSE, FALSE, sizeof (SelectorEntry));
+  GType type = st_theme_node_get_element_type (a_node);
+  GStrv classes;
+  guint i, last_seq = G_MAXUINT;
+
+  collect_entries (candidates, index->by_id, st_theme_node_get_element_id (a_node));
+  classes = st_theme_node_get_element_classes (a_node);
+  for (i = 0; classes && classes[i]; i++)
+    collect_entries (candidates, index->by_class, classes[i]);
+
+  if (type == G_TYPE_NONE)
+    {
+      collect_entries (candidates, index->by_type, "stage");
+    }
+  else
+    {
+      GType *ifaces;
+      guint n_ifaces;
+      GType t;
+
+      for (t = type; t; t = g_type_parent (t))
+        collect_entries (candidates, index->by_type, g_type_name (t));
+
+      ifaces = g_type_interfaces (type, &n_ifaces);
+      for (i = 0; i < n_ifaces; i++)
+        collect_entries (candidates, index->by_type, g_type_name (ifaces[i]));
+      g_free (ifaces);
+    }
+
+  g_array_append_vals (candidates, index->other->data, index->other->len);
+  g_array_sort (candidates, compare_entries);
+
+  for (i = 0; i < candidates->len; i++)
+    {
+      SelectorEntry *entry = &g_array_index (candidates, SelectorEntry, i);
+      CRStatement *cur_stmt = entry->stmt;
+      CRSelector *cur_sel = entry->sel;
+      gboolean matches = FALSE;
+      enum CRStatus status = CR_OK;
+
+      /* a class or interface listed twice */
+      if (entry->seq == last_seq)
         continue;
+      last_seq = entry->seq;
 
-      /*
