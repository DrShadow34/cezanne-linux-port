+/* Selector index of a stylesheet. Every selector of its rulesets is filed
+ * under what its rightmost simple selector requires of a node: its id, else
+ * its first class, else its element type name (matched against the node's
+ * type, its parent types and interfaces, as element_name_matches_type()
+ * does). Selectors requiring none of these and @import statements go into
+ * @other, tried for every node. A node is only tested against its
+ * candidates, in their order in the stylesheet, so the cascade is the same
+ * as testing every selector: with ~1400 rules (the shell theme plus
+ * extension stylesheets) matching was most of the time St spent styling
+ * actors shown for the first time.
+ */
+typedef struct
+{
+  CRStatement *stmt;
+  CRSelector  *sel;     /* NULL: the @import statement @stmt */
+  guint        seq;     /* position in the stylesheet */
+} SelectorEntry;
+
+typedef struct
+{
+  GHashTable *by_id;    /* const char * -> GArray of SelectorEntry */
+  GHashTable *by_class;
+  GHashTable *by_type;
+  GArray     *other;
+} SheetIndex;
