+static SheetIndex *
+sheet_get_index (CRStyleSheet *sheet)
+{
+  SheetIndex *index = sheet->st_index;
+  CRStatement *stmt;
+  guint seq = 0;
+
+  if (index)
+    return index;
+
+  index = g_new0 (SheetIndex, 1);
+  index->by_id = entry_table_new ();
+  index->by_class = entry_table_new ();
+  index->by_type = entry_table_new ();
+  index->other = g_array_new (FALSE, FALSE, sizeof (SelectorEntry));
+
+  for (stmt = sheet->statements; stmt; stmt = stmt->next)
+    {
+      if (stmt->type == AT_IMPORT_RULE_STMT)
+        {
+          SelectorEntry entry = { stmt, NULL, seq++ };
+
+          g_array_append_val (index->other, entry);
+        }
+      else if (stmt->type == RULESET_STMT &&
+               stmt->kind.ruleset && stmt->kind.ruleset->sel_list)
+        {
+          CRSelector *sel;
+
+          for (sel = stmt->kind.ruleset->sel_list; sel; sel = sel->next)
             {
-              sel_list = cur_stmt->kind.ruleset->sel_list;
+              SelectorEntry entry = { stmt, sel, seq++ };
+
+              if (sel->simple_sel)
+                sheet_index_add_selector (index, sel->simple_sel, &entry);
             }
-          break;
+        }
+    }
+
+  sheet->st_index = index;
+  sheet->st_index_free = sheet_index_free;
+  return index;
+}
 
