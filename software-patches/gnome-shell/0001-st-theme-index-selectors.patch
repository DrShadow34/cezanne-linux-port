+  /* the keys are the stylesheet's own strings, alive as long as it is */
+  return g_hash_table_new_full (g_str_hash, g_str_equal, NULL,
+                                (GDestroyNotify) g_array_unref);
+}
+
+static void
+entry_table_add (GHashTable          *table,
+                 const char          *key,
+                 const SelectorEntry *entry)
+{
+  GArray *entries = g_hash_table_lookup (table, key);
+
+  if (!entries)
+    {
+      entries = g_array_new (FALSE, FALSE, sizeof (SelectorEntry));
+      g_hash_table_insert (table, (gpointer) key, entries);
+    }
+  g_array_append_val (entries, *entry);
+}
