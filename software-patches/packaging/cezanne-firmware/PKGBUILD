# Vendor firmware the cezanne drivers load, copied from the stock MIUI images
# (vendor / md1img / scp partitions, libmnl DSP images; NOTES has where each
# blob comes from): CONNSYS Wi-Fi / BT / FM / GPS patches and configs, the
# modem's mdota files, the SCP image, CS35L41 speaker tunings, AW8697 haptics.
# Bump pkgver (date) when a blob changes.
pkgname=cezanne-firmware
pkgver=20261102
pkgrel=1
pkgdesc="Vendor firmware for the Redmi K30 Ultra (cezanne): CONNSYS, modem, SCP, audio amps, haptics"
arch=(any)
url="https://localhost/arch-port"
license=(LicenseRef-vendor-redistributable)
options=(!strip)

package() {
  cd "$startdir/firmware"
  find . -type f -print0 | while IFS= read -r -d '' f; do
    install -Dm644 "$f" "$pkgdir/usr/lib/firmware/${f#./}"
  done
}
