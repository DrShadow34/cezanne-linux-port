From 6f8e87c6c05c59879bb08651ce8c24dc43678caf Mon Sep 17 00:00:00 2001
From: cezanne <port@local>
Date: Sun, 1 Nov 2026 05:10:30 +0100
Subject: [PATCH 9/9] panvk: 32 vertex attributes on v9

DXVK's D3D9 fixed-function vertex shader declares 18 inputs (blend
weight / indices at locations 16 and 17) and D3D11 has 32 input slots;
the v9 path asserted on locations past 15. The v9 driver set holds 32
attribute descriptors; the compiler loads indices from 16 on with a
register index (the immediate form only reaches 15). Bindings stay at
16.

The vertex shader's dummy sampler, and the dynamic buffers after it,
follow the attributes in the driver set: the draw puts them at
MAX_VS_ATTRIBS, so the descriptor lowering must too (with 16 there,
vertex shaders read their dynamic UBOs from unused attribute
descriptors: vkQuake drew no models).
---
 src/panfrost/vulkan/panvk_shader.h                     | 5 ++++-
 src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c   | 2 +-
 src/panfrost/vulkan/panvk_vX_physical_device.c         | 2 +-
 src/panfrost/vulkan/panvk_vX_shader.c                  | 2 +-
 4 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_shader.h b/src/panfrost/vulkan/panvk_shader.h
index 6817292..53acfda 100644
--- a/src/panfrost/vulkan/panvk_shader.h
+++ b/src/panfrost/vulkan/panvk_shader.h
@@ -27,7 +27,10 @@
 extern const struct vk_device_shader_ops panvk_per_arch(device_shader_ops);
 
 #define MAX_RTS 8
-#define MAX_VS_ATTRIBS 16
+/* v9: 32 vertex attributes (D3D11 has 32 input slots; DXVK's D3D9
+ * fixed-function vertex shader declares 18). Indices from 16 on are loaded
+ * with a register index instead of the immediate one. */
+#define MAX_VS_ATTRIBS (PAN_ARCH == 9 ? 32 : 16)
 
 #if PAN_ARCH < 9
 
diff --git a/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c b/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
--- a/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
+++ b/src/panfrost/vulkan/panvk_vX_nir_lower_descriptors.c
@@ -1163,7 +1163,7 @@ create_copy_table(nir_shader *nir, struct lower_desc_ctx *ctx)
    switch (nir->info.stage) {
    case MESA_SHADER_VERTEX:
       /* Dummy sampler comes after the vertex attributes. */
-      dummy_sampler_idx = 16;
+      dummy_sampler_idx = MAX_VS_ATTRIBS;
       break;
    case MESA_SHADER_FRAGMENT:
       /* Dummy sampler comes after the varyings. */
diff --git a/src/panfrost/vulkan/panvk_vX_physical_device.c b/src/panfrost/vulkan/panvk_vX_physical_device.c
index 80c3b67..3dceedf 100644
--- a/src/panfrost/vulkan/panvk_vX_physical_device.c
+++ b/src/panfrost/vulkan/panvk_vX_physical_device.c
@@ -902,7 +902,7 @@ panvk_per_arch(get_physical_device_properties)(
       /* Software limit to keep VkCommandBuffer tracking sane. The HW supports
        * up to 2^9 vertex attributes.
        */
-      .maxVertexInputAttributes = MAX_VBS,
+      .maxVertexInputAttributes = MAX_VS_ATTRIBS,
       .maxVertexInputBindings = MAX_VBS,
       /* MALI_ATTRIBUTE::offset is 32-bit. */
       .maxVertexInputAttributeOffset = UINT32_MAX,
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index 815df7a..89a634c 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -1574,7 +1574,7 @@ panvk_compile_shader(struct panvk_device *dev,
           */
          nir_foreach_shader_in_variable(var, nir) {
             assert(var->data.location >= VERT_ATTRIB_GENERIC0 &&
-                   var->data.location <= VERT_ATTRIB_GENERIC15);
+                   var->data.location < VERT_ATTRIB_GENERIC0 + MAX_VS_ATTRIBS);
             var->data.driver_location =
                var->data.location - VERT_ATTRIB_GENERIC0;
          }
