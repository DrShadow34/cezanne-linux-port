 src/panfrost/libpan/copy.cl             |  67 ++++++++
 src/panfrost/vulkan/panvk_image.c       |  34 +++-
 src/panfrost/vulkan/panvk_image.h       |   2 +
 src/panfrost/vulkan/panvk_vX_cmd_meta.c | 208 ++++++++++++++++++++++++
 4 files changed, 310 insertions(+), 1 deletion(-)

diff --git a/src/panfrost/libpan/copy.cl b/src/panfrost/libpan/copy.cl
index c3ad0bd..e3dc34e 100644
--- a/src/panfrost/libpan/copy.cl
+++ b/src/panfrost/libpan/copy.cl
@@ -29,4 +29,71 @@ panlib_fill_uint4_scalar(global uint4 *address, uint a, uint b, uint c, uint d)
 {
    address[cl_global_id.x] = (uint4)(a, b, c, d);
 }
+
+/* Index of element (x, y) inside a Mali u-interleaved tile: the bits of y
+ * go to the odd positions, the bits of x ^ y to the even ones (pan_tiling.c
+ * bit_duplication[y] ^ space_4[x]).
+ */
+static uint32_t
+panlib_u_interleave(uint32_t x, uint32_t y)
+{
+   uint32_t xy = x ^ y;
+
+   xy = (xy | (xy << 2)) & 0x33;
+   xy = (xy | (xy << 1)) & 0x55;
+   y = (y | (y << 2)) & 0x33;
+   y = (y | (y << 1)) & 0x55;
+   return xy | (y << 1);
+}
+
+/* Byte offset of block (x, y) in a surface: linear (tile_shift 0) or
+ * u-interleaved in tiles of (1 << tile_shift)^2 blocks, 4x4 for compressed
+ * formats and 16x16 otherwise. row_stride is the size of a row of tiles.
+ */
+static uint64_t
+panlib_block_offset(uint32_t x, uint32_t y, uint32_t row_stride,
+                    uint32_t tile_shift, uint32_t block_size)
+{
+   uint64_t row = (uint64_t)(y >> tile_shift) * row_stride;
+
+   if (!tile_shift)
+      return row + (uint64_t)x * block_size;
+
+   uint32_t mask = (1u << tile_shift) - 1;
+   uint32_t idx = ((x >> tile_shift) << (2 * tile_shift)) +
+                  panlib_u_interleave(x & mask, y & mask);
+   return row + (uint64_t)idx * block_size;
+}
+
+/* Copies a width x (count / width) rectangle of 8 or 16 byte blocks between
+ * two surfaces (buffers, linear or u-interleaved images), one layer per
+ * global_id.y. Used for compressed u-interleaved images, which vk_meta's
+ * uncompressed views can't alias (their tiles are 4x4 blocks, not 16x16).
+ */
+KERNEL(64)
+panlib_copy_image_blocks(uint64_t src, uint64_t dst, uint64_t src_layer_stride,
+                         uint64_t dst_layer_stride, uint32_t src_row_stride,
+                         uint32_t dst_row_stride, uint32_t src_x,
+                         uint32_t src_y, uint32_t dst_x, uint32_t dst_y,
+                         uint32_t width, uint32_t count,
+                         uint32_t src_tile_shift, uint32_t dst_tile_shift,
+                         uint32_t block_size)
+{
+   uint32_t i = cl_global_id.x;
+   if (i >= count)
+      return;
+
+   uint32_t x = i % width, y = i / width;
+   uint64_t s = src + cl_global_id.y * src_layer_stride +
+                panlib_block_offset(src_x + x, src_y + y, src_row_stride,
+                                    src_tile_shift, block_size);
+   uint64_t d = dst + cl_global_id.y * dst_layer_stride +
+                panlib_block_offset(dst_x + x, dst_y + y, dst_row_stride,
+                                    dst_tile_shift, block_size);
+
+   if (block_size == 16)
+      *(global uint4 *)d = *(global uint4 *)s;
+   else
+      *(global uint2 *)d = *(global uint2 *)s;
+}
 #endif
diff --git a/src/panfrost/vulkan/panvk_image.c b/src/panfrost/vulkan/panvk_image.c
index 892f301..d9441a2 100644
--- a/src/panfrost/vulkan/panvk_image.c
+++ b/src/panfrost/vulkan/panvk_image.c
@@ -504,6 +504,24 @@ panvk_image_init_layouts(struct panvk_image *image,
    return VK_SUCCESS;
 }
 
+/* On v9, copies touching compressed U-interleaved images don't go through
+ * vk_meta's uncompressed views (U-interleaved tiles are 4x4 blocks for
+ * compressed formats, 16x16 texels otherwise, so no view can alias them) but
+ * through panlib_copy_image_blocks, which computes the tiled addresses. Such
+ * images then don't need the RGBA-view flags that force them LINEAR.
+ */
+bool
+panvk_image_compressed_copies_by_blocks(const struct panvk_image *image)
+{
+   struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(image->vk.base.device->physical);
+
+   return pan_arch(phys_dev->kmod.dev->props.gpu_id) == 9 &&
+          vk_format_is_compressed(image->vk.format) &&
+          vk_format_get_blocksize(image->vk.format) >= 8 &&
+          image->vk.image_type != VK_IMAGE_TYPE_1D;
+}
+
 static void
 panvk_image_pre_mod_select_meta_adjustments(struct panvk_image *image)
 {
@@ -550,7 +568,8 @@ panvk_image_pre_mod_select_meta_adjustments(struct panvk_image *image)
 
    if ((image->vk.usage &
         (VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT)) &&
-       vk_format_is_compressed(image->vk.format)) {
+       vk_format_is_compressed(image->vk.format) &&
+       !panvk_image_compressed_copies_by_blocks(image)) {
       /* We need to be able to create RGBA views of compressed formats for
        * vk_meta copies.
        *
@@ -568,6 +587,19 @@ panvk_image_post_mod_select_meta_adjustments(struct panvk_image *image)
 {
    const VkImageAspectFlags aspects = vk_format_aspects(image->vk.format);
 
+   /* Compressed images that didn't get U-interleaved after all (the app asked
+    * for uncompressed views, or LINEAR) are copied by vk_meta through RGBA
+    * views, as on the other archs.
+    */
+   if ((image->vk.usage &
+        (VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT)) &&
+       vk_format_is_compressed(image->vk.format) &&
+       panvk_image_compressed_copies_by_blocks(image) &&
+       image->vk.drm_format_mod != DRM_FORMAT_MOD_ARM_16X16_BLOCK_U_INTERLEAVED) {
+      image->vk.create_flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT |
+                                VK_IMAGE_CREATE_BLOCK_TEXEL_VIEW_COMPATIBLE_BIT;
+   }
+
    /* If the image didn't end up using AFBC, we should add the storage flag
     * to allow vkmeta to take the compute based copying path. */
