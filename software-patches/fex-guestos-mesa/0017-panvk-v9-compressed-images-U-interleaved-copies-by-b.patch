diff --git a/src/panfrost/vulkan/panvk_image.h b/src/panfrost/vulkan/panvk_image.h
index eeb4529..8284b43 100644
--- a/src/panfrost/vulkan/panvk_image.h
+++ b/src/panfrost/vulkan/panvk_image.h
@@ -58,6 +58,8 @@ bool panvk_image_can_use_afbc(
    VkImageUsageFlags usage, VkImageType type, VkImageTiling tiling,
    VkImageCreateFlags flags);
 
+bool panvk_image_compressed_copies_by_blocks(const struct panvk_image *image);
+
 static inline unsigned
 panvk_plane_index(const struct panvk_image *image,
                   VkImageAspectFlags aspect_mask)
diff --git a/src/panfrost/vulkan/panvk_vX_cmd_meta.c b/src/panfrost/vulkan/panvk_vX_cmd_meta.c
index 28d9fcc..93ebdf4 100644
--- a/src/panfrost/vulkan/panvk_vX_cmd_meta.c
+++ b/src/panfrost/vulkan/panvk_vX_cmd_meta.c
@@ -370,6 +370,192 @@ panvk_per_arch(CmdCopyBuffer2)(VkCommandBuffer commandBuffer,
    meta_compute_end(cmdbuf, &save);
 }
 
+#if PAN_ARCH == 9
+/* Compressed U-interleaved images (see panvk_image_compressed_copies_by_blocks)
+ * are copied block by block with panlib_copy_image_blocks: vk_meta's
+ * uncompressed views would assume 16x16 tiles, compressed ones have 4x4.
+ */
+static bool
+is_compressed_utiled(const struct panvk_image *img)
+{
+   return vk_format_is_compressed(img->vk.format) &&
+          img->vk.drm_format_mod == DRM_FORMAT_MOD_ARM_16X16_BLOCK_U_INTERLEAVED;
+}
+
+struct block_surface {
+   uint64_t base;
+   uint64_t layer_stride;
+   uint32_t row_stride;
+   /* 0 = linear, else log2 of the U-interleaved tile size in blocks */
+   uint32_t tile_shift;
+};
+
+static struct block_surface
+image_block_surface(const struct panvk_image *img, uint32_t mip,
+                    uint32_t first_layer_or_z)
+{
+   const struct pan_image_plane *plane = &img->planes[0].plane;
+   const struct pan_image_slice_layout *slice = &plane->layout.slices[mip];
+   const uint64_t layer_stride = img->vk.image_type == VK_IMAGE_TYPE_3D
+                                    ? slice->tiled_or_linear.surface_stride_B
+                                    : plane->layout.array_stride_B;
+   uint32_t tile_shift = 0;
+
+   assert(!drm_is_afbc(img->vk.drm_format_mod));
+   if (img->vk.drm_format_mod == DRM_FORMAT_MOD_ARM_16X16_BLOCK_U_INTERLEAVED)
+      tile_shift = vk_format_is_compressed(img->vk.format) ? 2 : 4;
+
+   return (struct block_surface){
+      .base = plane->base + slice->offset_B + first_layer_or_z * layer_stride,
+      .layer_stride = layer_stride,
+      .row_stride = slice->tiled_or_linear.row_stride_B,
+      .tile_shift = tile_shift,
+   };
+}
+
+static struct block_surface
+buffer_block_surface(const struct panvk_buffer *buf, VkDeviceSize offset,
+                     VkFormat fmt, uint32_t row_length, uint32_t image_height)
+{
+   const uint32_t row_stride = DIV_ROUND_UP(row_length,
+                                            vk_format_get_blockwidth(fmt)) *
+                               vk_format_get_blocksize(fmt);
+
+   return (struct block_surface){
+      .base = panvk_buffer_gpu_ptr(buf, offset),
+      .layer_stride = (uint64_t)DIV_ROUND_UP(image_height,
+                                             vk_format_get_blockheight(fmt)) *
+                      row_stride,
+      .row_stride = row_stride,
+   };
+}
+
+static void
+copy_blocks(struct panvk_cmd_buffer *cmdbuf, const struct block_surface *src,
+            uint32_t src_x, uint32_t src_y, const struct block_surface *dst,
+            uint32_t dst_x, uint32_t dst_y, uint32_t width, uint32_t height,
+            uint32_t layers, uint32_t block_size)
+{
+   const uint32_t count = width * height;
+
+   if (!count || !layers)
+      return;
+
+   struct panvk_precomp_ctx ctx = panvk_per_arch(precomp_cs)(cmdbuf);
+   panlib_copy_image_blocks(&ctx, panlib_3d(DIV_ROUND_UP(count, 64), layers, 1),
+                            PANLIB_BARRIER_NONE, src->base, dst->base,
+                            src->layer_stride, dst->layer_stride,
+                            src->row_stride, dst->row_stride, src_x, src_y,
+                            dst_x, dst_y, width, count, src->tile_shift,
+                            dst->tile_shift, block_size);
+}
+
+/* Layers (2D arrays) or Z slices (3D) a buffer <-> image region covers. */
+static void
+region_layers(const struct panvk_image *img,
+              const VkImageSubresourceLayers *subres, int32_t z,
+              uint32_t depth, uint32_t *first, uint32_t *count)
+{
+   if (img->vk.image_type == VK_IMAGE_TYPE_3D) {
+      *first = z;
+      *count = depth;
+   } else {
+      *first = subres->baseArrayLayer;
+      *count = vk_image_subresource_layer_count(&img->vk, subres);
+   }
+}
+
+static bool
+copy_buffer_image_blocks(struct panvk_cmd_buffer *cmdbuf,
+                         struct panvk_image *img, struct panvk_buffer *buf,
+                         uint32_t region_count,
+                         const VkBufferImageCopy2 *regions, bool to_image)
+{
+   if (!is_compressed_utiled(img))
+      return false;
+
+   const VkFormat fmt = img->vk.format;
+   const uint32_t bw = vk_format_get_blockwidth(fmt);
+   const uint32_t bh = vk_format_get_blockheight(fmt);
+   const uint32_t bs = vk_format_get_blocksize(fmt);
+
+   for (uint32_t i = 0; i < region_count; i++) {
+      const VkBufferImageCopy2 *r = &regions[i];
+      uint32_t first, layers;
+
+      region_layers(img, &r->imageSubresource, r->imageOffset.z,
+                    r->imageExtent.depth, &first, &layers);
+
+      const struct block_surface isurf =
+         image_block_surface(img, r->imageSubresource.mipLevel, first);
+      const struct block_surface bsurf = buffer_block_surface(
+         buf, r->bufferOffset, fmt,
+         r->bufferRowLength ? r->bufferRowLength : r->imageExtent.width,
+         r->bufferImageHeight ? r->bufferImageHeight : r->imageExtent.height);
+      const uint32_t ix = r->imageOffset.x / bw, iy = r->imageOffset.y / bh;
+      const uint32_t w = DIV_ROUND_UP(r->imageExtent.width, bw);
+      const uint32_t h = DIV_ROUND_UP(r->imageExtent.height, bh);
+
+      if (to_image)
+         copy_blocks(cmdbuf, &bsurf, 0, 0, &isurf, ix, iy, w, h, layers, bs);
+      else
+         copy_blocks(cmdbuf, &isurf, ix, iy, &bsurf, 0, 0, w, h, layers, bs);
+   }
+
+   return true;
+}
+
+static bool
+copy_image_blocks(struct panvk_cmd_buffer *cmdbuf,
+                  const VkCopyImageInfo2 *info)
+{
+   VK_FROM_HANDLE(panvk_image, src, info->srcImage);
+   VK_FROM_HANDLE(panvk_image, dst, info->dstImage);
+
+   if (!is_compressed_utiled(src) && !is_compressed_utiled(dst))
+      return false;
+
+   /* The other image is size-compatible: 64/128-bit, never AFBC on v9. */
+   if (drm_is_afbc(src->vk.drm_format_mod) ||
+       drm_is_afbc(dst->vk.drm_format_mod)) {
+      mesa_loge("panvk: copy between compressed and AFBC images");
+      return false;
+   }
+
+   const uint32_t sbw = vk_format_get_blockwidth(src->vk.format);
+   const uint32_t sbh = vk_format_get_blockheight(src->vk.format);
+   const uint32_t dbw = vk_format_get_blockwidth(dst->vk.format);
+   const uint32_t dbh = vk_format_get_blockheight(dst->vk.format);
+   const uint32_t bs = vk_format_get_blocksize(src->vk.format);
+
+   assert(bs == vk_format_get_blocksize(dst->vk.format));
+
+   for (uint32_t i = 0; i < info->regionCount; i++) {
+      const VkImageCopy2 *r = &info->pRegions[i];
+      uint32_t src_first, dst_first, layers, dst_layers;
+
+      /* The extent is in source texels. */
+      region_layers(src, &r->srcSubresource, r->srcOffset.z, r->extent.depth,
+                    &src_first, &layers);
+      region_layers(dst, &r->dstSubresource, r->dstOffset.z, r->extent.depth,
+                    &dst_first, &dst_layers);
+      layers = MIN2(layers, dst_layers);
+
+      const struct block_surface ssurf =
+         image_block_surface(src, r->srcSubresource.mipLevel, src_first);
+      const struct block_surface dsurf =
+         image_block_surface(dst, r->dstSubresource.mipLevel, dst_first);
+
+      copy_blocks(cmdbuf, &ssurf, r->srcOffset.x / sbw, r->srcOffset.y / sbh,
+                  &dsurf, r->dstOffset.x / dbw, r->dstOffset.y / dbh,
+                  DIV_ROUND_UP(r->extent.width, sbw),
+                  DIV_ROUND_UP(r->extent.height, sbh), layers, bs);
+   }
+
+   return true;
+}
+#endif
+
 static bool
 lower_copy_buffer_to_image(
    VkCommandBuffer commandBuffer,
@@ -457,6 +643,14 @@ panvk_per_arch(CmdCopyBufferToImage2)(
    if (lower_copy_buffer_to_image(commandBuffer, pCopyBufferToImageInfo))
       return;
 
+#if PAN_ARCH == 9
+   VK_FROM_HANDLE(panvk_buffer, buf, pCopyBufferToImageInfo->srcBuffer);
+   if (copy_buffer_image_blocks(cmdbuf, img, buf,
+                                pCopyBufferToImageInfo->regionCount,
+                                pCopyBufferToImageInfo->pRegions, true))
+      return;
+#endif
+
    const bool use_gfx_pipeline = copy_to_image_use_gfx_pipeline(img);
    struct vk_meta_copy_image_properties img_props =
       panvk_meta_copy_get_image_properties(img, use_gfx_pipeline, true);
@@ -488,6 +682,15 @@ panvk_per_arch(CmdCopyImageToBuffer2)(
    VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
    struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
    VK_FROM_HANDLE(panvk_image, img, pCopyImageToBufferInfo->srcImage);
+
+#if PAN_ARCH == 9
+   VK_FROM_HANDLE(panvk_buffer, buf, pCopyImageToBufferInfo->dstBuffer);
+   if (copy_buffer_image_blocks(cmdbuf, img, buf,
+                                pCopyImageToBufferInfo->regionCount,
+                                pCopyImageToBufferInfo->pRegions, false))
+      return;
+#endif
+
    struct vk_meta_copy_image_properties img_props =
       panvk_meta_copy_get_image_properties(img, false, false);
    struct panvk_cmd_meta_compute_save_ctx save = {0};
@@ -650,6 +853,11 @@ panvk_per_arch(CmdCopyImage2)(VkCommandBuffer commandBuffer,
    if (lower_copy_image(commandBuffer, pCopyImageInfo))
       return;
 
+#if PAN_ARCH == 9
+   if (copy_image_blocks(cmdbuf, pCopyImageInfo))
+      return;
+#endif
+
    const bool use_gfx_pipeline = copy_to_image_use_gfx_pipeline(dst_img);
    struct vk_meta_copy_image_properties dst_img_props =
       panvk_meta_copy_get_image_properties(dst_img, use_gfx_pipeline, true);
