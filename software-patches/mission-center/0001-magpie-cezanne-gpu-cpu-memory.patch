-            .into());
-        }
-    }
-
-    let mut file = std::fs::File::create(&output_path)?;
-    file.write_all(content.as_slice())?;
-    file.flush()?;
-
-    println!("cargo:rerun-if-changed={}", output_path);
-
-    Ok(output_path)
-}
