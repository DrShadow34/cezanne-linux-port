+// cezanne port: phones have no SMBIOS; the kernel's mt6885-dram-info device
+// carries the same MEMORY_DEVICE_* udev properties (one module per rank)
+fn memory_info_device() -> String {
+    const DMI: &str = "/sys/devices/virtual/dmi/id";
+    if std::path::Path::new(DMI).exists() {
+        return DMI.to_owned();
+    }
+    std::fs::read_dir("/sys/bus/platform/drivers/cezanne-dram-info")
+        .ok()
+        .and_then(|mut entries| {
+            entries.find_map(|e| {
+                let path = std::fs::canonicalize(e.ok()?.path()).ok()?;
+                path.join("memory_devices").exists().then_some(path)
+            })
+        })
+        .map(|p| p.to_string_lossy().into_owned())
+        .unwrap_or_else(|| DMI.to_owned())
+}
