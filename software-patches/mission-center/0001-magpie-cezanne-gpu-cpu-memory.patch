     static NAME: OnceLock<String> = OnceLock::new();
     NAME.get_or_init(|| {
+        // cezanne port: sysinfo names arm64 cores by part ("Cortex-A55");
+        // the kernel's "model name" (the SoC, patch 0047) wins when present
+        if let Some(name) = std::fs::read_to_string("/proc/cpuinfo").ok().and_then(|info| {
+            info.lines().find_map(|line| {
+                let (key, value) = line.split_once(':')?;
+                (key.trim() == "model name").then(|| value.trim().to_owned())
+            })
+        }) {
+            return name;
+        }
