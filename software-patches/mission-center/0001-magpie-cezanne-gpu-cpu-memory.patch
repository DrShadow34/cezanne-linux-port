diff --color -ruN a/subprojects/magpie/platform-linux/src/gpus/ctop.rs b/subprojects/magpie/platform-linux/src/gpus/ctop.rs
--- a/subprojects/magpie/platform-linux/src/gpus/ctop.rs	1970-01-01 01:00:00.000000000 +0100
+++ b/subprojects/magpie/platform-linux/src/gpus/ctop.rs	2026-10-28 21:19:42.823799412 +0100
@@ -0,0 +1,97 @@
+/* src/gpus/ctop.rs
+ *
+ * FFI to libcezanne-top (ctop.h of the cezanne port's cezanne-top package):
+ * GPU render load, clocks, temperature and memory from DRM fdinfo /
+ * devfreq / thermal zones, hardware decoder / encoder load from the vcodec
+ * sysfs attributes. Replaces nvtop, which knows neither platform (non-PCI)
+ * GPUs as Mission Center expects them nor V4L2 codec engines.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+use std::ffi::{c_char, CStr};
+
+pub const CTOP_MAX_ENGINES: usize = 4;
+
+pub const CTOP_TEMP: u32 = 1 << 0;
+pub const CTOP_CLOCK: u32 = 1 << 1;
+pub const CTOP_CLOCK_MAX: u32 = 1 << 2;
+pub const CTOP_MEMORY: u32 = 1 << 3;
+pub const CTOP_UTIL: u32 = 1 << 4;
+pub const CTOP_DECODE: u32 = 1 << 5;
+pub const CTOP_ENCODE: u32 = 1 << 6;
+
+#[repr(C)]
+pub struct CtopProc {
+    pub pid: i32,
+    pub comm: [c_char; 16],
+    pub valid: u32,
+    pub memory: u64,
+    pub util: f32,
+    pub decode: f32,
+    pub encode: f32,
+}
+
+#[repr(C)]
+pub struct CtopGpu {
+    pub id: [c_char; 32],
+    pub name: [c_char; 64],
+    pub driver: [c_char; 16],
+    pub render_node: [c_char; 32],
+    pub vendor_id: u32,
+    pub device_id: u32,
+    pub valid: u32,
+    pub temp_mc: i32,
+    pub clock_mhz: u32,
+    pub clock_max_mhz: u32,
+    pub memory_used: u64,
+    pub memory_total: u64,
+    pub util: f32,
+    pub engines: u32,
+    pub engine_name: [[c_char; 16]; CTOP_MAX_ENGINES],
+    pub engine_util: [f32; CTOP_MAX_ENGINES],
+    pub decode: f32,
+    pub encode: f32,
+    pub nproc: u32,
+    pub proc_: *const CtopProc,
+}
+
+#[repr(C)]
+pub struct Ctop {
+    _private: [u8; 0],
+}
+
+extern "C" {
+    pub fn ctop_open() -> *mut Ctop;
+    pub fn ctop_refresh(c: *mut Ctop) -> i32;
+    pub fn ctop_count(c: *const Ctop) -> u32;
+    pub fn ctop_gpu(c: *const Ctop, i: u32) -> *const CtopGpu;
+    pub fn ctop_close(c: *mut Ctop);
+}
+
+/// The library handle; magpie only uses it behind the GpusHandler mutex.
+pub struct Handle(pub *mut Ctop);
+
+unsafe impl Send for Handle {}
+unsafe impl Sync for Handle {}
+
+impl Drop for Handle {
+    fn drop(&mut self) {
+        unsafe { ctop_close(self.0) }
+    }
+}
+
+pub fn string(s: &[c_char]) -> String {
+    unsafe { CStr::from_ptr(s.as_ptr()) }
+        .to_string_lossy()
+        .to_string()
+}
+
+impl CtopGpu {
+    pub fn processes(&self) -> &[CtopProc] {
+        if self.proc_.is_null() || self.nproc == 0 {
+            return &[];
+        }
+        unsafe { std::slice::from_raw_parts(self.proc_, self.nproc as usize) }
+    }
+}
