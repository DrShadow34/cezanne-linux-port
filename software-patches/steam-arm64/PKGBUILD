# END sources
# bump with a packaging change while the sources stay (else the rebuild is
# not published); update-sources.sh changes pkgver, so back to 1 then
pkgrel=1
pkgdesc="Valve's native aarch64 Steam client"
arch=(aarch64)
url="https://store.steampowered.com/"
license=(LicenseRef-steam-subscriber-agreement)
depends=(bash coreutils util-linux file lsof pciutils usbutils xdg-utils xz
         python
         alsa-lib at-spi2-core brotli bzip2 cairo dbus expat fontconfig
         freetype2 gdk-pixbuf2 glib2 glibc libasyncns libcups libdrm libgcc
         libglvnd libibus libice libnm libpipewire libpulse libsm libsndfile
         libssh2 libstdc++ libva libvdpau libx11 libxcb libxcomposite
         libxcursor libxdamage libxext libxfixes libxi libxinerama
         libxkbcommon libxrandr libxrender libxtst mesa nspr nss openal
         openssl pango sdl2-compat systemd-libs vulkan-icd-loader zlib zstd)
makedepends=(unzip)
optdepends=('zenity: dialogs of the client')
provides=(steam)
conflicts=(steam)
options=(!strip !debug)
_cdn=https://client-update.fastly.steamstatic.com
source=("https://repo.steampowered.com/steam/archive/stable/steam_${_launcher}.tar.gz"
        "steam-runtime-steamrt-arm64-${_runtime}.tar.xz::https://repo.steampowered.com/steamrt3c/images/${_runtime}/steam-runtime-steamrt-arm64.tar.xz"
        steam
        "${_zips[@]/#/$_cdn/}")
# makepkg would unpack the zips itself (it goes by content, not name)
noextract=("${_zips[@]}")
sha256sums=("$_launchersum"
            "$_runtimesum"
            'SKIP'
            "${_zipsums[@]}")

package() {
  local lib="$pkgdir/usr/lib/steam-arm64"
  local boot="$lib/bootstrap" rt="$srcdir/steam-runtime-steamrt-arm64"
  local z entry target f size

  install -d "$boot"
  for z in "${_zips[@]}"; do
    unzip -qq -o "$srcdir/$z" -d "$boot"
  done
  # some entries come with Windows paths: "steamrtarm64\libs\libcurl.so"
  while IFS= read -r -d '' entry; do
    target="$boot/$(basename "$entry" | tr '\\' /)"
    if [ -d "$entry" ]; then
      mkdir -p "$target"
      cp -a "$entry/." "$target/"
      rm -rf "$entry"
    else
      mkdir -p "$(dirname "$target")"
      mv "$entry" "$target"
    fi
  done < <(find "$boot" -mindepth 1 -maxdepth 1 -name '*\\*' -print0 | sort -z)
  chmod -R u+rwX,go+rX,go-w "$boot"
  # the zips keep no modes: executables are the ELF files and scripts
  while IFS= read -r -d '' f; do
    case "$(head -c 4 "$f" | od -An -tx1 | tr -d ' \n')" in
      7f454c46|2321*) chmod 755 "$f" ;;
    esac
  done < <(find "$boot" -type f -print0)
  test -x "$boot/steamrtarm64/steam"

  install -d "$lib/runtime" "$lib/lib"
  cp -a "$rt/bin" "$rt/pressure-vessel" "$rt/VERSIONS.txt" "$lib/runtime/"
  cp -a "$rt"/steamrt3c_platform_*/files/lib/aarch64-linux-gnu/lib{gtk,gdk}-x11-2.0.so.0.* "$lib/lib/"
  for f in "$lib"/lib/*.so.0.*; do
    ln -s "${f##*/}" "${f%.so.0.*}.so.0"	# the tarball has no soname links
  done
  test -e "$lib/runtime/bin/steam-runtime-launcher-service"
  test -e "$lib/lib/libgtk-x11-2.0.so.0"

  install -Dm755 steam "$pkgdir/usr/bin/steam"
  cd steam-launcher
  # the phone's screen is too narrow for the desktop client: Big Picture
  # (touch, Steam's own keyboard); it leaves to the desktop client on exit
  sed 's|^Exec=/usr/bin/steam %U$|Exec=/usr/bin/steam -gamepadui %U|' steam.desktop |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/steam.desktop"
  grep -q '^Exec=/usr/bin/steam -gamepadui %U$' "$pkgdir/usr/share/applications/steam.desktop"
  for f in icons/*/steam.png; do
    size=${f#icons/}; size=${size%%/*}
    install -Dm644 "$f" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/steam.png"
  done
  install -Dm644 subprojects/steam-devices/60-steam-input.rules \
    "$pkgdir/usr/lib/udev/rules.d/60-steam-input.rules"
  install -Dm644 subprojects/steam-devices/60-steam-vr.rules \
    "$pkgdir/usr/lib/udev/rules.d/60-steam-vr.rules"
  install -Dm644 steam_subscriber_agreement.txt \
    "$pkgdir/usr/share/licenses/$pkgname/steam_subscriber_agreement.txt"
}
