# Valve's native aarch64 Steam client for the cezanne port (Arch Linux ARM
# has no Steam). Valve publishes it quietly next to the x86 one: the client
# manifest steam_client_linuxarm64 lists zips for each platform; the "_all"
# ones (UI, resources) and the "_linuxarm64_linuxarm64" ones are the native
# client (steamrtarm64/steam, CEF web helper, codecs, SDL3). They are pinned
# here as a bootstrap: /usr/bin/steam copies it into ~/.local/share/Steam on
# the first start and the client updates itself there. update-sources.sh
# pins the current client manifest, runtime and launcher; cezanne-build
# (type follow) runs it before each build and rebuilds when upstream-version
# (runtime, launcher) changes, not for every client release.
# The client runs on the host, not in Valve's container: it calls
# steam-runtime-launcher-service by name (bin/ + pressure-vessel/ of Valve's
# arm64 Steam Runtime 3c tarball) and steamui.so links gtk2, which Arch
# Linux ARM dropped: the runtime's two gtk2 libraries go to lib/ (the
# launcher's LD_LIBRARY_PATH); its 207 MB container platform is left out.
# Icons, desktop file and controller udev rules come from Valve's
# steam-launcher tarball, as in Arch's x86 steam package; the desktop entry
# starts Big Picture (-gamepadui), which fits the phone and brings Steam's
# own touch keyboard.
# Reference: github.com/Daaboulex/steam-arm64-nix (NixOS packaging).
pkgname=steam-arm64
# BEGIN sources (update-sources.sh)
pkgver=1792618285.257593.87
_launcher=1.0.0.87
_launchersum=649375d2f9377f8009aaf3e2ff09978041eb9114897d9c5a3886f1d82e27ba1f
_runtime=3c.0.20260824.257593
_runtimesum=2f2be461b6a4360828e200e1644e18cd957eedc36a38e5a1e13a39276320b6e2
_zips=(
  tenfoot_images_all.zip.86419c7a56c12dd107b5e0d46f50c8a9b121f3cc
  steamui_websrc_all.zip.24dd80531ce5c8cf19b5bfdd2e580ab55ebf8365
  resources_misc_all.zip.99ed79ed868d732d8e9e9a45444b8f003191e3dd
  resources_hidpi_all.zip.a110d78e994c028dc1c412951e87a0c4e9c819f7
  resources_all.zip.213fe769fd8484a0d149453c5655e70c1d13b086
  strings_en_all.zip.e716a67d7fa91ba70490a6417e25d45c5435e393
