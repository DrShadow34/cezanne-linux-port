+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <vector>
+
+#include <libcamera/geometry.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class Phase {
+		Idle,		/* manual, or auto mode before a trigger */
+		Local,		/* hill climb from the current position */
+		Coarse,		/* full range, large steps */
+		Fine,		/* around the coarse peak, small steps */
+		Focused,
+		Failed,
+	};
+
+	double measure(const IPAContext &context, const SwIspStats *stats) const;
+	void startScan(IPAContext &context);
+	void startLocalScan(IPAContext &context);
+	void moveTo(IPAContext &context, int32_t position, uint32_t frame);
+	void scanStep(IPAContext &context, uint32_t frame, double value);
+	float dioptres(int32_t position) const;
+	int32_t position(float dioptres) const;
+
+	int32_t min_ = 0;
+	int32_t max_ = 0;
+	int32_t step_ = 0;
+
+	int mode_ = 0;
+	bool windowsMetering_ = false;
+	std::vector<Rectangle> windows_;
+	Size sensorSize_;
+
+	Phase phase_ = Phase::Idle;
+	int32_t target_ = 0;
+	uint32_t measureFrame_ = 0;	/* first frame taken with the lens settled */
+	int32_t bestPos_ = 0;
+	double bestValue_ = 0.0;
+	double lastValue_ = 0.0;
+	/* exposure x gain: scans wait for the AGC and restart when it moves */
+	double lastEv_ = 0.0;
+	unsigned int evStableFrames_ = 0;
+	unsigned int evWaitFrames_ = 0;
+	double minValue_ = 0.0;
+	unsigned int drops_ = 0;
+	int32_t fineEnd_ = 0;
+	int32_t localStart_ = 0;
+	int32_t dir_ = 1;
+	bool reversed_ = false;
+	bool remeasure_ = false;
+	bool local_ = false;	/* the scan started as Local */
+	unsigned int localDrops_ = 0;
+
+	double focusedValue_ = 0.0;	/* continuous mode: reference after a scan */
+	unsigned int changedFrames_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
