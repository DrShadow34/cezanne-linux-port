--- /dev/null
+++ b/src/ipa/simple/algorithms/lens.cpp
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Lens corrections: shading (vignetting, colour shading) and distortion
+ *
+ * Tuning:
+ *   - Lens:
+ *       shading:            # gain grid over the sensor (corners included),
+ *         width: 15         # row-major, R G B per point, applied after the
+ *         height: 15        # black level
+ *         gains: [ ... ]
+ *       distortion:         # output -> raw, in sensor pixels:
+ *         k: [ k1, .. k4 ]  # raw = c + (u - c) (1 + k1 r^2 + .. + k4 r^8),
+ *         centre: [ x, y ]  # r = |u - c| / half the sensor diagonal
+ *
+ * On the Redmi K30 Ultra the shading grids are the per-unit calibration in
+ * the camera modules' EEPROMs, and the ultrawide's distortion comes from a
+ * checkerboard calibration (mainline/camera/tools).
+ */
+
+#include "lens.h"
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLens)
+
+int Lens::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	const ValueNode &shading = tuningData["shading"];
+	if (shading.isDictionary()) {
+		auto w = shading["width"].get<unsigned int>();
+		auto h = shading["height"].get<unsigned int>();
+		const auto &gains = shading["gains"].asList();
+		std::vector<float> values;
+		for (const auto &g : gains)
+			values.push_back(g.get<float>().value_or(1.0f));
+		if (!w || !h || *w * *h > DebayerParams::kLscMaxPoints ||
+		    values.size() != *w * *h * 3) {
+			LOG(IPASoftLens, Error) << "Invalid shading grid";
+			return -EINVAL;
+		}
+		shadingWidth_ = *w;
+		shadingHeight_ = *h;
+		std::copy(values.begin(), values.end(), shadingGains_.begin());
+		shading_ = true;
+	}
+
+	const ValueNode &distortion = tuningData["distortion"];
+	if (distortion.isDictionary()) {
+		unsigned int i = 0;
+		for (const auto &k : distortion["k"].asList())
+			if (i < distortionK_.size())
+				distortionK_[i++] = k.get<float>().value_or(0.0f);
+		i = 0;
+		for (const auto &c : distortion["centre"].asList())
+			if (i < distortionCentre_.size())
+				distortionCentre_[i++] = c.get<float>().value_or(0.0f);
+		distortion_ = true;
+	}
+
+	LOG(IPASoftLens, Debug)
+		<< "shading " << shading_ << " (" << shadingWidth_ << "x"
+		<< shadingHeight_ << "), distortion " << distortion_;
+	return 0;
+}
+
+void Lens::prepare([[maybe_unused]] IPAContext &context,
+		   [[maybe_unused]] const uint32_t frame,
+		   [[maybe_unused]] IPAFrameContext &frameContext,
+		   DebayerParams *params)
+{
+	params->lscWidth = shading_ ? shadingWidth_ : 0;
+	params->lscHeight = shading_ ? shadingHeight_ : 0;
+	if (shading_)
+		std::copy(shadingGains_.begin(),
+			  shadingGains_.begin() + shadingWidth_ * shadingHeight_ * 3,
+			  params->lscGains.begin());
+
+	params->distortion = distortion_;
+	params->distortionK = distortionK_;
+	params->distortionCentre = distortionCentre_;
+}
+
+REGISTER_IPA_ALGORITHM(Lens, "Lens")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
