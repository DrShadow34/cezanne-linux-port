diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
new file mode 100644
index 0000000..6e70d04
--- /dev/null
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -0,0 +1,483 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast-detection autofocus for the software ISP
+ *
+ * The statistics carry a grid of per-tile sharpness values (squared
+ * differences of neighbouring same-colour pixels) computed on every frame.
+ * A scan moves the lens over its whole range in coarse steps, stops once the
+ * sharpness has clearly passed a peak, then rescans around the best coarse
+ * position in fine steps.  Every lens move waits kSettleFrames frames before
+ * the next measurement: the move is issued after a frame was processed, so
+ * the next frame is already being read out.
+ *
+ * The metric is normalised by the squared mean brightness of the metered
+ * tiles so that exposure changes during a scan do not look like focus
+ * changes.  Lens positions are reported in dioptres assuming a linear map of
+ * the VCM range to 0 .. kMaxDioptres (uncalibrated).
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace {
+
+constexpr unsigned int kSettleFrames = 4;
+constexpr unsigned int kSettleFramesLong = 6;
+constexpr unsigned int kCoarseSteps = 16;
+constexpr unsigned int kFineDivider = 4;
+constexpr float kMaxDioptres = 12.0f;
+/* stop the coarse scan after this many steps below kDropRatio * best */
+constexpr unsigned int kDropSteps = 3;
+constexpr double kDropRatio = 0.6;
+/* a peak lower than this times the scan minimum: nothing to focus on */
+constexpr double kMinPeakRatio = 1.15;
+/* continuous mode: rescan after the metric stays this far off for a while */
+constexpr double kChangeRatio = 0.5;
+constexpr unsigned int kChangeFrames = 20;
+/* first scan after start: let the AGC converge */
+constexpr unsigned int kStartupFrames = 20;
+/* local search: a step this much below the best counts as past the peak */
+constexpr double kLocalDropRatio = 0.92;
+/*
+ * The AGC raising the gain during a scan raises the noise in the sharpness
+ * measure: a dim macro scan climbed with the gain (9.8x -> 16x) to the far
+ * end past the real peak, and the gain followed the lens (the magnified
+ * frame has more of a dark edge).  Scans start once exposure x gain held
+ * within kEvSteady for kEvStableFrames frames, and hold the AGC until done.
+ */
+constexpr double kEvSteady = 0.03;
+constexpr unsigned int kEvStableFrames = 4;
+constexpr unsigned int kEvMaxWaitFrames = 60;
+/* window below this share of the frame's average contrast: whole frame */
+constexpr double kMinWindowContrast = 0.25;
+
+} /* namespace */
+
+int Af::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+{
+	if (!context.lens.present) {
+		LOG(IPASoftAf, Info) << "No focus lens, autofocus disabled";
+		return 0;
+	}
+
+	min_ = context.lens.min;
+	max_ = context.lens.max;
+	step_ = std::max<int32_t>((max_ - min_) / kCoarseSteps, 1);
+
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, controls::AfModeContinuous);
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues, controls::AfTriggerStart);
+	context.ctrlMap[&controls::AfMetering] =
+		ControlInfo(controls::AfMeteringValues, controls::AfMeteringAuto);
+	context.ctrlMap[&controls::AfWindows] =
+		ControlInfo(Rectangle{}, Rectangle(65535, 65535, 65535, 65535),
+			    Rectangle{});
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, kMaxDioptres, dioptres(context.lens.def));
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	if (!context.lens.present)
+		return 0;
+
+	sensorSize_ = context.sensorInfo.outputSize;
+	focusedValue_ = 0.0;
+	changedFrames_ = 0;
+
+	/* Same sensor mode (e.g. a still capture): keep the focus and mode */
+	if (context.configuration.keepState) {
+		/* frame numbers restart with the new session */
+		measureFrame_ = kSettleFramesLong;
+		return 0;
+	}
+
+	/* Platform default: continuous, the applications rarely ask for it */
+	mode_ = controls::AfModeContinuous;
+	windowsMetering_ = false;
+	windows_.clear();
+
+	context.activeState.af.position = context.lens.def;
+	context.activeState.af.dirty = true;
+	startScan(context);
+	measureFrame_ = kStartupFrames;
+
+	return 0;
+}
+
+void Af::queueRequest(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.lens.present)
+		return;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != mode_) {
+		mode_ = *mode;
+		LOG(IPASoftAf, Debug) << "AfMode " << mode_;
+		if (mode_ == controls::AfModeContinuous)
+			startScan(context);
+		else
+			phase_ = Phase::Idle;
+	}
+
+	bool refocus = false;
+	const auto &metering = controls.get(controls::AfMetering);
+	if (metering) {
+		bool windows = *metering == controls::AfMeteringWindows;
+		refocus |= windows != windowsMetering_;
+		windowsMetering_ = windows;
+	}
+
+	const auto &windows = controls.get(controls::AfWindows);
+	if (windows) {
+		std::vector<Rectangle> w(windows->begin(), windows->end());
+		refocus |= windowsMetering_ && w != windows_;
+		windows_ = std::move(w);
+		LOG(IPASoftAf, Debug) << "AfWindows " << windows_.size()
+				      << (windows_.empty() ? "" : " " + windows_[0].toString());
+	}
+
+	/* a new metering area in continuous mode: refocus there */
+	if (refocus && mode_ == controls::AfModeContinuous)
+		startLocalScan(context);
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && mode_ == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart)
+			startScan(context);
+		else
+			phase_ = Phase::Idle;
+	}
+
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition && mode_ == controls::AfModeManual) {
+		context.activeState.af.position = position(*lensPosition);
+		context.activeState.af.dirty = true;
+	}
+}
+
+/* Sharpness of the metered tiles, normalised by their mean brightness */
+double Af::measure(const IPAContext &context, const SwIspStats *stats) const
+{
+	constexpr unsigned int gw = SwIspStats::kAfGridWidth;
+	constexpr unsigned int gh = SwIspStats::kAfGridHeight;
+	std::vector<bool> use(SwIspStats::kAfGridSize, false);
+	bool any = false;
+
+	if (windowsMetering_ && sensorSize_.width && sensorSize_.height) {
+		for (const Rectangle &r : windows_) {
+			if (r.width == 0 || r.height == 0)
+				continue;
+			int x0 = std::clamp<int>(r.x * gw / sensorSize_.width, 0, gw - 1);
+			int y0 = std::clamp<int>(r.y * gh / sensorSize_.height, 0, gh - 1);
+			int x1 = std::clamp<int>((r.x + r.width - 1) * gw / sensorSize_.width, 0, gw - 1);
+			int y1 = std::clamp<int>((r.y + r.height - 1) * gh / sensorSize_.height, 0, gh - 1);
+			for (int y = y0; y <= y1; y++)
+				for (int x = x0; x <= x1; x++)
+					use[y * gw + x] = any = true;
+		}
+	}
+	if (!any) {
+		/* centre third of the frame */
+		for (unsigned int y = gh / 3; y < gh - gh / 3; y++)
+			for (unsigned int x = gw / 3; x < gw - gw / 3; x++)
+				use[y * gw + x] = true;
+	}
+
+	double sharp = 0.0, bright = 0.0, allSharp = 0.0, allBright = 0.0;
+	unsigned int n = 0;
+	for (unsigned int i = 0; i < SwIspStats::kAfGridSize; i++) {
+		allSharp += stats->afSharpness[i];
+		allBright += stats->afBrightness[i];
+		if (!use[i])
+			continue;
+		sharp += stats->afSharpness[i];
+		bright += stats->afBrightness[i];
+		n++;
+	}
+	/*
+	 * A window with hardly any structure (plain surface in the middle of
+	 * a close-up) measures noise: use the whole frame then.
+	 */
+	if (sharp < allSharp * n / SwIspStats::kAfGridSize * kMinWindowContrast) {
+		sharp = allSharp;
+		bright = allBright;
+	}
+	if (bright <= 0.0)
+		return 0.0;
+
+	/* relative within a scan: sharpness over the squared brightness */
+	(void)context;
+	return sharp / (bright * bright) * 1e12;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	phase_ = Phase::Coarse;
+	bestValue_ = 0.0;
+	bestPos_ = min_;
+	lastValue_ = 0.0;
+	minValue_ = 0.0;
+	drops_ = 0;
+	local_ = false;
+	remeasure_ = true;
+	target_ = min_;
+	measureFrame_ = 0;
+	context.activeState.af.position = target_;
+	context.activeState.af.dirty = true;
+	LOG(IPASoftAf, Debug) << "Scan start";
+}
+
+/*
+ * A new metering window (tap to focus) usually needs a small lens move: climb
+ * from the current position, towards infinity first, turn round if the first
+ * step loses sharpness, and finish with a short fine scan.  About a third of a
+ * full scan.
+ */
+void Af::startLocalScan(IPAContext &context)
+{
+	phase_ = Phase::Local;
+	bestValue_ = 0.0;
+	lastValue_ = 0.0;
+	minValue_ = 0.0;
+	drops_ = 0;
+	localDrops_ = 0;
+	local_ = true;
+	reversed_ = false;
+	dir_ = 1;
+	target_ = std::clamp(context.activeState.af.position, min_, max_);
+	localStart_ = target_;
+	bestPos_ = target_;
+	measureFrame_ = 0;
+	LOG(IPASoftAf, Debug) << "Local scan from " << target_;
+}
+
+void Af::moveTo(IPAContext &context, int32_t pos, uint32_t frame)
+{
+	pos = std::clamp(pos, min_, max_);
+	/* large jumps ring for a while */
+	unsigned int settle = std::abs(pos - target_) > 2 * step_
+			      ? kSettleFramesLong : kSettleFrames;
+	target_ = pos;
+	context.activeState.af.position = target_;
+	context.activeState.af.dirty = true;
+	measureFrame_ = frame + settle;
+}
+
+void Af::scanStep(IPAContext &context, uint32_t frame, double value)
+{
+	/*
+	 * The scan's first position comes from wherever the lens was (or from
+	 * a lens just powered up with the stream): its first sample can still
+	 * show the old position, sharper or not, and once won the scan with
+	 * 2.6 times the value of every later sample.  Measure it again.
+	 */
+	if (remeasure_) {
+		remeasure_ = false;
+		moveTo(context, target_, frame);
+		return;
+	}
+
+	if (minValue_ == 0.0 || value < minValue_)
+		minValue_ = value;
+	if (value > bestValue_) {
+		bestValue_ = value;
+		bestPos_ = target_;
+		drops_ = 0;
+	} else if (value < bestValue_ * kDropRatio &&
+		   !(phase_ == Phase::Fine && target_ < bestPos_)) {
+		/* the fine scan climbs towards the coarse peak first */
+		drops_++;
+	}
+	lastValue_ = value;
+
+	if (phase_ == Phase::Local) {
+		bool worse = value < bestValue_ * kLocalDropRatio;
+		if (worse)
+			localDrops_++;
+		else if (target_ == bestPos_)
+			localDrops_ = 0;
+		bool edge = (dir_ > 0 && target_ >= max_) ||
+			    (dir_ < 0 && target_ <= min_);
+		bool firstStepWorse = worse && bestPos_ == localStart_ && !reversed_;
+		if (!(localDrops_ >= 2 || edge || firstStepWorse)) {
+			moveTo(context, target_ + dir_ * step_, frame);
+			return;
+		}
+		if (!reversed_ && bestPos_ == localStart_) {
+			reversed_ = true;
+			dir_ = -dir_;
+			localDrops_ = 0;
+			moveTo(context, localStart_ + dir_ * step_, frame);
+			return;
+		}
+		/* fine scan over half a coarse step either side of the peak */
+		phase_ = Phase::Fine;
+		fineEnd_ = std::min(bestPos_ + step_ / 2, max_);
+		drops_ = 0;
+		moveTo(context, std::max(bestPos_ - step_ / 2, min_), frame);
+		return;
+	}
+
+	if (phase_ == Phase::Coarse) {
+		bool done = target_ >= max_ || drops_ >= kDropSteps;
+		if (!done) {
+			moveTo(context, target_ + step_, frame);
+			return;
+		}
+		/* fine scan around the coarse peak */
+		phase_ = Phase::Fine;
+		fineEnd_ = std::min(bestPos_ + step_, max_);
+		drops_ = 0;
+		moveTo(context, std::max(bestPos_ - step_, min_), frame);
+		return;
+	}
+
+	/* Fine */
+	int32_t fineStep = std::max<int32_t>(step_ / kFineDivider, 1);
+	if (target_ < fineEnd_ && drops_ < kDropSteps) {
+		moveTo(context, target_ + fineStep, frame);
+		return;
+	}
+
+	/* a local search only sees the top of the curve: no contrast check */
+	phase_ = local_ || bestValue_ >= minValue_ * kMinPeakRatio
+		 ? Phase::Focused : Phase::Failed;
+	/* reference: measured once the lens is back at the peak */
+	focusedValue_ = 0.0;
+	changedFrames_ = 0;
+	moveTo(context, bestPos_, frame);
+	LOG(IPASoftAf, Debug)
+		<< (phase_ == Phase::Focused ? "Focused" : "Failed")
+		<< " at " << bestPos_ << ", value " << bestValue_;
+}
+
+void Af::process(IPAContext &context, const uint32_t frame,
+		 IPAFrameContext &frameContext,
+		 const SwIspStats *stats, ControlList &metadata)
+{
+	if (!context.lens.present)
+		return;
+
+	/* a scan started from a request: let the first lens move settle */
+	if (measureFrame_ == 0 &&
+	    (phase_ == Phase::Local || phase_ == Phase::Coarse || phase_ == Phase::Fine))
+		measureFrame_ = frame + kSettleFramesLong;
+
+	double ev = frameContext.sensor.exposure * frameContext.sensor.gain;
+	if (lastEv_ > 0.0 && std::abs(ev / lastEv_ - 1.0) <= kEvSteady)
+		evStableFrames_++;
+	else
+		evStableFrames_ = 0;
+	lastEv_ = ev;
+
+	bool scanning = phase_ == Phase::Local || phase_ == Phase::Coarse ||
+			phase_ == Phase::Fine;
+	if (scanning && frame >= measureFrame_ && bestValue_ == 0.0 &&
+	    !context.activeState.af.holdAgc) {
+		/* wait for the AGC (bounded) before the first step, then hold it */
+		if (evStableFrames_ < kEvStableFrames &&
+		    frame < measureFrame_ + kEvMaxWaitFrames &&
+		    ++evWaitFrames_ < kEvMaxWaitFrames)
+			return;
+		evWaitFrames_ = 0;
+		context.activeState.af.holdAgc = true;
+	}
+	if (!scanning)
+		context.activeState.af.holdAgc = false;
+
+	if (stats->afValid && frame >= measureFrame_) {
+		double value = measure(context, stats);
+
+		LOG(IPASoftAf, Debug)
+			<< "pos " << target_ << " value " << value
+			<< " exposure " << frameContext.sensor.exposure
+			<< " gain " << frameContext.sensor.gain;
+
+		switch (phase_) {
+		case Phase::Local:
+		case Phase::Coarse:
+		case Phase::Fine:
+			scanStep(context, frame, value);
+			break;
+		case Phase::Focused:
+		case Phase::Failed:
+			if (mode_ != controls::AfModeContinuous)
+				break;
+			if (focusedValue_ == 0.0) {
+				focusedValue_ = value;
+				break;
+			}
+			/* refocus once the scene has changed for a while */
+			if (focusedValue_ > 0.0 &&
+			    (value < focusedValue_ * kChangeRatio ||
+			     value > focusedValue_ / kChangeRatio))
+				changedFrames_++;
+			else
+				changedFrames_ = 0;
+			if (changedFrames_ >= kChangeFrames) {
+				startScan(context);
+				measureFrame_ = frame + kSettleFramesLong;
+			}
+			break;
+		case Phase::Idle:
+			break;
+		}
+	}
+
+	int32_t state;
+	switch (phase_) {
+	case Phase::Local:
+	case Phase::Coarse:
+	case Phase::Fine:
+		state = controls::AfStateScanning;
+		break;
+	case Phase::Focused:
+		state = controls::AfStateFocused;
+		break;
+	case Phase::Failed:
+		state = controls::AfStateFailed;
+		break;
+	default:
+		state = controls::AfStateIdle;
+		break;
+	}
+	metadata.set(controls::AfState, state);
+	metadata.set(controls::LensPosition, dioptres(context.activeState.af.position));
+}
+
+float Af::dioptres(int32_t pos) const
+{
+	if (max_ <= min_)
+		return 0.0f;
+	return static_cast<float>(pos - min_) * kMaxDioptres / (max_ - min_);
+}
+
+int32_t Af::position(float d) const
+{
+	d = std::clamp(d, 0.0f, kMaxDioptres);
+	return min_ + static_cast<int32_t>(std::lround(d * (max_ - min_) / kMaxDioptres));
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
