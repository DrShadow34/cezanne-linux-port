+/*
+ * Autofocus statistics: on every 8th line, a band-pass of the same-colour
+ * pixels: 2x2 same-colour blocks (rows y and y + 2, columns x and x + 2)
+ * averaged, and the squared difference of blocks 4 pixels apart above a
+ * small noise floor, summed per tile of a kAfGridWidth x kAfGridHeight grid
+ * over the statistics window, plus the sum of the sampled pixels for
+ * normalisation.  The averaging halves the noise: with plain neighbour
+ * differences a dim, high-gain scene (macro camera indoors) measured mostly
+ * noise and the scan ended at the wrong end.  The floor applies to the
+ * 4-pixel sums, so dark scenes keep their sub-LSB steps.  8-bit or 10-bit
+ * (in 16) unpacked Bayer; 10-bit sums are scaled to the 8-bit range.
+ */
+void SwStatsCpu::processAf(MappedFrameBuffer &in)
+{
+	if (gridShift_)
+		processAfT<uint16_t>(in);
+	else
+		processAfT<uint8_t>(in);
+}
+
+template<typename T>
+void SwStatsCpu::processAfT(MappedFrameBuffer &in)
+{
+	constexpr unsigned int kGw = SwIspStats::kAfGridWidth;
+	constexpr unsigned int kGh = SwIspStats::kAfGridHeight;
+	/* noise floor on 4-pixel sums: 1.5 LSB (8-bit) of an average */
+	const int kNoise = 6 << gridShift_;
+	const unsigned int stride = stride_ / sizeof(T);
+	const unsigned int w = window_.width;
+	const unsigned int h = window_.height;
+	unsigned int xs[kGw + 1];
+
+	sharedStats_->afSharpness.fill(0);
+	sharedStats_->afBrightness.fill(0);
+	if (w < 8 * kGw || h < 8 * kGh)
+		return;
+
+	for (unsigned int t = 0; t <= kGw; t++)
+		xs[t] = (t * w / kGw) & ~1u;
+
+	const T *base = reinterpret_cast<const T *>(in.planes()[0].data()) +
+			window_.y * stride + window_.x;
+	for (unsigned int y = 0; y + 2 < h; y += 8) {
+		const T *r0 = base + y * stride;
+		const T *r2 = r0 + 2 * stride;
+		unsigned int ty = y * kGh / h;
+
+		for (unsigned int tx = 0; tx < kGw; tx++) {
+			uint64_t sharp = 0, bright = 0;
+			unsigned int end = std::min(xs[tx + 1], w - 6);
+
+			for (unsigned int x = xs[tx]; x < end; x++) {
+				int a = r0[x] + r0[x + 2] + r2[x] + r2[x + 2];
+				int b = r0[x + 4] + r0[x + 6] + r2[x + 4] + r2[x + 6];
+				int d = std::abs(b - a) - kNoise;
+
+				if (d > 0)
+					sharp += d * d;
+				bright += r0[x];
+			}
+			sharedStats_->afSharpness[ty * kGw + tx] += sharp >> (2 * gridShift_);
+			sharedStats_->afBrightness[ty * kGw + tx] += bright >> gridShift_;
+		}
+	}
+	sharedStats_->afValid = true;
+}
