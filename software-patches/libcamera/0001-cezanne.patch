+/*
+ * White balance statistics: colour sums per tile of the autofocus grid, from
+ * every fourth 2x2 block on every fourth line pair, leaving out blocks with a
+ * saturated channel (their colour is wrong).  8-bit or 10-bit (in 16)
+ * unpacked Bayer; 10-bit sums are scaled to the 8-bit range.
+ */
+void SwStatsCpu::processAwbGrid(MappedFrameBuffer &in)
+{
+	if (gridShift_)
+		processAwbGridT<uint16_t>(in);
+	else
+		processAwbGridT<uint8_t>(in);
+}
+
+template<typename T>
+void SwStatsCpu::processAwbGridT(MappedFrameBuffer &in)
+{
+	constexpr unsigned int kGw = SwIspStats::kAfGridWidth;
+	constexpr unsigned int kGh = SwIspStats::kAfGridHeight;
+	const unsigned int kSaturated = 250 << gridShift_;
+	const unsigned int stride = stride_ / sizeof(T);
+	const unsigned int x0 = window_.x & ~1u;
+	const unsigned int w = window_.width & ~1u;
+	const unsigned int h = window_.height & ~1u;
+	const unsigned int bx = redX_ ^ 1, by = redY_ ^ 1;
+
+	sharedStats_->awbR.fill(0);
+	sharedStats_->awbG.fill(0);
+	sharedStats_->awbB.fill(0);
+	sharedStats_->awbCount.fill(0);
+	if (w < 8 * kGw || h < 8 * kGh)
+		return;
+
+	const T *base = reinterpret_cast<const T *>(in.planes()[0].data()) +
+			window_.y * stride + x0;
+	std::array<uint64_t, SwIspStats::kAfGridSize> sumR{}, sumG{}, sumB{};
+	for (unsigned int y = 0; y < h; y += 8) {
+		const T *l0 = base + y * stride;
+		const T *l1 = l0 + stride;
+		const T *lr = redY_ ? l1 : l0, *lb = by ? l1 : l0;
+		unsigned int row = y * kGh / h * kGw;
+
+		for (unsigned int x = 0; x < w; x += 8) {
+			unsigned int r = lr[x + redX_];
+			unsigned int b = lb[x + bx];
+			unsigned int g = l0[x + (redY_ ? redX_ : redX_ ^ 1)] +
+					 l1[x + (redY_ ? redX_ ^ 1 : redX_)];
+			if (r >= kSaturated || b >= kSaturated || g >= 2 * kSaturated)
+				continue;
+			unsigned int i = row + x * kGw / w;
+			sumR[i] += r;
+			sumG[i] += g;
+			sumB[i] += b;
+			sharedStats_->awbCount[i]++;
+		}
+	}
+	for (unsigned int i = 0; i < SwIspStats::kAfGridSize; i++) {
+		sharedStats_->awbR[i] = sumR[i] >> gridShift_;
+		sharedStats_->awbG[i] = sumG[i] >> gridShift_;
+		sharedStats_->awbB[i] = sumB[i] >> gridShift_;
+	}
+	sharedStats_->awbValid = true;
+}
