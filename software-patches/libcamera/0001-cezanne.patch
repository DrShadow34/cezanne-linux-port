+int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	/*
+	 * Optional locus: the raw R/G and B/G of a neutral surface under
+	 * illuminants of known colour temperature.  With it, every tile of the
+	 * statistics grid votes for the illuminants under which it would be
+	 * neutral, brighter tiles more (white-patch prior), instead of the
+	 * whole frame averaging to grey.
+	 */
+	locus_.clear();
+	for (const auto &p : tuningData["locus"].asList()) {
+		auto ct = p["ct"].get<double>();
+		auto r = p["r"].get<double>();
+		auto b = p["b"].get<double>();
+		if (!ct || !r || !b || *r <= 0 || *b <= 0) {
+			LOG(IPASoftAwb, Error) << "Invalid locus point";
+			return -EINVAL;
+		}
+		locus_.push_back({ *ct, *r, *b });
+	}
+	std::sort(locus_.begin(), locus_.end(),
+		  [](const LocusPoint &a, const LocusPoint &b) { return a.ct < b.ct; });
+	if (locus_.size() == 1) {
+		LOG(IPASoftAwb, Error) << "The locus needs at least two points";
+		return -EINVAL;
+	}
+
+	return 0;
+}
