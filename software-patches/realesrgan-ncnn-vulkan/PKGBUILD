# realesrgan-ncnn-vulkan: Real-ESRGAN upscaling on the GPU through Vulkan
# (PanVK), for cezanne-photo --upscale (the camera app's AI upscaling). The
# v0.2.0 release built against Arch's ncnn and libwebp (0001: a system ncnn
# brings glslang through its own CMake config), with the models of the
# Real-ESRGAN 0.2.5.0 release and Upscayl's compact upscayl-lite-4x (the one
# the Mali-G77 runs in reasonable time; realesrgan-x4plus takes ~2 hours) in
# /usr/share/realesrgan/models (the directory has to be named "models").
pkgname=realesrgan-ncnn-vulkan
pkgver=0.2.0
pkgrel=1
pkgdesc="Real-ESRGAN image upscaling with ncnn and Vulkan, with its models and upscayl-lite-4x"
arch=(aarch64)
url="https://github.com/xinntao/Real-ESRGAN-ncnn-vulkan"
license=(MIT BSD-3-Clause AGPL-3.0-or-later)
depends=(glibc gcc-libs ncnn libwebp vulkan-icd-loader)
makedepends=(cmake glslang vulkan-headers)
_zip=realesrgan-ncnn-vulkan-20220424-ubuntu.zip
_upscayl=6cfaf45b2aae2847cba4f2313b57ca20a0ddd79c
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/$_zip"
        "https://raw.githubusercontent.com/upscayl/upscayl/$_upscayl/resources/models/upscayl-lite-4x.bin"
        "https://raw.githubusercontent.com/upscayl/upscayl/$_upscayl/resources/models/upscayl-lite-4x.param"
        0001-system-ncnn.patch)
noextract=("$_zip")
sha256sums=('346663b1924b2a1bfa655d656bfbba6b09f76ff75e4eee9d1fff4bfdef8b5712'
            'e5aa6eb131234b87c0c51f82b89390f5e3e642b7b70f2b9bbe95b6a285a40c96'
            '85ee266b632a765a725425ba6a5620c088c8aa2939a03063b2d83b3462724cc1'
            '22174924330297357434ad21ed0af7f4b820008d2a502b492754d130d4142714'
            SKIP)

prepare() {
  # the release's models only (it also carries an x86 binary and samples)
  rm -rf models
  bsdtar -xf "$_zip" models
  patch -d Real-ESRGAN-ncnn-vulkan-$pkgver -Np1 -i "$srcdir/0001-system-ncnn.patch"
}

build() {
  cmake -S Real-ESRGAN-ncnn-vulkan-$pkgver/src -B build -DCMAKE_BUILD_TYPE=Release \
    -DUSE_SYSTEM_NCNN=ON -DUSE_SYSTEM_WEBP=ON
  cmake --build build
}

package() {
  install -Dm755 build/realesrgan-ncnn-vulkan "$pkgdir/usr/bin/realesrgan-ncnn-vulkan"
  install -Dm644 -t "$pkgdir/usr/share/realesrgan/models" models/* \
    upscayl-lite-4x.bin upscayl-lite-4x.param
  install -Dm644 Real-ESRGAN-ncnn-vulkan-$pkgver/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
