+    [14] = "\\+(CREG|CEREG):\\s*0*([0-9]),\\s*0*([0-9])\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)\\s*,\\s*0*([0-9]+)\\s*,\\s*[^,\\s]*\\s*,\\s*[^,\\s]*",
+    /* +CREG|CEREG: <stat>,<lac>,<ci>,<AcT>,<cause_type>,<reject_cause> (unsolicited) */
+    [15] = "\\+(CREG|CEREG):\\s*0*([0-9])\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)\\s*,\\s*0*([0-9]+)\\s*,\\s*[^,\\s]*\\s*,\\s*[^,\\s]*",
+    /* +CGREG: <n>,<stat>,<lac>,<ci>,<AcT>,<rac>,<cause_type>,<reject_cause> (solicited) */
+    [16] = "\\+(CGREG):\\s*0*([0-9]),\\s*0*([0-9])\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)\\s*,\\s*0*([0-9]+)\\s*,\\s*[^,\\s]*\\s*,\\s*[^,\\s]*\\s*,\\s*[^,\\s]*",
+    /* +CGREG: <stat>,<lac>,<ci>,<AcT>,<rac>,<cause_type>,<reject_cause> (unsolicited) */
+    [17] = "\\+(CGREG):\\s*0*([0-9])\\s*,\\s*([^,\\s]*)\\s*,\\s*([^,\\s]*)\\s*,\\s*0*([0-9]+)\\s*,\\s*[^,\\s]*\\s*,\\s*[^,\\s]*\\s*,\\s*[^,\\s]*",
 };
 
