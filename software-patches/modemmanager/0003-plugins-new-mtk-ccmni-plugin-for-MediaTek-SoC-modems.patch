diff --git a/src/plugins/mtk-ccmni/mm-broadband-modem-mtk-ccmni.c b/src/plugins/mtk-ccmni/mm-broadband-modem-mtk-ccmni.c
new file mode 100644
index 0000000..79378f1
--- /dev/null
+++ b/src/plugins/mtk-ccmni/mm-broadband-modem-mtk-ccmni.c
@@ -0,0 +1,255 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ */
+
+#include <config.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-broadband-bearer-mtk-ccmni.h"
+#include "mm-broadband-modem-mtk-ccmni.h"
+#include "mm-iface-modem.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+
+static void iface_modem_init (MMIfaceModemInterface *iface);
+
+G_DEFINE_TYPE_EXTENDED (MMBroadbandModemMtkCcmni, mm_broadband_modem_mtk_ccmni, MM_TYPE_BROADBAND_MODEM, 0,
+                        G_IMPLEMENT_INTERFACE (MM_TYPE_IFACE_MODEM, iface_modem_init))
+
+/*****************************************************************************/
+/* Data URCs */
+
+/* "+EIF: <transaction * 100 + interface>, ifup, <family>, <address>, <mtu>":
+ * the modem picked the network interface for a context it just activated */
+static void
+eif_received (MMPortSerialAt           *port,
+              GMatchInfo               *match_info,
+              MMBroadbandModemMtkCcmni *self)
+{
+    g_autofree gchar *event = NULL;
+    guint             id;
+
+    event = g_match_info_fetch (match_info, 2);
+    if (!mm_get_uint_from_match_info (match_info, 1, &id) || g_strcmp0 (event, "ifup"))
+        return;
+    self->ifup_interface = id % 100;
+    self->ifup_count++;
+    mm_obj_dbg (self, "network interface %u up", self->ifup_interface);
+}
+
+guint
+mm_broadband_modem_mtk_ccmni_get_ifup (MMBroadbandModemMtkCcmni *self,
+                                       guint                    *interface)
+{
+    if (interface)
+        *interface = self->ifup_interface;
+    return self->ifup_count;
+}
+
+static void
+setup_ports (MMBroadbandModem *self)
+{
+    MMBroadbandModemMtkCcmni *mtk = MM_BROADBAND_MODEM_MTK_CCMNI (self);
+    MMPortSerialAt           *primary;
+
+    MM_BROADBAND_MODEM_CLASS (mm_broadband_modem_mtk_ccmni_parent_class)->setup_ports (self);
+
+    primary = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    if (!primary)
+        return;
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, mtk->eif_regex,
+                                                   (MMPortSerialAtUnsolicitedMsgFn) eif_received,
+                                                   self, NULL);
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, mtk->ignore_regex,
+                                                   NULL, NULL, NULL);
+}
+
+/*****************************************************************************/
+/* SIM hot swap (Modem interface) */
+
+/* "+ESIMS: <inserted>,<cause>" (enabled with AT+ESIMS=1 by cezanne-modemd):
+ * 0,11 when the SIM is pulled, 1,12 when one goes in and 1,29 once the MD
+ * has initialized it. The MD watches the SIM detect pin itself. */
+#define ESIMS_CAUSE_PLUG_OUT  11
+#define ESIMS_CAUSE_SIM_READY 29
+
+static void
+esims_received (MMPortSerialAt           *port,
+                GMatchInfo               *match_info,
+                MMBroadbandModemMtkCcmni *self)
+{
+    guint inserted;
+    guint cause;
+
+    if (!mm_get_uint_from_match_info (match_info, 1, &inserted) ||
+        !mm_get_uint_from_match_info (match_info, 2, &cause))
+        return;
+    mm_obj_dbg (self, "SIM status: inserted %u, cause %u", inserted, cause);
+    if ((!inserted && cause == ESIMS_CAUSE_PLUG_OUT) ||
+        (inserted && cause == ESIMS_CAUSE_SIM_READY))
+        mm_iface_modem_process_sim_event (MM_IFACE_MODEM (self));
+}
+
+static gboolean
+modem_setup_sim_hot_swap_finish (MMIfaceModem  *self,
+                                 GAsyncResult  *res,
+                                 GError       **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+modem_setup_sim_hot_swap (MMIfaceModem        *_self,
+                          GAsyncReadyCallback  callback,
+                          gpointer             user_data)
+{
+    MMBroadbandModemMtkCcmni *self = MM_BROADBAND_MODEM_MTK_CCMNI (_self);
+    MMPortSerialAt           *primary;
+    GTask                    *task;
+    g_autoptr(GError)         error = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    primary = mm_base_modem_peek_port_primary (MM_BASE_MODEM (self));
+    if (!primary) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "no primary port for SIM status reports");
+        g_object_unref (task);
+        return;
+    }
+    mm_port_serial_at_add_unsolicited_msg_handler (primary, self->esims_regex,
+                                                   (MMPortSerialAtUnsolicitedMsgFn) esims_received,
+                                                   self, NULL);
+    /* keep the port open while the modem is failed (no SIM) or disabled */
+    if (!mm_broadband_modem_sim_hot_swap_ports_context_init (MM_BROADBAND_MODEM (self), &error))
+        mm_obj_warn (self, "failed to initialize SIM hot swap ports context: %s", error->message);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+modem_cleanup_sim_hot_swap (MMIfaceModem *self)
+{
+    mm_broadband_modem_sim_hot_swap_ports_context_reset (MM_BROADBAND_MODEM (self));
+}
+
+/*****************************************************************************/
+/* Create Bearer (Modem interface) */
+
+static MMBaseBearer *
+modem_create_bearer_finish (MMIfaceModem  *self,
+                            GAsyncResult  *res,
+                            GError       **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+bearer_new_ready (GObject      *source,
+                  GAsyncResult *res,
+                  GTask        *task)
+{
+    MMBaseBearer *bearer;
+    GError       *error = NULL;
+
+    bearer = mm_broadband_bearer_mtk_ccmni_new_finish (res, &error);
+    if (!bearer)
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, bearer, g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+modem_create_bearer (MMIfaceModem        *self,
+                     MMBearerProperties  *properties,
+                     GAsyncReadyCallback  callback,
+                     gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_obj_dbg (self, "creating ccmni bearer...");
+    mm_broadband_bearer_mtk_ccmni_new (MM_BROADBAND_MODEM (self),
+                                       properties,
+                                       NULL, /* cancellable */
+                                       (GAsyncReadyCallback)bearer_new_ready,
+                                       task);
+}
+
+/*****************************************************************************/
+
+MMBroadbandModemMtkCcmni *
+mm_broadband_modem_mtk_ccmni_new (const gchar  *device,
+                                  const gchar  *physdev,
+                                  const gchar **drivers,
+                                  const gchar  *plugin,
+                                  guint16       vendor_id,
+                                  guint16       product_id)
+{
+    return g_object_new (MM_TYPE_BROADBAND_MODEM_MTK_CCMNI,
+                         MM_BASE_MODEM_DEVICE, device,
+                         MM_BASE_MODEM_PHYSDEV, physdev,
+                         MM_BASE_MODEM_DRIVERS, drivers,
+                         MM_BASE_MODEM_PLUGIN, plugin,
+                         MM_BASE_MODEM_VENDOR_ID, vendor_id,
+                         MM_BASE_MODEM_PRODUCT_ID, product_id,
+                         /* data only through the ccmni network links */
+                         MM_BASE_MODEM_DATA_NET_SUPPORTED, TRUE,
+                         MM_BASE_MODEM_DATA_TTY_SUPPORTED, FALSE,
+                         NULL);
+}
+
+static void
+mm_broadband_modem_mtk_ccmni_init (MMBroadbandModemMtkCcmni *self)
+{
+    self->eif_regex = g_regex_new ("\\r\\n\\+EIF:\\s*(\\d+),\\s*(\\w+)[^\\r\\n]*\\r\\n",
+                                   G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    self->esims_regex = g_regex_new ("\\r\\n\\+ESIMS:\\s*(\\d+),\\s*(\\d+)\\r\\n",
+                                     G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+    /* data call bookkeeping meant for the vendor RIL */
+    self->ignore_regex = g_regex_new ("\\r\\n\\+(?:EPDN|EWIFIPDNACT|EDRETRY|EGMSS|EPDNHANDOVER):[^\\r\\n]*\\r\\n",
+                                      G_REGEX_RAW | G_REGEX_OPTIMIZE, 0, NULL);
+}
+
+static void
+finalize (GObject *object)
+{
+    MMBroadbandModemMtkCcmni *self = MM_BROADBAND_MODEM_MTK_CCMNI (object);
+
+    g_regex_unref (self->eif_regex);
+    g_regex_unref (self->esims_regex);
+    g_regex_unref (self->ignore_regex);
+    G_OBJECT_CLASS (mm_broadband_modem_mtk_ccmni_parent_class)->finalize (object);
+}
+
+static void
+iface_modem_init (MMIfaceModemInterface *iface)
+{
+    iface->create_bearer = modem_create_bearer;
+    iface->create_bearer_finish = modem_create_bearer_finish;
+    iface->setup_sim_hot_swap = modem_setup_sim_hot_swap;
+    iface->setup_sim_hot_swap_finish = modem_setup_sim_hot_swap_finish;
+    iface->cleanup_sim_hot_swap = modem_cleanup_sim_hot_swap;
+}
+
+static void
+mm_broadband_modem_mtk_ccmni_class_init (MMBroadbandModemMtkCcmniClass *klass)
+{
+    GObjectClass          *object_class = G_OBJECT_CLASS (klass);
+    MMBroadbandModemClass *broadband_modem_class = MM_BROADBAND_MODEM_CLASS (klass);
+
+    object_class->finalize = finalize;
+    broadband_modem_class->setup_ports = setup_ports;
+}
