diff --git a/src/plugins/mtk-ccmni/77-mm-mtk-ccmni.rules b/src/plugins/mtk-ccmni/77-mm-mtk-ccmni.rules
new file mode 100644
index 0000000..a33a58b
--- /dev/null
+++ b/src/plugins/mtk-ccmni/77-mm-mtk-ccmni.rules
@@ -0,0 +1,19 @@
+# do not edit this file, it will be overwritten on update
+
+# MediaTek SoC modems driven by the cezanne-ccci kernel driver: AT on a WWAN
+# port, packet data on DPMAIF network links (the vendor's ccmni interfaces).
+
+ACTION!="add|change|move|bind", GOTO="mm_mtk_ccmni_end"
+
+SUBSYSTEM=="wwan", DRIVERS=="cezanne-ccci", GOTO="mm_mtk_ccmni_process"
+SUBSYSTEM=="net",  DRIVERS=="cezanne-ccci", GOTO="mm_mtk_ccmni_process"
+GOTO="mm_mtk_ccmni_end"
+
+LABEL="mm_mtk_ccmni_process"
+
+ENV{ID_MM_MTK_CCMNI}="1"
+
+# One modem: the AT port and the network links have different parents
+ENV{ID_MM_PHYSDEV_UID}="mtk-ccmni"
+
+LABEL="mm_mtk_ccmni_end"
diff --git a/src/plugins/mtk-ccmni/mm-broadband-bearer-mtk-ccmni.c b/src/plugins/mtk-ccmni/mm-broadband-bearer-mtk-ccmni.c
new file mode 100644
index 0000000..7a41c2c
--- /dev/null
+++ b/src/plugins/mtk-ccmni/mm-broadband-bearer-mtk-ccmni.c
@@ -0,0 +1,593 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * The modem routes an activated PDP context (+CGACT) to a network interface
+ * of its choice and reports it with "+EIF: <transaction><interface>, ifup,
+ * ...", a new one on each activation; the bearer moves the kernel's network
+ * link to that interface (/sys/class/net/<link>/md_interface). The modem
+ * leaves the address out of +CGCONTRDP, so the address comes from +CGPADDR
+ * and only DNS and MTU from +CGCONTRDP.
+ */
+
+#include <config.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-base-modem-at.h"
+#include "mm-broadband-bearer-mtk-ccmni.h"
+#include "mm-broadband-modem-mtk-ccmni.h"
+#include "mm-log-object.h"
+#include "mm-modem-helpers.h"
+
+G_DEFINE_TYPE (MMBroadbandBearerMtkCcmni, mm_broadband_bearer_mtk_ccmni, MM_TYPE_BROADBAND_BEARER)
+
+/*****************************************************************************/
+/* Response parsing */
+
+/* fields of one "+TAG: a,"b",c" line, unquoted */
+static GStrv
+split_fields (const gchar *line,
+              const gchar *tag)
+{
+    GPtrArray   *fields;
+    GString     *field;
+    const gchar *p;
+    gboolean     quoted = FALSE;
+
+    fields = g_ptr_array_new ();
+    field = g_string_new (NULL);
+    for (p = mm_strip_tag (line, tag); *p && *p != '\r' && *p != '\n'; p++) {
+        if (*p == '"')
+            quoted = !quoted;
+        else if (*p == ',' && !quoted) {
+            g_ptr_array_add (fields, g_strstrip (g_string_free (field, FALSE)));
+            field = g_string_new (NULL);
+        } else
+            g_string_append_c (field, *p);
+    }
+    g_ptr_array_add (fields, g_strstrip (g_string_free (field, FALSE)));
+    g_ptr_array_add (fields, NULL);
+    return (GStrv) g_ptr_array_free (fields, FALSE);
+}
+
+/* IPv4 as is; IPv6 either with colons or as 16 dotted bytes (27.007) */
+static gchar *
+parse_address (const gchar *str,
+               gboolean    *is_ipv6)
+{
+    g_auto(GStrv) parts = NULL;
+    guint8        bytes[16];
+    gchar         buf[INET6_ADDRSTRLEN];
+    guint         n, i;
+
+    if (!str || !str[0])
+        return NULL;
+    if (strchr (str, ':')) {
+        *is_ipv6 = TRUE;
+        return g_strdup (str);
+    }
+    parts = g_strsplit (str, ".", -1);
+    n = g_strv_length (parts);
+    if (n == 4) {
+        if (g_str_equal (str, "0.0.0.0"))
+            return NULL;
+        *is_ipv6 = FALSE;
+        return g_strdup (str);
+    }
+    if (n != 16)
+        return NULL;
+    for (i = 0; i < 16; i++)
+        bytes[i] = (guint8) atoi (parts[i]);
+    if (!inet_ntop (AF_INET6, bytes, buf, sizeof (buf)))
+        return NULL;
+    *is_ipv6 = TRUE;
+    return g_strdup (buf);
+}
+
+/*****************************************************************************/
+/* 3GPP IP config retrieval (sub-step of the 3GPP Connection sequence) */
+
+typedef struct {
+    MMBaseModem    *modem;
+    MMPortSerialAt *primary;
+    guint           cid;
+    gchar          *ipv4;
+    gchar          *ipv6;
+    gchar          *dns4[3];
+    gchar          *dns6[3];
+    guint           mtu;
+} GetIpConfigContext;
+
+static void
+get_ip_config_context_free (GetIpConfigContext *ctx)
+{
+    guint i;
+
+    for (i = 0; i < 2; i++) {
+        g_free (ctx->dns4[i]);
+        g_free (ctx->dns6[i]);
+    }
+    g_free (ctx->ipv4);
+    g_free (ctx->ipv6);
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_slice_free (GetIpConfigContext, ctx);
+}
+
+typedef struct {
+    MMBearerIpConfig *ipv4;
+    MMBearerIpConfig *ipv6;
+} IpConfigs;
+
+static void
+ip_configs_free (IpConfigs *configs)
+{
+    g_clear_object (&configs->ipv4);
+    g_clear_object (&configs->ipv6);
+    g_slice_free (IpConfigs, configs);
+}
+
+static gboolean
+get_ip_config_3gpp_finish (MMBroadbandBearer  *self,
+                           GAsyncResult       *res,
+                           MMBearerIpConfig  **ipv4_config,
+                           MMBearerIpConfig  **ipv6_config,
+                           GError            **error)
+{
+    IpConfigs *configs;
+
+    configs = g_task_propagate_pointer (G_TASK (res), error);
+    if (!configs)
+        return FALSE;
+    *ipv4_config = g_steal_pointer (&configs->ipv4);
+    *ipv6_config = g_steal_pointer (&configs->ipv6);
+    ip_configs_free (configs);
+    return TRUE;
+}
+
+static void
+get_ip_config_complete (GTask *task)
+{
+    MMBroadbandBearerMtkCcmni *self;
+    GetIpConfigContext        *ctx;
+    IpConfigs                 *configs;
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+    configs = g_slice_new0 (IpConfigs);
+    if (ctx->ipv4) {
+        mm_obj_dbg (self, "IPv4 address %s, DNS %s %s, MTU %u", ctx->ipv4,
+                    ctx->dns4[0] ? ctx->dns4[0] : "-", ctx->dns4[1] ? ctx->dns4[1] : "-",
+                    ctx->mtu);
+        configs->ipv4 = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (configs->ipv4, MM_BEARER_IP_METHOD_STATIC);
+        mm_bearer_ip_config_set_address (configs->ipv4, ctx->ipv4);
+        mm_bearer_ip_config_set_prefix (configs->ipv4, 32);
+        if (ctx->dns4[0])
+            mm_bearer_ip_config_set_dns (configs->ipv4, (const gchar **) ctx->dns4);
+        if (ctx->mtu)
+            mm_bearer_ip_config_set_mtu (configs->ipv4, ctx->mtu);
+    }
+    if (ctx->ipv6) {
+        /* the network's prefix comes by router advertisement */
+        mm_obj_dbg (self, "IPv6 address %s", ctx->ipv6);
+        configs->ipv6 = mm_bearer_ip_config_new ();
+        mm_bearer_ip_config_set_method (configs->ipv6, MM_BEARER_IP_METHOD_DHCP);
+        mm_bearer_ip_config_set_address (configs->ipv6, ctx->ipv6);
+        mm_bearer_ip_config_set_prefix (configs->ipv6, 64);
+        if (ctx->dns6[0])
+            mm_bearer_ip_config_set_dns (configs->ipv6, (const gchar **) ctx->dns6);
+        if (ctx->mtu)
+            mm_bearer_ip_config_set_mtu (configs->ipv6, ctx->mtu);
+    }
+    g_task_return_pointer (task, configs, (GDestroyNotify) ip_configs_free);
+    g_object_unref (task);
+}
+
+static void
+cgcontrdp_ready (MMBaseModem  *modem,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    MMBroadbandBearerMtkCcmni *self;
+    GetIpConfigContext        *ctx;
+    const gchar               *response;
+    g_autoptr(GError)          error = NULL;
+    g_auto(GStrv)              lines = NULL;
+    guint                      i, n4 = 0, n6 = 0;
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response) {
+        /* not fatal: no DNS servers then */
+        mm_obj_warn (self, "couldn't read context #%u parameters: %s", ctx->cid, error->message);
+        get_ip_config_complete (task);
+        return;
+    }
+
+    /* cid, bearer id, APN, address, gateway, DNS 1, DNS 2, P-CSCF 1, P-CSCF 2,
+     * IM CN flag, LIPA, IPv4 MTU, ...: one line per IP family */
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        g_auto(GStrv) f = NULL;
+        guint         j, len;
+
+        if (!strstr (lines[i], "+CGCONTRDP:"))
+            continue;
+        f = split_fields (lines[i], "+CGCONTRDP:");
+        len = g_strv_length (f);
+        for (j = 5; j <= 6 && j < len; j++) {
+            gboolean  is_ipv6 = FALSE;
+            gchar    *dns = parse_address (f[j], &is_ipv6);
+
+            if (!dns)
+                continue;
+            if (is_ipv6 && n6 < 2)
+                ctx->dns6[n6++] = dns;
+            else if (!is_ipv6 && n4 < 2)
+                ctx->dns4[n4++] = dns;
+            else
+                g_free (dns);
+        }
+        if (len > 11 && !ctx->mtu)
+            ctx->mtu = (guint) atoi (f[11]);
+    }
+    get_ip_config_complete (task);
+}
+
+static void
+cgpaddr_ready (MMBaseModem  *modem,
+               GAsyncResult *res,
+               GTask        *task)
+{
+    GetIpConfigContext *ctx;
+    const gchar        *response;
+    GError             *error = NULL;
+    g_auto(GStrv)       f = NULL;
+    g_autofree gchar   *cmd = NULL;
+    guint               i;
+
+    ctx = g_task_get_task_data (task);
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    /* +CGPADDR: <cid>,<address>[,<address>] */
+    f = split_fields (response, "+CGPADDR:");
+    for (i = 1; f[i]; i++) {
+        gboolean  is_ipv6 = FALSE;
+        gchar    *address = parse_address (f[i], &is_ipv6);
+
+        if (!address)
+            continue;
+        if (is_ipv6 && !ctx->ipv6)
+            ctx->ipv6 = address;
+        else if (!is_ipv6 && !ctx->ipv4)
+            ctx->ipv4 = address;
+        else
+            g_free (address);
+    }
+    if (!ctx->ipv4 && !ctx->ipv6) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "No address for context #%u: '%s'", ctx->cid, response);
+        g_object_unref (task);
+        return;
+    }
+
+    cmd = g_strdup_printf ("+CGCONTRDP=%u", ctx->cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                   MM_IFACE_PORT_AT (ctx->primary),
+                                   cmd,
+                                   10,
+                                   FALSE,
+                                   FALSE, /* raw */
+                                   NULL, /* cancellable */
+                                   (GAsyncReadyCallback) cgcontrdp_ready,
+                                   task);
+}
+
+static void
+get_ip_config_3gpp (MMBroadbandBearer   *self,
+                    MMBroadbandModem    *modem,
+                    MMPortSerialAt      *primary,
+                    MMPortSerialAt      *secondary,
+                    MMPort              *data,
+                    guint                cid,
+                    MMBearerIpFamily     ip_family,
+                    GAsyncReadyCallback  callback,
+                    gpointer             user_data)
+{
+    GetIpConfigContext *ctx;
+    GTask              *task;
+    g_autofree gchar   *cmd = NULL;
+
+    ctx = g_slice_new0 (GetIpConfigContext);
+    ctx->modem = MM_BASE_MODEM (g_object_ref (modem));
+    ctx->primary = g_object_ref (primary);
+    ctx->cid = cid;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) get_ip_config_context_free);
+
+    cmd = g_strdup_printf ("+CGPADDR=%u", cid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                   MM_IFACE_PORT_AT (primary),
+                                   cmd,
+                                   10,
+                                   FALSE,
+                                   FALSE, /* raw */
+                                   NULL, /* cancellable */
+                                   (GAsyncReadyCallback) cgpaddr_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+/* 3GPP Dialing (sub-step of the 3GPP Connection sequence) */
+
+static MMPort *
+dial_3gpp_finish (MMBroadbandBearer  *self,
+                  GAsyncResult       *res,
+                  GError            **error)
+{
+    return MM_PORT (g_task_propagate_pointer (G_TASK (res), error));
+}
+
+typedef struct {
+    MMBroadbandModemMtkCcmni *modem;
+    MMPort                   *data;
+    guint                     ifup_count;   /* reports before +CGACT */
+    guint                     polls;
+} DialContext;
+
+static void
+dial_context_free (DialContext *ctx)
+{
+    g_object_unref (ctx->data);
+    g_object_unref (ctx->modem);
+    g_slice_free (DialContext, ctx);
+}
+
+/* point the network link at the modem's interface for this context */
+static gboolean
+set_link_interface (MMPort  *data,
+                    guint    interface,
+                    GError **error)
+{
+    g_autofree gchar *path = NULL;
+    g_autofree gchar *value = NULL;
+    gint              fd;
+    gssize            n;
+
+    path = g_strdup_printf ("/sys/class/net/%s/md_interface", mm_port_get_device (data));
+    value = g_strdup_printf ("%u", interface);
+    fd = open (path, O_WRONLY | O_CLOEXEC);
+    if (fd < 0) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "%s: %s", path, g_strerror (errno));
+        return FALSE;
+    }
+    n = write (fd, value, strlen (value));
+    if (n < 0)
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "%s: %s", path, g_strerror (errno));
+    close (fd);
+    return n >= 0;
+}
+
+static gboolean
+wait_ifup (GTask *task)
+{
+    MMBroadbandBearerMtkCcmni *self;
+    DialContext               *ctx;
+    GError                    *error = NULL;
+    guint                      interface;
+
+    self = g_task_get_source_object (task);
+    ctx = g_task_get_task_data (task);
+    if (mm_broadband_modem_mtk_ccmni_get_ifup (ctx->modem, &interface) == ctx->ifup_count) {
+        /* comes right after the OK; none if the context was up already */
+        if (ctx->polls++ < 30)
+            return G_SOURCE_CONTINUE;
+        mm_obj_warn (self, "no interface report, keeping %s as it is",
+                     mm_port_get_device (ctx->data));
+    } else {
+        mm_obj_dbg (self, "%s on modem interface %u", mm_port_get_device (ctx->data), interface);
+        if (!set_link_interface (ctx->data, interface, &error)) {
+            g_task_return_error (task, error);
+            g_object_unref (task);
+            return G_SOURCE_REMOVE;
+        }
+    }
+    g_task_return_pointer (task, g_object_ref (ctx->data), g_object_unref);
+    g_object_unref (task);
+    return G_SOURCE_REMOVE;
+}
+
+static void
+cgact_ready (MMBaseModem  *modem,
+             GAsyncResult *res,
+             GTask        *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    if (wait_ifup (task) == G_SOURCE_CONTINUE)
+        g_timeout_add (100, (GSourceFunc) wait_ifup, task);
+}
+
+static void
+dial_3gpp (MMBroadbandBearer   *self,
+           MMBaseModem         *modem,
+           MMPortSerialAt      *primary,
+           guint                cid,
+           GCancellable        *cancellable,
+           GAsyncReadyCallback  callback,
+           gpointer             user_data)
+{
+    DialContext      *ctx;
+    MMPort           *data;
+    GTask            *task;
+    g_autofree gchar *cmd = NULL;
+
+    g_assert (primary != NULL);
+
+    task = g_task_new (self, cancellable, callback, user_data);
+
+    data = mm_base_modem_get_best_data_port (modem, MM_PORT_TYPE_NET);
+    if (!data) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_NOT_FOUND,
+                                 "No valid data port found to launch connection");
+        g_object_unref (task);
+        return;
+    }
+    ctx = g_slice_new0 (DialContext);
+    ctx->modem = MM_BROADBAND_MODEM_MTK_CCMNI (g_object_ref (modem));
+    ctx->data = data;
+    ctx->ifup_count = mm_broadband_modem_mtk_ccmni_get_ifup (ctx->modem, NULL);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) dial_context_free);
+
+    cmd = g_strdup_printf ("+CGACT=1,%u", cid);
+    mm_base_modem_at_command_full (modem,
+                                   MM_IFACE_PORT_AT (primary),
+                                   cmd,
+                                   MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                   FALSE,
+                                   FALSE, /* raw */
+                                   NULL, /* cancellable */
+                                   (GAsyncReadyCallback) cgact_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+/* 3GPP disconnect */
+
+static gboolean
+disconnect_3gpp_finish (MMBroadbandBearer  *self,
+                        GAsyncResult       *res,
+                        GError            **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+cgact_off_ready (MMBaseModem  *modem,
+                 GAsyncResult *res,
+                 GTask        *task)
+{
+    g_autoptr(GError) error = NULL;
+
+    /* the network may keep the default bearer up: not fatal */
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error))
+        mm_obj_dbg (g_task_get_source_object (task), "deactivation failed: %s", error->message);
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+disconnect_3gpp (MMBroadbandBearer   *self,
+                 MMBroadbandModem    *modem,
+                 MMPortSerialAt      *primary,
+                 MMPortSerialAt      *secondary,
+                 MMPort              *data,
+                 guint                cid,
+                 GAsyncReadyCallback  callback,
+                 gpointer             user_data)
+{
+    GTask            *task;
+    g_autofree gchar *cmd = NULL;
+
+    g_assert (primary != NULL);
+
+    task = g_task_new (self, NULL, callback, user_data);
+    cmd = g_strdup_printf ("+CGACT=0,%u", cid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                   MM_IFACE_PORT_AT (primary),
+                                   cmd,
+                                   MM_BASE_BEARER_DEFAULT_DISCONNECTION_TIMEOUT,
+                                   FALSE,
+                                   FALSE, /* raw */
+                                   NULL, /* cancellable */
+                                   (GAsyncReadyCallback) cgact_off_ready,
+                                   task);
+}
+
+/*****************************************************************************/
+
+MMBaseBearer *
+mm_broadband_bearer_mtk_ccmni_new_finish (GAsyncResult  *res,
+                                          GError       **error)
+{
+    GObject *bearer;
+    GObject *source;
+
+    source = g_async_result_get_source_object (res);
+    bearer = g_async_initable_new_finish (G_ASYNC_INITABLE (source), res, error);
+    g_object_unref (source);
+
+    if (!bearer)
+        return NULL;
+
+    /* Only export valid bearers */
+    mm_base_bearer_export (MM_BASE_BEARER (bearer));
+
+    return MM_BASE_BEARER (bearer);
+}
+
+void
+mm_broadband_bearer_mtk_ccmni_new (MMBroadbandModem    *modem,
+                                   MMBearerProperties  *config,
+                                   GCancellable        *cancellable,
+                                   GAsyncReadyCallback  callback,
+                                   gpointer             user_data)
+{
+    g_async_initable_new_async (
+        MM_TYPE_BROADBAND_BEARER_MTK_CCMNI,
+        G_PRIORITY_DEFAULT,
+        cancellable,
+        callback,
+        user_data,
+        MM_BASE_BEARER_MODEM, modem,
+        MM_BASE_BEARER_CONFIG, config,
+        NULL);
+}
+
+static void
+mm_broadband_bearer_mtk_ccmni_init (MMBroadbandBearerMtkCcmni *self)
+{
+}
+
+static void
+mm_broadband_bearer_mtk_ccmni_class_init (MMBroadbandBearerMtkCcmniClass *klass)
+{
+    MMBroadbandBearerClass *broadband_bearer_class = MM_BROADBAND_BEARER_CLASS (klass);
+
+    broadband_bearer_class->dial_3gpp = dial_3gpp;
+    broadband_bearer_class->dial_3gpp_finish = dial_3gpp_finish;
+    broadband_bearer_class->get_ip_config_3gpp = get_ip_config_3gpp;
+    broadband_bearer_class->get_ip_config_3gpp_finish = get_ip_config_3gpp_finish;
+    broadband_bearer_class->disconnect_3gpp = disconnect_3gpp;
+    broadband_bearer_class->disconnect_3gpp_finish = disconnect_3gpp_finish;
+}
