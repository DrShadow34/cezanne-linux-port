+
+#ifndef MM_BROADBAND_MODEM_MTK_CCMNI_H
+#define MM_BROADBAND_MODEM_MTK_CCMNI_H
+
+#include "mm-broadband-modem.h"
+
+#define MM_TYPE_BROADBAND_MODEM_MTK_CCMNI            (mm_broadband_modem_mtk_ccmni_get_type ())
+#define MM_BROADBAND_MODEM_MTK_CCMNI(obj)            (G_TYPE_CHECK_INSTANCE_CAST ((obj), MM_TYPE_BROADBAND_MODEM_MTK_CCMNI, MMBroadbandModemMtkCcmni))
+#define MM_BROADBAND_MODEM_MTK_CCMNI_CLASS(klass)    (G_TYPE_CHECK_CLASS_CAST ((klass),  MM_TYPE_BROADBAND_MODEM_MTK_CCMNI, MMBroadbandModemMtkCcmniClass))
+#define MM_IS_BROADBAND_MODEM_MTK_CCMNI(obj)         (G_TYPE_CHECK_INSTANCE_TYPE ((obj), MM_TYPE_BROADBAND_MODEM_MTK_CCMNI))
+#define MM_IS_BROADBAND_MODEM_MTK_CCMNI_CLASS(klass) (G_TYPE_CHECK_CLASS_TYPE ((klass),  MM_TYPE_BROADBAND_MODEM_MTK_CCMNI))
+#define MM_BROADBAND_MODEM_MTK_CCMNI_GET_CLASS(obj)  (G_TYPE_INSTANCE_GET_CLASS ((obj),  MM_TYPE_BROADBAND_MODEM_MTK_CCMNI, MMBroadbandModemMtkCcmniClass))
+
+typedef struct _MMBroadbandModemMtkCcmni MMBroadbandModemMtkCcmni;
+typedef struct _MMBroadbandModemMtkCcmniClass MMBroadbandModemMtkCcmniClass;
+
+struct _MMBroadbandModemMtkCcmni {
+    MMBroadbandModem parent;
+    GRegex *eif_regex;
+    GRegex *esims_regex;
+    GRegex *ignore_regex;
+    guint   ifup_count;     /* "+EIF: <id>, ifup" reports seen */
+    guint   ifup_interface; /* interface of the last one */
+};
+
+struct _MMBroadbandModemMtkCcmniClass {
+    MMBroadbandModemClass parent;
+};
+
+GType mm_broadband_modem_mtk_ccmni_get_type (void);
+
+MMBroadbandModemMtkCcmni *mm_broadband_modem_mtk_ccmni_new (const gchar  *device,
+                                                            const gchar  *physdev,
+                                                            const gchar **drivers,
+                                                            const gchar  *plugin,
+                                                            guint16       vendor_id,
+                                                            guint16       product_id);
+
+/* number of interface-up reports so far, and the interface of the last one */
+guint mm_broadband_modem_mtk_ccmni_get_ifup (MMBroadbandModemMtkCcmni *self,
+                                             guint                    *interface);
+
