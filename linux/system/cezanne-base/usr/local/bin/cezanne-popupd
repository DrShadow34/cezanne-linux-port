#!/usr/bin/python3
# Pop-up front camera daemon (Redmi K30 Ultra).
#
# Raises the camera while it is in use and retracts it otherwise, like MIUI's
# mi.motor.daemon. Motor: popup-motor.ko (/sys/bus/platform/devices/
# popup-camera/{move,state}); position: ak09970.ko IIO "popup_hall", read
# against MIUI's per-unit calibration (persist:/sensors/hall_calidata.txt).
#
# "In use" =
#   - a client holds a connection on /run/cezanne-popup.sock after sending
#     "hold" (the camera stack opens it and keeps it; if the process exits or
#     crashes the kernel closes the socket and the camera goes down), or
#   - a front camera capture runs: STREAM_ATTRS reads "1" (cezanne_camsv.ko
#     sets it from stream-on to stream-off; open video nodes alone do not
#     count, libcamera/PipeWire keep them open all the time).
#
# Safety: retract at start and stop, verify every move with the hall sensor
# (retry, then report), retract when the camera is pushed in by hand or the
# phone is in free fall, and rate-limit pop-ups (MIUI warns about frequent
# use; a long burst triggers a cool-down that protects the motor).
import glob
import math
import os
import selectors
import signal
import socket
import subprocess
import sys
import time

MOTOR = '/sys/bus/platform/devices/popup-camera'
SOCK = '/run/cezanne-popup.sock'
CALI_FILES = ['/var/lib/cezanne-popup/hall_calidata.txt']
# where MIUI keeps it: copied once into CALI_FILES[0] (mounted read only)
PERSIST = '/dev/disk/by-partlabel/persist'
PERSIST_CALI = 'sensors/hall_calidata.txt'
STREAM_ATTRS = ['/sys/bus/platform/devices/1a004000.camera/streaming']
RELEASE_DELAY = 0.5		# s: app switches should not bounce the camera
WARN_COUNT, WARN_WINDOW = 5, 60		# pop-ups per s before notifying
LIMIT_COUNT, LIMIT_WINDOW = 10, 120	# ... before a cool-down
COOLDOWN = 60
FREEFALL_MS2 = 3.0		# |a| below this ...
FREEFALL_SAMPLES = 3		# ... for this many 20 ms samples
PRESS_POS = 7.9			# popped up (rests at 8.00-8.02) but below this ...
PRESS_SAMPLES = 2		# ... for this many 20 ms samples: pushed in
HALL_SLOW_S = 0.3		# a hall read slower than this: bus trouble ...
HALL_RETRY_S = 30		# ... do without the sensor this long


def log(*a):
    print(*a, file=sys.stderr, flush=True)


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read())
    except (OSError, ValueError):
        return None


def find_iio(name):
    for d in glob.glob('/sys/bus/iio/devices/iio:device*'):
        try:
            with open(d + '/name') as f:
                if f.read().strip() == name:
                    return d
        except OSError:
            pass
    return None


class Hall:
    """Position 0 (retracted) .. 9 from the 3-axis field, nearest neighbour
    between MIUI's calibrated points (linear in between)."""

    def __init__(self):
        self.dev = find_iio('popup_hall')
        self.table = self.load_table()
        self.broken_until = 0

    @staticmethod
    def copy_persist_cali():
        """the per-unit calibration out of MIUI's persist partition, once"""
        dst = CALI_FILES[0]
        if os.path.exists(dst) or not os.path.exists(PERSIST):
            return
        mnt = f'/run/cezanne-popup.persist.{os.getpid()}'
        os.makedirs(mnt, exist_ok=True)
        try:
            if subprocess.run(['mount', '-o', 'ro', PERSIST, mnt],
                              capture_output=True).returncode != 0:
                return
            try:
                with open(os.path.join(mnt, PERSIST_CALI), 'rb') as f:
                    data = f.read()
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst + '.new', 'wb') as f:
                    f.write(data)
                os.rename(dst + '.new', dst)
                log(f'calibration copied from persist:/{PERSIST_CALI}')
            except OSError:
                pass
            finally:
                subprocess.run(['umount', mnt], capture_output=True)
        finally:
            os.rmdir(mnt)

    @staticmethod
    def load_table():
        Hall.copy_persist_cali()
        for path in CALI_FILES:
            try:
                pts = []
                with open(path) as f:
                    for line in f:
                        if line.startswith('pos'):
                            v = line.split(':')
                            pos = float(v[1].split(',')[0])
                            xyz = [float(t) for t in v[-1].split(',')]
                            pts.append((pos, xyz))
                if len(pts) >= 2:
                    return sorted(pts)
            except (OSError, ValueError, IndexError):
                pass
        # this unit's factory data, as a fallback
        return [(0, [-197, 663, -7336]), (1, [-1108, 2084, -6935]),
                (2, [-2557, 4518, -6157]), (3, [-3936, 6833, -4246]),
                (4, [-4529, 7838, -1270]), (5, [-3886, 6765, 1395]),
                (6, [-2798, 4920, 2550]), (7, [-1809, 3333, 2731]),
                (8, [-1171, 2136, 2396]), (9, [-776, 1349, 1953])]

    def read(self):
        if not self.dev:
            self.dev = find_iio('popup_hall')
            if not self.dev:
                return None
        # A hung I2C bus makes every read block for seconds: then go
        # without position feedback for a while (moves are timed anyway)
        # instead of delaying every move and check.
        now = time.monotonic()
        if now < self.broken_until:
            return None
        v = [read_int(f'{self.dev}/in_magn_{a}_raw') for a in 'xyz']
        if time.monotonic() - now > HALL_SLOW_S:
            log('hall sensor not responding, ignoring it for',
                HALL_RETRY_S, 's')
            self.broken_until = time.monotonic() + HALL_RETRY_S
            return None
        return None if None in v else v

    def position(self, xyz=None):
        xyz = xyz or self.read()
        if xyz is None:
            return None
        # project onto the closest calibration segment
        best = None
        for (p0, a), (p1, b) in zip(self.table, self.table[1:]):
            ab = [bb - aa for aa, bb in zip(a, b)]
            l2 = sum(t * t for t in ab) or 1
            t = max(0.0, min(1.0, sum((x - aa) * d for x, aa, d
                                      in zip(xyz, a, ab)) / l2))
            proj = [aa + t * d for aa, d in zip(a, ab)]
            dist = math.dist(xyz, proj)
            if best is None or dist < best[0]:
                best = (dist, p0 + t * (p1 - p0))
        return best[1]


class Motor:
    def move(self, cmd):
        try:
            with open(MOTOR + '/move', 'w') as f:
                f.write(cmd)
        except OSError as e:
            log('motor:', e)
            return False
        t0 = time.monotonic()
        while time.monotonic() - t0 < 1.5:
            try:
                with open(MOTOR + '/state') as f:
                    if f.read().strip() == 'idle':
                        return True
            except OSError:
                return False
            time.sleep(0.02)
        self.stop()
        return False

    def stop(self):
        try:
            with open(MOTOR + '/move', 'w') as f:
                f.write('stop')
        except OSError:
            pass


class Notifier:
    def send(self, title, body, urgency='normal'):
        try:
            out = subprocess.run(['loginctl', 'list-sessions', '--no-legend'],
                                 capture_output=True, text=True).stdout
        except OSError:
            return
        for line in out.splitlines():
            f = line.split()
            if len(f) >= 4 and f[3] == 'seat0':
                uid, user = int(f[1]), f[2]
                env = dict(os.environ,
                           DBUS_SESSION_BUS_ADDRESS=f'unix:path=/run/user/{uid}/bus')
                subprocess.Popen(['runuser', '-u', user, '--', 'notify-send',
                                  '-a', 'Pop-up camera', '-i', 'camera-web',
                                  '-u', urgency, title, body], env=env,
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
                return


class Daemon:
    def __init__(self):
        self.hall = Hall()
        self.motor = Motor()
        self.notify = Notifier()
        self.sel = selectors.DefaultSelector()
        self.holders = set()
        self.up = False
        self.release_at = None
        self.pops = []
        self.cooldown_until = 0
        self.warned_at = 0
        self.accel = None
        self.fall = 0
        self.press = 0
        self.manual = False	# 'up' command without a hold

    # ---- movement ----------------------------------------------------
    def go(self, up):
        want = 'up' if up else 'down'
        for attempt in range(2):
            self.motor.move(want)
            pos = self.hall.position()
            ok = pos is None or (pos >= 7.5 if up else pos <= 0.8)
            log(f'{want}: position {pos if pos is None else round(pos, 2)}'
                f'{"" if ok else " (not reached)"}')
            if ok:
                self.up = up
                return True
        self.up = up
        return False

    def retract(self, reason):
        log('retract:', reason)
        if not self.go(False):
            self.notify.send('Pop-up camera',
                             'Camera did not retract fully', 'critical')
        self.release_at = None
        self.manual = False

    def pop(self):
        now = time.monotonic()
        if now < self.cooldown_until:
            log('pop refused: cooling down')
            return False
        self.pops = [t for t in self.pops if now - t < LIMIT_WINDOW] + [now]
        recent = sum(1 for t in self.pops if now - t < WARN_WINDOW)
        if len(self.pops) >= LIMIT_COUNT:
            self.cooldown_until = now + COOLDOWN
            self.notify.send('Pop-up camera',
                             f'Used too often, paused for {COOLDOWN} s', 'critical')
            return False
        if recent >= WARN_COUNT and now - self.warned_at > WARN_WINDOW:
            self.warned_at = now
            self.notify.send('Pop-up camera',
                             'Frequent use wears the motor')
        if not self.go(True):
            self.notify.send('Pop-up camera',
                             'Camera is blocked', 'critical')
            self.retract('pop-up blocked')
            return False
        self.accel = find_iio('accel')
        self.fall = 0
        return True

    # ---- usage --------------------------------------------------------
    def device_in_use(self):
        return any(read_int(attr) == 1 for attr in STREAM_ATTRS)

    def in_use(self):
        return bool(self.holders) or self.manual or self.device_in_use()

    def update(self):
        busy = self.in_use()
        now = time.monotonic()
        if busy:
            self.release_at = None
            if not self.up and now >= self.cooldown_until:
                self.pop()
        elif self.up:
            if self.release_at is None:
                self.release_at = now + RELEASE_DELAY
            elif now >= self.release_at:
                self.retract('camera released')

    # ---- safety while up ---------------------------------------------
    def check_up(self):
        if not self.up:
            return
        if self.accel:
            a = [read_int(f'{self.accel}/in_accel_{c}_raw') for c in 'xyz']
            if None not in a:
                g = math.sqrt(sum(v * v for v in a)) / 1000.0
                self.fall = self.fall + 1 if g < FREEFALL_MS2 else 0
                if self.fall >= FREEFALL_SAMPLES:
                    self.retract(f'free fall (|a| {g:.1f} m/s^2)')
                    self.notify.send('Pop-up camera',
                                     'Fall detected, camera retracted')
                    self.cooldown_until = time.monotonic() + 3
                    return
        pos = self.hall.position()
        self.press = self.press + 1 if pos is not None and pos < PRESS_POS else 0
        if self.press >= PRESS_SAMPLES:
            self.press = 0
            self.retract(f'pushed in (position {pos:.1f})')
            self.notify.send('Pop-up camera',
                             'Pushed in, camera retracted')
            self.cooldown_until = time.monotonic() + 2

    # ---- socket API ---------------------------------------------------
    def serve(self):
        try:
            os.unlink(SOCK)
        except FileNotFoundError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCK)
        os.chmod(SOCK, 0o666)
        srv.listen(8)
        srv.setblocking(False)
        self.sel.register(srv, selectors.EVENT_READ, self.accept)

    def accept(self, srv):
        conn, _ = srv.accept()
        conn.setblocking(False)
        self.sel.register(conn, selectors.EVENT_READ, self.client)

    def reply(self, conn, text):
        try:
            conn.sendall(text.encode() + b'\n')
        except OSError:
            pass

    def client(self, conn):
        try:
            data = conn.recv(256)
        except OSError:
            data = b''
        if not data:
            self.sel.unregister(conn)
            self.holders.discard(conn)
            conn.close()
            return
        for cmd in data.decode(errors='replace').split():
            if cmd == 'hold':
                self.holders.add(conn)
                self.update()
                self.reply(conn, 'up' if self.up else 'refused')
            elif cmd == 'release':
                self.holders.discard(conn)
                self.reply(conn, 'ok')
            elif cmd == 'up':
                self.manual = True
                self.update()
                self.reply(conn, 'up' if self.up else 'refused')
            elif cmd == 'down':
                self.manual = False
                self.holders.clear()
                if self.up:
                    self.retract('requested')
                self.reply(conn, 'down')
            elif cmd == 'status':
                pos = self.hall.position()
                self.reply(conn, f'{"up" if self.up else "down"} position='
                           f'{"?" if pos is None else f"{pos:.2f}"} '
                           f'holders={len(self.holders)} '
                           f'cooldown={max(0, self.cooldown_until - time.monotonic()):.0f}s')
            else:
                self.reply(conn, 'commands: hold release up down status')

    # ---- main loop ----------------------------------------------------
    def run(self):
        stop = []
        signal.signal(signal.SIGTERM, lambda *a: stop.append(1))
        signal.signal(signal.SIGINT, lambda *a: stop.append(1))
        pos = self.hall.position()
        log(f'start: position {pos}')
        if pos is None or pos > 0.8:
            self.retract('start-up')
        self.serve()
        try:
            while not stop:
                timeout = 0.02 if self.up else 0.2
                for key, _ in self.sel.select(timeout):
                    key.data(key.fileobj)
                self.update()
                self.check_up()
        finally:
            if self.up or (self.hall.position() or 0) > 0.8:
                self.retract('shutdown')
            try:
                os.unlink(SOCK)
            except OSError:
                pass


if __name__ == '__main__':
    Daemon().run()
