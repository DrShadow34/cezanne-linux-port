#!/usr/bin/python3 -I
"""Direct (charge pump) charging from a USB PD PPS adapter.

The BQ25970 / BQ25968 halves VBUS into the battery and does not regulate, so
the battery current is set by the adapter voltage: request ~2 x VBAT, then
step the PPS voltage by 20 mV on the battery voltage / battery current / bus
current loops. Rules from the vendor pd_policy_manager (cezanne DT values):

- start: PPS adapter, battery 10..48 C, VBAT < 4.30 V (non-FFC 4.45 V
  limit - 150 mV), MT6360 input cut to 100 mA while measuring
- battery current limit: 6 A, 4.8 A for a non-Xiaomi ("unverified") PPS
  adapter, 5.4 A below 4.25 V / 3.52 A above (vendor step charging), 3.52 A at
  10..15 C; bus current = half + 50 mA, at most 3 A
- VBAT within 10 mV of 4.45 V: lower the current limit 100 mA per second
- done: VBAT > 4.37 V and IBAT < 1.5 A for 10 s -> back to the MT6360,
  which finishes the CV phase (no retry until the adapter is replugged)
- stop on any pump fault, temperature leaving the range, adapter removal
- charge limit / temperature guard (the gauge, mt6359-gauge): while the
  MT6360's charge_behaviour is inhibit-charge the pump neither starts nor
  runs (the battery's charge_control_end_threshold stops charging there,
  charging resumes at the start threshold)

QC chargers (no PD; type from the xmusb350 driver): 9 V through QC 2.0
mode select for the MT6360 (mt6360-chg-setup then allows 2 A input, 3 A
charge), once the charger has been attached QC_SETTLE s without a PD
contract (a USB-C charger can do both; TCPM gives up PD within ~3 s); back
to 5 V while the battery is >= 48 C.

QC 3 / 3+ direct charging (vendor cp_qc30, limits from the cezanne DT):
same start window as PPS; QC 5 V, continuous mode, D+ steps up to
2 x VBAT + 300 mV (QC 3+: 10 steps at a time below 2 x VBAT), pump on, then
one step per period on the vendor's thresholds (QC 3.0 steps are 200 mV,
~1 A of battery current: +-500..600 mA hysteresis). Off while
/run/cezanne-dcharge-no-qc-pump exists.

While running, /run/cezanne-dcharge holds our pid and mt6360-chg-setup
leaves the MT6360 alone. The pump stops by itself 5 s after the last
keepalive (bq25970 driver) if this program dies.
"""
import glob
import os
import signal
import sys
import time

PS = '/sys/class/power_supply'
CP = f'{PS}/bq25970'
BAT = f'{PS}/battery'
FLAG = '/run/cezanne-dcharge'

VBAT_MAX = 4450          # mV, non-FFC
VBAT_START_MAX = VBAT_MAX - 150
VBAT_MIN = 3500
FCC_MAX = 6000           # mA
FCC_UNVERIFIED = 4800
STEP_VBAT, STEP_FCC_HI, STEP_FCC_LO = 4250, 5400, 3520
IBUS_MAX = 3000
TAPER_HYS, TAPER_DONE_HYS, TAPER_DONE_IBAT = 10, 80, 1500
T_MIN, T_MAX, T_HYS = 100, 480, 20   # 0.1 C
T_COOL = 150
FCC_COOL = 3520
PPS_STEP = 20            # mV
PPS_VMAX = 10000         # vendor: APDO 11 V max - 1 V
PERIOD = 0.5
PPS_REFRESH = 5          # s; sources hard reset without a request in 15 s

XM = f'{PS}/xmusb350'
QC_TYPES = ('qc2', 'qc3', 'qc3-18', 'qc3-27', 'qc3p-18', 'qc3p-27')
QC_SETTLE = 5            # s
QC_VBUS_LOST = 7000      # mV: 9 V requested, VBUS below this = out of QC
QC_TRIES = 3             # 9 V requests per attach
QC_T_HOT, QC_T_OK = 480, 450   # 0.1 C
# QC direct charging: (IBAT, IBUS) mA per type; plain "qc3" (class not
# measured) as class A 18 W
QC_PUMP_LIMITS = {
    'qc3': (3200, 1700), 'qc3-18': (3200, 1700), 'qc3-27': (5400, 2700),
    'qc3p-18': (4500, 2300), 'qc3p-27': (5600, 2700),
}
QC_VBUS_ALARM = 9500     # mV, vendor bus OVP alarm threshold (QC 3 / 3+)
QC_INIT_UP = 300         # mV over 2 x VBAT before the pump starts
QC_PUMP_OFF = '/run/cezanne-dcharge-no-qc-pump'
INPUT_CAP = '/run/cezanne-aicr-max'   # mt6360-chg-setup's input cap: no pump either

# bq25970 state register bits
CONV_VBUS_LO, CONV_VBUS_HI, CONV_SWITCHING = 0x20, 0x10, 0x04
INT_BUS_OVP_ALM, INT_BUS_OCP_ALM = 0x20, 0x10
REG_VBAT_ACTIVE = 0x08

running = True


def log(*a):
    print(*a, flush=True)


def rd(path):
    with open(path) as f:
        return f.read().strip()


def rdi(path):
    return int(rd(path))


def wr(path, val):
    with open(path, 'w') as f:
        f.write(str(val))


def tcpm():
    for p in glob.glob(f'{PS}/tcpm-source-psy-*'):
        if rd(f'{p}/online') != '0':
            return p
    return None


def mt6360():
    p = glob.glob(f'{PS}/mt6360-chg*')
    return p[0] if p else None


def charge_inhibited():
    """the gauge holds the MT6360's charging off (charge limit or
    temperature): the pump must not charge either"""
    chg = mt6360()
    try:
        return bool(chg) and '[inhibit-charge]' in rd(f'{chg}/charge_behaviour')
    except OSError:
        return False


def cp_state():
    # "conv %02x int %02x fault %02x reg %02x"
    f = rd(f'{CP}/state').split()
    return {f[i]: int(f[i + 1], 16) for i in range(0, len(f), 2)}


def sample():
    return {
        'vbat': rdi(f'{CP}/battery_voltage') // 1000,
        'ibat': rdi(f'{CP}/battery_current') // 1000,
        'vbus': rdi(f'{CP}/voltage_now') // 1000,
        'ibus': rdi(f'{CP}/current_now') // 1000,
        'vac': rdi(f'{CP}/ac_voltage') // 1000,
        'temp': rdi(f'{BAT}/temp'),
        'cap': rdi(f'{BAT}/capacity'),
        **cp_state(),
    }


class Session:
    """One direct charging run on an attached PPS adapter."""

    def __init__(self, src, chg):
        self.src, self.chg = src, chg
        self.req_mv = 0
        self.req_t = 0
        self.fcc_taper = FCC_MAX
        self.taper_t = 0
        self.done_t = 0

    def present(self):
        return tcpm() is not None

    def request(self, mv, force=False):
        mv = max(5000, min(PPS_VMAX, mv - mv % PPS_STEP))
        now = time.monotonic()
        if mv == self.req_mv and not force and now - self.req_t < PPS_REFRESH:
            return
        wr(f'{self.src}/voltage_now', mv * 1000)
        self.req_mv, self.req_t = mv, now

    def fcc(self, s):
        fcc = min(FCC_MAX, FCC_UNVERIFIED, self.fcc_taper)
        fcc = min(fcc, STEP_FCC_HI if s['vbat'] < STEP_VBAT else STEP_FCC_LO)
        if s['temp'] < T_COOL:
            fcc = min(fcc, FCC_COOL)
        return fcc

    def start(self):
        wr(FLAG, os.getpid())
        wr(f'{self.chg}/input_current_limit', 100000)
        time.sleep(1)
        s = sample()
        if not VBAT_MIN <= s['vbat'] < VBAT_START_MAX:
            return f"vbat {s['vbat']} mV out of range"
        # PPS at the current fixed contract, then the adapter current limit
        # (each PPS request must stay >= op-sink-microwatt: current first)
        try:
            wr(f'{self.src}/online', 2)
        except OSError as e:
            return f'no pps: {e}'
        apdo_ma = rdi(f'{self.src}/current_max') // 1000
        log(f'pps on, apdo current {apdo_ma} mA')
        wr(f'{self.src}/current_now', min(apdo_ma, IBUS_MAX) * 1000)
        self.request(2 * s['vbat'] + 300, force=True)
        # VBUS into the pump's window (VBUS_ERRORLO / HI)
        for _ in range(50):
            time.sleep(0.1)
            st = cp_state()
            if st['conv'] & CONV_VBUS_LO:
                self.request(self.req_mv + PPS_STEP)
            elif st['conv'] & CONV_VBUS_HI:
                self.request(self.req_mv - PPS_STEP)
            else:
                break
        else:
            return 'vbus never in range'
        wr(f'{self.chg}/online', 0)
        wr(f'{CP}/online', 1)
        for _ in range(10):
            time.sleep(0.1)
            if cp_state()['conv'] & CONV_SWITCHING:
                break
        else:
            return f'pump not switching: {rd(CP + "/state")}'
        log(f'pump on at {self.req_mv} mV, {sample()}')
        return None

    def step(self, s):
        """One control period; returns a stop reason or None."""
        if s['fault'] or not s['conv'] & CONV_SWITCHING:
            return f"pump stopped: {rd(CP + '/state')}"
        if not T_MIN <= s['temp'] < T_MAX:
            return f"battery {s['temp'] / 10} C"
        if charge_inhibited():
            return f"charge limit at {s['cap']}%"
        now = time.monotonic()

        # CV: walk the current limit down near the voltage limit
        if s['vbat'] > VBAT_MAX - TAPER_HYS:
            if now - self.taper_t >= 1:
                self.fcc_taper = min(self.fcc_taper, self.fcc(s)) - 100
                self.taper_t = now
        if s['vbat'] > VBAT_MAX - TAPER_DONE_HYS and s['ibat'] < TAPER_DONE_IBAT:
            self.done_t = self.done_t or now
            if now - self.done_t >= 10:
                return 'done'
        else:
            self.done_t = 0

        fcc = self.fcc(s)
        ibus_lim = min(fcc // 2 + 50, IBUS_MAX)
        steps = [
            -1 if s['vbat'] > VBAT_MAX else 1 if s['vbat'] < VBAT_MAX - 10 else 0,
            1 if s['ibat'] < fcc - 50 else -1 if s['ibat'] > fcc else 0,
            1 if s['ibus'] < ibus_lim else -1 if s['ibus'] > ibus_lim + 50 else 0,
            -3 if s['reg'] & REG_VBAT_ACTIVE else 1,
            -1 if s['int'] & (INT_BUS_OVP_ALM | INT_BUS_OCP_ALM) else 1,
        ]
        self.request(self.req_mv + min(steps) * PPS_STEP)
        wr(f'{CP}/online', 1)
        return None

    def stop(self):
        for f in (lambda: wr(f'{CP}/online', 0),
                  lambda: wr(f'{self.chg}/online', 1),
                  lambda: wr(f'{self.src}/online', 1) if tcpm() else None):
            try:
                f()
            except OSError as e:
                log(f'stop: {e}')
        try:
            os.unlink(FLAG)
        except FileNotFoundError:
            pass
        # back to the MT6360 policy (input limit, JEITA)
        os.system('/usr/local/bin/mt6360-chg-setup')


class QcSession(Session):
    """One direct charging run on a QC 3 / 3+ charger (xmusb350 pulses)."""

    def __init__(self, qc, chg):
        super().__init__(None, chg)
        self.qc = qc
        self.plus = qc.startswith('qc3p')
        self.fcc_max, self.ibus_max = QC_PUMP_LIMITS[qc]
        self.backoff = 0     # vendor "value": IBUS margin while VBAT regulates

    def present(self):
        try:
            return rd(f'{XM}/qc_type') == self.qc
        except OSError:
            return False

    def vbus(self):
        return rdi(f'{CP}/voltage_now') // 1000

    def pulse(self, n):
        wr(f'{XM}/pulses', n)
        time.sleep(0.05 * abs(n) if self.plus else 0.1 * abs(n))
        self.req_mv = self.vbus()

    def fcc(self, s):
        return min(super().fcc(s), self.fcc_max)

    def start(self):
        wr(FLAG, os.getpid())
        wr(f'{self.chg}/input_current_limit', 100000)
        wr(f'{XM}/qc_mode', 'qc2-5v')
        for _ in range(30):
            time.sleep(0.2)
            if self.vbus() < 5300:
                break
        else:
            return f'vbus {self.vbus()} mV, not back at 5 V'
        wr(f'{XM}/qc_mode', 'qc3p' if self.plus else 'qc3')
        time.sleep(0.5)
        s = sample()
        if not VBAT_MIN <= s['vbat'] < VBAT_START_MAX:
            return f"vbat {s['vbat']} mV out of range"
        target = 2 * s['vbat'] + QC_INIT_UP
        for _ in range(250 if self.plus else 30):
            v = self.vbus()
            if v >= target - 50:
                break
            if v > QC_VBUS_ALARM:
                return f'vbus {v} mV over the alarm threshold'
            self.pulse(10 if self.plus and v < 2 * s['vbat'] and v < 8300 else 1)
        else:
            return f'vbus stuck at {self.vbus()} mV (target {target})'
        # into the pump's window (VBUS_ERRORLO / HI)
        n = 4 if self.plus else 1
        for _ in range(10 if self.plus else 5):
            st = cp_state()
            if st['conv'] & CONV_VBUS_LO:
                self.pulse(n)
            elif st['conv'] & CONV_VBUS_HI:
                self.pulse(-n)
            else:
                break
        else:
            return f'vbus not in the pump window: {rd(CP + "/state")}'
        wr(f'{self.chg}/online', 0)
        wr(f'{CP}/online', 1)
        for _ in range(10):
            time.sleep(0.1)
            if cp_state()['conv'] & CONV_SWITCHING:
                break
        else:
            return f'pump not switching: {rd(CP + "/state")}'
        log(f'qc pump on ({self.qc}) at {self.vbus()} mV, {sample()}')
        return None

    def step(self, s):
        if s['fault'] or not s['conv'] & CONV_SWITCHING:
            return f"pump stopped: {rd(CP + '/state')}"
        if not T_MIN <= s['temp'] < T_MAX:
            return f"battery {s['temp'] / 10} C"
        if charge_inhibited():
            return f"charge limit at {s['cap']}%"
        now = time.monotonic()
        if s['vbat'] > VBAT_MAX - TAPER_HYS:
            if now - self.taper_t >= 1:
                self.fcc_taper = min(self.fcc_taper, self.fcc(s)) - 100
                self.taper_t = now
        if s['vbat'] > VBAT_MAX - TAPER_DONE_HYS and s['ibat'] < TAPER_DONE_IBAT:
            self.done_t = self.done_t or now
            if now - self.done_t >= 10:
                return 'done'
        else:
            self.done_t = 0

        fcc = self.fcc(s)
        ibus_lim = min(fcc // 2, self.ibus_max)
        alarm = s['int'] & (INT_BUS_OVP_ALM | INT_BUS_OCP_ALM)
        vreg = s['reg'] & REG_VBAT_ACTIVE
        b = self.backoff
        if self.plus:
            up = (s['vbus'] <= QC_VBUS_ALARM and s['ibus'] < ibus_lim - b + 50
                  and s['vbat'] < VBAT_MAX - 20 and s['ibat'] < fcc)
            down = (vreg or s['vbat'] > VBAT_MAX - 10 or s['ibat'] > fcc + 50
                    or s['ibus'] > ibus_lim - b + 100)
        else:
            up = (s['vbus'] <= QC_VBUS_ALARM and s['ibus'] < ibus_lim - b
                  and s['vbat'] < VBAT_MAX - 40 and s['ibat'] < fcc - 600)
            down = (vreg or s['vbat'] > VBAT_MAX or s['ibat'] > fcc + 500
                    or s['ibus'] > ibus_lim + 400 - b)
        if alarm or down:
            self.pulse(-1)
        elif up:
            self.pulse(1)
        if vreg:
            self.backoff += 100
        elif s['vbat'] < VBAT_MAX - 150:
            self.backoff = 0
        wr(f'{CP}/online', 1)
        return None

    def stop(self):
        for f in (lambda: wr(f'{CP}/online', 0),
                  lambda: wr(f'{self.chg}/online', 1),
                  lambda: wr(f'{XM}/qc_mode', 'qc2-5v')):
            try:
                f()
            except OSError as e:
                log(f'stop: {e}')
        try:
            os.unlink(FLAG)
        except FileNotFoundError:
            pass
        os.system('/usr/local/bin/mt6360-chg-setup')


def qc_pump_eligible(qc):
    """QC 3 / 3+ charger settled (see QC.poll) and the battery in range."""
    if (os.path.exists(QC_PUMP_OFF) or os.path.exists(INPUT_CAP)
            or not os.path.isdir(CP)):
        return None
    try:
        t = rd(f'{XM}/qc_type')
    except OSError:
        return None
    if t not in QC_PUMP_LIMITS or pd_contract() or qc.since is None:
        return None
    if time.monotonic() - qc.since < QC_SETTLE:
        return None
    temp = rdi(f'{BAT}/temp')
    if not T_MIN + T_HYS <= temp < T_MAX - T_HYS:
        return None
    if rdi(f'{BAT}/capacity') >= 100 or charge_inhibited():
        return None
    # charging current lifts it; the session measures again with the input cut
    if rdi(f'{BAT}/voltage_now') // 1000 >= VBAT_MAX - 50:
        return None
    return t


def pd_contract():
    """TCPM has a PD contract (usb_type other than plain Type-C)."""
    src = tcpm()
    return bool(src) and '[C]' not in rd(f'{src}/usb_type')


class QC:
    """9 V from a QC 2.0 / 3.0 / 3+ charger for the switching charger."""

    def __init__(self):
        self.reset()
        self.chip_reset = False   # once per plug: QC_TRIES failed -> redetect

    def reset(self):
        self.since, self.tries, self.hot, self.low = None, 0, False, 0

    def mode(self, m):
        wr(f'{XM}/qc_mode', m)

    def poll(self):
        try:
            qc = rd(f'{XM}/qc_type')
        except OSError:
            qc = 'none'
        if qc == 'none':
            self.chip_reset = False
        if qc not in QC_TYPES or pd_contract():
            self.reset()
            return
        now = time.monotonic()
        if self.since is None:
            self.since = now
            log(f'qc charger: {qc}')
        if now - self.since < QC_SETTLE:
            return
        t = rdi(f'{BAT}/temp')
        if t >= QC_T_HOT or (self.hot and t >= QC_T_OK):
            if not self.hot:
                log(f'qc: battery {t / 10} C, back to 5 V')
                self.mode('qc2-5v')
                self.hot = True
                os.system('/usr/local/bin/mt6360-chg-setup')
            return
        self.hot = False
        # requested 9 V and VBUS not collapsed (it sags ~0.5 V at 2 A)
        if rdi(f'{XM}/qc_voltage') >= 8500:
            if rdi(f'{CP}/voltage_now') // 1000 >= QC_VBUS_LOST:
                self.low = 0
                return
            self.low += 1
            if self.low < 2:
                return
            log('qc: vbus collapsed, charger left QC')
        self.low = 0
        if self.tries >= QC_TRIES:
            if not self.chip_reset:
                # the charger left QC mode behind the chip's back: handshake again
                log('qc: no 9 V, resetting the xmusb350')
                self.chip_reset = True
                wr(f'{XM}/reset', 1)
                self.reset()
            return
        self.tries += 1
        # QC 2.0 fixed 9 V (QC 3 chargers too); from the 5 V mode only
        self.mode('qc2-5v')
        self.mode('qc2-9v')
        time.sleep(0.5)
        vbus = rdi(f'{CP}/voltage_now') // 1000
        log(f'qc: 9 V requested ({qc}), vbus {vbus} mV')
        os.system('/usr/local/bin/mt6360-chg-setup')


def eligible():
    """PPS adapter attached and the battery in the direct charging range."""
    src = tcpm()
    if not src or not os.path.isdir(CP) or os.path.exists(INPUT_CAP):
        return None
    # the adapter's advertised capabilities (no renegotiation to probe)
    if not glob.glob('/sys/class/typec/port*-partner/usb_power_delivery/'
                     'source-capabilities/*:programmable_supply'):
        return None
    t = rdi(f'{BAT}/temp')
    if not T_MIN + T_HYS <= t < T_MAX - T_HYS:
        return None
    if rdi(f'{BAT}/capacity') >= 100 or charge_inhibited():
        return None
    return src


def main():
    def term(*_):
        global running
        running = False
    signal.signal(signal.SIGTERM, term)
    signal.signal(signal.SIGINT, term)

    attached = None      # adapter session id: retry only after a replug
    finished = False
    retry_at = 0
    qc = QC()
    while running:
        src = tcpm()
        if src != attached:
            attached, finished, retry_at = src, False, 0
        ses = None
        if not finished and time.monotonic() >= retry_at:
            if eligible():
                ses = Session(src, mt6360())
            else:
                qt = qc_pump_eligible(qc)
                if qt:
                    ses = QcSession(qt, mt6360())
        if ses is None:
            try:
                qc.poll()
            except OSError as e:
                log(f'qc: {e}')
            time.sleep(2)
            continue

        reason = None
        try:
            reason = ses.start()
            last_log = 0
            while running and reason is None:
                time.sleep(PERIOD)
                if not ses.present():
                    reason = 'adapter removed'
                    break
                s = sample()
                reason = ses.step(s)
                if time.monotonic() - last_log >= 10:
                    last_log = time.monotonic()
                    log(f"req {ses.req_mv} mV fcc {ses.fcc(s)} | vbus {s['vbus']} "
                        f"ibus {s['ibus']} vbat {s['vbat']} ibat {s['ibat']} "
                        f"T {s['temp'] / 10} cap {s['cap']}%")
        except OSError as e:
            reason = f'error: {e}'
        finally:
            ses.stop()
        log(f'stop: {reason or "terminated"}')
        if isinstance(ses, QcSession):
            qc.reset()       # back to the 9 V switching path
        if reason == 'done' or (reason or '').startswith(('vbat', 'no pps')):
            finished = True
        else:
            retry_at = time.monotonic() + 60


if __name__ == '__main__':
    sys.exit(main())
