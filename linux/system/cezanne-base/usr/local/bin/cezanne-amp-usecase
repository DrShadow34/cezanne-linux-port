#!/usr/bin/env python3
# cezanne-amp-usecase [--wait SECONDS] music|handsfree: the CS35L41 protection firmware's
# "fast use case" tuning deltas, as MIUI's audio_device.xml selects them
# (media = spk-music / rcv-music, speakerphone = *-handsfree) and the vendor
# driver applies them (cs35l41_do_fast_switch, GPL): the delta file is a
# comma separated list of s32, the first one the word count; written big
# endian into CSPL_UPDATE_PARAMS_CONFIG, then CSPL_COMMAND = UPDATE_PARAM (8)
# and CSPL_STATE must read RUNNING (0) again. Needs the DSPs running (they
# start with the first clocked stream since boot and are never stopped
# again: the firmware ignores pause, system suspend keeps the amps powered),
# so the parameters stay until the next boot. --wait: first wait (up to
# SECONDS) until both DSP heartbeats count.
import struct
import subprocess
import sys
import time

CARD = 'cezanne'
FW = '/usr/lib/firmware/cirrus'
AMPS = (('Bottom', 'spk'), ('Top', 'rcv'))
CSPL_CMD_UPDATE_PARAM = 8
CSPL_ST_RUNNING = 0
PARAMS_SIZE = 400		# bytes of the UPDATE_PARAMS_CONFIG control


def ctl(amp, name):
    """ALSA names end after 43 characters; wm_adsp cuts the firmware's
    control name from the front (Bottom: ...ATE_PARAMS_CONFIG)"""
    prefix = '%s DSP1 Protection cd ' % amp
    return 'name=' + prefix + name[max(0, len(prefix) + len(name) - 43):]


def cset(name, data):
    subprocess.run(['amixer', '-q', '-c', CARD, 'cset', name,
                    ','.join('0x%02x' % b for b in data)], check=True)


def cget_u32(name):
    out = subprocess.run(['amixer', '-c', CARD, 'cget', name], capture_output=True,
                         text=True, check=True).stdout
    for line in out.splitlines():
        if line.strip().startswith(': values='):
            b = bytes(int(x, 16) for x in line.split('=', 1)[1].split(','))
            return struct.unpack('>I', b[:4])[0]
    raise RuntimeError('no value for ' + name)


def running(amp):
    hb = 'name=%s DSP1 Protection 400a4 HALO_HEARTBEAT' % amp
    a = cget_u32(hb)
    time.sleep(0.3)
    return cget_u32(hb) != a


def apply(amp, kind, mode):
    words = [int(x) for x in open('%s/cs35l41-delta-%s-%s.txt' % (FW, kind, mode)).read().split(',')]
    if words[0] != len(words) or 4 * len(words) > PARAMS_SIZE:
        raise ValueError('%s-%s: bad delta file (%d words, header %d)' % (kind, mode, len(words), words[0]))
    data = struct.pack('>%di' % len(words), *words)
    cset(ctl(amp, 'CSPL_UPDATE_PARAMS_CONFIG'), data + bytes(PARAMS_SIZE - len(data)))
    cset(ctl(amp, 'CSPL_COMMAND'), struct.pack('>I', CSPL_CMD_UPDATE_PARAM))
    for _ in range(50):
        if cget_u32(ctl(amp, 'CSPL_STATE')) == CSPL_ST_RUNNING:
            print('%s: %s-%s applied' % (amp, kind, mode))
            return True
        time.sleep(0.01)
    print('%s: CSPL not running after %s-%s' % (amp, kind, mode), file=sys.stderr)
    return False


def main():
    args = sys.argv[1:]
    wait = 0
    if args[:1] == ['--wait'] and len(args) > 1:
        wait = float(args[1])
        args = args[2:]
    mode = args[0] if args else ''
    if mode not in ('music', 'handsfree'):
        sys.exit('usage: cezanne-amp-usecase [--wait SECONDS] music|handsfree')
    end = time.monotonic() + wait
    while not all(running(amp) for amp, _ in AMPS):
        if time.monotonic() > end:
            sys.exit('DSPs not running')
        time.sleep(1)
    ok = all([apply(amp, kind, mode) for amp, kind in AMPS])
    sys.exit(0 if ok else 1)


main()
