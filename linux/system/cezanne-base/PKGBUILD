# cezanne-base: the port's system integration from this rootfs overlay tree:
# configs and drop-ins (/etc), systemd units, udev rules, the cezanne-* system
# scripts (/usr/local/bin, /usr/local/lib/cezanne), ALSA UCM, the Plymouth
# theme and the GSettings override.
# Not here: the GNOME Shell extensions (cezanne-extensions, since
# 2026-11-08), firmware (cezanne-firmware), kernel modules (linux-cezanne),
# installation-specific files (fstab, locale.conf), device state (/var/lib).
# The version is the build time: cezanne-build rebuilds when the tree changes.
pkgname=cezanne-base
pkgver=0
pkgrel=1
pkgdesc="Redmi K30 Ultra (cezanne) system integration: configs, units, udev rules, scripts"
arch=(any)
url="https://github.com/DrShadow34/cezanne-linux-port"
license=(GPL-2.0-or-later)
depends=(systemd python dconf gnome-shell plymouth btrfs-progs compsize)
install=cezanne-base.install

pkgver() {
  date -u +%Y%m%d.%H%M%S
}

# installation-specific, owned by other packages, or not shipped
_skip='^etc/(fstab|locale\.conf|plymouth/plymouthd\.conf)$|^usr/lib/firmware/'

package() {
  cd "$startdir"
  local f mode
  while IFS= read -r -d '' f; do
    f=${f#./}
    [[ $f =~ $_skip ]] && continue
    if [[ -L $f ]]; then
      install -d "$pkgdir/$(dirname "$f")"
      cp -P "$f" "$pkgdir/$f"
    else
      mode=$(stat -c %a "$f")
      # commands are executable whatever the tree's mode (an editor that
      # rewrote mt6360-chg-setup as 644 stopped the charger setup)
      [[ $f == usr/local/bin/* || $f == usr/local/sbin/* ]] && mode=755
      install -Dm"$mode" "$f" "$pkgdir/$f"
    fi
  done < <(find ./etc ./usr \( -type f -o -type l \) -print0)

  # units enabled on the first install (systemctl preset in the .install)
  install -d "$pkgdir/usr/lib/systemd/system-preset"
  for f in etc/systemd/system/*.service; do
    # bring-up logger (wakes every 5 s): enabled by hand only
    [[ ${f##*/} == usbnet-debug.service ]] && continue
    echo "enable ${f##*/}"
  done > "$pkgdir/usr/lib/systemd/system-preset/80-cezanne-base.preset"

  # every /etc file is configuration: local edits survive upgrades (.pacnew)
  backup=($(cd "${pkgdir:-/nonexistent}" 2>/dev/null && find etc -type f | sort))
}
