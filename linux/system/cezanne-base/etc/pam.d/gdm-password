#%PAM-1.0
# cezanne: Arch's gdm-password (system-local-login -> system-login ->
# system-auth) with the auth part inlined so that a cancelled conversation
# (pam_unix: PAM_AUTHTOK_ERR / PAM_CONV_ERR; the lock screen dropping or
# restarting its password prompt: a fingerprint unlock, a shell restart,
# the AOD taking over) fails without counting for pam_faillock. Three of
# those locked the account for 10 min, fingerprint too. A wrong password
# (PAM_AUTH_ERR) still counts.

auth       required                    pam_shells.so
auth       requisite                   pam_nologin.so
auth       required                    pam_faillock.so      preauth
-auth      [success=4 default=ignore]  pam_systemd_home.so
auth       [success=2 conv_err=1 authtok_err=1 default=bad] pam_unix.so try_first_pass nullok
auth       [default=die]               pam_faillock.so      authfail
auth       requisite                   pam_deny.so
auth       optional                    pam_permit.so
auth       required                    pam_env.so
auth       required                    pam_faillock.so      authsucc
-auth      optional                    pam_gnome_keyring.so
-auth      optional                    pam_oo7.so

account    include                     system-local-login

password   include                     system-local-login
-password  optional                    pam_gnome_keyring.so use_authtok
-password  optional                    pam_oo7.so use_authtok

session    include                     system-local-login
-session   optional                    pam_gnome_keyring.so auto_start
-session   optional                    pam_oo7.so auto_start
