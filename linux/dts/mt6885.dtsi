// SPDX-License-Identifier: GPL-2.0
/*
 * MediaTek MT6885 / MT6889 (Dimensity 1000 / 1000+) - minimal SoC description.
 * Values taken from the vendor device tree (lk runtime DTB); only blocks with
 * mainline drivers are described.
 */

#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/mt6885-clk.h>
/* audsys gates are laid out as on MT8192 (driver reused) */
#include <dt-bindings/clock/mt8192-clk.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/memory/mtk-memory-port.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/gce/mt6885-gce.h>
#include <dt-bindings/power/mt6885-power.h>
#include <dt-bindings/spmi/spmi.h>
#include <dt-bindings/reset/mt6885-resets.h>
#include <dt-bindings/thermal/mediatek,lvts-thermal.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "mediatek,mt6885";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	/* display block instances (mediatek-drm tells pipe 0 / 1 apart by these) */
	aliases {
		ovl0 = &ovl0;
		ovl1 = &ovl1;
		rdma0 = &rdma0;
		rdma1 = &rdma1;
		color0 = &color0;
		color1 = &color1;
		ccorr0 = &ccorr0;
		ccorr1 = &ccorr1;
		aal0 = &aal0;
		aal1 = &aal1;
		gamma0 = &gamma0;
		gamma1 = &gamma1;
		postmask0 = &postmask0;
		postmask1 = &postmask1;
		dither0 = &dither0;
		dither1 = &dither1;
		dsc0 = &dsc0;
		dsi0 = &dsi0;
	};

	/* CCI OPP table holder for SVS (DVFS itself is MCUPM's, see cpufreq_mcupm) */
	cci: cci {
		compatible = "mediatek,mt6885-cci";
		status = "disabled";
	};

	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";
		opp-shared;

		/*
		 * stock gpufreq (mtk_gpufreq_internal_plat.h) segment 1 sign-off
		 * points, VSRAM 0.75 V: the 16 OPPs GPU EEM calibrates
		 * (g_ptpod_opp_idx_table_segment), SVS trims their voltages
		 */
		opp-350000000 {
			opp-hz = /bits/ 64 <350000000>;
			opp-microvolt = <568750>;
		};

		opp-390000000 {
			opp-hz = /bits/ 64 <390000000>;
			opp-microvolt = <581250>;
		};

		opp-431000000 {
			opp-hz = /bits/ 64 <431000000>;
			opp-microvolt = <593750>;
		};

		opp-471000000 {
			opp-hz = /bits/ 64 <471000000>;
			opp-microvolt = <600000>;
		};

		opp-512000000 {
			opp-hz = /bits/ 64 <512000000>;
			opp-microvolt = <612500>;
		};

		opp-553000000 {
			opp-hz = /bits/ 64 <553000000>;
			opp-microvolt = <625000>;
		};

		opp-593000000 {
			opp-hz = /bits/ 64 <593000000>;
			opp-microvolt = <631250>;
		};

		opp-634000000 {
			opp-hz = /bits/ 64 <634000000>;
			opp-microvolt = <643750>;
		};

		opp-675000000 {
			opp-hz = /bits/ 64 <675000000>;
			opp-microvolt = <650000>;
		};

		opp-695000000 {
			opp-hz = /bits/ 64 <695000000>;
			opp-microvolt = <662500>;
		};

		opp-715000000 {
			opp-hz = /bits/ 64 <715000000>;
			opp-microvolt = <675000>;
		};

		opp-735000000 {
			opp-hz = /bits/ 64 <735000000>;
			opp-microvolt = <687500>;
		};

		opp-755000000 {
			opp-hz = /bits/ 64 <755000000>;
			opp-microvolt = <700000>;
		};

		opp-775000000 {
			opp-hz = /bits/ 64 <775000000>;
			opp-microvolt = <712500>;
		};

		opp-805000000 {
			opp-hz = /bits/ 64 <805000000>;
			opp-microvolt = <731250>;
		};

		opp-836000000 {
			opp-hz = /bits/ 64 <836000000>;
			opp-microvolt = <750000>;
		};
	};

	/*
	 * Trips: passive at 85 C (CPU zones throttle their cluster through the
	 * MCUPM cpufreq policy, GPU zones through Panfrost devfreq), critical at 115 C.
	 */
	/*
	 * TRNG (0x1020f000) is secure: read through the ATF (the BSP's
	 * mt67xx-rng call, MTK_SIP_KERNEL_GET_RND 0xc200026a)
	 */
	rng {
		compatible = "mediatek,mt6885-rng";
	};

	thermal-zones {
		cpu-big0-thermal {
			polling-delay = <250>;
			polling-delay-passive = <100>;
			thermal-sensors = <&lvts_mcu MT8192_MCU_BIG_CPU0>;

			trips {
				/* wide hysteresis: releasing all of it means a 2.6 GHz spike */
				cpu_big0_alert: trip-alert {
					temperature = <75000>;
					hysteresis = <15000>;
					type = "passive";
				};

				/*
				 * Untrimmed (no EEM) A77 voltages: the hotspot
				 * goes +45 C within 0.5 s at 2.6 GHz, faster than
				 * step_wise ramps. Clamp to state 5 (1.93 GHz) here.
				 */
				cpu_big0_hot: trip-hot {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_big0_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_big0_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map1 {
					trip = <&cpu_big0_hot>;
					cooling-device = <&cpu4 5 THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-big1-thermal {
			polling-delay = <250>;
			polling-delay-passive = <100>;
			thermal-sensors = <&lvts_mcu MT8192_MCU_BIG_CPU1>;

			trips {
				/* wide hysteresis: releasing all of it means a 2.6 GHz spike */
				cpu_big1_alert: trip-alert {
					temperature = <75000>;
					hysteresis = <15000>;
					type = "passive";
				};

				/*
				 * Untrimmed (no EEM) A77 voltages: the hotspot
				 * goes +45 C within 0.5 s at 2.6 GHz, faster than
				 * step_wise ramps. Clamp to state 5 (1.93 GHz) here.
				 */
				cpu_big1_hot: trip-hot {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_big1_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_big1_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map1 {
					trip = <&cpu_big1_hot>;
					cooling-device = <&cpu4 5 THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-big2-thermal {
			polling-delay = <250>;
			polling-delay-passive = <100>;
			thermal-sensors = <&lvts_mcu MT8192_MCU_BIG_CPU2>;

			trips {
				/* wide hysteresis: releasing all of it means a 2.6 GHz spike */
				cpu_big2_alert: trip-alert {
					temperature = <75000>;
					hysteresis = <15000>;
					type = "passive";
				};

				/*
				 * Untrimmed (no EEM) A77 voltages: the hotspot
				 * goes +45 C within 0.5 s at 2.6 GHz, faster than
				 * step_wise ramps. Clamp to state 5 (1.93 GHz) here.
				 */
				cpu_big2_hot: trip-hot {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_big2_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_big2_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map1 {
					trip = <&cpu_big2_hot>;
					cooling-device = <&cpu4 5 THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-big3-thermal {
			polling-delay = <250>;
			polling-delay-passive = <100>;
			thermal-sensors = <&lvts_mcu MT8192_MCU_BIG_CPU3>;

			trips {
				/* wide hysteresis: releasing all of it means a 2.6 GHz spike */
				cpu_big3_alert: trip-alert {
					temperature = <75000>;
					hysteresis = <15000>;
					type = "passive";
				};

				/*
				 * Untrimmed (no EEM) A77 voltages: the hotspot
				 * goes +45 C within 0.5 s at 2.6 GHz, faster than
				 * step_wise ramps. Clamp to state 5 (1.93 GHz) here.
				 */
				cpu_big3_hot: trip-hot {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_big3_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_big3_alert>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};

				map1 {
					trip = <&cpu_big3_hot>;
					cooling-device = <&cpu4 5 THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-little0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT8192_MCU_LITTLE_CPU0>;

			trips {
				cpu_little0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_little0_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_little0_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-little1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT8192_MCU_LITTLE_CPU1>;

			trips {
				cpu_little1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_little1_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_little1_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-little2-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT8192_MCU_LITTLE_CPU2>;

			trips {
				cpu_little2_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_little2_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_little2_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		cpu-little3-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_mcu MT8192_MCU_LITTLE_CPU3>;

			trips {
				cpu_little3_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_little3_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_little3_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_ap MT8192_AP_GPU0>;

			trips {
				gpu0_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				gpu0_hot: trip-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "hot";
				};
				gpu0_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu0_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gpu1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_ap MT8192_AP_GPU1>;

			trips {
				gpu1_alert: trip-alert {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};
				gpu1_hot: trip-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "hot";
				};
				gpu1_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&gpu1_alert>;
					cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		vpu0-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_ap MT8192_AP_VPU0>;

			trips {
				vpu0_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

		vpu1-thermal {
			polling-delay = <1000>;
			polling-delay-passive = <250>;
			thermal-sensors = <&lvts_ap MT8192_AP_VPU1>;

			trips {
				vpu1_crit: trip-crit {
					temperature = <115000>;
					hysteresis = <0>;
					type = "critical";
				};
			};
		};

