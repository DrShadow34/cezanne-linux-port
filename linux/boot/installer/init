#!/usr/bin/bash
# cezanne installer: a RAM-only Arch toolset in the recovery slot. Brings up
# the USB network (phone 172.16.42.1, DHCP for the host) and sshd with the
# installed system's host keys, nothing else: the installation itself is
# driven over ssh (mainline/installer/README). Never touches a partition on
# its own except clearing the one-shot misc BCB that booted it.
export PATH=/usr/bin
mount -t devtmpfs dev /dev
mount -t proc proc /proc
mount -t sysfs sys /sys
mkdir -p /dev/pts /run /tmp /sys/kernel/config
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs none /sys/kernel/config
exec >/dev/kmsg 2>&1
echo "INSTALLER: up"

part() {	# GPT name -> /dev/sdXN
	local u
	for u in /sys/class/block/*/uevent; do
		grep -qx "PARTNAME=$1" "$u" && { echo "/dev/$(basename "$(dirname "$u")")"; return; }
	done
}

# the BCB "boot-recovery" that sent us here: one shot only
for i in $(seq 1 50); do misc=$(part misc); [ -n "$misc" ] && break; sleep 0.2; done
[ -n "$misc" ] && dd if=/dev/zero of="$misc" bs=32 count=1 conv=notrunc,fsync 2>/dev/null &&
	echo "INSTALLER: cleared BCB on $misc"

G=/sys/kernel/config/usb_gadget/g1
for i in $(seq 1 100); do [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break; sleep 0.2; done
mkdir -p $G && cd $G
echo 0x18d1 > idVendor; echo 0xd001 > idProduct
mkdir -p strings/0x409 functions/rndis.usb0 configs/c.1/strings/0x409
echo cezanne-installer > strings/0x409/serialnumber
echo "Arch Linux ARM" > strings/0x409/manufacturer
echo "Redmi K30 Ultra (installer)" > strings/0x409/product
echo RNDIS > configs/c.1/strings/0x409/configuration
ln -sf $G/functions/rndis.usb0 configs/c.1/
ls /sys/class/udc | head -1 > UDC
cd /
for i in $(seq 1 50); do IF=$(ls /sys/class/net | grep -E '^(rndis|usb)' | head -1); [ -n "$IF" ] && break; sleep 0.2; done
ip link set lo up
ip addr add 172.16.42.1/24 dev "$IF"
ip link set "$IF" up
echo "INSTALLER: $IF up"
dnsmasq -u root --port=0 --interface="$IF" --bind-interfaces \
	--dhcp-range=172.16.42.2,172.16.42.10,1h --dhcp-option=3 --dhcp-option=6 \
	--dhcp-leasefile=/run/dnsmasq.leases
mkdir -p /var/empty /run/sshd
/usr/bin/sshd -e
echo "INSTALLER: sshd started"
while :; do sleep 3600; done
