 	DBGLOG(INIT, TRACE, "start.\n");
@@ -7712,6 +8003,7 @@ static void wlanOnPostNetRegister(void)
 #endif
 	/* 4 <5> Register Notifier callback */
 	wlanRegisterInetAddrNotifier();
+	register_pm_notifier(&wlan_suspend_mode_pm_nb);
 }
 
