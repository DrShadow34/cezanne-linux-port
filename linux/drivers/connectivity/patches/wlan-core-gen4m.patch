+/*
+ * Linux has no early suspend: enter the firmware's screen-off mode (packet
+ * filter, ARP/NS offload, multi-DTIM) around system suspend instead, so only
+ * frames for us wake the AP and the link stays up while suspended.
+ */
+static struct GLUE_INFO *wlanPmGlueInfo(void)
+{
+	struct net_device *prDev;
+
+	if (u4WlanDevNum == 0 || u4WlanDevNum > CFG_MAX_WLAN_DEVICES)
+		return NULL;
+	prDev = arWlanDevInfo[u4WlanDevNum - 1].prDev;
+	if (!prDev)
+		return NULL;
+	return *((struct GLUE_INFO **) netdev_priv(prDev));
+}
+
+/*
+ * 802.11 power save and the driver's suspend mode (RX filter without
+ * all-multicast, multicast list) while the phone sleeps. The power save is
+ * the WOW one of wlanSuspendPmHandle(), which only the PCIe / USB / SDIO
+ * HIFs call: without it the radio listens all the time in suspend (deep
+ * suspend ~177 mA instead of ~88 mA). Switching either sends firmware
+ * commands whose interrupt comes a moment later and would wake (or abort)
+ * the suspend it was meant for, so both stay on across the short wakes of
+ * the AOD and go back off only after WOW_PS_HOLD_MS awake (the phone is in
+ * use: no power save latency, as cfg80211 set it). Switching the suspend
+ * mode on every suspend and resume aborted 3-5 suspends after each AOD
+ * minute update (~30 s awake per 10 min).
+ */
+#define WOW_PS_BSS_NONE		0xff
+#define WOW_PS_HOLD_MS		15000
+#define WOW_PS_SETTLE_MS	500
+static uint8_t ucWowPsBssIndex = WOW_PS_BSS_NONE;
+
+static void wlan_wow_ps_restore(struct work_struct *work)
+{
+	struct GLUE_INFO *prGlueInfo = wlanPmGlueInfo();
+
+	if (prGlueInfo && prGlueInfo->prAdapter && !kalIsHalted()) {
+		if (ucWowPsBssIndex != WOW_PS_BSS_NONE)
+			nicConfigPowerSaveProfileEntry(prGlueInfo->prAdapter,
+				ucWowPsBssIndex, Param_PowerModeCAM,
+				FALSE, PS_CALLER_WOW);
+		if (prGlueInfo->fgIsInSuspendMode) {
+			DBGLOG(INIT, INFO, "suspend mode 0\n");
+			prGlueInfo->fgIsInSuspendMode = FALSE;
+			wlanSetSuspendMode(prGlueInfo, FALSE);
+		}
+	}
+	ucWowPsBssIndex = WOW_PS_BSS_NONE;
+}
+
+static DECLARE_DELAYED_WORK(wlan_wow_ps_restore_work, wlan_wow_ps_restore);
+
+static int wlan_suspend_mode_pm_notifier(struct notifier_block *nb,
+					 unsigned long event, void *unused)
+{
+	struct GLUE_INFO *prGlueInfo = wlanPmGlueInfo();
+	u_int8_t fgSwitched = FALSE;
+
+	if (event != PM_SUSPEND_PREPARE && event != PM_POST_SUSPEND)
+		return NOTIFY_DONE;
+	if (!prGlueInfo || !prGlueInfo->prAdapter || kalIsHalted())
+		return NOTIFY_DONE;
+
+	if (event == PM_POST_SUSPEND) {
+		schedule_delayed_work(&wlan_wow_ps_restore_work,
+				      msecs_to_jiffies(WOW_PS_HOLD_MS));
+		return NOTIFY_DONE;
+	}
+
+	cancel_delayed_work_sync(&wlan_wow_ps_restore_work);
+	if (ucWowPsBssIndex == WOW_PS_BSS_NONE) {
+		struct BSS_INFO *prAisBssInfo =
+			aisGetConnectedBssInfo(prGlueInfo->prAdapter);
+
+		if (prAisBssInfo) {
+			ucWowPsBssIndex = prAisBssInfo->ucBssIndex;
+			nicConfigPowerSaveProfileEntry(prGlueInfo->prAdapter,
+				ucWowPsBssIndex, Param_PowerModeFast_PSP,
+				FALSE, PS_CALLER_WOW);
+			fgSwitched = TRUE;
+		}
+	}
+	if (!prGlueInfo->fgIsInSuspendMode) {
+		DBGLOG(INIT, INFO, "suspend mode 1\n");
+		prGlueInfo->fgIsInSuspendMode = TRUE;
+		/* waits for the command queue: the firmware has the PS change too */
+		wlanSetSuspendMode(prGlueInfo, TRUE);
+		fgSwitched = TRUE;
+	}
+	if (fgSwitched)
+		msleep(WOW_PS_SETTLE_MS);	/* take its interrupt awake */
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block wlan_suspend_mode_pm_nb = {
+	.notifier_call = wlan_suspend_mode_pm_notifier,
+};
