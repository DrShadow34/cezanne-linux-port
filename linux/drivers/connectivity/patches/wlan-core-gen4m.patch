+/*
+ * Station mode: the connected AP is the only station. NetworkManager reads
+ * the link signal with a station dump; without one the strength it shows
+ * only changes with scan results (stale for as long as nothing scans).
+ */
+static int mtk_cfg7_dump_station(struct wiphy *wiphy,
+	struct wireless_dev *wdev, int idx, u8 *mac,
+	struct station_info *sinfo)
+{
+	struct GLUE_INFO *prGlueInfo = NULL;
+	struct net_device *ndev = wdev->netdev;
+	uint32_t u4BufLen = 0;
+	uint8_t ucBssIndex;
+
+	if (idx != 0 || !ndev)
+		return -ENOENT;
+
+	WIPHY_PRIV(wiphy, prGlueInfo);
+	if (!wlanIsDriverReady(prGlueInfo, WLAN_DRV_READY_CHECK_WLAN_ON |
+		WLAN_DRV_READY_CHECK_HIF_SUSPEND))
+		return -ENOENT;
+#if CFG_ENABLE_WIFI_DIRECT && CFG_ENABLE_WIFI_DIRECT_CFG_80211
+	if (mtk_IsP2PNetDevice(prGlueInfo, ndev) > 0)
+		return -ENOENT;
+#endif
+
+	ucBssIndex = wlanGetBssIdx(ndev);
+	if (!IS_BSS_INDEX_AIS(prGlueInfo->prAdapter, ucBssIndex))
+		return -ENOENT;
+	if (kalGetMediaStateIndicated(prGlueInfo, ucBssIndex) !=
+	    MEDIA_STATE_CONNECTED)
+		return -ENOENT;
+	if (kalIoctlByBssIdx(prGlueInfo, wlanoidQueryBssid, mac, MAC_ADDR_LEN,
+			     &u4BufLen, ucBssIndex) != WLAN_STATUS_SUCCESS ||
+	    u4BufLen != MAC_ADDR_LEN || is_zero_ether_addr(mac))
+		return -ENOENT;
+
+	return mtk_cfg_get_station(wiphy, ndev, mac, sinfo);
+}
