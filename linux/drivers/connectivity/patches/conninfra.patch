@@ -370,6 +370,36 @@ static void conn_adaptor_dev_pwr_on_off_handler(struct work_struct *work)
 	}
 }
 
+/*
+ * mainline port: there is no MTK display notifier, so screen state (which
+ * starts the RF pre-calibration on the first unblank) comes from userspace:
+ * echo 1 > /sys/module/conninfra/parameters/screen_on
+ */
+static int conn_adaptor_screen_on_set(const char *val,
+				      const struct kernel_param *kp)
+{
+	bool on;
+	int ret = kstrtobool(val, &on);
+
+	if (ret)
+		return ret;
+	atomic_set(&g_es_lr_flag_for_blank, on);
+	pr_info("Conninfra screen %s (userspace)\n", on ? "on" : "off");
+	schedule_work(&g_pwr_on_off_work);
+	return 0;
+}
+
+static int conn_adaptor_screen_on_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%d\n", atomic_read(&g_es_lr_flag_for_blank));
+}
+
+static const struct kernel_param_ops conn_adaptor_screen_on_ops = {
+	.set = conn_adaptor_screen_on_set,
+	.get = conn_adaptor_screen_on_get,
+};
+module_param_cb(screen_on, &conn_adaptor_screen_on_ops, NULL, 0644);
+
 static int mtk_conn_adaptor_suspend(void)
 {
 	int ret = 0;
