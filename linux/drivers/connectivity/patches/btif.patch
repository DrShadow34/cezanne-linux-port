+# MediaTek BTIF (AP <-> CONNSYS BT serial link) from the 4.14 BSP, built out of tree
+KO_PATH := $(M)
+ccflags-y += -I$(KO_PATH)/common/inc -I$(KO_PATH)/common/plat_inc
+ccflags-y += -include $(KO_PATH)/../compat/include/compat_mainline.h -I$(KO_PATH)/../compat/include
+ccflags-y += -D BTIF_DBG_SUPPORT=0
