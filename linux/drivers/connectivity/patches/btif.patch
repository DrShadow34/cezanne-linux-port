diff --git a/compat_btif.h b/compat_btif.h
new file mode 100644
index 0000000..dce5838
--- /dev/null
+++ b/compat_btif.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* 4.14 -> mainline shims for the MediaTek BTIF driver (force-included) */
+#ifndef COMPAT_BTIF_H
+#define COMPAT_BTIF_H
+#include <linux/time64.h>
+#include <linux/timekeeping.h>
+#include <linux/dma-mapping.h>
+
+/* timestamps are only used for debug logs */
+struct timeval {
+	long tv_sec;
+	long tv_usec;
+};
+static inline void do_gettimeofday(struct timeval *tv)
+{
+	struct timespec64 ts;
+
+	ktime_get_real_ts64(&ts);
+	tv->tv_sec = ts.tv_sec;
+	tv->tv_usec = ts.tv_nsec / NSEC_PER_USEC;
+}
+#define timespec timespec64
+#define ktime_to_timespec ktime_to_timespec64
+
+#define dma_zalloc_coherent dma_alloc_coherent
+/* RX vFIFO is dma_alloc_coherent memory: no cache maintenance needed */
+#define __dma_unmap_area(p, len, dir) do { } while (0)
+/* TX copies into the coherent vFIFO; the flushed source buffer is never DMA-read */
+#define __dma_flush_area(p, len) do { } while (0)
+#endif
