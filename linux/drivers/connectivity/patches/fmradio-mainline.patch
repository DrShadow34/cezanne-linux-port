diff --git a/Kbuild b/Kbuild
new file mode 100644
index 0000000..68cd01f
--- /dev/null
+++ b/Kbuild
@@ -0,0 +1,18 @@
+# FM radio of the MT6635 (CONNAC2 connsys of the MT6885) as an out-of-tree
+# module for the mainline kernel, on top of our conninfra port.
+# Build: src/connectivity/build2.sh fmradio (CONNINFRA_SRC set there).
+MODULE_NAME := fmradio_drv
+obj-m += $(MODULE_NAME).o
+
+ccflags-y += -I$(src)/inc -I$(src)/plat/inc -I$(src)/chips/mt6635/inc
+ccflags-y += -I$(CONNINFRA_SRC)/include
+ccflags-y += -DMT6635_FM -DCFG_FM_CONNAC2=1
+ccflags-y += -DCONFIG_MTK_WCN_ARM64 -DWMT_IDC_SUPPORT=0
+ccflags-y += -DMTK_WCN_WMT_STP_EXP_SYMBOL_ABSTRACT
+
+$(MODULE_NAME)-objs := core/fm_module.o core/fm_main.o core/fm_config.o \
+	core/fm_rds_parser.o core/fm_patch.o core/fm_utils.o core/fm_link.o \
+	core/fm_eint.o core/fm_cmd.o core/fm_reg_utils.o \
+	chips/mt6635/pub/mt6635_fm_rds.o chips/mt6635/pub/mt6635_2_fm_lib.o \
+	plat/conn_infra.o
+ccflags-y += -Wno-missing-prototypes
diff --git a/core/fm_main.c b/core/fm_main.c
index e1c5da7..3dd7f2e 100644
--- a/core/fm_main.c
+++ b/core/fm_main.c
@@ -21,6 +21,7 @@
 #include "fm_reg_utils.h"
 /* #include "fm_cust_cfg.h" */
 #include "fm_cmd.h"
+#include <linux/pm_wakeup.h>
 #include "fm_reg_utils.h"
 
 /* fm main data structure */
@@ -160,10 +161,22 @@ enum fm_pwr_state fm_pwr_state_get(struct fm *fmp)
 	return FM_PWR_MAX;
 }
 
+/*
+ * Held while the receiver / transmitter is powered: radio keeps playing when
+ * the system would suspend (as the Android FM app's wakelock did).
+ */
+static struct wakeup_source *fm_ws;
+
 enum fm_pwr_state fm_pwr_state_set(struct fm *fmp, enum fm_pwr_state sta)
 {
 	if (fmp && (sta < FM_PWR_MAX)) {
 		fmp->pwr_sta = sta;
+		if (fm_ws) {
+			if (sta == FM_PWR_OFF)
+				__pm_relax(fm_ws);
+			else
+				__pm_stay_awake(fm_ws);
+		}
 		WCN_DBG(FM_DBG | MAIN, "pwr state set to %d\n", sta);
 		return fmp->pwr_sta;
 	}
@@ -419,6 +432,10 @@ signed int fm_powerup(struct fm *fm, struct fm_tune_parm *parm)
 	if (FM_LOCK(fm_ops_lock))
 		return -FM_ELOCK;
 
+	/* no suspend in the middle of the power-up (released below if it fails) */
+	if (fm_ws)
+		__pm_stay_awake(fm_ws);
+
 	/* for normal case */
 	if (fm_low_ops.bi.pwron == NULL) {
 		WCN_DBG(FM_NTC | MAIN, "get fm_low_ops fail\n");
@@ -479,6 +496,8 @@ signed int fm_powerup(struct fm *fm, struct fm_tune_parm *parm)
 	}
 
 out:
+	if (fm_ws && fm_pwr_state_get(fm) == FM_PWR_OFF)
+		__pm_relax(fm_ws);
 	FM_UNLOCK(fm_ops_lock);
 	return ret;
 }
@@ -2355,30 +2374,26 @@ static signed int fm_ops_unregister(struct fm_lowlevel_ops *ops)
 {
 	signed int ret = 0;
 
-	if (fm_wcn_ops.ei.rds_ops_unregister)
-		ret = fm_wcn_ops.ei.rds_ops_unregister(&ops->ri);
-	else
+	/* each step even if one fails: IRQ and callbacks must not outlive the module */
+	if (!fm_wcn_ops.ei.rds_ops_unregister ||
+	    fm_wcn_ops.ei.rds_ops_unregister(&ops->ri)) {
+		WCN_DBG(FM_ERR | MAIN, "fm_rds_ops_unregister fail\n");
 		ret = -1;
-	if (ret) {
-		WCN_DBG(FM_ERR | MAIN, "fm_rds_ops_unregister fail(%d)\n", ret);
-		return ret;
 	}
 
-	if (fm_wcn_ops.ei.low_ops_unregister)
-		ret = fm_wcn_ops.ei.low_ops_unregister(&ops->bi);
-	else
+	if (!fm_wcn_ops.ei.low_ops_unregister ||
+	    fm_wcn_ops.ei.low_ops_unregister(&ops->bi)) {
+		WCN_DBG(FM_ERR | MAIN, "fm_low_ops_unregister fail\n");
 		ret = -1;
-	if (ret) {
-		WCN_DBG(FM_ERR | MAIN, "fm_low_ops_unregister fail(%d)\n", ret);
-		return ret;
 	}
 
-	ret = fm_callback_unregister(&ops->cb);
-	if (ret) {
-		WCN_DBG(FM_ERR | MAIN, "fm_callback_unregister fail(%d)\n", ret);
-		return ret;
+	if (fm_callback_unregister(&ops->cb)) {
+		WCN_DBG(FM_ERR | MAIN, "fm_callback_unregister fail\n");
+		ret = -1;
 	}
 
+	/* IRQ, register windows, conninfra callbacks: the BSP never unloaded */
+	fm_wcn_ops_unregister();
 	return ret;
 }
 
@@ -2716,6 +2731,8 @@ signed int fm_env_setup(void)
 
 	WCN_DBG(FM_NTC | MAIN, "%s\n", __func__);
 
+	fm_ws = wakeup_source_register(NULL, "fmradio");
+
 	ret = fm_ops_register(&fm_low_ops);
 	if (ret)
 		return ret;
@@ -2798,6 +2815,9 @@ signed int fm_env_destroy(void)
 
 	WCN_DBG(FM_NTC | MAIN, "%s\n", __func__);
 
+	wakeup_source_unregister(fm_ws);
+	fm_ws = NULL;
+
 	fm_link_release();
 
 	ret = fm_ops_unregister(&fm_low_ops);
diff --git a/core/fm_module.c b/core/fm_module.c
index 3064fa4..3c6769f 100644
--- a/core/fm_module.c
+++ b/core/fm_module.c
@@ -75,10 +75,9 @@ static const struct file_operations fm_ops = {
 static ssize_t fm_proc_read(struct file *file, char __user *buf, size_t count, loff_t *ppos);
 static ssize_t fm_proc_write(struct file *file, const char *buffer, size_t count, loff_t *ppos);
 
-static const struct file_operations fm_proc_ops = {
-	.owner = THIS_MODULE,
-	.read = fm_proc_read,
-	.write = fm_proc_write,
+static const struct proc_ops fm_proc_ops = {
+	.proc_read = fm_proc_read,
+	.proc_write = fm_proc_write,
 };
 
 #ifdef CONFIG_COMPAT
@@ -1423,7 +1422,7 @@ static signed int fm_cdev_setup(struct fm *fm)
 		return ret;
 	}
 #ifndef FM_DEV_STATIC_ALLOC
-	plat->cls = class_create(THIS_MODULE, FM_NAME);
+	plat->cls = class_create(FM_NAME);
 
 	if (IS_ERR(plat->cls)) {
 		ret = PTR_ERR(plat->cls);
@@ -1583,13 +1582,12 @@ static signed int mt_fm_probe(struct platform_device *pdev)
 	return ret;
 }
 
-static signed int mt_fm_remove(struct platform_device *pdev)
+static void mt_fm_remove(struct platform_device *pdev)
 {
 	WCN_DBG(FM_NTC | MAIN, "%s\n", __func__);
 
 	fm_mod_destroy(g_fm);
 	g_fm = NULL;
-	return 0;
 }
 
 static struct platform_device *pr_fm_device;
@@ -1600,6 +1598,24 @@ static struct platform_device mt_fm_device = {
 };
 */
 
+/*
+ * No system suspend while the receiver is powered: suspending CONNSYS with FM
+ * on reset the SoC (2026-11-01). A player keeps the phone awake with a sleep
+ * inhibitor (the AOD honours it); this only makes any other suspend fail.
+ */
+static int mt_fm_pm_prepare(struct device *dev)
+{
+	if (g_fm && fm_pwr_state_get(g_fm) != FM_PWR_OFF) {
+		WCN_DBG(FM_ALT | MAIN, "FM is on, refusing suspend\n");
+		return -EBUSY;
+	}
+	return 0;
+}
+
+static const struct dev_pm_ops mt_fm_pm_ops = {
+	.prepare = mt_fm_pm_prepare,
+};
+
 /* platform driver entry */
 static struct platform_driver mt_fm_dev_drv = {
 	.probe = mt_fm_probe,
@@ -1607,6 +1623,7 @@ static struct platform_driver mt_fm_dev_drv = {
 	.driver = {
 		   .name = FM_NAME,
 		   .owner = THIS_MODULE,
+		   .pm = &mt_fm_pm_ops,
 		   }
 };
 
diff --git a/core/fm_reg_utils.c b/core/fm_reg_utils.c
index abf65ad..a3b6e67 100644
--- a/core/fm_reg_utils.c
+++ b/core/fm_reg_utils.c
@@ -31,7 +31,7 @@ int fm_ioremap_read(phys_addr_t addr, unsigned int *val)
 	void *vir_addr = NULL;
 
 	request_mem_region(addr, size, "FM_TEMP_READ");
-	vir_addr = ioremap_nocache(addr, size);
+	vir_addr = ioremap(addr, size);
 	if (!vir_addr) {
 		WCN_DBG(FM_ERR | CHIP, "Cannot remap address.\n");
 		return -1;
@@ -53,7 +53,7 @@ int fm_ioremap_write(phys_addr_t addr, unsigned int val)
 	void *vir_addr = NULL;
 
 	request_mem_region(addr, size, "FM_TEMP_WRITE");
-	vir_addr = ioremap_nocache(addr, size);
+	vir_addr = ioremap(addr, size);
 	if (!vir_addr) {
 		WCN_DBG(FM_ERR | CHIP, "Cannot remap address.\n");
 		return -1;
diff --git a/core/fm_utils.c b/core/fm_utils.c
index 3de38f1..3e764c1 100644
--- a/core/fm_utils.c
+++ b/core/fm_utils.c
@@ -447,7 +447,7 @@ static signed int fm_timer_stop(struct fm_timer *thiz)
 	struct timer_list *timerlist = (struct timer_list *)thiz->priv;
 
 	thiz->flag &= ~FM_TIMER_FLAG_ACTIVATED;
-	del_timer(timerlist);
+	timer_delete(timerlist);
 
 	return 0;
 }
diff --git a/inc/fm_main.h b/inc/fm_main.h
index 4e72693..556d193 100644
--- a/inc/fm_main.h
+++ b/inc/fm_main.h
@@ -219,17 +219,23 @@ struct fm_tx_scan_parm {
 	unsigned short ScanTBLSize;	/* IN: desired size, OUT: scan result size */
 };
 
+/* struct timeval's layout (gone from the kernel), the ioctl ABI keeps it */
+struct fm_timeval {
+	long tv_sec;
+	long tv_usec;
+};
+
 struct fm_gps_rtc_info {
 	signed int err;		/* error number, 0: success, other: err code */
 	signed int retryCnt;	/* GPS mnl can decide retry times */
 	signed int ageThd;		/* GPS 3D fix time diff threshold */
 	signed int driftThd;	/* GPS RTC drift threshold */
-	struct timeval tvThd;	/* time value diff threshold */
+	struct fm_timeval tvThd;	/* time value diff threshold */
 	signed int age;		/* GPS 3D fix time diff */
 	signed int drift;		/* GPS RTC drift */
 	union {
 		unsigned long stamp;	/* time stamp in jiffies */
-		struct timeval tv;	/* time stamp value in RTC */
+		struct fm_timeval tv;	/* time stamp value in RTC */
 	};
 	signed int flag;		/* rw flag */
 };
diff --git a/plat/conn_infra.c b/plat/conn_infra.c
index 9850f02..ba84335 100644
--- a/plat/conn_infra.c
+++ b/plat/conn_infra.c
@@ -1116,7 +1116,7 @@ static int drv_interface_init(void)
 	info->spi_phy_addr = TOP_RF_SPI_AON_ADDR;
 	info->spi_size = TOP_RF_SPI_AON_SIZE;
 	request_mem_region(info->spi_phy_addr, info->spi_size, "FM_SPI");
-	info->spi_vir_addr = ioremap_nocache(
+	info->spi_vir_addr = ioremap(
 		info->spi_phy_addr, info->spi_size);
 	if (info->spi_vir_addr == NULL) {
 		WCN_DBG(FM_ERR | CHIP, "Cannot remap address.\n");
@@ -1126,7 +1126,7 @@ static int drv_interface_init(void)
 	info->top_phy_addr = TOP_MISC_OFF_ADDR;
 	info->top_size = TOP_MISC_OFF_SIZE;
 	request_mem_region(info->top_phy_addr, info->top_size, "FM_TOP");
-	info->top_vir_addr = ioremap_nocache(
+	info->top_vir_addr = ioremap(
 		info->top_phy_addr, info->top_size);
 	if (info->top_vir_addr == NULL) {
 		WCN_DBG(FM_ERR | CHIP, "Cannot remap address.\n");
@@ -1136,7 +1136,7 @@ static int drv_interface_init(void)
 	info->mcu_phy_addr = MCU_CFG_ADDR;
 	info->mcu_size = MCU_CFG_SIZE;
 	request_mem_region(info->mcu_phy_addr, info->mcu_size, "FM_MCU");
-	info->mcu_vir_addr = ioremap_nocache(
+	info->mcu_vir_addr = ioremap(
 		info->mcu_phy_addr, info->mcu_size);
 	if (info->mcu_vir_addr == NULL) {
 		WCN_DBG(FM_ERR | CHIP, "Cannot remap address.\n");
@@ -1477,7 +1477,7 @@ static void register_drv_ops_init(void)
 	ei->spi_hopping = NULL;
 #endif
 	ei->low_ops_register = mt6635_fm_low_ops_register;
-	ei->rds_ops_unregister = mt6635_fm_rds_ops_unregister;
+	ei->low_ops_unregister = mt6635_fm_low_ops_unregister;
 	ei->rds_ops_register = mt6635_fm_rds_ops_register;
 	ei->rds_ops_unregister = mt6635_fm_rds_ops_unregister;
 }
@@ -1486,8 +1486,9 @@ static void register_drv_ops_uninit(void)
 {
 	struct fm_ext_interface *ei = &fm_wcn_ops.ei;
 
-	if (ei->irq_id)
+	if (ei->irq_id && ei->drv)
 		free_irq(ei->irq_id, ei->drv);
+	conninfra_sub_drv_ops_unregister(CONNDRV_TYPE_FM);
 	drv_interface_uninit();
 	fm_memset(&fm_wcn_ops, 0, sizeof(struct fm_wcn_reg_ops));
 }
