 Kbuild              | 18 ++++++++++++++++
 core/fm_main.c      | 52 +++++++++++++++++++++++++++++++--------------
 core/fm_module.c    | 31 +++++++++++++++++++++------
 core/fm_reg_utils.c |  4 ++--
 core/fm_utils.c     |  2 +-
 inc/fm_main.h       | 10 +++++++--
 plat/conn_infra.c   | 11 +++++-----
