diff --git a/drivers/soc/mediatek/mt6885-cpuhp.c b/drivers/soc/mediatek/mt6885-cpuhp.c
new file mode 100644
index 000000000..2da3e5b3d
--- /dev/null
+++ b/drivers/soc/mediatek/mt6885-cpuhp.c
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6885 CPU hotplug: after PSCI CPU_OFF, MediaTek's ATF still needs the
+ * boot side to power the core down through a SIP call, otherwise the next
+ * CPU_ON of that core never completes. From the 4.14 BSP's
+ * base/power/cpuhotplug (cpuhp_platform_cpuoff()); its cluster power-down
+ * call (0xc2000210) is not implemented by this ATF.
+ */
+#include <linux/arm-smccc.h>
+#include <linux/cpu.h>
+#include <linux/cpuhotplug.h>
+#include <linux/init.h>
+#include <linux/of.h>
+
+#define MTK_SIP_POWER_DOWN_CORE		0xc2000212
+
+static int mt6885_cpuhp_dead(unsigned int cpu)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MTK_SIP_POWER_DOWN_CORE, cpu, 0, 0, 0, 0, 0, 0, &res);
+	return 0;
+}
+
+static int __init mt6885_cpuhp_init(void)
+{
+	int ret;
+
+	if (!of_machine_is_compatible("mediatek,mt6885"))
+		return 0;
+
+	ret = cpuhp_setup_state_nocalls(CPUHP_BP_PREPARE_DYN, "soc/mt6885:dead",
+					NULL, mt6885_cpuhp_dead);
+	return ret < 0 ? ret : 0;
+}
+early_initcall(mt6885_cpuhp_init);
