+/* cpuhvfs_update_volt(): new Vproc in the OPP's entry, then the cluster's EEM flag */
+static void mcupm_update_volt(struct mcupm_cpufreq *m, int c, int i, unsigned long uV)
+{
+	u32 __iomem *tbl = m->csram + OFFS_TBL_S;
+	const u16 *e = mt6885_lv2_pvt[c * NR_FREQ + i];
+	/* never above the signoff table */
+	u16 code = clamp_t(u16, DIV_ROUND_UP(uV, VPROC_STEP_UV), VPROC_MIN, e[1]);
+
+	if (code == m->vproc[c][i])
+		return;
+	m->vproc[c][i] = code;
+	writel((code & 0xfff) << 16 | e[0], &tbl[c * 36 + i]);
+	writel(1, m->csram + OFFS_EEM_S + 4 * c);
+}
+
+/*
+ * SVS init01 reads the buck right after pinning an OPP: wait until MCUPM has
+ * ramped it (it reports the new OPP index before the voltage settles).
+ */
+static void mcupm_wait_vproc(struct mcupm_cpufreq *m, int r, int uV)
+{
+	int v;
+
+	if (read_poll_timeout(regulator_get_voltage, v, v == uV, 100, 50000, false,
+			      m->proc[r]))
+		dev_warn(m->dev, "Vproc %d: %d uV, not %d uV\n", r, v, uV);
+}
+
+/* OPPs were enabled or disabled: move the cluster to an allowed OPP */
+static void mcupm_restrict(struct mcupm_cpufreq *m, int c)
+{
+	u32 en = ~m->disabled[c] & GENMASK(NR_FREQ - 1, 0), idx, cur;
+	bool pinned = hweight32(en) == 1;
+
+	if (c == CLUSTER_CCI) {
+		/*
+		 * MCUPM moves the CCI with the clusters (CCI map); while OPPs
+		 * are disabled, clamp the CCI voltage to the fastest one left
+		 * (mt_cpufreq_ctrl_cci_volt(), 10 uV units). The CCI shares
+		 * the LL buck and is pinned last.
+		 */
+		writel(m->disabled[c] && en ? m->vproc[c][__ffs(en)] * 625 : 0,
+		       m->csram + OFFS_CCI_VOLT_CLAMP);
+		if (pinned)
+			mcupm_wait_vproc(m, 0, m->vproc[c][__ffs(en)] * VPROC_STEP_UV);
+		return;
+	}
+
+	idx = mcupm_set_opp(m, c, m->req[c]);
+	if (!pinned)
+		return;
+	if (readl_poll_timeout(m->csram + OFFS_CUR_FREQ_S + 4 * c, cur, cur == idx,
+			       100, 100000))
+		dev_warn(m->dev, "cluster %d: OPP %u not reached (at %u)\n", c, idx, cur);
+	else if (c == 1)
+		mcupm_wait_vproc(m, 1, m->vproc[c][idx] * VPROC_STEP_UV);
+}
+
+static int mcupm_opp_notify(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct mcupm_opp_dev *od = container_of(nb, struct mcupm_opp_dev, nb);
+	struct mcupm_cpufreq *m = od->m;
+	unsigned long mhz = dev_pm_opp_get_freq(data) / 1000000;
+	unsigned long flags;
+	int c = od->c, i;
+
+	for (i = 0; i < NR_FREQ; i++)
+		if (mt6885_lv2_pvt[c * NR_FREQ + i][0] == mhz)
+			break;
+	if (i == NR_FREQ)
+		return NOTIFY_DONE;
+
+	switch (event) {
+	case OPP_EVENT_ADJUST_VOLTAGE:
+		mcupm_update_volt(m, c, i, dev_pm_opp_get_voltage(data));
+		break;
+	case OPP_EVENT_ENABLE:
+	case OPP_EVENT_DISABLE:
+		spin_lock_irqsave(&m->lock, flags);
+		if (event == OPP_EVENT_DISABLE)
+			m->disabled[c] |= BIT(i);
+		else
+			m->disabled[c] &= ~BIT(i);
+		spin_unlock_irqrestore(&m->lock, flags);
+		mcupm_restrict(m, c);
+		break;
+	default:
+		return NOTIFY_DONE;
+	}
+	return NOTIFY_OK;
+}
+
+static int mcupm_add_opps(struct mcupm_cpufreq *m, struct device *dev, int c)
+{
+	struct mcupm_opp_dev *od = &m->opp[c];
+	int i, ret;
+
+	for (i = 0; i < NR_FREQ; i++) {
+		const u16 *e = mt6885_lv2_pvt[c * NR_FREQ + i];
+
+		ret = dev_pm_opp_add(dev, e[0] * 1000000UL, e[1] * VPROC_STEP_UV);
+		if (ret)
+			goto err;
+	}
+
+	od->m = m;
+	od->dev = dev;
+	od->c = c;
+	od->nb.notifier_call = mcupm_opp_notify;
+	ret = dev_pm_opp_register_notifier(dev, &od->nb);
+	if (ret)
+		goto err;
+	return 0;
+
+err:
+	dev_pm_opp_remove_all_dynamic(dev);
+	return ret;
+}
+
+static void mcupm_remove_opps(struct mcupm_cpufreq *m, int c)
+{
+	struct mcupm_opp_dev *od = &m->opp[c];
+
+	if (!od->dev)
+		return;
+	dev_pm_opp_unregister_notifier(od->dev, &od->nb);
+	dev_pm_opp_remove_all_dynamic(od->dev);
+	od->dev = NULL;
+}
+
+static int mcupm_add_cpu_opps(struct mcupm_cpufreq *m, int c)
+{
+	struct device *cpu_dev = get_cpu_device(c ? 4 : 0);
+	struct cpumask cpus;
+	int cpu, ret;
+
+	ret = mcupm_add_opps(m, cpu_dev, c);
+	if (ret)
+		return ret;
+
+	cpumask_clear(&cpus);
+	for_each_possible_cpu(cpu)
+		if (mcupm_cpu_cluster(cpu) == c)
+			cpumask_set_cpu(cpu, &cpus);
+	return dev_pm_opp_set_sharing_cpus(cpu_dev, &cpus);
+}
