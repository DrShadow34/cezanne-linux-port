-static int mcupm_cpufreq_target_index(struct cpufreq_policy *policy, unsigned int index)
+/* the nearest OPP to idx that is enabled in the OPP table, slower ones first */
+static u32 mcupm_allowed_opp(struct mcupm_cpufreq *m, int c, u32 idx)
+{
+	u32 en = ~m->disabled[c] & GENMASK(NR_FREQ - 1, 0);
+	u32 d;
