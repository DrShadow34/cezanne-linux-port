diff --git a/drivers/usb/mtu3/mtu3_gadget_ep0.c b/drivers/usb/mtu3/mtu3_gadget_ep0.c
index e4fd1bb14..f89d0b20c 100644
--- a/drivers/usb/mtu3/mtu3_gadget_ep0.c
+++ b/drivers/usb/mtu3/mtu3_gadget_ep0.c
@@ -511,6 +511,7 @@ static void ep0_rx_state(struct mtu3 *mtu)
 	struct mtu3_request *mreq;
 	struct usb_request *req;
 	void __iomem *mbase = mtu->mac_base;
+	unsigned int len;
 	u32 maxp;
 	u32 csr;
 	u16 count = 0;
@@ -521,34 +522,38 @@ static void ep0_rx_state(struct mtu3 *mtu)
 	mreq = next_ep0_request(mtu);
 	req = &mreq->request;
 
-	/* read packet and ack; or stall because of gadget driver bug */
-	if (req) {
-		void *buf = req->buf + req->actual;
-		unsigned int len = req->length - req->actual;
+	/*
+	 * Without a request yet, leave the packet in the FIFO: RXPKTRDY stays
+	 * set, so the controller NAKs, and ep0_queue() reads it once the
+	 * gadget driver queues one. Drivers may do that after their setup()
+	 * returned: f_uvc's comes from user space (UVCIOC_SEND_RESPONSE), and
+	 * stalling here failed every UVC SET_CUR.
+	 */
+	if (!req) {
+		dev_dbg(mtu->dev, "%s: no request yet, NAK\n", __func__);
+		return;
+	}
 
-		/* read the buffer */
-		count = mtu3_readl(mbase, U3D_RXCOUNT0);
-		if (count > len) {
-			req->status = -EOVERFLOW;
-			count = len;
-		}
-		ep0_read_fifo(mtu->ep0, buf, count);
-		req->actual += count;
-		csr |= EP0_RXPKTRDY;
+	/* read packet and ack */
+	len = req->length - req->actual;
+	count = mtu3_readl(mbase, U3D_RXCOUNT0);
+	if (count > len) {
+		req->status = -EOVERFLOW;
+		count = len;
+	}
+	ep0_read_fifo(mtu->ep0, req->buf + req->actual, count);
+	req->actual += count;
+	csr |= EP0_RXPKTRDY;
 
-		maxp = mtu->g.ep0->maxpacket;
-		if (count < maxp || req->actual == req->length) {
-			mtu->ep0_state = MU3D_EP0_STATE_SETUP;
-			dev_dbg(mtu->dev, "ep0 state: %s\n",
-				decode_ep0_state(mtu));
+	maxp = mtu->g.ep0->maxpacket;
+	if (count < maxp || req->actual == req->length) {
+		mtu->ep0_state = MU3D_EP0_STATE_SETUP;
+		dev_dbg(mtu->dev, "ep0 state: %s\n",
+			decode_ep0_state(mtu));
 
-			csr |= EP0_DATAEND;
-		} else {
-			req = NULL;
-		}
+		csr |= EP0_DATAEND;
 	} else {
-		csr |= EP0_RXPKTRDY | EP0_SENDSTALL;
-		dev_dbg(mtu->dev, "%s: SENDSTALL\n", __func__);
+		req = NULL;
 	}
 
 	mtu3_writel(mbase, U3D_EP0CSR, csr);
@@ -829,6 +834,10 @@ static int ep0_queue(struct mtu3_ep *mep, struct mtu3_request *mreq)
 	/* sequence #1, IN ... start writing the data */
 	if (mtu->ep0_state == MU3D_EP0_STATE_TX)
 		ep0_tx_state(mtu);
+	/* control-OUT data that arrived before the request: read it now */
+	else if (mtu->ep0_state == MU3D_EP0_STATE_RX &&
+		 (mtu3_readl(mtu->mac_base, U3D_EP0CSR) & EP0_RXPKTRDY))
+		ep0_rx_state(mtu);
 
 	return 0;
 }
