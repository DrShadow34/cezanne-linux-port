+/*
+ * First timestamp use of a client on a GPU whose timestamp stops with the
+ * cycle counter and resets with power (timestamp_hold): keep both on until
+ * the client closes.
+ */
+static int panfrost_timestamp_hold(struct panfrost_device *pfdev,
+				   struct panfrost_file_priv *priv)
+{
+	int ret = 0;
+
+	if (!pfdev->comp->timestamp_hold || READ_ONCE(priv->timestamp_hold))
+		return 0;
+
+	mutex_lock(&pfdev->timestamp_hold.lock);
+	if (priv->timestamp_hold)
+		goto out;
+
+	ret = pm_runtime_resume_and_get(pfdev->base.dev);
+	if (ret)
+		goto out;
+
+	pfdev->timestamp_hold.users++;
+	panfrost_cycle_counter_get(pfdev);
+	WRITE_ONCE(priv->timestamp_hold, true);
+	dev_info(pfdev->base.dev, "timestamp hold by %s[%d], %u users\n",
+		 current->comm, task_pid_nr(current), pfdev->timestamp_hold.users);
+out:
+	mutex_unlock(&pfdev->timestamp_hold.lock);
+	return ret;
+}
+
+static void panfrost_timestamp_release(struct panfrost_device *pfdev,
+				       struct panfrost_file_priv *priv)
+{
+	if (!priv->timestamp_hold)
+		return;
+
+	mutex_lock(&pfdev->timestamp_hold.lock);
+	panfrost_cycle_counter_put(pfdev);
+	pfdev->timestamp_hold.users--;
+	mutex_unlock(&pfdev->timestamp_hold.lock);
+	pm_runtime_put_autosuspend(pfdev->base.dev);
+}
