+/*
+ * MT6885: the system timer only reaches GPU_TIMESTAMP when MFG_TIMESTAMP
+ * (mfgcfg + 0x130) bit 0 is set, otherwise it reads 0; the BSP sets it on
+ * every GPU power-on (mt_gpufreq_set_timestamp()).
+ */
+#define MT6885_MFG_TIMESTAMP	0x130
+
+static void panfrost_gpu_mt6885_quirk(struct panfrost_device *pfdev)
+{
+	static void __iomem *mfgcfg;
+
+	if (!mfgcfg) {
+		struct device_node *np =
+			of_find_compatible_node(NULL, NULL, "mediatek,mt6885-mfgcfg");
+
+		mfgcfg = np ? of_iomap(np, 0) : NULL;
+		of_node_put(np);
+		if (!mfgcfg) {
+			dev_warn_once(pfdev->base.dev, "no mfgcfg, GPU timestamps stay 0\n");
+			return;
+		}
+	}
+	writel(BIT(0), mfgcfg + MT6885_MFG_TIMESTAMP);
+}
