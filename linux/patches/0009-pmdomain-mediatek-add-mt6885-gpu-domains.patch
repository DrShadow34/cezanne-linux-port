+		.data = &mt6885_scpsys_data,
+	}, {
 		.compatible = "mediatek,mt8192-power-controller",
 		.data = &mt8192_scpsys_data,
 	},
diff --git a/include/dt-bindings/power/mt6885-power.h b/include/dt-bindings/power/mt6885-power.h
new file mode 100644
index 000000000..5bcb887bc
--- /dev/null
+++ b/include/dt-bindings/power/mt6885-power.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * MT6885 power domains (only the GPU ones are described so far).
+ */
+#ifndef _DT_BINDINGS_POWER_MT6885_POWER_H
+#define _DT_BINDINGS_POWER_MT6885_POWER_H
+
+#define MT6885_POWER_DOMAIN_MFG0	0	/* mfg_async */
+#define MT6885_POWER_DOMAIN_MFG1	1	/* mfg */
+#define MT6885_POWER_DOMAIN_MFG2	2	/* shader core 0 */
+#define MT6885_POWER_DOMAIN_MFG3	3	/* shader cores 1-2 */
+#define MT6885_POWER_DOMAIN_MFG4	4	/* shader cores 3-4 */
+#define MT6885_POWER_DOMAIN_MFG5	5	/* shader cores 5-6 */
+#define MT6885_POWER_DOMAIN_MFG6	6	/* shader cores 7-8 */
+#define MT6885_POWER_DOMAIN_AUDIO	7
+#define MT6885_POWER_DOMAIN_CONN	8
+
+#endif /* _DT_BINDINGS_POWER_MT6885_POWER_H */
