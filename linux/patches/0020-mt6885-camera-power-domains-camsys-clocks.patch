+#define MT6885_TOP_AXI_PROT_EN_1_CAM		BIT(22)
+#define MT6885_TOP_AXI_PROT_EN_MM_CAM_2ND	(BIT(1) | BIT(3) | BIT(5))
+#define MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWA	BIT(18)
+#define MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWA_2ND	BIT(19)
+#define MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWB	BIT(20)
+#define MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWB_2ND	BIT(21)
+#define MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWC	BIT(22)
+#define MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWC_2ND	BIT(23)
 
 static enum scpsys_bus_prot_block scpsys_bus_prot_blocks_mt6885[] = {
 	BUS_PROT_BLOCK_INFRA
@@ -178,6 +192,90 @@ static const struct scpsys_domain_data scpsys_domain_data_mt6885[] = {
 		/* stays on across system sleep while conninfra (a wakeup device) uses it */
 		.caps = MTK_SCPD_KEEP_DEFAULT_OFF | MTK_SCPD_ACTIVE_WAKEUP,
 	},
+	/*
+	 * Camera: BSP spm_mtcmos_ctrl_cam(). Its parent DIS (MM bus, SMI) is
+	 * kept on by lk for the display and not modelled here. Like CONN, the
+	 * BSP does not wait for the protection acks after release (they stay
+	 * up), so neither may we.
+	 */
+	[MT6885_POWER_DOMAIN_CAM] = {
+		.name = "cam",
+		.sta_mask = BIT(23),
+		.ctl_offs = 0x035c,
+		.pwr_sta_offs = 0x016c,
+		.pwr_sta2nd_offs = 0x0170,
+		.sram_pdn_bits = GENMASK(8, 8),
+		.sram_pdn_ack_bits = GENMASK(12, 12),
+		.bp_cfg = {
+			BUS_PROT_WR_IGN(INFRA, MT6885_TOP_AXI_PROT_EN_2_CAM,
+				    MT6885_TOP_AXI_PROT_EN_2_SET, MT6885_TOP_AXI_PROT_EN_2_CLR,
+				    MT6885_TOP_AXI_PROT_EN_2_STA1),
+			BUS_PROT_WR_IGN(INFRA, MT6885_TOP_AXI_PROT_EN_MM_CAM,
+				    MT6885_TOP_AXI_PROT_EN_MM_SET, MT6885_TOP_AXI_PROT_EN_MM_CLR,
+				    MT6885_TOP_AXI_PROT_EN_MM_STA1),
+			BUS_PROT_WR_IGN(INFRA, MT6885_TOP_AXI_PROT_EN_1_CAM,
+				    MT6885_TOP_AXI_PROT_EN_1_SET, MT6885_TOP_AXI_PROT_EN_1_CLR,
+				    MT6885_TOP_AXI_PROT_EN_1_STA1),
+			BUS_PROT_WR_IGN(INFRA, MT6885_TOP_AXI_PROT_EN_MM_CAM_2ND,
+				    MT6885_TOP_AXI_PROT_EN_MM_SET, MT6885_TOP_AXI_PROT_EN_MM_CLR,
+				    MT6885_TOP_AXI_PROT_EN_MM_STA1),
+		},
+		.caps = MTK_SCPD_KEEP_DEFAULT_OFF,
+	},
+	[MT6885_POWER_DOMAIN_CAM_RAWA] = {
+		.name = "cam_rawa",
+		.sta_mask = BIT(24),
+		.ctl_offs = 0x0360,
+		.pwr_sta_offs = 0x016c,
+		.pwr_sta2nd_offs = 0x0170,
+		.sram_pdn_bits = GENMASK(8, 8),
+		.sram_pdn_ack_bits = GENMASK(12, 12),
+		.bp_cfg = {
+			BUS_PROT_WR_IGN(INFRA, MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWA,
+				    MT6885_TOP_AXI_PROT_EN_MM_SET, MT6885_TOP_AXI_PROT_EN_MM_CLR,
+				    MT6885_TOP_AXI_PROT_EN_MM_STA1),
+			BUS_PROT_WR_IGN(INFRA, MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWA_2ND,
+				    MT6885_TOP_AXI_PROT_EN_MM_SET, MT6885_TOP_AXI_PROT_EN_MM_CLR,
+				    MT6885_TOP_AXI_PROT_EN_MM_STA1),
+		},
+		.caps = MTK_SCPD_KEEP_DEFAULT_OFF,
+	},
+	[MT6885_POWER_DOMAIN_CAM_RAWB] = {
+		.name = "cam_rawb",
+		.sta_mask = BIT(25),
+		.ctl_offs = 0x0364,
+		.pwr_sta_offs = 0x016c,
+		.pwr_sta2nd_offs = 0x0170,
+		.sram_pdn_bits = GENMASK(8, 8),
+		.sram_pdn_ack_bits = GENMASK(12, 12),
+		.bp_cfg = {
+			BUS_PROT_WR_IGN(INFRA, MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWB,
+				    MT6885_TOP_AXI_PROT_EN_MM_SET, MT6885_TOP_AXI_PROT_EN_MM_CLR,
+				    MT6885_TOP_AXI_PROT_EN_MM_STA1),
+			BUS_PROT_WR_IGN(INFRA, MT6885_TOP_AXI_PROT_EN_MM_CAM_RAWB_2ND,
+				    MT6885_TOP_AXI_PROT_EN_MM_SET, MT6885_TOP_AXI_PROT_EN_MM_CLR,
+				    MT6885_TOP_AXI_PROT_EN_MM_STA1),
+		},
+		.caps = MTK_SCPD_KEEP_DEFAULT_OFF,
+	},
+	[MT6885_POWER_DOMAIN_CAM_RAWC] = {
