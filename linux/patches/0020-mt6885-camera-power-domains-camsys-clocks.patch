diff --git a/drivers/clk/mediatek/clk-mt6885-cam.c b/drivers/clk/mediatek/clk-mt6885-cam.c
new file mode 100644
index 000000000..ff4a75c79
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6885-cam.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MT6885 camera subsystem clock gates (camsys + the three raw pipes).
+ * Same layout as MT8192 (clk-mt8192-cam.c) plus LARB15 and MRAW1; bits from
+ * the BSP clk-mt6885.c camsys_main_clks / camsys_raw*_clks.
+ */
+#include <linux/clk-provider.h>
+#include <linux/platform_device.h>
+
+#include "clk-mtk.h"
+#include "clk-gate.h"
+
+#include <dt-bindings/clock/mt6885-clk.h>
+
+static const struct mtk_gate_regs cam_cg_regs = {
+	.set_ofs = 0x4,
+	.clr_ofs = 0x8,
+	.sta_ofs = 0x0,
+};
+
+#define GATE_CAM(_id, _name, _parent, _shift)	\
+	GATE_MTK(_id, _name, _parent, &cam_cg_regs, _shift, &mtk_clk_gate_ops_setclr)
+
+static const struct mtk_gate cam_clks[] = {
+	GATE_CAM(CAMSYS_LARB13, "cam_larb13", "cam_sel", 0),
+	GATE_CAM(CAMSYS_DFP_VAD, "cam_dfp_vad", "cam_sel", 1),
+	GATE_CAM(CAMSYS_LARB14, "cam_larb14", "cam_sel", 2),
+	GATE_CAM(CAMSYS_LARB15, "cam_larb15", "cam_sel", 3),
+	GATE_CAM(CAMSYS_CAM, "cam_cam", "cam_sel", 6),
+	GATE_CAM(CAMSYS_CAMTG, "cam_camtg", "cam_sel", 7),
+	GATE_CAM(CAMSYS_SENINF, "cam_seninf", "cam_sel", 8),
+	GATE_CAM(CAMSYS_CAMSV0, "cam_camsv0", "cam_sel", 9),
+	GATE_CAM(CAMSYS_CAMSV1, "cam_camsv1", "cam_sel", 10),
+	GATE_CAM(CAMSYS_CAMSV2, "cam_camsv2", "cam_sel", 11),
+	GATE_CAM(CAMSYS_CAMSV3, "cam_camsv3", "cam_sel", 12),
+	GATE_CAM(CAMSYS_CCU0, "cam_ccu0", "cam_sel", 13),
+	GATE_CAM(CAMSYS_CCU1, "cam_ccu1", "cam_sel", 14),
+	GATE_CAM(CAMSYS_MRAW0, "cam_mraw0", "cam_sel", 15),
+	GATE_CAM(CAMSYS_MRAW1, "cam_mraw1", "cam_sel", 16),
+	GATE_CAM(CAMSYS_FAKE_ENG, "cam_fake_eng", "cam_sel", 17),
+};
+
+#define CAM_RAW_CLKS(_x)							\
+static const struct mtk_gate cam_raw##_x##_clks[] = {				\
+	GATE_CAM(CAMSYS_RAW_LARBX, "cam_raw" #_x "_larbx", "cam_sel", 0),	\
+	GATE_CAM(CAMSYS_RAW_CAM, "cam_raw" #_x "_cam", "cam_sel", 1),		\
+	GATE_CAM(CAMSYS_RAW_CAMTG, "cam_raw" #_x "_camtg", "cam_sel", 2),	\
+};										\
+static const struct mtk_clk_desc cam_raw##_x##_desc = {			\
+	.clks = cam_raw##_x##_clks,						\
+	.num_clks = ARRAY_SIZE(cam_raw##_x##_clks),				\
+}
+
+CAM_RAW_CLKS(a);
+CAM_RAW_CLKS(b);
+CAM_RAW_CLKS(c);
+
+static const struct mtk_clk_desc cam_desc = {
+	.clks = cam_clks,
+	.num_clks = ARRAY_SIZE(cam_clks),
+};
+
+static const struct of_device_id of_match_clk_mt6885_cam[] = {
+	{ .compatible = "mediatek,mt6885-camsys", .data = &cam_desc },
+	{ .compatible = "mediatek,mt6885-camsys-rawa", .data = &cam_rawa_desc },
+	{ .compatible = "mediatek,mt6885-camsys-rawb", .data = &cam_rawb_desc },
+	{ .compatible = "mediatek,mt6885-camsys-rawc", .data = &cam_rawc_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6885_cam);
+
+static struct platform_driver clk_mt6885_cam_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6885-cam",
+		.of_match_table = of_match_clk_mt6885_cam,
+	},
+};
+module_platform_driver(clk_mt6885_cam_drv);
+
+MODULE_DESCRIPTION("MediaTek MT6885 camera clocks driver");
+MODULE_LICENSE("GPL");
