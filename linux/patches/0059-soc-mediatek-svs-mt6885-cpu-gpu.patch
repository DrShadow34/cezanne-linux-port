+/*
+ * Banks in monitor mode get their thermal zone offset updated from the mon
+ * interrupt; poll the zones of the others.
+ */
+static void svs_temp_work(struct work_struct *work)
+{
+	struct svs_platform *svsp = container_of(to_delayed_work(work),
+						 struct svs_platform, temp_work);
+	struct svs_bank *svsb;
+	u32 idx;
+
+	for (idx = 0; idx < svsp->bank_max; idx++) {
+		svsb = &svsp->banks[idx];
+
+		if (svsb->phase != SVSB_PHASE_INIT02 || IS_ERR_OR_NULL(svsb->tzd))
+			continue;
+
+		if (svs_bank_temp_voffset(svsb) != svsb->temp_voffset)
+			svs_adjust_pm_opp_volts(svsb);
+	}
+
+	queue_delayed_work(system_freezable_power_efficient_wq,
+			   &svsp->temp_work, HZ);
+}
+
+static void svs_start_temp_work(struct svs_platform *svsp)
+{
+	u32 idx;
+
+	for (idx = 0; idx < svsp->bank_max; idx++) {
+		struct svs_bank *svsb = &svsp->banks[idx];
+
+		if (svsb->mode_support & SVSB_MODE_INIT02 &&
+		    !(svsb->mode_support & SVSB_MODE_MON) &&
+		    !IS_ERR_OR_NULL(svsb->tzd)) {
+			queue_delayed_work(system_freezable_power_efficient_wq,
+					   &svsp->temp_work, HZ);
+			return;
+		}
+	}
+}
