+/*
+ * MT6885 M_HW_RES words: per bank [7:0] MTDES, [12:10] DVFS_LOW, [15:13] SPEC,
+ * [23:16] BDES, [31:24] MDES (BSP eem_v2/mt6885 struct eem_devinfo).
+ */
+#define MT6885_RES_DVFS_LOW		GENMASK(12, 10)
+#define MT6885_RES_SPEC			GENMASK(15, 13)
+#define MT6885_RES_CPU_L_HI		5
+
+static bool svs_mt6885_efuse_parsing(struct svs_platform *svsp,
+				     const struct svs_platform_data *pdata)
+{
+	u32 i, res;
+
+	if (!svs_common_parse_efuse(svsp, pdata))
+		return false;
+
+	for (i = 0; i < svsp->bank_max; i++) {
+		struct svs_bank *svsb = &svsp->banks[i];
+		const struct svs_bank_pdata *bdata = &svsb->pdata;
+
+		if (bdata->sw_id == SVSB_SWID_GPU)
+			continue;
+
+		/*
+		 * The 2.6 GHz parts (segment 0x10) characterise the big high
+		 * bank in the CPU_L_HI fuses with SPEC 2; other bins would need
+		 * the CPU_B_HI word and other OPP tables.
+		 */
+		if (bdata->type == SVSB_TYPE_HIGH) {
+			res = svsp->efuse[MT6885_RES_CPU_L_HI];
+			if (FIELD_GET(MT6885_RES_SPEC, res) != 2) {
+				dev_err(svsp->dev, "unsupported CPU bin: 0x%08x\n", res);
+				return false;
+			}
+			continue;
+		}
+
+		/* low-voltage DVFS bins raise the floor */
+		res = svsp->efuse[bdata->dev_fuse_map[BDEV_MTDES].index];
+		switch (FIELD_GET(MT6885_RES_DVFS_LOW, res)) {
+		case 4:
+			svsb->vmin = 0x28;
+			break;
+		case 5:
+			svsb->vmin = 0x24;
+			break;
+		}
+	}
+
+	return true;
+}
