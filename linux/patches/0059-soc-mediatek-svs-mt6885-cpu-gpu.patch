+/*
+ * A 2-line high bank without init01 of its own runs init02 with the DC and
+ * aging offsets that init01 measured on its low bank (MT6885 big CPU).
+ */
+static void svs_share_init01_result(struct svs_platform *svsp)
+{
+	struct svs_bank *svsb, *low;
+	u32 idx, i;
+
+	for (idx = 0; idx < svsp->bank_max; idx++) {
+		svsb = &svsp->banks[idx];
+
+		if (!(svsb->volt_flags & SVSB_INIT01_FROM_LOW_BANK))
+			continue;
+
+		for (i = 0; i < svsp->bank_max; i++) {
+			low = &svsp->banks[i];
+
+			if (low->pdata.sw_id == svsb->pdata.sw_id &&
+			    low->pdata.type == SVSB_TYPE_LOW &&
+			    low->mode_support & SVSB_MODE_INIT01) {
+				svsb->dc_voffset_in = low->dc_voffset_in;
+				svsb->age_voffset_in = low->age_voffset_in;
+				break;
+			}
+		}
+	}
+}
+
+static u32 svs_bank_temp_voffset(struct svs_bank *svsb)
+{
+	const struct svs_bank_pdata *bdata = &svsb->pdata;
+	int tzone_temp;
+
+	if (svs_get_zone_temp(svsb, &tzone_temp))
+		return svsb->temp_voffset;
+
+	if (tzone_temp >= bdata->tzone_htemp)
+		return bdata->tzone_htemp_voffset;
+	if (tzone_temp <= bdata->tzone_ltemp)
+		return bdata->tzone_ltemp_voffset;
+
+	return 0;
+}
