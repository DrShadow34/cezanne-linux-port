 				    MT6885_TOP_AXI_PROT_EN_MM_STA1),
 		},
-		.caps = MTK_SCPD_KEEP_DEFAULT_OFF,
 	},
 	[MT6885_POWER_DOMAIN_VDEC2] = {
 		.name = "vdec2",
@@ -374,7 +373,6 @@ static const struct scpsys_domain_data scpsys_domain_data_mt6885[] = {
