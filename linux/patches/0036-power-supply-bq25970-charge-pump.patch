diff --git a/drivers/power/supply/bq25970_charger.c b/drivers/power/supply/bq25970_charger.c
new file mode 100644
index 000000000..0e73bea40
--- /dev/null
+++ b/drivers/power/supply/bq25970_charger.c
@@ -0,0 +1,673 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * TI BQ25970 / BQ25968 switched-capacitor (2:1) battery charger
+ *
+ * The charge pump halves VBUS into the battery; it does not regulate a
+ * voltage or current itself (apart from a soft regulation just below the
+ * battery OVP / OCP limits). The adapter's programmable voltage (USB PD PPS)
+ * sets the charge current, so the control loop lives outside this driver:
+ * it writes "online" to start / stop switching and reads VBUS, IBUS and the
+ * battery side ADCs here.
+ *
+ * Writing online=1 must be repeated at least every BQ25970_KEEPALIVE_MS:
+ * if the loop stops, the converter is switched off.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/i2c.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define BQ25970_BAT_OVP			0x00
+#define BQ25970_BAT_OVP_ALM		0x01
+#define BQ25970_BAT_OCP			0x02
+#define BQ25970_BAT_OCP_ALM		0x03
+#define BQ25970_BAT_UCP_ALM		0x04
+#define BQ25970_AC_PROTECTION		0x05
+#define BQ25970_BUS_OVP			0x06
+#define BQ25970_BUS_OVP_ALM		0x07
+#define BQ25970_BUS_OCP_UCP		0x08
+#define BQ25970_BUS_OCP_ALM		0x09
+#define BQ25970_CONVERTER_STATE		0x0a
+#define BQ25970_CONTROL			0x0b
+#define BQ25970_CHRG_CTRL		0x0c
+#define BQ25970_INT_STAT		0x0d
+#define BQ25970_INT_FLAG		0x0e
+#define BQ25970_INT_MASK		0x0f
+#define BQ25970_FLT_STAT		0x10
+#define BQ25970_FLT_FLAG		0x11
+#define BQ25970_FLT_MASK		0x12
+#define BQ25970_PART_INFO		0x13
+#define BQ25970_ADC_CTRL		0x14
+#define BQ25970_ADC_FN_DISABLE		0x15
+#define BQ25970_IBUS_ADC		0x16
+#define BQ25970_VBUS_ADC		0x18
+#define BQ25970_VAC_ADC			0x1a
+#define BQ25970_VOUT_ADC		0x1c
+#define BQ25970_VBAT_ADC		0x1e
+#define BQ25970_IBAT_ADC		0x20
+#define BQ25970_TDIE_ADC		0x26
+#define BQ25970_TSBUS_FLT		0x28
+#define BQ25970_TSBAT_FLT		0x29
+#define BQ25970_TDIE_ALM		0x2a
+#define BQ25970_REG_CTRL		0x2b
+#define BQ25970_REG_THRESHOLD		0x2c
+#define BQ25970_REG_FLAG_MASK		0x2d
+#define BQ25970_DEGLITCH		0x2e
+#define BQ25970_MAX_REG			0x2e
+
+/* the enable / disable bit of the protection and alarm registers */
+#define BQ25970_PROT_DIS		BIT(7)
+
+#define BQ25970_BAT_OVP_MIN_UV		3475000
+#define BQ25970_BAT_OVP_ALM_MIN_UV	3500000
+#define BQ25970_BAT_OVP_STEP_UV		25000
+#define BQ25970_BAT_OVP_MASK		GENMASK(5, 0)
+#define BQ25970_BAT_OCP_MIN_UA		2000000
+#define BQ25970_BAT_OCP_STEP_UA		100000
+#define BQ25970_BAT_OCP_MASK		GENMASK(6, 0)
+#define BQ25970_BUS_OVP_MIN_UV		5950000
+#define BQ25970_BUS_OVP_ALM_MIN_UV	6000000
+#define BQ25970_BUS_OVP_STEP_UV		50000
+#define BQ25970_BUS_OVP_MASK		GENMASK(6, 0)
+#define BQ25970_BUS_OCP_MIN_UA		1000000
+#define BQ25970_BUS_OCP_STEP_UA		250000
+#define BQ25970_BUS_OCP_MASK		GENMASK(3, 0)
+#define BQ25970_BUS_OCP_ALM_STEP_UA	50000
+#define BQ25970_BUS_OCP_ALM_MASK	GENMASK(6, 0)
+
+/* AC_PROTECTION */
+#define BQ25970_AC_OVP_STAT		BIT(7)
+#define BQ25970_AC_OVP_FLAG		BIT(6)
+#define BQ25970_VDROP_400MV		BIT(4)
+#define BQ25970_VDROP_DEGLITCH_5MS	BIT(3)
+#define BQ25970_AC_OVP_MASK		GENMASK(2, 0)
+#define BQ25970_AC_OVP_MIN_UV		11000000
+#define BQ25970_AC_OVP_STEP_UV		1000000
+
+/* BUS_OCP_UCP */
+#define BQ25970_IBUS_UCP_FALL_FLAG	BIT(4)
+
+/* CONVERTER_STATE */
+#define BQ25970_TSHUT_FLAG		BIT(7)
+#define BQ25970_TSHUT_STAT		BIT(6)
+#define BQ25970_VBUS_ERRORLO_STAT	BIT(5)
+#define BQ25970_VBUS_ERRORHI_STAT	BIT(4)
+#define BQ25970_SS_TIMEOUT_FLAG		BIT(3)
+#define BQ25970_CONV_SWITCHING_STAT	BIT(2)
+#define BQ25970_CONV_OCP_FLAG		BIT(1)
+
+/* CONTROL */
+#define BQ25970_WATCHDOG_DIS		BIT(2)
+
+/* CHRG_CTRL */
+#define BQ25970_CHG_EN			BIT(7)
+#define BQ25970_TSBUS_DIS		BIT(2)
+#define BQ25970_TSBAT_DIS		BIT(1)
+#define BQ25970_TDIE_DIS		BIT(0)
+
+/* INT_STAT / INT_FLAG / INT_MASK */
+#define BQ25970_BAT_OVP_ALM_INT		BIT(7)
+#define BQ25970_BAT_OCP_ALM_INT		BIT(6)
+#define BQ25970_BUS_OVP_ALM_INT		BIT(5)
+#define BQ25970_BUS_OCP_ALM_INT		BIT(4)
+#define BQ25970_BAT_UCP_ALM_INT		BIT(3)
+#define BQ25970_ADAPTER_INSERT		BIT(2)
+#define BQ25970_VBAT_INSERT		BIT(1)
+#define BQ25970_ADC_DONE		BIT(0)
+
+/* FLT_STAT / FLT_FLAG / FLT_MASK */
+#define BQ25970_BAT_OVP_FLT		BIT(7)
+#define BQ25970_BAT_OCP_FLT		BIT(6)
+#define BQ25970_BUS_OVP_FLT		BIT(5)
+#define BQ25970_BUS_OCP_FLT		BIT(4)
+#define BQ25970_TS_ALM_FLT		BIT(3)
+#define BQ25970_TSBAT_FLT_BIT		BIT(2)
+#define BQ25970_TSBUS_FLT_BIT		BIT(1)
+#define BQ25970_TDIE_ALM_FLT		BIT(0)
+
+#define BQ25970_DEV_ID_MASK		GENMASK(3, 0)
+#define BQ25968_ID			0x16
+#define BQ25970_ID			0x10
+
+/* ADC_CTRL: continuous, averaged, 13 bit */
+#define BQ25970_ADC_EN			BIT(7)
+#define BQ25970_ADC_AVG			BIT(5)
+#define BQ25970_ADC_13BIT		(2 << 2)
+#define BQ25970_IBUS_ADC_DIS		BIT(0)
+/* ADC_FN_DISABLE: VOUT, TSBUS and TSBAT off; VBUS, VAC, VBAT, IBAT, TDIE on */
+#define BQ25970_ADC_FN_OFF		(BIT(5) | BIT(2) | BIT(1))
+
+/* REG_CTRL */
+#define BQ25970_SS_TIMEOUT_MASK		GENMASK(7, 5)
+#define BQ25970_SS_TIMEOUT_100S		(7 << 5)
+#define BQ25970_EN_REGULATION		BIT(4)
+#define BQ25970_IBUS_UCP_RISE_500MA	BIT(2)
+#define BQ25970_IBAT_SNS_RES_5MOHM	BIT(1)
+
+/* REG_THRESHOLD: regulate 200 mA below BAT_OCP and 50 mV below BAT_OVP */
+#define BQ25970_REG_THRESHOLD_MASK	GENMASK(7, 4)
+#define BQ25970_VBAT_REG_ACTIVE		BIT(3)
+#define BQ25970_IBAT_REG_ACTIVE		BIT(2)
+
+/* REG_FLAG_MASK */
+#define BQ25970_VDROP_OVP_FLAG		BIT(5)
+#define BQ25970_VOUT_OVP_FLAG		BIT(4)
+
+/* DEGLITCH */
+#define BQ25970_IBUS_LOW_DG_5MS		BIT(3)
+
+#define BQ25970_KEEPALIVE_MS		5000
+
+struct bq25970 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *psy;
+	struct delayed_work keepalive;
+	struct mutex lock;
+	const char *model;
+	u32 bat_ovp_uv;
+	u32 bat_ocp_ua;
+	u32 bus_ovp_uv;
+	u32 bus_ocp_ua;
+	u32 ac_ovp_uv;
+	bool sense_5mohm;
+};
+
+static const struct regmap_config bq25970_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = BQ25970_MAX_REG,
+	.cache_type = REGCACHE_NONE,
+};
+
+/* the ADC results are big endian two's complement, 1 mV / 1 mA per LSB */
+static int bq25970_adc(struct bq25970 *bq, unsigned int reg, int *val)
+{
+	__be16 raw;
+	int ret;
+
+	ret = regmap_bulk_read(bq->regmap, reg, &raw, sizeof(raw));
+	if (ret)
+		return ret;
+	*val = (s16)be16_to_cpu(raw);
+	return 0;
+}
+
+static int bq25970_enable(struct bq25970 *bq, bool on)
+{
+	int ret;
+
+	ret = regmap_update_bits(bq->regmap, BQ25970_CHRG_CTRL, BQ25970_CHG_EN,
+				 on ? BQ25970_CHG_EN : 0);
+	if (ret)
+		return ret;
+	if (on)
+		mod_delayed_work(system_wq, &bq->keepalive,
+				 msecs_to_jiffies(BQ25970_KEEPALIVE_MS));
+	else
+		cancel_delayed_work(&bq->keepalive);
+	return 0;
+}
+
+static void bq25970_keepalive_expired(struct work_struct *work)
+{
+	struct bq25970 *bq = container_of(work, struct bq25970, keepalive.work);
+
+	dev_warn(bq->dev, "no keepalive for %d ms, stopping\n",
+		 BQ25970_KEEPALIVE_MS);
+	mutex_lock(&bq->lock);
+	regmap_update_bits(bq->regmap, BQ25970_CHRG_CTRL, BQ25970_CHG_EN, 0);
+	mutex_unlock(&bq->lock);
+	power_supply_changed(bq->psy);
+}
+
+static int bq25970_health(struct bq25970 *bq, int *health)
+{
+	unsigned int flt, conv;
+	int ret;
+
+	ret = regmap_read(bq->regmap, BQ25970_FLT_STAT, &flt);
+	if (!ret)
+		ret = regmap_read(bq->regmap, BQ25970_CONVERTER_STATE, &conv);
+	if (ret)
+		return ret;
+
+	if (conv & BQ25970_TSHUT_STAT)
+		*health = POWER_SUPPLY_HEALTH_OVERHEAT;
+	else if (flt & (BQ25970_BAT_OVP_FLT | BQ25970_BUS_OVP_FLT))
+		*health = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+	else if (flt & (BQ25970_BAT_OCP_FLT | BQ25970_BUS_OCP_FLT))
+		*health = POWER_SUPPLY_HEALTH_OVERCURRENT;
+	else
+		*health = POWER_SUPPLY_HEALTH_GOOD;
+	return 0;
+}
+
+static int bq25970_get_property(struct power_supply *psy,
+				enum power_supply_property psp,
+				union power_supply_propval *val)
+{
+	struct bq25970 *bq = power_supply_get_drvdata(psy);
+	unsigned int reg;
+	int ret = 0, v;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = regmap_read(bq->regmap, BQ25970_CHRG_CTRL, &reg);
+		val->intval = !!(reg & BQ25970_CHG_EN);
+		break;
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = regmap_read(bq->regmap, BQ25970_CONVERTER_STATE, &reg);
+		val->intval = reg & BQ25970_CONV_SWITCHING_STAT ?
+			      POWER_SUPPLY_STATUS_CHARGING :
+			      POWER_SUPPLY_STATUS_NOT_CHARGING;
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		ret = bq25970_health(bq, &val->intval);
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = bq25970_adc(bq, BQ25970_VBUS_ADC, &v);
+		val->intval = v * 1000;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		ret = bq25970_adc(bq, BQ25970_IBUS_ADC, &v);
+		val->intval = v * 1000;
+		break;
+	case POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT:
+		val->intval = bq->bus_ovp_uv;
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		val->intval = bq->bus_ocp_ua;
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		/* 0.5 C per LSB -> 0.1 C */
+		ret = bq25970_adc(bq, BQ25970_TDIE_ADC, &v);
+		val->intval = v * 5;
+		break;
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = bq->model;
+		break;
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = "Texas Instruments";
+		break;
+	default:
+		return -EINVAL;
+	}
+	return ret;
+}
+
+static int bq25970_set_property(struct power_supply *psy,
+				enum power_supply_property psp,
+				const union power_supply_propval *val)
+{
+	struct bq25970 *bq = power_supply_get_drvdata(psy);
+	int ret;
+
+	if (psp != POWER_SUPPLY_PROP_ONLINE)
+		return -EINVAL;
+
+	mutex_lock(&bq->lock);
+	ret = bq25970_enable(bq, val->intval);
+	mutex_unlock(&bq->lock);
+	return ret;
+}
+
+static int bq25970_property_is_writeable(struct power_supply *psy,
+					 enum power_supply_property psp)
+{
+	return psp == POWER_SUPPLY_PROP_ONLINE;
+}
+
+static enum power_supply_property bq25970_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_INPUT_VOLTAGE_LIMIT,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+	POWER_SUPPLY_PROP_MANUFACTURER,
+};
+
+static const struct power_supply_desc bq25970_desc = {
+	.name = "bq25970",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = bq25970_props,
+	.num_properties = ARRAY_SIZE(bq25970_props),
+	.get_property = bq25970_get_property,
+	.set_property = bq25970_set_property,
+	.property_is_writeable = bq25970_property_is_writeable,
+};
+
+/* battery side ADCs and raw state for the control loop, in uV / uA */
+static ssize_t bq25970_adc_show(struct device *dev, unsigned int reg, char *buf)
+{
+	struct bq25970 *bq = power_supply_get_drvdata(to_power_supply(dev));
+	int ret, v;
+
+	ret = bq25970_adc(bq, reg, &v);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "%d\n", v * 1000);
+}
+
+static ssize_t battery_voltage_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	return bq25970_adc_show(dev, BQ25970_VBAT_ADC, buf);
+}
+static DEVICE_ATTR_RO(battery_voltage);
+
+static ssize_t battery_current_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	return bq25970_adc_show(dev, BQ25970_IBAT_ADC, buf);
+}
+static DEVICE_ATTR_RO(battery_current);
+
+static ssize_t ac_voltage_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	return bq25970_adc_show(dev, BQ25970_VAC_ADC, buf);
+}
+static DEVICE_ATTR_RO(ac_voltage);
+
+/* converter state, interrupt / fault status and regulation status */
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct bq25970 *bq = power_supply_get_drvdata(to_power_supply(dev));
+	unsigned int conv, stat, flt, regs;
+	int ret;
+
+	ret = regmap_read(bq->regmap, BQ25970_CONVERTER_STATE, &conv);
+	if (!ret)
+		ret = regmap_read(bq->regmap, BQ25970_INT_STAT, &stat);
+	if (!ret)
+		ret = regmap_read(bq->regmap, BQ25970_FLT_STAT, &flt);
+	if (!ret)
+		ret = regmap_read(bq->regmap, BQ25970_REG_THRESHOLD, &regs);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "conv %02x int %02x fault %02x reg %02x\n",
+			  conv, stat, flt, regs);
+}
+static DEVICE_ATTR_RO(state);
+
+static struct attribute *bq25970_attrs[] = {
+	&dev_attr_battery_voltage.attr,
+	&dev_attr_battery_current.attr,
+	&dev_attr_ac_voltage.attr,
+	&dev_attr_state.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(bq25970);
+
+static irqreturn_t bq25970_irq(int irq, void *data)
+{
+	struct bq25970 *bq = data;
+	unsigned int ac = 0, ucp = 0, conv = 0, flag = 0, flt = 0, regf = 0;
+
+	/* the flags clear on read */
+	mutex_lock(&bq->lock);
+	regmap_read(bq->regmap, BQ25970_AC_PROTECTION, &ac);
+	regmap_read(bq->regmap, BQ25970_BUS_OCP_UCP, &ucp);
+	regmap_read(bq->regmap, BQ25970_CONVERTER_STATE, &conv);
+	regmap_read(bq->regmap, BQ25970_INT_FLAG, &flag);
+	regmap_read(bq->regmap, BQ25970_FLT_FLAG, &flt);
+	regmap_read(bq->regmap, BQ25970_REG_FLAG_MASK, &regf);
+	mutex_unlock(&bq->lock);
+
+	if (flt || (ac & BQ25970_AC_OVP_FLAG) ||
+	    (conv & (BQ25970_TSHUT_FLAG | BQ25970_SS_TIMEOUT_FLAG |
+		     BQ25970_CONV_OCP_FLAG)) ||
+	    (regf & (BQ25970_VDROP_OVP_FLAG | BQ25970_VOUT_OVP_FLAG)))
+		dev_warn_ratelimited(bq->dev,
+			"fault %02x ac %02x conv %02x reg %02x\n",
+			flt, ac, conv, regf);
+	else
+		dev_dbg(bq->dev, "int %02x ucp %02x conv %02x\n",
+			flag, ucp, conv);
+
+	power_supply_changed(bq->psy);
+	return IRQ_HANDLED;
+}
+
+static int bq25970_hw_init(struct bq25970 *bq)
+{
+	struct regmap *rm = bq->regmap;
+	unsigned int v;
+	int ret;
+
+	/* converter off, no chip watchdog (the keepalive above replaces it) */
+	ret = regmap_update_bits(rm, BQ25970_CHRG_CTRL, BQ25970_CHG_EN, 0);
+	if (ret)
+		return ret;
+	regmap_update_bits(rm, BQ25970_CONTROL, BQ25970_WATCHDOG_DIS,
+			   BQ25970_WATCHDOG_DIS);
+
+	/* battery OVP / OCP and their alarms (OVP alarm off, as the vendor) */
+	v = (bq->bat_ovp_uv - BQ25970_BAT_OVP_MIN_UV) / BQ25970_BAT_OVP_STEP_UV;
+	regmap_write(rm, BQ25970_BAT_OVP, v & BQ25970_BAT_OVP_MASK);
+	v = (bq->bat_ovp_uv - 35000 - BQ25970_BAT_OVP_ALM_MIN_UV) /
+	    BQ25970_BAT_OVP_STEP_UV;
+	regmap_write(rm, BQ25970_BAT_OVP_ALM,
+		     BQ25970_PROT_DIS | (v & BQ25970_BAT_OVP_MASK));
+	v = (bq->bat_ocp_ua - BQ25970_BAT_OCP_MIN_UA) / BQ25970_BAT_OCP_STEP_UA;
+	regmap_write(rm, BQ25970_BAT_OCP, v & BQ25970_BAT_OCP_MASK);
+	v = (bq->bat_ocp_ua - 1000000 - BQ25970_BAT_OCP_MIN_UA) /
+	    BQ25970_BAT_OCP_STEP_UA;
+	regmap_write(rm, BQ25970_BAT_OCP_ALM, v & BQ25970_BAT_OCP_MASK);
+	/* battery UCP alarm off: the gauge decides when charging is done */
+	regmap_update_bits(rm, BQ25970_BAT_UCP_ALM, BQ25970_PROT_DIS,
+			   BQ25970_PROT_DIS);
+
+	/* bus OVP / OCP, alarms 1 V / 250 mA below */
+	v = (bq->bus_ovp_uv - BQ25970_BUS_OVP_MIN_UV) / BQ25970_BUS_OVP_STEP_UV;
+	regmap_update_bits(rm, BQ25970_BUS_OVP, BQ25970_BUS_OVP_MASK, v);
+	v = (bq->bus_ovp_uv - 1000000 - BQ25970_BUS_OVP_ALM_MIN_UV) /
+	    BQ25970_BUS_OVP_STEP_UV;
+	regmap_write(rm, BQ25970_BUS_OVP_ALM, v & BQ25970_BUS_OVP_MASK);
+	v = (bq->bus_ocp_ua - BQ25970_BUS_OCP_MIN_UA) / BQ25970_BUS_OCP_STEP_UA;
+	regmap_update_bits(rm, BQ25970_BUS_OCP_UCP,
+			   BQ25970_PROT_DIS | BQ25970_BUS_OCP_MASK,
+			   v & BQ25970_BUS_OCP_MASK);
+	v = (bq->bus_ocp_ua - 250000) / BQ25970_BUS_OCP_ALM_STEP_UA;
+	regmap_write(rm, BQ25970_BUS_OCP_ALM, v & BQ25970_BUS_OCP_ALM_MASK);
+
+	/* AC (adapter input) OVP, VDROP 400 mV with 5 ms deglitch */
+	v = (bq->ac_ovp_uv - BQ25970_AC_OVP_MIN_UV) / BQ25970_AC_OVP_STEP_UV;
+	regmap_update_bits(rm, BQ25970_AC_PROTECTION,
+			   BQ25970_VDROP_400MV | BQ25970_VDROP_DEGLITCH_5MS |
+			   BQ25970_AC_OVP_MASK,
+			   BQ25970_VDROP_400MV | BQ25970_VDROP_DEGLITCH_5MS |
+			   (v & BQ25970_AC_OVP_MASK));
+
+	/*
+	 * TSBUS / TSBAT / TDIE protection off (no thermistors on those pins
+	 * on cezanne; the vendor disables die protection too)
+	 */
+	regmap_update_bits(rm, BQ25970_CHRG_CTRL,
+			   BQ25970_TSBUS_DIS | BQ25970_TSBAT_DIS |
+			   BQ25970_TDIE_DIS,
+			   BQ25970_TSBUS_DIS | BQ25970_TSBAT_DIS |
+			   BQ25970_TDIE_DIS);
+
+	/*
+	 * soft start timeout 100 s, battery regulation on, IBUS UCP rising
+	 * threshold 300 mA (5 ms deglitch on falling), sense resistor
+	 */
+	regmap_update_bits(rm, BQ25970_REG_CTRL,
+			   BQ25970_SS_TIMEOUT_MASK | BQ25970_EN_REGULATION |
+			   BQ25970_IBUS_UCP_RISE_500MA |
+			   BQ25970_IBAT_SNS_RES_5MOHM,
+			   BQ25970_SS_TIMEOUT_100S | BQ25970_EN_REGULATION |
+			   (bq->sense_5mohm ? BQ25970_IBAT_SNS_RES_5MOHM : 0));
+	regmap_update_bits(rm, BQ25970_REG_THRESHOLD,
+			   BQ25970_REG_THRESHOLD_MASK, 0);
+	regmap_update_bits(rm, BQ25970_DEGLITCH, BQ25970_IBUS_LOW_DG_5MS,
+			   BQ25970_IBUS_LOW_DG_5MS);
+
+	/* interrupts: no ADC done, battery alarms or thermistor faults */
+	regmap_update_bits(rm, BQ25970_INT_MASK,
+			   BQ25970_ADC_DONE | BQ25970_BAT_OVP_ALM_INT |
+			   BQ25970_BAT_OCP_ALM_INT | BQ25970_BAT_UCP_ALM_INT,
+			   BQ25970_ADC_DONE | BQ25970_BAT_OVP_ALM_INT |
+			   BQ25970_BAT_OCP_ALM_INT | BQ25970_BAT_UCP_ALM_INT);
+	regmap_update_bits(rm, BQ25970_FLT_MASK,
+			   BQ25970_TSBAT_FLT_BIT | BQ25970_TSBUS_FLT_BIT |
+			   BQ25970_TDIE_ALM_FLT | BQ25970_TS_ALM_FLT,
+			   BQ25970_TSBAT_FLT_BIT | BQ25970_TSBUS_FLT_BIT |
+			   BQ25970_TDIE_ALM_FLT | BQ25970_TS_ALM_FLT);
+
+	/* ADC: continuous, averaged, 13 bit */
+	regmap_write(rm, BQ25970_ADC_FN_DISABLE, BQ25970_ADC_FN_OFF);
+	return regmap_write(rm, BQ25970_ADC_CTRL, BQ25970_ADC_EN |
+			    BQ25970_ADC_AVG | BQ25970_ADC_13BIT);
+}
+
+static int bq25970_parse_dt(struct bq25970 *bq)
+{
+	struct device *dev = bq->dev;
+	u32 sense = 5000;
+
+	bq->bat_ovp_uv = 4525000;
+	bq->bat_ocp_ua = 7000000;
+	bq->bus_ovp_uv = 12000000;
+	bq->bus_ocp_ua = 3750000;
+	bq->ac_ovp_uv = 14000000;
+	device_property_read_u32(dev, "ti,bat-ovp-microvolt", &bq->bat_ovp_uv);
+	device_property_read_u32(dev, "ti,bat-ocp-microamp", &bq->bat_ocp_ua);
+	device_property_read_u32(dev, "ti,bus-ovp-microvolt", &bq->bus_ovp_uv);
+	device_property_read_u32(dev, "ti,bus-ocp-microamp", &bq->bus_ocp_ua);
+	device_property_read_u32(dev, "ti,ac-ovp-microvolt", &bq->ac_ovp_uv);
+	device_property_read_u32(dev, "ti,sense-resistor-micro-ohms", &sense);
+
+	bq->bat_ovp_uv = clamp(bq->bat_ovp_uv, 3600000U, 4600000U);
+	bq->bat_ocp_ua = clamp(bq->bat_ocp_ua, 3100000U, 8000000U);
+	bq->bus_ovp_uv = clamp(bq->bus_ovp_uv, 7000000U, 12000000U);
+	bq->bus_ocp_ua = clamp(bq->bus_ocp_ua, 1250000U, 4750000U);
+	bq->ac_ovp_uv = clamp(bq->ac_ovp_uv, 11000000U, 17000000U);
+	if (sense != 2000 && sense != 5000)
+		return dev_err_probe(dev, -EINVAL,
+				     "sense resistor must be 2 or 5 mOhm\n");
+	bq->sense_5mohm = sense == 5000;
+	return 0;
+}
+
+static void bq25970_stop(void *data)
+{
+	struct bq25970 *bq = data;
+
+	cancel_delayed_work_sync(&bq->keepalive);
+	regmap_update_bits(bq->regmap, BQ25970_CHRG_CTRL, BQ25970_CHG_EN, 0);
+}
+
+static int bq25970_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct power_supply_config cfg = {};
+	struct bq25970 *bq;
+	unsigned int id;
+	int ret;
+
+	bq = devm_kzalloc(dev, sizeof(*bq), GFP_KERNEL);
+	if (!bq)
+		return -ENOMEM;
+	bq->dev = dev;
+	mutex_init(&bq->lock);
+	INIT_DELAYED_WORK(&bq->keepalive, bq25970_keepalive_expired);
+	i2c_set_clientdata(client, bq);
+
+	bq->regmap = devm_regmap_init_i2c(client, &bq25970_regmap_config);
+	if (IS_ERR(bq->regmap))
+		return dev_err_probe(dev, PTR_ERR(bq->regmap), "regmap\n");
+
+	ret = regmap_read(bq->regmap, BQ25970_PART_INFO, &id);
+	if (ret)
+		return dev_err_probe(dev, ret, "no device\n");
+	switch (id) {
+	case BQ25968_ID:
+		bq->model = "BQ25968";
+		break;
+	case BQ25970_ID:
+		bq->model = "BQ25970";
+		break;
+	default:
+		/* the SC8551 second source has a different ADC scale */
+		return dev_err_probe(dev, -ENODEV, "unsupported part %#x\n", id);
+	}
+
+	ret = bq25970_parse_dt(bq);
+	if (ret)
+		return ret;
+
+	ret = bq25970_hw_init(bq);
+	if (ret)
+		return dev_err_probe(dev, ret, "init\n");
+
+	cfg.drv_data = bq;
+	cfg.fwnode = dev_fwnode(dev);
+	cfg.attr_grp = bq25970_groups;
+	bq->psy = devm_power_supply_register(dev, &bq25970_desc, &cfg);
+	if (IS_ERR(bq->psy))
+		return dev_err_probe(dev, PTR_ERR(bq->psy), "power supply\n");
+	/* released before the power supply: the keepalive work uses it */
+	ret = devm_add_action_or_reset(dev, bq25970_stop, bq);
+	if (ret)
+		return ret;
+
+	if (client->irq) {
+		ret = devm_request_threaded_irq(dev, client->irq, NULL,
+						bq25970_irq, IRQF_ONESHOT,
+						dev_name(dev), bq);
+		if (ret)
+			return dev_err_probe(dev, ret, "irq\n");
+	}
+
+	dev_info(dev, "%s, bat %u mV / %u mA, bus %u mV / %u mA\n", bq->model,
+		 bq->bat_ovp_uv / 1000, bq->bat_ocp_ua / 1000,
+		 bq->bus_ovp_uv / 1000, bq->bus_ocp_ua / 1000);
+	return 0;
+}
+
+static void bq25970_shutdown(struct i2c_client *client)
+{
+	bq25970_stop(i2c_get_clientdata(client));
+}
+
+static const struct of_device_id bq25970_of_match[] = {
+	{ .compatible = "ti,bq25970" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, bq25970_of_match);
+
+static const struct i2c_device_id bq25970_i2c_ids[] = {
+	{ "bq25970" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, bq25970_i2c_ids);
+
+static struct i2c_driver bq25970_driver = {
+	.driver = {
+		.name = "bq25970-charger",
+		.of_match_table = bq25970_of_match,
+	},
+	.probe = bq25970_probe,
+	.shutdown = bq25970_shutdown,
+	.id_table = bq25970_i2c_ids,
+};
+module_i2c_driver(bq25970_driver);
+
+MODULE_DESCRIPTION("TI BQ25970 / BQ25968 charge pump driver");
+MODULE_LICENSE("GPL");
