 	enum mtk_smi_type	type;
 	bool			has_gals;
 	u32			bus_sel; /* Balance some larbs to enter mmu0 or mmu1 */
@@ -153,6 +147,14 @@ struct mtk_smi {
 	};
 	struct device			*smi_common_dev; /* for sub common */
 	const struct mtk_smi_common_plat *plat;
+	/*
+	 * Keep the clocks on through the noirq phase of a system suspend:
+	 * other power domains' bus protection (applied by genpd then) only
+	 * gets its acks with this SMI running. Only for an SMI whose own
+	 * domain stays on: a power cycle resets the gates under the held
+	 * enable count and they stay gated.
+	 */
+	bool				noirq_clks;
 };
 
 struct mtk_smi_larb { /* larb: local arbiter */
@@ -817,14 +819,6 @@ static const struct mtk_smi_common_plat mtk_smi_common_mt6893 = {
