 static const struct mtk_smi_common_plat mtk_smi_common_mt8183 = {
 	.type     = MTK_SMI_GEN2,
 	.has_gals = true,
@@ -887,7 +881,7 @@ static const struct of_device_id mtk_smi_common_of_ids[] = {
 	{.compatible = "mediatek,mt2712-smi-common", .data = &mtk_smi_common_gen2},
 	{.compatible = "mediatek,mt6779-smi-common", .data = &mtk_smi_common_mt6779},
 	{.compatible = "mediatek,mt6795-smi-common", .data = &mtk_smi_common_mt6795},
-	{.compatible = "mediatek,mt6885-smi-common", .data = &mtk_smi_common_mt6885},
+	{.compatible = "mediatek,mt6885-smi-common", .data = &mtk_smi_common_mt6893},
 	{.compatible = "mediatek,mt6893-smi-common", .data = &mtk_smi_common_mt6893},
 	{.compatible = "mediatek,mt8167-smi-common", .data = &mtk_smi_common_gen2},
 	{.compatible = "mediatek,mt8173-smi-common", .data = &mtk_smi_common_gen2},
@@ -915,6 +909,8 @@ static int mtk_smi_common_probe(struct platform_device *pdev)
 		return -ENOMEM;
 	common->dev = dev;
 	common->plat = of_device_get_match_data(dev);
+	common->noirq_clks = of_property_read_bool(dev->of_node,
+						   "mediatek,clocks-on-in-noirq");
 
 	if (common->plat->has_gals) {
 		if (common->plat->type == MTK_SMI_GEN2)
@@ -1001,7 +997,7 @@ static int __maybe_unused mtk_smi_common_suspend_noirq(struct device *dev)
 {
 	struct mtk_smi *common = dev_get_drvdata(dev);
 
-	if (!common->plat->clk_on_for_pd_off)
+	if (!common->noirq_clks)
 		return 0;
 	return clk_bulk_prepare_enable(common->clk_num, common->clks);
 }
@@ -1010,11 +1006,7 @@ static int __maybe_unused mtk_smi_common_resume_noirq(struct device *dev)
 {
 	struct mtk_smi *common = dev_get_drvdata(dev);
 
-	/*
-	 * Runtime-suspended here: this drops the clocks to off, which is what
-	 * a power-cycled domain has in its gates; runtime resume ungates.
-	 */
-	if (common->plat->clk_on_for_pd_off)
+	if (common->noirq_clks)
 		clk_bulk_disable_unprepare(common->clk_num, common->clks);
 	return 0;
 }
