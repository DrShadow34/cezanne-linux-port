+static struct drm_property_blob *mtk_crtc_lut_blob(struct drm_device *drm,
+						   const u16 *table, unsigned int n)
+{
+	struct drm_property_blob *blob;
+	struct drm_color_lut *lut;
+	unsigned int i;
+
+	lut = kcalloc(n, sizeof(*lut), GFP_KERNEL);
+	if (!lut)
+		return ERR_PTR(-ENOMEM);
+	for (i = 0; i < n; i++) {
+		u16 v = table ? table[i] : DIV_ROUND_CLOSEST(i * 0xffff, n - 1);
+
+		lut[i].red = lut[i].green = lut[i].blue = v;
+	}
+	blob = drm_property_create_blob(drm, n * sizeof(*lut), lut);
+	kfree(lut);
+	return blob;
