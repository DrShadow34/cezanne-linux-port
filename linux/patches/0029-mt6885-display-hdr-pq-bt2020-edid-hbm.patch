+static bool j10_hdr_pq(struct drm_bridge *bridge, struct drm_atomic_commit *state)
+{
+	struct drm_connector_state *conn_state;
+	struct drm_connector *connector;
+	const struct hdr_output_metadata *md;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state,
+							     bridge->encoder);
+	if (!connector)
+		return false;
+	conn_state = drm_atomic_get_new_connector_state(state, connector);
+	if (!conn_state || !conn_state->hdr_output_metadata)
+		return false;
+	md = conn_state->hdr_output_metadata->data;
+	return md->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084;
+}
