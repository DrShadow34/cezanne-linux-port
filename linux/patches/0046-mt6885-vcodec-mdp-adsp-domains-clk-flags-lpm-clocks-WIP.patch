@@ -12,10 +12,17 @@
  * The BSP also sets MCUPM_CM_CTRL (CPU -> DRAM frequency coupling, cm_mgr);
  * nothing drives that here, so it stays off.
  *
+ * Also gates the clocks listed in the "cezanne,mt6885-lpm-unused-clocks"
+ * node: lk leaves them running, nothing on Arch uses them, and they block
+ * the SPM constraints. With clk_ignore_unused (needed: blanket gating hits
+ * firmware clocks nothing references) they would stay on, so take and drop
+ * each once; a clock some driver holds stays on.
+ *
  * Only done when ATF runs the SPM resource constraints, i.e. lk loaded the
  * SPM firmware (normal / boot-slot boot; a recovery-slot boot has none).
  */
 #include <linux/arm-smccc.h>
+#include <linux/clk.h>
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/of.h>
@@ -84,6 +91,30 @@ static bool mt6885_spm_constraints_on(void)
 	return r.a0 && r.a0 != SMCCC_RET_NOT_SUPPORTED;
 }
 
+static void __init mt6885_lpm_gate_unused(void)
+{
+	struct device_node *np;
+	int i, n, gated = 0;
+
+	np = of_find_compatible_node(NULL, NULL, "cezanne,mt6885-lpm-unused-clocks");
+	if (!np)
+		return;
+	n = of_count_phandle_with_args(np, "clocks", "#clock-cells");
+	for (i = 0; i < n; i++) {
+		struct clk *clk = of_clk_get(np, i);
+
+		if (IS_ERR(clk))
+			continue;
+		if (!clk_prepare_enable(clk)) {
+			clk_disable_unprepare(clk);
+			gated++;
+		}
+		clk_put(clk);
+	}
+	of_node_put(np);
+	pr_info("mt6885-lpm: dropped %d of %d unused clocks\n", gated, n);
+}
+
 static int __init mt6885_lpm_init(void)
 {
 	if (!of_machine_is_compatible("mediatek,mt6885"))
@@ -92,6 +123,7 @@ static int __init mt6885_lpm_init(void)
 		pr_info("mt6885-lpm: no SPM constraints (no SPM firmware), skipped\n");
 		return 0;
 	}
+	mt6885_lpm_gate_unused();
 	mbox = ioremap(MCUPM_MBOX3_SRAM, MCUPM_MBOX3_SIZE);
