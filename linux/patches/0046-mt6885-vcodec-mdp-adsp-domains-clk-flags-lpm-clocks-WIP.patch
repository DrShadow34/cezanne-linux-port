--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6885-vcodec.c
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MT6885 video codec clock gates: vdecsys_soc (VDEC power domain, soc +
+ * LAT), vdecsys (VDEC2, core), vencsys and vencsys_c1. Same layout as MT8192
+ * (clk-mt8192-vdec.c / -venc.c); bits from the BSP clk-mt6885.c
+ * vdec_*gcon_clks / venc_*gcon_clks. All gates are "set = on".
+ */
+#include <linux/clk-provider.h>
+#include <linux/platform_device.h>
+
+#include "clk-mtk.h"
+#include "clk-gate.h"
+
+#include <dt-bindings/clock/mt6885-clk.h>
+
+static const struct mtk_gate_regs vdec0_cg_regs = {
+	.set_ofs = 0x0,
+	.clr_ofs = 0x4,
+	.sta_ofs = 0x0,
+};
+
+static const struct mtk_gate_regs vdec1_cg_regs = {
+	.set_ofs = 0x200,
+	.clr_ofs = 0x204,
+	.sta_ofs = 0x200,
+};
+
+static const struct mtk_gate_regs vdec2_cg_regs = {
+	.set_ofs = 0x8,
+	.clr_ofs = 0xc,
+	.sta_ofs = 0x8,
+};
+
+#define GATE_VDEC(_id, _name, _regs, _shift)	\
+	GATE_MTK(_id, _name, "vdec_sel", _regs, _shift, &mtk_clk_gate_ops_setclr_inv)
+
+#define VDEC_CLKS(_p)								\
+static const struct mtk_gate _p##_clks[] = {					\
+	GATE_VDEC(VDEC_VDEC, #_p "_vdec", &vdec0_cg_regs, 0),			\
+	GATE_VDEC(VDEC_ACTIVE, #_p "_active", &vdec0_cg_regs, 4),		\
+	GATE_VDEC(VDEC_LAT, #_p "_lat", &vdec1_cg_regs, 0),			\
+	GATE_VDEC(VDEC_LAT_ACTIVE, #_p "_lat_active", &vdec1_cg_regs, 4),	\
+	GATE_VDEC(VDEC_LARB1, #_p "_larb1", &vdec2_cg_regs, 0),		\
+};										\
+static const struct mtk_clk_desc _p##_desc = {					\
+	.clks = _p##_clks,							\
+	.num_clks = ARRAY_SIZE(_p##_clks),					\
+}
+
+VDEC_CLKS(vdec_soc);
+VDEC_CLKS(vdec);
+
+static const struct mtk_gate_regs venc_cg_regs = {
+	.set_ofs = 0x4,
+	.clr_ofs = 0x8,
+	.sta_ofs = 0x0,
+};
+
+#define GATE_VENC(_id, _name, _shift)	\
+	GATE_MTK(_id, _name, "venc_sel", &venc_cg_regs, _shift, &mtk_clk_gate_ops_setclr_inv)
+
+#define VENC_CLKS(_p)								\
+static const struct mtk_gate _p##_clks[] = {					\
+	GATE_VENC(VENC_SET0_LARB, #_p "_set0_larb", 0),				\
+	GATE_VENC(VENC_SET1_VENC, #_p "_set1_venc", 4),				\
+	GATE_VENC(VENC_SET2_JPGENC, #_p "_set2_jpgenc", 8),			\
+	GATE_VENC(VENC_SET3_JPGDEC, #_p "_set3_jpgdec", 12),			\
+	GATE_VENC(VENC_SET4_JPGDEC_C1, #_p "_set4_jpgdec_c1", 16),		\
+	GATE_VENC(VENC_SET5_GALS, #_p "_set5_gals", 28),			\
+};										\
+static const struct mtk_clk_desc _p##_desc = {					\
+	.clks = _p##_clks,							\
+	.num_clks = ARRAY_SIZE(_p##_clks),					\
+}
+
+VENC_CLKS(venc);
+VENC_CLKS(venc_c1);
+
+static const struct of_device_id of_match_clk_mt6885_vcodec[] = {
+	{ .compatible = "mediatek,mt6885-vdecsys-soc", .data = &vdec_soc_desc },
+	{ .compatible = "mediatek,mt6885-vdecsys", .data = &vdec_desc },
+	{ .compatible = "mediatek,mt6885-vencsys", .data = &venc_desc },
+	{ .compatible = "mediatek,mt6885-vencsys-c1", .data = &venc_c1_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt6885_vcodec);
+
+static struct platform_driver clk_mt6885_vcodec_drv = {
+	.probe = mtk_clk_simple_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "clk-mt6885-vcodec",
+		.of_match_table = of_match_clk_mt6885_vcodec,
+	},
+};
+module_platform_driver(clk_mt6885_vcodec_drv);
+MODULE_DESCRIPTION("MediaTek MT6885 video codec clocks driver");
+MODULE_LICENSE("GPL");
