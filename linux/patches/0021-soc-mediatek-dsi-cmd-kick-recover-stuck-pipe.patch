 struct dsi_cmd_kick {
 	struct device *dev;
@@ -94,6 +97,7 @@ struct dsi_cmd_kick {
 	void __iomem *dsi;
 	void __iomem *mmsys;
 	void __iomem *ovl[2];		/* both pipes, for scanout address flips */
+	void __iomem *ovl_all[4];	/* OVL + OVL_2L of both pipes, for recovery */
