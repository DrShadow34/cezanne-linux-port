-			  k->frames, k->waits, k->timeouts, k->te_timeouts);
+	return sysfs_emit(buf, "frames %lu waits %lu timeouts %lu te_timeouts %lu recoveries %lu\n",
+			  k->frames, k->waits, k->timeouts, k->te_timeouts, k->recoveries);
 }
 static DEVICE_ATTR_RO(stats);
 
@@ -332,6 +363,20 @@ static int dsi_cmd_kick_probe(struct platform_device *pdev)
 		}
 	}
 
+	/* overlay engines to reset when the pipe gets stuck */
+	{
+		static const char * const names[] = { "ovl0", "ovl1", "ovl0_2l", "ovl1_2l" };
+
+		for (i = 0; i < ARRAY_SIZE(names); i++) {
+			struct resource *res;
+
+			res = platform_get_resource_byname(pdev, IORESOURCE_MEM, names[i]);
+			if (res)
+				k->ovl_all[i] = devm_ioremap(dev, res->start,
+							     resource_size(res));
+		}
+	}
+
 	/* pipe 1 RDMA gets the thresholds lk set up for pipe 0 */
