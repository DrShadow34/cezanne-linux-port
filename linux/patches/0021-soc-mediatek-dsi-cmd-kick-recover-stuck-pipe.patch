@@ -104,11 +108,36 @@ struct dsi_cmd_kick {
 	unsigned long waits;
 	unsigned long timeouts;
 	unsigned long te_timeouts;
+	unsigned long recoveries;
 };
 
 /* one panel per board; simpledrm has no handle to us */
 static struct dsi_cmd_kick *kick;
 
+/*
+ * Under heavy CPU/memory load (e.g. a parallel compile) the overlay engines
+ * can stop mid-frame waiting for memory and never finish: DSI stays busy and
+ * the panel keeps showing the last frame.  Resetting the four OVL engines and
+ * the DSI engine (their configuration survives) gets frames going again.
+ */
+static void dsi_recover(struct dsi_cmd_kick *k)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(k->ovl_all); i++) {
+		if (!k->ovl_all[i])
+			continue;
+		writel(1, k->ovl_all[i] + OVL_RST);
+		writel(0, k->ovl_all[i] + OVL_RST);
+	}
+	writel(readl(k->dsi + DSI_CON_CTRL) | DSI_RESET, k->dsi + DSI_CON_CTRL);
+	writel(readl(k->dsi + DSI_CON_CTRL) & ~DSI_RESET, k->dsi + DSI_CON_CTRL);
+	writel(0, k->dsi + DSI_INTSTA);
+	k->recoveries++;
+	dev_warn_ratelimited(k->dev, "display pipe stuck, reset OVL + DSI (%lu)\n",
+			     k->recoveries);
+}
+
 static void dsi_wait_idle(struct dsi_cmd_kick *k)
 {
 	u32 val;
@@ -116,8 +145,10 @@ static void dsi_wait_idle(struct dsi_cmd_kick *k)
 	if (!(readl(k->dsi + DSI_INTSTA) & DSI_BUSY))
 		return;
 	k->waits++;
-	if (readl_poll_timeout(k->dsi + DSI_INTSTA, val, !(val & DSI_BUSY), 50, 50000))
+	if (readl_poll_timeout(k->dsi + DSI_INTSTA, val, !(val & DSI_BUSY), 50, 50000)) {
 		k->timeouts++;
+		dsi_recover(k);
+	}
 }
 
 void mtk_dsi_cmd_kick_begin(bool wait_idle)
@@ -274,8 +305,8 @@ static ssize_t stats_show(struct device *dev, struct device_attribute *attr, cha
 {
