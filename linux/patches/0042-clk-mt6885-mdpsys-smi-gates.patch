diff --git a/drivers/clk/mediatek/clk-mt6885-cam.c b/drivers/clk/mediatek/clk-mt6885-cam.c
index ff4a75c79..d2ac2bcc7 100644
--- a/drivers/clk/mediatek/clk-mt6885-cam.c
+++ b/drivers/clk/mediatek/clk-mt6885-cam.c
@@ -3,6 +3,10 @@
  * MT6885 camera subsystem clock gates (camsys + the three raw pipes).
  * Same layout as MT8192 (clk-mt8192-cam.c) plus LARB15 and MRAW1; bits from
  * the BSP clk-mt6885.c camsys_main_clks / camsys_raw*_clks.
+ *
+ * Also the MDP subsystem's SMI gates: camera larb13 (CAMSV1-6) reaches memory
+ * through the MDP SMI common and IOMMU. And the MM SRAM's (0x1e000000, the
+ * video encoder's NBM buffers; BSP mmsram node): MMSYSRAM and APMCU_GALS.
  */
 #include <linux/clk-provider.h>
 #include <linux/platform_device.h>
@@ -55,6 +59,35 @@ CAM_RAW_CLKS(a);
 CAM_RAW_CLKS(b);
 CAM_RAW_CLKS(c);
 
+static const struct mtk_gate_regs mdp0_cg_regs = {
+	.set_ofs = 0x104,
+	.clr_ofs = 0x108,
+	.sta_ofs = 0x100,
+};
+
+static const struct mtk_gate_regs mdp1_cg_regs = {
+	.set_ofs = 0x114,
+	.clr_ofs = 0x118,
+	.sta_ofs = 0x110,
+};
+
+#define GATE_MDP(_id, _name, _regs, _shift)	\
+	GATE_MTK(_id, _name, "mdp_sel", _regs, _shift, &mtk_clk_gate_ops_setclr)
+
+static const struct mtk_gate mdp_clks[] = {
+	GATE_MDP(MDPSYS_APB_BUS, "mdp_apb_bus", &mdp0_cg_regs, 31),
+	GATE_MDP(MDPSYS_SMI0, "mdp_smi0", &mdp1_cg_regs, 4),
+	GATE_MDP(MDPSYS_SMI1, "mdp_smi1", &mdp1_cg_regs, 8),
+	GATE_MDP(MDPSYS_SMI2, "mdp_smi2", &mdp1_cg_regs, 12),
+	GATE_MDP(MDPSYS_MMSYSRAM, "mdp_mmsysram", &mdp1_cg_regs, 0),
+	GATE_MDP(MDPSYS_APMCU_GALS, "mdp_apmcu_gals", &mdp1_cg_regs, 1),
+};
+
+static const struct mtk_clk_desc mdp_desc = {
+	.clks = mdp_clks,
+	.num_clks = ARRAY_SIZE(mdp_clks),
+};
+
 static const struct mtk_clk_desc cam_desc = {
 	.clks = cam_clks,
 	.num_clks = ARRAY_SIZE(cam_clks),
@@ -65,6 +98,7 @@ static const struct of_device_id of_match_clk_mt6885_cam[] = {
 	{ .compatible = "mediatek,mt6885-camsys-rawa", .data = &cam_rawa_desc },
 	{ .compatible = "mediatek,mt6885-camsys-rawb", .data = &cam_rawb_desc },
 	{ .compatible = "mediatek,mt6885-camsys-rawc", .data = &cam_rawc_desc },
+	{ .compatible = "mediatek,mt6885-mdpsys", .data = &mdp_desc },
 	{ /* sentinel */ }
 };
 MODULE_DEVICE_TABLE(of, of_match_clk_mt6885_cam);
diff --git a/include/dt-bindings/clock/mt6885-clk.h b/include/dt-bindings/clock/mt6885-clk.h
index cafb9a71d..af5a1e5b6 100644
--- a/include/dt-bindings/clock/mt6885-clk.h
+++ b/include/dt-bindings/clock/mt6885-clk.h
@@ -369,6 +369,15 @@
 #define CAMSYS_RAW_CAMTG	2
 #define CAMSYS_RAW_NR_CLK	3
 
+/* mdpsys_config (0x1f000000): only the SMI / bus / MM SRAM gates (BSP mdpsys_config_clks) */
+#define MDPSYS_APB_BUS		0
+#define MDPSYS_SMI0		1
+#define MDPSYS_SMI1		2
+#define MDPSYS_SMI2		3
+#define MDPSYS_MMSYSRAM		4
+#define MDPSYS_APMCU_GALS	5
+#define MDPSYS_NR_CLK		6
+
 /* mmsys_config (0x14116000), BSP clk-mt6885.c mmsys_config_clks */
 #define MM_DISP_RSZ0            0
 #define MM_DISP_RSZ1            1
