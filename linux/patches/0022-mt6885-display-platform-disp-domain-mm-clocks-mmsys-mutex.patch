diff --git a/drivers/soc/mediatek/mt6885-mmsys.h b/drivers/soc/mediatek/mt6885-mmsys.h
new file mode 100644
index 000000000..a51322ebf
--- /dev/null
+++ b/drivers/soc/mediatek/mt6885-mmsys.h
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef __SOC_MEDIATEK_MT6885_MMSYS_H
+#define __SOC_MEDIATEK_MT6885_MMSYS_H
+
+/*
+ * MT6885 display routing, from the BSP mtk_drm_ddp.c
+ * (mtk_ddp_mout_en/sel_in/sout_sel_MT6885, mtk_ddp_insert_dsc_prim_MT6885).
+ * The BSP's "virtual" OVL0/RDMA0 stages are folded into the real links.
+ * Main path: OVL0_2L -> OVL0 -> RDMA0 -> COLOR0 -> CCORR0 -> AAL0 ->
+ * GAMMA0 -> POSTMASK0 -> DITHER0 -> [DSC_WRAP0 ->] DSI0 (the PQ blocks
+ * AAL0..DITHER0 are hard-wired).  lk routes CCORR0 through MDP_AAL4 (DRE);
+ * we go straight to AAL0 as the BSP does without DRE.
+ */
+#define MT6885_DISP_AAL0_SEL_IN			0x650
+#define MT6885_DISP_COLOR0_OUT_SEL_IN		0x658
+#define MT6885_DISP_CCORR0_SOUT_SEL		0xeb4
+#define MT6885_DISP_RDMA0_SEL_IN		0xf34
+#define MT6885_DISP_RDMA0_SOUT_SEL		0xf38
+#define MT6885_DISP_RDMA0_RSZ0_SEL_IN		0xf3c
+#define MT6885_DISP_RDMA0_RSZ0_SOUT_SEL		0xf40
+#define MT6885_DISP_DSC_WRAP_SOUT_SEL		0xf48
+#define MT6885_MMSYS_OVL_CON			0xf4c
+#define MT6885_DISP_DITHER0_MOUT_EN		0xf50
+#define MT6885_DSI0_SEL_IN			0xf54
+#define MT6885_DISP_OVL0_2L_OVL1_OVL1_2L_BGOUT_SEL	0xf68
+#define MT6885_DISP_OVL0_BLENDOUT_SOUT_SEL	0xf6c
+#define MT6885_DISP_TOVL0_OUT1_SEL_IN		0xf70
+#define MT6885_DISP_TOVL0_OUT1_MOUT_EN		0xf74
+#define MT6885_DISP_DSI0_DSC_WRAP_SOUT_SEL	0xf80
+#define MT6885_DISP_RDMA4_PQ0_MERGE0_SEL_IN	0xf88
+#define MT6885_DISP_PQ0_SOUT_SEL		0xff8
+
+#define MT6885_OVL_CON_OVL0_BLENDOUT		BIT(0)
+#define MT6885_OVL_CON_OVL0_2L_BGOUT		BIT(3)
+#define MT6885_BGOUT_SEL_FROM_OVL0_2L		0x1
+#define MT6885_OVL0_BLENDOUT_SOUT_TOVL0_OUT1	0x1
+#define MT6885_TOVL0_OUT1_SEL_IN_OVL0_BLENDOUT	0x1
+#define MT6885_TOVL0_OUT1_MOUT_RDMA0		BIT(0)
+#define MT6885_RDMA0_SEL_IN_TOVL0_OUT1		0x0
+#define MT6885_RDMA0_SOUT_RDMA0_RSZ0		0x0
+#define MT6885_RDMA0_RSZ0_SEL_IN_RDMA0		0x0
+#define MT6885_RDMA0_RSZ0_SOUT_COLOR0		0x1
+#define MT6885_COLOR0_OUT_SEL_IN_COLOR0		0x0
+#define MT6885_CCORR0_SOUT_AAL0			0x1
+#define MT6885_AAL0_SEL_IN_CCORR0		0x1
+#define MT6885_DITHER0_MOUT_DSI0		BIT(0)
+#define MT6885_DITHER0_MOUT_PQ0_SOUT		BIT(3)
+#define MT6885_DSI0_SEL_IN_DITHER0		0x1
+#define MT6885_DSI0_SEL_IN_DSC_WRAP		0x3
+#define MT6885_PQ0_SOUT_MERGE0_SEL		0x1
+#define MT6885_MERGE0_SEL_IN_PQ0		0x1
+#define MT6885_DSI0_DSC_WRAP_SOUT_DSC_WRAP0	0x1
+#define MT6885_DSC_WRAP_SOUT_DSI0		0x0
+
+#define MT6885_SEL_MASK				GENMASK(3, 0)
+
+/* BSP smi_reg.h MMSYS_SW0_RST_B */
+#define MT6885_MMSYS_SW0_RST_B			0x140
+
+static const struct mtk_mmsys_routes mmsys_mt6885_routing_table[] = {
+	MMSYS_ROUTE(OVL_2L, 0, OVL, 0,
+		    MT6885_MMSYS_OVL_CON, MT6885_OVL_CON_OVL0_2L_BGOUT,
+		    MT6885_OVL_CON_OVL0_2L_BGOUT),
+	MMSYS_ROUTE(OVL_2L, 0, OVL, 0,
+		    MT6885_DISP_OVL0_2L_OVL1_OVL1_2L_BGOUT_SEL, MT6885_SEL_MASK,
+		    MT6885_BGOUT_SEL_FROM_OVL0_2L),
+	MMSYS_ROUTE(OVL, 0, RDMA, 0,
+		    MT6885_MMSYS_OVL_CON, MT6885_OVL_CON_OVL0_BLENDOUT,
+		    MT6885_OVL_CON_OVL0_BLENDOUT),
+	MMSYS_ROUTE(OVL, 0, RDMA, 0,
+		    MT6885_DISP_OVL0_BLENDOUT_SOUT_SEL, MT6885_SEL_MASK,
+		    MT6885_OVL0_BLENDOUT_SOUT_TOVL0_OUT1),
+	MMSYS_ROUTE(OVL, 0, RDMA, 0,
+		    MT6885_DISP_TOVL0_OUT1_SEL_IN, MT6885_SEL_MASK,
+		    MT6885_TOVL0_OUT1_SEL_IN_OVL0_BLENDOUT),
+	MMSYS_ROUTE(OVL, 0, RDMA, 0,
+		    MT6885_DISP_TOVL0_OUT1_MOUT_EN, MT6885_TOVL0_OUT1_MOUT_RDMA0,
+		    MT6885_TOVL0_OUT1_MOUT_RDMA0),
+	MMSYS_ROUTE(OVL, 0, RDMA, 0,
+		    MT6885_DISP_RDMA0_SEL_IN, MT6885_SEL_MASK,
+		    MT6885_RDMA0_SEL_IN_TOVL0_OUT1),
+	MMSYS_ROUTE(RDMA, 0, COLOR, 0,
+		    MT6885_DISP_RDMA0_SOUT_SEL, MT6885_SEL_MASK,
+		    MT6885_RDMA0_SOUT_RDMA0_RSZ0),
+	MMSYS_ROUTE(RDMA, 0, COLOR, 0,
+		    MT6885_DISP_RDMA0_RSZ0_SEL_IN, MT6885_SEL_MASK,
+		    MT6885_RDMA0_RSZ0_SEL_IN_RDMA0),
+	MMSYS_ROUTE(RDMA, 0, COLOR, 0,
+		    MT6885_DISP_RDMA0_RSZ0_SOUT_SEL, MT6885_SEL_MASK,
+		    MT6885_RDMA0_RSZ0_SOUT_COLOR0),
+	MMSYS_ROUTE(COLOR, 0, CCORR, 0,
+		    MT6885_DISP_COLOR0_OUT_SEL_IN, MT6885_SEL_MASK,
+		    MT6885_COLOR0_OUT_SEL_IN_COLOR0),
+	MMSYS_ROUTE(CCORR, 0, AAL, 0,
+		    MT6885_DISP_CCORR0_SOUT_SEL, MT6885_SEL_MASK,
+		    MT6885_CCORR0_SOUT_AAL0),
+	MMSYS_ROUTE(CCORR, 0, AAL, 0,
+		    MT6885_DISP_AAL0_SEL_IN, MT6885_SEL_MASK,
+		    MT6885_AAL0_SEL_IN_CCORR0),
+	/* without DSC */
+	MMSYS_ROUTE(DITHER, 0, DSI, 0,
+		    MT6885_DISP_DITHER0_MOUT_EN, GENMASK(3, 0),
+		    MT6885_DITHER0_MOUT_DSI0),
+	MMSYS_ROUTE(DITHER, 0, DSI, 0,
+		    MT6885_DSI0_SEL_IN, MT6885_SEL_MASK,
+		    MT6885_DSI0_SEL_IN_DITHER0),
+	/* with DSC: DITHER0 -> PQ0_SOUT -> MERGE0_SEL -> DSC_WRAP0 -> DSI0 */
+	MMSYS_ROUTE(DITHER, 0, DSC, 0,
+		    MT6885_DISP_DITHER0_MOUT_EN, GENMASK(3, 0),
+		    MT6885_DITHER0_MOUT_PQ0_SOUT),
+	MMSYS_ROUTE(DITHER, 0, DSC, 0,
+		    MT6885_DISP_PQ0_SOUT_SEL, MT6885_SEL_MASK,
+		    MT6885_PQ0_SOUT_MERGE0_SEL),
+	MMSYS_ROUTE(DITHER, 0, DSC, 0,
+		    MT6885_DISP_RDMA4_PQ0_MERGE0_SEL_IN, MT6885_SEL_MASK,
+		    MT6885_MERGE0_SEL_IN_PQ0),
+	MMSYS_ROUTE(DSC, 0, DSI, 0,
+		    MT6885_DISP_DSI0_DSC_WRAP_SOUT_SEL, MT6885_SEL_MASK,
+		    MT6885_DSI0_DSC_WRAP_SOUT_DSC_WRAP0),
+	MMSYS_ROUTE(DSC, 0, DSI, 0,
+		    MT6885_DISP_DSC_WRAP_SOUT_SEL, MT6885_SEL_MASK,
+		    MT6885_DSC_WRAP_SOUT_DSI0),
+	MMSYS_ROUTE(DSC, 0, DSI, 0,
+		    MT6885_DSI0_SEL_IN, MT6885_SEL_MASK,
+		    MT6885_DSI0_SEL_IN_DSC_WRAP),
+};
+
+#endif /* __SOC_MEDIATEK_MT6885_MMSYS_H */
diff --git a/drivers/soc/mediatek/mtk-dsi-cmd-kick.c b/drivers/soc/mediatek/mtk-dsi-cmd-kick.c
index 20b7bb5c0..222b8ead9 100644
--- a/drivers/soc/mediatek/mtk-dsi-cmd-kick.c
+++ b/drivers/soc/mediatek/mtk-dsi-cmd-kick.c
@@ -320,6 +320,20 @@ static ssize_t resend_store(struct device *dev, struct device_attribute *attr,
 }
 static DEVICE_ATTR_WO(resend);
 
+/*
+ * Shared with mtk-mmsys / mtk-mutex (DT nodes for the mediatek-drm port), so
+ * map without claiming the regions.
+ */
+static void __iomem *kick_map(struct platform_device *pdev, const char *name)
+{
+	struct resource *res = platform_get_resource_byname(pdev, IORESOURCE_MEM, name);
+
+	if (!res)
+		return IOMEM_ERR_PTR(-EINVAL);
+	return devm_ioremap(&pdev->dev, res->start, resource_size(res)) ?:
+	       IOMEM_ERR_PTR(-ENOMEM);
+}
+
 static int dsi_cmd_kick_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -331,13 +345,13 @@ static int dsi_cmd_kick_probe(struct platform_device *pdev)
 	if (!k)
 		return -ENOMEM;
 
-	k->mutex = devm_platform_ioremap_resource_byname(pdev, "mutex");
+	k->mutex = kick_map(pdev, "mutex");
 	if (IS_ERR(k->mutex))
 		return PTR_ERR(k->mutex);
-	k->dsi = devm_platform_ioremap_resource_byname(pdev, "dsi");
+	k->dsi = kick_map(pdev, "dsi");
 	if (IS_ERR(k->dsi))
 		return PTR_ERR(k->dsi);
-	k->mmsys = devm_platform_ioremap_resource_byname(pdev, "mmsys");
+	k->mmsys = kick_map(pdev, "mmsys");
