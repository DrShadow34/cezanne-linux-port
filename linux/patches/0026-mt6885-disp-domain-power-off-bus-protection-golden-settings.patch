+/*
+ * BSP mtk_rdma_cal_golden_setting() for MT6885, command mode: the fetch
+ * thresholds are microseconds of output at the mode's pixel rate (3 bytes
+ * per pixel, FIFO entries of 16 bytes). A pipe stalls rather than
+ * underflows in command mode: no output threshold, no underflow output.
+ */
+static void mtk_rdma_golden_setting(struct mtk_disp_rdma *rdma, unsigned int width,
+				    unsigned int height, unsigned int vrefresh,
+				    unsigned int fifo, struct cmdq_pkt *cmdq_pkt)
+{
+	/* FIFO depth filled per us at the 208 MHz mmsys clock */
+	const s64 fill_rate = 96 * 208 * 3 / 16;
+	u64 rate = (u64)width * height * (vrefresh ?: 60) * 3;
+	u32 pre_lo, pre_hi, ultra_lo, issue;
+	s64 sodi_hi;
+
+	rate = div_u64(rate, 1000) * 125;
+	rate = div_u64(rate, 16 * 1000);
+#define RDMA_TH(us)	((u32)DIV_ROUND_UP_ULL(rate * (us), 1000))
+
+	pre_lo = RDMA_TH(245);
+	pre_hi = RDMA_TH(255);
+	ultra_lo = RDMA_TH(230);
+	issue = fifo - pre_lo >= 256 ? 256 : fifo - pre_lo;
+	sodi_hi = DIV_ROUND_UP_ULL(max_t(s64, (s64)fifo * 1000 -
+					 (fill_rate - (s64)rate) * 12, 0), 1000);
+	if (sodi_hi < pre_hi)
+		sodi_hi = pre_hi;
+	if (sodi_hi >= fifo)
+		sodi_hi = fifo - 1;
+
+	mtk_ddp_write(cmdq_pkt, pre_lo | pre_hi << 16 | RDMA_VALID_TH_FORCE_PRE_ULTRA,
+		      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_MEM_GMC_S0);
+	mtk_ddp_write(cmdq_pkt, ultra_lo | pre_lo << 16 | RDMA_VALID_TH_BLOCK_ULTRA,
+		      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_MEM_GMC_S1);
+	mtk_ddp_write(cmdq_pkt, issue, &rdma->cmdq_reg, rdma->regs,
+		      DISP_REG_RDMA_MEM_GMC_SETTING_2);
+	mtk_ddp_write(cmdq_pkt, fifo << 16, &rdma->cmdq_reg, rdma->regs,
+		      DISP_REG_RDMA_FIFO_CON);
+	mtk_ddp_write(cmdq_pkt, RDMA_TH(230 + 50) | (u32)sodi_hi << 16,
+		      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_TH_FOR_SODI);
+	mtk_ddp_write(cmdq_pkt, pre_lo | (pre_lo + 1) << 16, &rdma->cmdq_reg,
+		      rdma->regs, DISP_REG_RDMA_TH_FOR_DVFS);
+	mtk_ddp_write(cmdq_pkt, 0, &rdma->cmdq_reg, rdma->regs,
+		      DISP_REG_RDMA_SRAM_SEL);
+	mtk_ddp_write(cmdq_pkt, RDMA_TH(245 + 40) | RDMA_TH(255 + 40) << 16,
+		      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_DVFS_PRE);
+	mtk_ddp_write(cmdq_pkt, RDMA_TH(230 + 40) | RDMA_TH(245 + 40) << 16,
+		      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_DVFS_ULTRA);
+	mtk_ddp_write(cmdq_pkt, RDMA_TH(245 + 20) | RDMA_TH(245 + 20) << 16,
+		      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_LEAVE_DRS);
+	mtk_ddp_write(cmdq_pkt, RDMA_TH(245 + 40) | RDMA_TH(245 + 40) << 16,
+		      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_ENTER_DRS);
+	mtk_ddp_write(cmdq_pkt, RDMA_TH(113) | RDMA_TH(117) << 16,
+		      &rdma->cmdq_reg, rdma->regs, DISP_REG_RDMA_MEM_GMC_S3);
+	mtk_ddp_write_mask(cmdq_pkt, RDMA_LAYER_SMI_ID_EN, &rdma->cmdq_reg,
+			   rdma->regs, DISP_REG_RDMA_GREQ_URG_NUM_SEL,
+			   RDMA_LAYER_SMI_ID_EN);
+#undef RDMA_TH
+}
