+/*
+ * A suspend that powers the controllers down (MT6885 deep SPM: infra and
+ * MCUSYS off) leaves them at their reset values: no calibration, no sensor
+ * selection, and no sample ever turns valid again (-EAGAIN on every zone
+ * until reboot). Program them as at probe then, as the BSP does on each
+ * resume, keeping the calibration (and RC counts) from boot. The cached
+ * thresholds are dropped so the thermal core's resume update writes the
+ * trip interrupts again.
+ */
+static int lvts_ctrl_reprogram(struct device *dev, struct lvts_ctrl *lvts_ctrl)
+{
+	const struct lvts_data *lvts_data = lvts_ctrl->lvts_data;
+	int ret;
+
+	lvts_ctrl_set_enable(lvts_ctrl, true);
+
+	ret = lvts_ctrl_connect(dev, lvts_ctrl);
+	if (ret)
+		return ret;
+
+	lvts_write_config(lvts_ctrl, lvts_data->init_cmd, lvts_data->num_init_cmd);
+	if (lvts_data->rc_ref)
+		lvts_ctrl_manual_rck(dev, lvts_ctrl, false);
+
+	lvts_ctrl_calibrate(dev, lvts_ctrl);
+
+	ret = lvts_ctrl_configure(dev, lvts_ctrl);
+	if (ret)
+		return ret;
+
+	lvts_ctrl->low_thresh = INT_MIN;
+	lvts_ctrl->high_thresh = INT_MIN;
+	lvts_ctrl_select_sensors(lvts_ctrl);
+
+	return 0;
+}
