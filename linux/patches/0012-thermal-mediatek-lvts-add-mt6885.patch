+/*
+ * MT6885 (BSP lvts_Device_Enable_Init_all_Devices with LVTS_DEVICE_AUTO_RCK = 0):
+ * manual RCK, counting window 20 us, TSV2F/TSBG chopper settings, TS_EN with a
+ * TSDIV_EN/TSVCO toggle, then single mode. The MT8192 default list enables
+ * auto-RCK, which gives spurious samples on this SoC.
+ */
+static const u32 mt6885_init_cmds[] = {
+	0xC1030300, 0xC1030420, 0xC1030500, 0xC1030AC4, 0xC1030C7C,
+	0xC103098D, 0xC10308F5, 0xC10308FC, 0xC10308F5, 0xC10307A6
+};
+
+/*
+ * Efuse reference RC counts (BSP lvts_thermal_cal_prepare): controller 0 (MCU
+ * big0) in word 21 [23:0]; controllers 1..6 packed in the top bytes of words
+ * 3k-2, 3k-1, 3k.
+ */
+static u32 lvts_mt6885_rc_ref(const u8 *calib, size_t len, int ctrl)
+{
+	const __le32 *w = (const __le32 *)calib;
+	int k = 3 * ctrl;
+
+	if (len < 22 * 4 || ctrl < 0 || ctrl > 6)
+		return 0;
+	if (!ctrl)
+		return le32_to_cpu(w[21]) & GENMASK(23, 0);
+	return (le32_to_cpu(w[k - 2]) >> 24) << 16 |
+	       (le32_to_cpu(w[k - 1]) >> 24) << 8 |
+	       (le32_to_cpu(w[k]) >> 24);
+}
