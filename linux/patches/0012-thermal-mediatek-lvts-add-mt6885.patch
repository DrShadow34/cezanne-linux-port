+#define LVTS_RDATA0(__base)		(__base + 0x00B0)
+#define LVTS_DEVICE_ACCESS_START	BIT(24)
+#define LVTS_DEVICE_SENSING_STATUS	BIT(25)
+
+static void lvts_wait_config(struct lvts_ctrl *lvts_ctrl, u32 busy)
+{
+	u32 val;
+
+	readl_poll_timeout(LVTS_CONFIG(lvts_ctrl->base), val, !(val & busy), 2, 200);
+}
+
+static void lvts_dev_write(struct lvts_ctrl *lvts_ctrl, u8 reg, u8 data)
+{
+	writel(0xC1030000 | reg << 8 | data, LVTS_CONFIG(lvts_ctrl->base));
+	usleep_range(5, 10);
+	lvts_wait_config(lvts_ctrl, LVTS_DEVICE_ACCESS_START);
+}
+
+static u32 lvts_dev_read(struct lvts_ctrl *lvts_ctrl, u8 reg)
+{
+	writel(0x81020000 | reg << 8, LVTS_CONFIG(lvts_ctrl->base));
+	usleep_range(5, 10);
+	lvts_wait_config(lvts_ctrl, LVTS_DEVICE_ACCESS_START);
+	return readl(LVTS_RDATA0(lvts_ctrl->base));
+}
+
+/*
+ * BSP lvts_device_read_count_RC_N() with LVTS_REFINE_MANUAL_RCK_WITH_EFUSE:
+ * count each sensor's RC oscillator, fall back to the efuse reference when the
+ * count is missing or more than 6% off, and fold it into the calibration
+ * (LVTS_EDATA = count_r * count_rc_now >> 14).
+ */
+static void lvts_ctrl_manual_rck(struct device *dev, struct lvts_ctrl *lvts_ctrl)
+{
+	u32 ref = lvts_ctrl->count_rc_ref;
+	int i, n = hweight8(lvts_ctrl->valid_sensor_mask);
+
+	lvts_dev_write(lvts_ctrl, 0x0e, 0x00);		/* manual RCK */
+	for (i = 0; i < n; i++) {
+		u32 rc;
+
+		lvts_dev_write(lvts_ctrl, 0x0d, i);	/* sensor i with RCK */
+		lvts_dev_write(lvts_ctrl, 0x06, 0x78);
+		lvts_dev_write(lvts_ctrl, 0x07, 0xa6);
+		lvts_dev_write(lvts_ctrl, 0x08, 0xf5);	/* TS_EN */
+		lvts_dev_write(lvts_ctrl, 0x08, 0xfc);	/* toggle TSDIV_EN/TSVCO_TG */
+		lvts_dev_write(lvts_ctrl, 0x08, 0xf5);
+		udelay(10);
+		lvts_dev_write(lvts_ctrl, 0x03, 0x02);	/* kick off RCK counting */
+		udelay(30);
+		lvts_wait_config(lvts_ctrl, LVTS_DEVICE_SENSING_STATUS);
+		rc = lvts_dev_read(lvts_ctrl, 0x00) & GENMASK(23, 0);
+		lvts_dev_write(lvts_ctrl, 0x08, 0xf1);	/* TS_EN off */
+
+		if (!rc || (ref && (max(rc, ref) * 1000ULL / min(rc, ref) > 1061))) {
+			dev_dbg(dev, "sensor %d: RC count %u, using efuse %u\n", i, rc, ref);
+			rc = ref;
+		}
+		if (rc)
+			lvts_ctrl->calibration[i] =
+				((u64)lvts_ctrl->calibration[i] * rc) >> 14;
+	}
+	lvts_dev_write(lvts_ctrl, 0x0d, 0x10);		/* sensors without RCK */
+	lvts_dev_write(lvts_ctrl, 0x06, 0xb8);		/* single mode */
+}
