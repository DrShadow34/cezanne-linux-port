@@ -1070,9 +1071,17 @@ static void mtk_crtc_atomic_begin(struct drm_crtc *crtc,
 	}
 }
 
-/* PQ output requested on the connector driven by this crtc in this commit */
-static bool mtk_crtc_hdr_pq(struct drm_crtc *crtc, struct drm_atomic_commit *state,
-			    bool *found)
+/* the panel's peak in the EDID / tables (mtk_hdr_tables.h) */
+#define MTK_HDR_PEAK_NITS	1200
+
+/*
+ * HDR output requested on the connector driven by this crtc in this commit.
+ * A source that says its content is mastered brighter than the panel (mpv
+ * on KMS: 10000) gets the roll-off table; one that already mapped to the
+ * display (mutter: no mastering luminance) gets the clipping one.
+ */
+static int mtk_crtc_hdr_mode(struct drm_crtc *crtc, struct drm_atomic_commit *state,
+			     bool *found)
 {
 	struct drm_connector_state *conn_state;
 	const struct hdr_output_metadata *md;
@@ -1085,11 +1094,16 @@ static bool mtk_crtc_hdr_pq(struct drm_crtc *crtc, struct drm_atomic_commit *sta
 			continue;
 		*found = true;
 		if (!conn_state->hdr_output_metadata)
-			return false;
+			return MTK_HDR_OFF;
 		md = conn_state->hdr_output_metadata->data;
-		return md->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084;
+		if (md->hdmi_metadata_type1.eotf != HDMI_EOTF_SMPTE_ST2084)
+			return MTK_HDR_OFF;
+		if (md->hdmi_metadata_type1.max_display_mastering_luminance >
+		    MTK_HDR_PEAK_NITS)
+			return MTK_HDR_PQ_ROLLOFF;
+		return MTK_HDR_PQ;
 	}
-	return false;
+	return MTK_HDR_OFF;
 }
 
