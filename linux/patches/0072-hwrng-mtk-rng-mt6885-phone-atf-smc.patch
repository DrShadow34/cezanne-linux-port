@@ -35,8 +35,13 @@
 
 /* Driver feature flags */
 #define MTK_RNG_SMC			BIT(0)
+/* the phone BSP's ATF call (MT6885): 16 bytes a call in a0..a3, no status */
+#define MTK_RNG_SMC_PHONE		BIT(1)
+#define MTK_RNG_SMC_ANY			(MTK_RNG_SMC | MTK_RNG_SMC_PHONE)
 
 #define MTK_SIP_KERNEL_GET_RND		MTK_SIP_SMC_CMD(0x550)
+#define MTK_SIP_KERNEL_GET_RND_PHONE	MTK_SIP_SMC_CMD(0x26a)
+#define MTK_RNG_PHONE_MAGIC		0x74726e67	/* "trng" */
 
 #define to_mtk_rng(p)	container_of(p, struct mtk_rng, rng)
 
@@ -133,6 +138,57 @@ static int mtk_rng_read_smc(struct hwrng *rng, void *buf, size_t max,
 	return retval || !wait ? retval : -EIO;
 }
 
+static void mtk_rng_smc_phone(u32 val[4])
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MTK_SIP_KERNEL_GET_RND_PHONE, MTK_RNG_PHONE_MAGIC,
+		      0, 0, 0, 0, 0, 0, &res);
+	val[0] = res.a0;
+	val[1] = res.a1;
+	val[2] = res.a2;
+	val[3] = res.a3;
+}
+
+static int mtk_rng_read_smc_phone(struct hwrng *rng, void *buf, size_t max,
+				  bool wait)
+{
+	u32 val[4];
+	int retval = 0;
+
+	while (max >= sizeof(u32)) {
+		size_t n = min(max, sizeof(val)) & ~(sizeof(u32) - 1);
+
+		mtk_rng_smc_phone(val);
+		memcpy(buf, val, n);
+		buf += n;
+		max -= n;
+		retval += n;
+	}
+	memzero_explicit(val, sizeof(val));
+
+	return retval;
+}
+
+/*
+ * The call returns no status: firmware without it answers
+ * SMCCC_RET_NOT_SUPPORTED in a0 (the rest left as passed), so two calls
+ * must differ.
+ */
+static bool mtk_rng_smc_phone_works(void)
+{
+	u32 a[4], b[4];
+	bool ok;
+
+	mtk_rng_smc_phone(a);
+	mtk_rng_smc_phone(b);
+	ok = a[0] != (u32)SMCCC_RET_NOT_SUPPORTED && memcmp(a, b, sizeof(a));
+	memzero_explicit(a, sizeof(a));
+	memzero_explicit(b, sizeof(b));
+
+	return ok;
+}
+
 static bool mtk_rng_hw_accessible(struct mtk_rng *priv)
 {
 	u32 val;
