index 000000000..c66570f8b
--- /dev/null
+++ b/drivers/tty/serial/earlycon-ramlog.c
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * earlycon that writes into a RAM buffer laid out as a pstore/ramoops
+ * persistent_ram_buffer, for boards with no reachable UART. After a reset the
+ * log shows up in the next OS's /sys/fs/pstore/console-ramoops.
+ *
+ *   earlycon=ramlog,<phys-addr>[,<zone-size>]
+ *
+ * The log simply stops when the window is full (no wrapping), so the result
+ * stays valid for a reader that assumes a larger zone.
+ *
+ * The buffer is mapped as device memory (writes must reach DRAM before a
+ * watchdog reset), so every access goes through the MMIO accessors: plain C
+ * accesses may be merged into unaligned stores, which fault on device memory.
+ */
+
+#include <linux/console.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/serial_core.h>
+#include <asm/early_ioremap.h>
+
+#define RAMLOG_SIG		0x43474244	/* PERSISTENT_RAM_SIG ^ console zone */
+#define RAMLOG_DEFAULT_SIZE	0x3c000	/* stay below early_ioremap's 64-page limit */
+
+/* struct persistent_ram_buffer: u32 sig, u32 start, u32 size, u8 data[] */
+#define RAMLOG_OFF_SIG		0
+#define RAMLOG_OFF_START	4
+#define RAMLOG_OFF_SIZE		8
+#define RAMLOG_OFF_DATA		12
+
+static void __iomem *ramlog;
+static u32 ramlog_cap;
+
+static void ramlog_write(struct console *con, const char *s, unsigned int n)
+{
+	u32 size = readl(ramlog + RAMLOG_OFF_SIZE);
+
+	while (n-- && size < ramlog_cap)
+		writeb(*s++, ramlog + RAMLOG_OFF_DATA + size++);
+	writel(size, ramlog + RAMLOG_OFF_START);
+	writel(size, ramlog + RAMLOG_OFF_SIZE);
+	/* make it reach DRAM before a possible watchdog reset */
+	dsb(sy);
+}
+
+/* bring-up debug: append a line using a temporary one-page mapping */
+static void __init ramlog_mark(phys_addr_t base, const char *fmt, ...)
+{
+	void __iomem *b = early_ioremap(base, PAGE_SIZE);
+	char line[96];
+	va_list ap;
+	u32 size;
+	int i, n;
+
+	if (!b)
+		return;
+	va_start(ap, fmt);
+	n = vscnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	size = readl(b + RAMLOG_OFF_SIZE);
+	for (i = 0; i < n && RAMLOG_OFF_DATA + size < PAGE_SIZE; i++)
+		writeb(line[i], b + RAMLOG_OFF_DATA + size++);
+	writel(size, b + RAMLOG_OFF_SIZE);
+	dsb(sy);
+	early_iounmap(b, PAGE_SIZE);
+}
+
+static int __init ramlog_setup(struct earlycon_device *dev, const char *opt)
+{
+	static const char hello[] = "RAMLOG: earlycon attached\n";
+	phys_addr_t base = dev->port.mapbase;
+	unsigned long zone = RAMLOG_DEFAULT_SIZE;
+	const char *p;
+
+	ramlog_mark(0x4d05f000, "RAMLOG: setup base=%pa opt=%s\n", &base, opt ?: "-");
+	if (!base)
+		return -ENODEV;
+	/* options after the address: "<zone-size>" */
+	if (opt && (p = strchr(opt, ',')) && kstrtoul(p + 1, 0, &zone))
+		zone = RAMLOG_DEFAULT_SIZE;
+
+	ramlog = early_ioremap(base, zone);
+	ramlog_mark(base, "RAMLOG: map %lx bytes -> %px\n", zone, ramlog);
+	if (!ramlog)
+		return -ENOMEM;
+	ramlog_cap = zone - RAMLOG_OFF_DATA;
+
+	/* continue an existing log (e.g. boot shim markers), else start fresh */
+	if (readl(ramlog + RAMLOG_OFF_SIG) != RAMLOG_SIG ||
+	    readl(ramlog + RAMLOG_OFF_SIZE) > ramlog_cap) {
+		writel(RAMLOG_SIG, ramlog + RAMLOG_OFF_SIG);
+		writel(0, ramlog + RAMLOG_OFF_SIZE);
+	}
+
+	ramlog_write(NULL, hello, sizeof(hello) - 1);
+	dev->con->write = ramlog_write;
+	return 0;
+}
+EARLYCON_DECLARE(ramlog, ramlog_setup);
