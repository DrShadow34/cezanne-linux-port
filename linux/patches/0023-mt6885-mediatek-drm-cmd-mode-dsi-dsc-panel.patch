+/*
+ * Drop every module from a mutex, e.g. ones a bootloader left in it for a
+ * pipeline the caller does not drive (would otherwise start with each frame).
+ */
+void mtk_mutex_clear_mods(struct mtk_mutex *mutex)
+{
+	struct mtk_mutex_ctx *mtx = container_of(mutex, struct mtk_mutex_ctx,
+						 mutex[mutex->id]);
+
+	WARN_ON(&mtx->mutex[mutex->id] != mutex);
+
+	writel(0, mtx->regs + DISP_REG_MUTEX_EN(mutex->id));
+	writel_relaxed(0, mtx->regs + mtx->data->mutex_mod_reg + 0x20 * mutex->id);
+	if (mtx->data->mutex_mod1_reg)
+		writel_relaxed(0, mtx->regs + mtx->data->mutex_mod1_reg +
+			       0x20 * mutex->id);
+}
+EXPORT_SYMBOL_GPL(mtk_mutex_clear_mods);
