+				     0x00, 0x00, 0x09, 0x5f);
+
+	/* 11-bit dimming */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x4f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* error flag */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xec, 0x00, 0xc2, 0xc2, 0x42);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x0d);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xec, 0x19);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe4, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* TE frequency (121.4 / 60.7 Hz) */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x16);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd1, 0x11);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* ripple improvement */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x36);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x0f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x03);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* OFC (MIPI 820 Mbps, OSC 91.8 MHz) */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe4, 0xdf, 0x4c, 0xa2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe9,
+				     0x11, 0x75, 0xdf, 0x4c, 0xa2, 0xa6, 0x37, 0xbe,
+				     0xa6, 0x37, 0xbe, 0x00, 0x32, 0x32);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_msleep(&dsi_ctx, 80);
+
+	/* 60 Hz (0x10 0x00 = 120 Hz) */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x00, 0x00);
+
+	/* dimming */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x06);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x10);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x13);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	/* HBM off, backlight 0 until the backlight device sets it */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x20, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				     0x00, 0x00);
+
+	/* ACL off */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0xd9);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xbb, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	/* colour: P3 tables (vendor CRC_P3 default) */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x81, 0x92);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb1, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01, 0xb1);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb1,
+				     0x9c, 0x07, 0x04, 0x3e, 0xc1, 0x13, 0x07, 0x07,
+				     0xa5, 0x52, 0xe2, 0xd3, 0xb9, 0x11, 0xbd, 0xe4,
+				     0xd8, 0x1b, 0xff, 0xf5, 0xe0);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x2b, 0xb1);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb1,
+				     0xb7, 0x00, 0x00, 0x15, 0xc2, 0x00, 0x08, 0x08,
+				     0xb9, 0x26, 0xee, 0xdb, 0xdc, 0x05, 0xcc, 0xe4,
+				     0xd7, 0x00, 0xff, 0xff, 0xff);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	return dsi_ctx.accum_err;
+}
+
+static int j10_prepare(struct drm_panel *panel)
+{
+	struct j10_panel *ctx = to_j10_panel(panel);
+	int ret;
+
+	ret = regulator_enable(ctx->vci);
+	if (ret)
+		return ret;
+	gpiod_set_value_cansleep(ctx->bias_gpio, 1);
+	j10_reset(ctx);
+
+	ret = j10_on(ctx);
+	if (ret < 0) {
+		dev_err(panel->dev, "panel init failed: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		gpiod_set_value_cansleep(ctx->bias_gpio, 0);
+		regulator_disable(ctx->vci);
+	}
+	return ret;
+}
+
+static int j10_unprepare(struct drm_panel *panel)
+{
+	struct j10_panel *ctx = to_j10_panel(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	gpiod_set_value_cansleep(ctx->bias_gpio, 0);
+	regulator_disable(ctx->vci);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	return 0;
+}
+
+/* 60 Hz; clock gives exactly 60 Hz with the vendor porches */
+static const struct drm_display_mode j10_mode = {
+	.clock = (1080 + 40 + 10 + 20) * (2400 + 20 + 2 + 8) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 40,
+	.hsync_end = 1080 + 40 + 10,
+	.htotal = 1080 + 40 + 10 + 20,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 20,
+	.vsync_end = 2400 + 20 + 2,
+	.vtotal = 2400 + 20 + 2 + 8,
+	.width_mm = 70,
+	.height_mm = 155,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int j10_get_modes(struct drm_panel *panel,
+			 struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &j10_mode);
+}
+
+static const struct drm_panel_funcs j10_panel_funcs = {
+	.prepare = j10_prepare,
+	.unprepare = j10_unprepare,
+	.get_modes = j10_get_modes,
+};
+
+static int j10_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	return ret < 0 ? ret : 0;
+}
+
+static const struct backlight_ops j10_bl_ops = {
+	.update_status = j10_bl_update_status,
+};
+
+static int j10_probe(struct mipi_dsi_device *dsi)
+{
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 1023,
+		.max_brightness = J10_MAX_BRIGHTNESS,
+	};
+	struct device *dev = &dsi->dev;
+	struct j10_panel *ctx;
+	struct drm_dsc_config *dsc;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct j10_panel, panel,
+				   &j10_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->vci = devm_regulator_get(dev, "vci");
+	if (IS_ERR(ctx->vci))
+		return dev_err_probe(dev, PTR_ERR(ctx->vci), "vci supply\n");
+	/* lk left the panel running: keep it out of reset until prepare */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio), "reset gpio\n");
+	ctx->bias_gpio = devm_gpiod_get(dev, "bias", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->bias_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->bias_gpio), "bias gpio\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	/* vendor dsc_params (DSC 1.1); the encoder is set up from this */
+	dsc = &ctx->dsc;
+	dsc->dsc_version_major = 1;
+	dsc->dsc_version_minor = 1;
+	dsc->pic_width = 1080;
+	dsc->pic_height = 2400;
+	dsc->slice_width = 540;
+	dsc->slice_height = 8;
+	dsc->slice_count = 2;
+	dsc->slice_chunk_size = 540;
+	dsc->bits_per_component = 8;
+	dsc->bits_per_pixel = 8 << 4;
+	dsc->line_buf_depth = 9;
+	dsc->convert_rgb = true;
+	dsc->block_pred_enable = true;
+	dsc->initial_xmit_delay = 512;
+	dsc->initial_dec_delay = 526;
+	dsc->initial_scale_value = 32;
+	dsc->scale_increment_interval = 187;
+	dsc->scale_decrement_interval = 7;
+	dsc->first_line_bpg_offset = 12;
+	dsc->nfl_bpg_offset = 3511;
+	dsc->slice_bpg_offset = 3255;
+	dsc->initial_offset = 6144;
+	dsc->final_offset = 4336;
+	dsc->flatness_min_qp = 3;
+	dsc->flatness_max_qp = 12;
+	dsc->rc_model_size = 8192;
+	dsc->rc_edge_factor = 6;
+	dsc->rc_quant_incr_limit0 = 11;
+	dsc->rc_quant_incr_limit1 = 11;
+	dsc->rc_tgt_offset_high = 3;
+	dsc->rc_tgt_offset_low = 3;
+	dsi->dsc = dsc;
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->hs_rate = 820000000;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->panel.prepare_prev_first = true;
+	ctx->panel.backlight = devm_backlight_device_register(dev, dev_name(dev),
+							      dev, dsi,
+							      &j10_bl_ops, &props);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "backlight\n");
+
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "mipi_dsi_attach\n");
+	}
+	return 0;
+}
+
+static void j10_remove(struct mipi_dsi_device *dsi)
+{
+	struct j10_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id j10_of_match[] = {
+	{ .compatible = "xiaomi,j10-38-08-0a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, j10_of_match);
+
+static struct mipi_dsi_driver j10_driver = {
+	.probe = j10_probe,
+	.remove = j10_remove,
+	.driver = {
+		.name = "panel-xiaomi-j10-38-08-0a",
+		.of_match_table = j10_of_match,
+	},
+};
+module_mipi_dsi_driver(j10_driver);
+
+MODULE_DESCRIPTION("Redmi K30 Ultra j10 (38 08 0a) DSC command-mode AMOLED panel");
+MODULE_LICENSE("GPL");
