+	const struct drm_dsc_config *dsc = mtk_dsi_get_dsc();
+
+	if (dsc) {
+		mtk_dsc_encoder_config(priv, dsc, w, h);
+		return;
+	}
 
 	/* dsc bypass mode */
 	mtk_ddp_write_mask(cmdq_pkt, DSC_BYPASS, &priv->cmdq_reg, priv->regs,
@@ -555,6 +646,14 @@ static bool mtk_ddp_path_available(const unsigned int *path,
