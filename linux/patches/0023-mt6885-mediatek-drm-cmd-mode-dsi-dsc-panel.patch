+/*
+ * Real compression for a panel that asked for DSC (mipi_dsi_device.dsc, via
+ * the DSI host).  Register programming from the MediaTek BSP mtk_dsc_config
+ * (MT6885, DSC 1.1, single pipe); PPS6-19 are the BSP's fixed rate-control
+ * tables (the DSC 1.1 defaults for 8 bpc / 8 bpp).
+ */
+static void mtk_dsc_encoder_config(struct mtk_ddp_comp_dev *priv,
+				   const struct drm_dsc_config *dsc,
+				   unsigned int w, unsigned int h)
+{
+	static const u32 rc_tables[14] = {
+		0x20000c03, 0x330b0b06, 0x382a1c0e, 0x69625446, 0x7b797770,
+		0x00007e7d, 0x00800880, 0xf8c100a1, 0xe8e3f0e3, 0xe103e0e3,
+		0xd943e123, 0xd185d965, 0xd1a7d1a5, 0x0000d1ed,
+	};
+	void __iomem *regs = priv->regs;
+	unsigned int sw = dsc->slice_width, sh = dsc->slice_height;
+	unsigned int pic_group_width = (w + 2) / 3;
+	unsigned int pic_height_ext = DIV_ROUND_UP(h, sh);
+	unsigned int slice_group_width = (sw + 2) / 3;
+	unsigned int chunk = sw * dsc->bits_per_pixel / 8 / 16;
+	unsigned int pad = (chunk + 2) / 3 * 3 - chunk;
+	int i;
+
+	writel(DSC_UFOE_SEL | DSC_EMPTY_FLAG_ALWAYS_HIGH, regs + DISP_REG_DSC_CON);
+	writel((pic_group_width - 1) << 16 | w, regs + DISP_REG_DSC_PIC_W);
+	writel((pic_height_ext * sh - 1) << 16 | (h - 1), regs + DISP_REG_DSC_PIC_H);
+	writel((slice_group_width - 1) << 16 | sw, regs + DISP_REG_DSC_SLICE_W);
+	writel((sw % 3) << 30 | (pic_height_ext - 1) << 16 | (sh - 1),
+	       regs + DISP_REG_DSC_SLICE_H);
+	writel(chunk, regs + DISP_REG_DSC_CHUNK_SIZE);
+	writel(pad, regs + DISP_REG_DSC_PAD);
+	writel(chunk * sh, regs + DISP_REG_DSC_BUF_SIZE);
+	writel((readl(regs + DISP_REG_DSC_MODE) & ~0xffff) |
+	       (dsc->slice_count > 1 ? DSC_SLICE_MODE : 0) |
+	       DSC_INIT_DELAY_HEIGHT(4), regs + DISP_REG_DSC_MODE);
+	writel(0x22, regs + DISP_REG_DSC_CFG);		/* BSP dsc_cfg 34 */
+	writel(readl(regs + DISP_REG_DSC_DBG_CON) | DSC_CKSM_CAL_EN,
+	       regs + DISP_REG_DSC_DBG_CON);
+	/* registers take effect at once: no command queue to commit them */
+	writel((readl(regs + DISP_REG_DSC_SHADOW) & ~DSC_SHADOW_MASK) |
+	       DSC_BYPASS_SHADOW | DSC_FORCE_COMMIT | DSC_SHADOW_VER_1_1,
+	       regs + DISP_REG_DSC_SHADOW);
+
+	writel(dsc->line_buf_depth | dsc->bits_per_component << 4 |
+	       dsc->bits_per_pixel << 8 | dsc->convert_rgb << 18 |
+	       dsc->block_pred_enable << 19, regs + DISP_REG_DSC_PPS(0));
+	writel(dsc->initial_xmit_delay | dsc->initial_dec_delay << 16,
+	       regs + DISP_REG_DSC_PPS(1));
+	writel(dsc->initial_scale_value | dsc->scale_increment_interval << 16,
+	       regs + DISP_REG_DSC_PPS(2));
+	writel(dsc->scale_decrement_interval | dsc->first_line_bpg_offset << 16,
+	       regs + DISP_REG_DSC_PPS(3));
+	writel(dsc->nfl_bpg_offset | dsc->slice_bpg_offset << 16,
+	       regs + DISP_REG_DSC_PPS(4));
+	writel(dsc->initial_offset | dsc->final_offset << 16,
+	       regs + DISP_REG_DSC_PPS(5));
+	for (i = 0; i < ARRAY_SIZE(rc_tables); i++)
+		writel(rc_tables[i], regs + DISP_REG_DSC_PPS(6 + i));
+	writel(0x800002c2, regs + DISP_REG_DSC_OBUF);	/* BSP: FHD+ out buffer */
+}
