diff --git a/drivers/gpu/drm/mediatek/mtk_ddp_comp.c b/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
index e6d987e67..cfa38832e 100644
--- a/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
+++ b/drivers/gpu/drm/mediatek/mtk_ddp_comp.c
@@ -750,6 +750,40 @@ static void mtk_ddp_comp_clk_put(void *_clk)
 	clk_put(clk);
 }
 
+/*
+ * Without an IOMMU nothing links a DMA block to its SMI larb ("mediatek,larb"):
+ * the larb would stay runtime-suspended, its clocks off and, after the
+ * display domain was power-cycled (suspend), its ports back to translated.
+ */
+static int mtk_ddp_comp_link_larb(struct device_node *node, struct device *dev)
+{
+	struct platform_device *larb_pdev;
+	struct device_node *larb_node;
+	struct device_link *link;
+
+	larb_node = of_parse_phandle(node, "mediatek,larb", 0);
+	if (!larb_node)
+		return 0;
+
+	larb_pdev = of_find_device_by_node(larb_node);
+	of_node_put(larb_node);
+	if (!larb_pdev)
+		return -EPROBE_DEFER;
+	if (!platform_get_drvdata(larb_pdev)) {
+		put_device(&larb_pdev->dev);
+		return -EPROBE_DEFER;
+	}
+
+	link = device_link_add(dev, &larb_pdev->dev,
+			       DL_FLAG_PM_RUNTIME | DL_FLAG_STATELESS);
+	put_device(&larb_pdev->dev);
+	if (!link) {
+		dev_err(dev, "Unable to link SMI larb\n");
+		return -EINVAL;
+	}
+	return 0;
+}
+
 int mtk_ddp_comp_init(struct device *dev, struct device_node *node, struct mtk_ddp_comp *comp,
 		      unsigned int comp_id)
 {
@@ -782,6 +816,10 @@ int mtk_ddp_comp_init(struct device *dev, struct device_node *node, struct mtk_d
 	if (ret)
 		return ret;
 
+	ret = mtk_ddp_comp_link_larb(node, comp->dev);
+	if (ret)
+		return ret;
+
 	if (type == MTK_DISP_AAL ||
 	    type == MTK_DISP_BLS ||
 	    type == MTK_DISP_CCORR ||
diff --git a/drivers/memory/mtk-smi.c b/drivers/memory/mtk-smi.c
index aaeba8ab2..2b294f82a 100644
--- a/drivers/memory/mtk-smi.c
+++ b/drivers/memory/mtk-smi.c
@@ -157,6 +157,13 @@ struct mtk_smi_larb { /* larb: local arbiter */
 	int				larbid;
 	u32				*mmu;
 	unsigned char			*bank;
+	/*
+	 * Without an IOMMU bound to it the larb keeps every port in MMU
+	 * bypass (physical addresses): its id then comes from the DT and
+	 * mmu points here.
+	 */
+	u32				no_mmu;
+	unsigned char			no_bank[32];
 };
 
 static int
@@ -280,6 +287,16 @@ static int mtk_smi_larb_config_port_gen2_general(struct device *dev)
 		reg |= BANK_SEL(larb->bank[i]);
 		writel(reg, larb->base + SMI_LARB_NONSEC_CON(i));
 	}
+
+	/* no IOMMU: the ports come up translated after a power cycle */
+	if (larb->mmu == &larb->no_mmu) {
+		for (i = 0; i < 32; i++) {
+			reg = readl_relaxed(larb->base + SMI_LARB_NONSEC_CON(i));
+			if (reg & F_MMU_EN)
+				writel(reg & ~F_MMU_EN,
+				       larb->base + SMI_LARB_NONSEC_CON(i));
+		}
+	}
 	return 0;
 }
 
