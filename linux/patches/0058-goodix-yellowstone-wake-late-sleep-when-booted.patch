input: goodix_yellowstone: wake late, sleep only once booted

Real AOD standby stayed at ~34 mA asleep while one long suspend was
~20 mA: at every AOD minute wake resume reset the chip and the AOD
suspended again ~0.2 s later, while the GT9896 firmware was still
starting, so the sleep command was lost and it scanned through the next
minute. Resume now resets it from delayed work (500 ms): short wakes
leave it asleep. If it was reset, suspend waits until it had 300 ms to
boot before sending the sleep command.

diff --git a/drivers/input/touchscreen/goodix_yellowstone.c b/drivers/input/touchscreen/goodix_yellowstone.c
index d706f7431..e046373d7 100644
--- a/drivers/input/touchscreen/goodix_yellowstone.c
+++ b/drivers/input/touchscreen/goodix_yellowstone.c
@@ -18,8 +18,10 @@
  *
  * System suspend: command 0x05 (sleep) to the command register, as the
  * vendor driver does; it scanned on through every suspend before. A reset
- * wakes it again, from a work item so it doesn't hold up resume (the AOD's
- * minute wakes are ~0.1 s).
+ * wakes it again, from delayed work so short wakes (the AOD's minute wakes,
+ * ~0.2 s) leave it asleep. A sleep command sent while its firmware is still
+ * starting after the reset is lost and it scans through the next suspend
+ * (~16 mA), so suspend waits until it has had GOODIX_YS_BOOT_MS.
  */
 #include <linux/delay.h>
 #include <linux/devm-helpers.h>
@@ -43,13 +45,16 @@
 #define GOODIX_YS_MAX_TOUCH	10
 #define GOODIX_YS_TOUCH_EVENT	0x80
 #define GOODIX_YS_CMD_SLEEP	0x05
+#define GOODIX_YS_WAKE_DELAY_MS	500
+#define GOODIX_YS_BOOT_MS	300
 
 struct goodix_ys {
 	struct i2c_client *client;
 	struct input_dev *input;
 	struct gpio_desc *reset_gpio;
 	struct touchscreen_properties prop;
-	struct work_struct resume_work;
+	struct delayed_work resume_work;
+	unsigned long ready;		/* jiffies: running after the reset */
 	u8 buf[GOODIX_YS_HEAD_LEN + GOODIX_YS_POINT_LEN * GOODIX_YS_MAX_TOUCH + 4];
 };
 
@@ -173,9 +178,11 @@ static void goodix_ys_reset(struct goodix_ys *ts)
 
 static void goodix_ys_resume_work(struct work_struct *work)
 {
-	struct goodix_ys *ts = container_of(work, struct goodix_ys, resume_work);
+	struct goodix_ys *ts = container_of(to_delayed_work(work),
+					    struct goodix_ys, resume_work);
 
 	goodix_ys_reset(ts);
+	ts->ready = jiffies + msecs_to_jiffies(GOODIX_YS_BOOT_MS);
 	goodix_ys_write_u8(ts, GOODIX_YS_REG_ESD, 0);
 	enable_irq(ts->client->irq);
 }
@@ -186,8 +193,10 @@ static int goodix_ys_suspend(struct device *dev)
 	int ret;
 
 	/* the last resume's reset not run yet: still asleep, IRQ off */
-	if (cancel_work_sync(&ts->resume_work))
+	if (cancel_delayed_work_sync(&ts->resume_work))
 		return 0;
+	if (time_before(jiffies, ts->ready))
+		msleep(jiffies_to_msecs(ts->ready - jiffies));
 	disable_irq(ts->client->irq);
 	ret = goodix_ys_command(ts, GOODIX_YS_CMD_SLEEP);
 	if (ret)
@@ -199,7 +208,8 @@ static int goodix_ys_resume(struct device *dev)
 {
 	struct goodix_ys *ts = dev_get_drvdata(dev);
 
-	schedule_work(&ts->resume_work);
+	schedule_delayed_work(&ts->resume_work,
+			      msecs_to_jiffies(GOODIX_YS_WAKE_DELAY_MS));
 	return 0;
 }
 
@@ -230,6 +240,7 @@ static int goodix_ys_probe(struct i2c_client *client)
 		return dev_err_probe(dev, PTR_ERR(ts->reset_gpio), "reset gpio\n");
 
 	goodix_ys_reset(ts);
+	ts->ready = jiffies + msecs_to_jiffies(GOODIX_YS_BOOT_MS);
 	/* "dynamic esd" init, as the vendor driver does after every reset */
 	goodix_ys_write_u8(ts, GOODIX_YS_REG_ESD, 0);
 
@@ -269,7 +280,8 @@ static int goodix_ys_probe(struct i2c_client *client)
 		return ret;
 
 	/* after the IRQ: cancelled before it is freed */
-	return devm_work_autocancel(dev, &ts->resume_work, goodix_ys_resume_work);
+	return devm_delayed_work_autocancel(dev, &ts->resume_work,
+					    goodix_ys_resume_work);
 }
 
 static const struct of_device_id goodix_ys_of_match[] = {
