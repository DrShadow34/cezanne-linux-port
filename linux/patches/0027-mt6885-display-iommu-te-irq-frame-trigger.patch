@@ -294,14 +294,17 @@ static int mtk_smi_larb_config_port_gen2_general(struct device *dev)
 		writel(reg, larb->base + SMI_LARB_NONSEC_CON(i));
 	}
 
-	/* no IOMMU: the ports come up translated after a power cycle */
-	if (larb->mmu == &larb->no_mmu) {
-		for (i = 0; i < 32; i++) {
-			reg = readl_relaxed(larb->base + SMI_LARB_NONSEC_CON(i));
-			if (reg & F_MMU_EN)
-				writel(reg & ~F_MMU_EN,
-				       larb->base + SMI_LARB_NONSEC_CON(i));
-		}
+	/*
+	 * Ports no IOMMU user is attached to stay physical (bypass). Some
+	 * SoCs (MT6885) reset to MMU on, so after a power cycle of their
+	 * domain these have to be cleared, not just left alone.
+	 */
+	for (i = 0; i < 32; i++) {
+		if (*larb->mmu & BIT(i))
+			continue;
+		reg = readl_relaxed(larb->base + SMI_LARB_NONSEC_CON(i));
+		if (reg & F_MMU_EN)
+			writel(reg & ~F_MMU_EN, larb->base + SMI_LARB_NONSEC_CON(i));
 	}
 	return 0;
 }
