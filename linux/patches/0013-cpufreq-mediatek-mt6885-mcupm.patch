diff --git a/drivers/cpufreq/mediatek-cpufreq-mcupm.c b/drivers/cpufreq/mediatek-cpufreq-mcupm.c
new file mode 100644
index 000000000..150f86a2a
--- /dev/null
+++ b/drivers/cpufreq/mediatek-cpufreq-mcupm.c
@@ -0,0 +1,295 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CPU DVFS on MediaTek MT6885 through the MCUPM ("hybrid DVFS").
+ *
+ * The MCUPM firmware (loaded by the bootloader) switches CPU PLLs and
+ * Vproc/Vsram itself. The kernel describes the OPPs in a shared SRAM
+ * ("CSRAM"), starts the firmware with a few IPIs over MCUPM mailbox 1 and then
+ * only writes the wanted OPP index of each cluster into CSRAM.
+ *
+ * Layout and protocol follow the MediaTek 4.14 BSP:
+ *   drivers/misc/mediatek/base/power/cpufreq_v1/src/mtk_cpufreq_hybrid.c
+ *   drivers/misc/mediatek/mcupm/mt6885/mcupm_ipi_table.h, drivers/rpmsg/mtk_rpmsg.c
+ * Only CPU_LEVEL_2 tables (efuse bin 0x10, 2.6 GHz big cores) are included.
+ */
+#include <linux/cpufreq.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/consumer.h>
+
+#include "mediatek-cpufreq-mcupm-mt6885.h"
+
+/* CSRAM offsets */
+#define CSRAM_SIZE		0x1400
+#define OFFS_TBL_S		0x0010
+#define OFFS_DATA_S		0x02a0
+#define OFFS_PPM_LIMIT_S	0x0320
+#define OFFS_CUR_FREQ_S		0x0354
+#define OFFS_WFI_S		0x037c
+#define OFFS_CCI_TBL_S		0x0fa0
+#define OFFS_CLUSTER_ONOFF_S	0x1224
+#define REPO_GUARD0		0x55aa55aa
+#define REPO_GUARD1		0xaa55aa55
+#define CLUSTER_ON		0x43434f4e	/* "CCON" */
+
+/* MCUPM mailbox registers (shared by all mailboxes, one bit per mailbox) */
+#define MBOX_CLR		0x074
+#define MBOX_RECV_STA		0x078
+#define MBOX_SEND_STA		0x150
+#define MBOX_SET		0x154
+#define DVFS_PIN		BIT(1)		/* CPU DVFS = mailbox 1 */
+#define DVFS_REPLY_SLOT		0x14		/* PIN_R_OFFSET_CPU_DVFS, 4-byte slots */
+
+/* enum cpu_dvfs_ipi_type */
+#define IPI_DVFS_INIT_PTBL	0
+#define IPI_DVFS_INIT		1
+#define IPI_INIT_VOLT_SETTING	6
+
+#define NR_FREQ			16
+#define NR_DVFS_CLUSTERS	3	/* LL, L, CCI */
+#define CPU_LEVEL		2
+
+struct mcupm_cpufreq {
+	struct device *dev;
+	void __iomem *csram;
+	void __iomem *mbox;
+	void __iomem *mbox_sram;
+	struct regulator *proc[2], *sram[2];	/* [0] = LL/CCI, [1] = L */
+	struct cpufreq_frequency_table table[2][NR_FREQ + 1];
+};
+
+static struct mcupm_cpufreq *mcf;
+
+static int mcupm_dvfs_ipi(struct mcupm_cpufreq *m, u32 cmd, u32 a0, u32 a1, u32 a2)
+{
+	u32 msg[4] = { cmd, a0, a1, a2 }, sta;
+	int i, ret;
+
+	if (readl(m->mbox + MBOX_SEND_STA) & DVFS_PIN)
+		return -EBUSY;
+	for (i = 0; i < 4; i++)
+		writel(msg[i], m->mbox_sram + 4 * i);
+	writel(DVFS_PIN, m->mbox + MBOX_SET);
+
+	ret = readl_poll_timeout(m->mbox + MBOX_RECV_STA, sta, sta & DVFS_PIN,
+				 100, 2000000);
+	if (ret) {
+		dev_err(m->dev, "IPI %u: no reply from MCUPM\n", cmd);
+		return ret;
+	}
+	writel(DVFS_PIN, m->mbox + MBOX_CLR);
+	ret = readl(m->mbox_sram + 4 * DVFS_REPLY_SLOT);
+	return ret < 0 ? ret : 0;
+}
+
+/* cpuhvfs_pvt_tbl_create() plus the CCI map */
+static void mcupm_write_tables(struct mcupm_cpufreq *m)
+{
+	u32 __iomem *tbl = m->csram + OFFS_TBL_S;
+	int c, i;
+
+	/* init_cpuhvfs_debug_repo() */
+	writel(REPO_GUARD0, m->csram + 0x0);
+	writel(REPO_GUARD1, m->csram + 0x4);
+	writel(REPO_GUARD0, m->csram + 0x8);
+	writel(REPO_GUARD1, m->csram + 0xc);
+	memset_io(m->csram + OFFS_DATA_S, 0, CSRAM_SIZE - OFFS_DATA_S);
+	writel(REPO_GUARD0, m->csram + OFFS_DATA_S);
+	for (c = 0; c < 2; c++)
+		writel(NR_FREQ - 1, m->csram + OFFS_PPM_LIMIT_S + 4 * c);
+
+	for (c = 0; c < NR_DVFS_CLUSTERS; c++) {
+		for (i = 0; i < NR_FREQ; i++) {
+			const u16 *e = mt6885_lv2_pvt[c * NR_FREQ + i];
+
+			/* [31:16] Vproc, [15:0] MHz;  [31:16] clk_div, [15:0] post_div */
+			writel((e[1] & 0xfff) << 16 | e[0], &tbl[c * 36 + i]);
+			writel((e[3] & 0xff) << 16 | (e[2] & 0xff), &tbl[c * 36 + NR_FREQ + i]);
+		}
+		writel(~0U, &tbl[c * 36 + 2 * NR_FREQ]);
+	}
+	writel(~0U, &tbl[3 * 36 + 2 * NR_FREQ]);
+
+	memcpy_toio(m->csram + OFFS_CCI_TBL_S, mt6885_lv2_cci_map,
+		    sizeof(mt6885_lv2_cci_map));
+	mb();
+}
+
+static int mcupm_dvfs_start(struct mcupm_cpufreq *m)
+{
+	int c, ret;
+
+	mcupm_write_tables(m);
+
+	ret = mcupm_dvfs_ipi(m, IPI_DVFS_INIT_PTBL, 0, 0, 0);
+	if (ret)
+		return ret;
+
+	/* tell MCUPM where the rails are now (10 uV units), LL, L, CCI */
+	for (c = 0; c < NR_DVFS_CLUSTERS; c++) {
+		int r = (c == 1);
+		int vproc = regulator_get_voltage(m->proc[r]);
+		int vsram = regulator_get_voltage(m->sram[r]);
+
+		if (vproc <= 0 || vsram <= 0)
+			return dev_err_probe(m->dev, -EINVAL,
+					     "cluster %d: cannot read Vproc/Vsram\n", c);
+		dev_info(m->dev, "cluster %d: Vproc %d uV, Vsram %d uV\n", c, vproc, vsram);
+		ret = mcupm_dvfs_ipi(m, IPI_INIT_VOLT_SETTING, c, vproc / 10, vsram / 10);
+		if (ret)
+			return ret;
+	}
+
+	ret = mcupm_dvfs_ipi(m, IPI_DVFS_INIT, CPU_LEVEL, 0, 0);
+	if (ret)
+		return ret;
+
+	for (c = 0; c < NR_DVFS_CLUSTERS; c++)
+		writel(CLUSTER_ON, m->csram + OFFS_CLUSTER_ONOFF_S + 4 * c);
+	return 0;
+}
+
+static int mcupm_cpu_cluster(unsigned int cpu)
+{
+	return cpu >= 4;	/* cpu0-3 A55 = LL (0), cpu4-7 A77 = L (1) */
+}
+
+static unsigned int mcupm_cpufreq_get(unsigned int cpu)
+{
+	int c = mcupm_cpu_cluster(cpu);
+	u32 idx = readl(mcf->csram + OFFS_CUR_FREQ_S + 4 * c);
+
+	if (idx >= NR_FREQ)
+		return 0;
+	return mt6885_lv2_pvt[c * NR_FREQ + idx][0] * 1000;
+}
+
+static int mcupm_cpufreq_target_index(struct cpufreq_policy *policy, unsigned int index)
+{
+	int c = mcupm_cpu_cluster(policy->cpu);
+
+	/* cpuhvfs_set_dvfs(): [3:0] OPP index */
+	writel(policy->freq_table[index].driver_data,
+	       mcf->csram + OFFS_WFI_S + 4 * c);
+	return 0;
+}
+
+static unsigned int mcupm_cpufreq_fast_switch(struct cpufreq_policy *policy,
+					      unsigned int target_freq)
+{
+	unsigned int index = cpufreq_table_find_index_dl(policy, target_freq, false);
+
+	mcupm_cpufreq_target_index(policy, index);
+	return policy->freq_table[index].frequency;
+}
+
+static int mcupm_cpufreq_init(struct cpufreq_policy *policy)
+{
+	int c = mcupm_cpu_cluster(policy->cpu), cpu;
+
+	for_each_possible_cpu(cpu)
+		if (mcupm_cpu_cluster(cpu) == c)
+			cpumask_set_cpu(cpu, policy->cpus);
+
+	policy->freq_table = mcf->table[c];
+	policy->cpuinfo.transition_latency = 1000 * NSEC_PER_USEC;
+	policy->fast_switch_possible = true;
+	return 0;
+}
+
+static struct cpufreq_driver mcupm_cpufreq_driver = {
+	.name		= "mcupm-cpufreq",
+	.flags		= CPUFREQ_NEED_INITIAL_FREQ_CHECK | CPUFREQ_IS_COOLING_DEV,
+	.verify		= cpufreq_generic_frequency_table_verify,
+	.target_index	= mcupm_cpufreq_target_index,
+	.fast_switch	= mcupm_cpufreq_fast_switch,
+	.get		= mcupm_cpufreq_get,
+	.init		= mcupm_cpufreq_init,
+};
+
+static int mcupm_cpufreq_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mcupm_cpufreq *m;
+	int c, i, ret;
+	u32 level;
+
+	if (of_property_read_u32(dev->of_node, "mediatek,cpu-level", &level) ||
+	    level != CPU_LEVEL)
+		return dev_err_probe(dev, -ENODEV, "only CPU level %d tables built in\n",
+				     CPU_LEVEL);
+
+	m = devm_kzalloc(dev, sizeof(*m), GFP_KERNEL);
+	if (!m)
+		return -ENOMEM;
+	m->dev = dev;
+	m->csram = devm_platform_ioremap_resource_byname(pdev, "csram");
+	if (IS_ERR(m->csram))
+		return PTR_ERR(m->csram);
+	m->mbox = devm_platform_ioremap_resource_byname(pdev, "mbox");
+	if (IS_ERR(m->mbox))
+		return PTR_ERR(m->mbox);
+	m->mbox_sram = devm_platform_ioremap_resource_byname(pdev, "mbox1-sram");
+	if (IS_ERR(m->mbox_sram))
+		return PTR_ERR(m->mbox_sram);
+
+	m->proc[0] = devm_regulator_get(dev, "proc-ll");
+	m->sram[0] = devm_regulator_get(dev, "sram-ll");
+	m->proc[1] = devm_regulator_get(dev, "proc-l");
+	m->sram[1] = devm_regulator_get(dev, "sram-l");
+	for (i = 0; i < 2; i++)
+		if (IS_ERR(m->proc[i]) || IS_ERR(m->sram[i]))
+			return dev_err_probe(dev, -EPROBE_DEFER, "CPU rails not ready\n");
+
+	for (c = 0; c < 2; c++) {
+		for (i = 0; i < NR_FREQ; i++) {
+			m->table[c][i].driver_data = i;
+			m->table[c][i].frequency = mt6885_lv2_pvt[c * NR_FREQ + i][0] * 1000;
+		}
+		m->table[c][NR_FREQ].frequency = CPUFREQ_TABLE_END;
+	}
+
+	ret = mcupm_dvfs_start(m);
+	if (ret)
+		return dev_err_probe(dev, ret, "MCUPM DVFS init failed\n");
+
+	mcf = m;
+	ret = cpufreq_register_driver(&mcupm_cpufreq_driver);
+	if (ret) {
+		mcf = NULL;
+		return ret;
+	}
+	dev_info(dev, "MCUPM CPU DVFS: LL %u-%u MHz, L %u-%u MHz\n",
+		 mt6885_lv2_pvt[15][0], mt6885_lv2_pvt[0][0],
+		 mt6885_lv2_pvt[31][0], mt6885_lv2_pvt[16][0]);
+	return 0;
+}
+
+static void mcupm_cpufreq_remove(struct platform_device *pdev)
+{
+	cpufreq_unregister_driver(&mcupm_cpufreq_driver);
+	mcf = NULL;
+}
+
+static const struct of_device_id mcupm_cpufreq_of_match[] = {
+	{ .compatible = "mediatek,mt6885-cpufreq-mcupm" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mcupm_cpufreq_of_match);
+
+static struct platform_driver mcupm_cpufreq_platdrv = {
+	.probe	= mcupm_cpufreq_probe,
+	.remove	= mcupm_cpufreq_remove,
+	.driver	= {
+		.name = "mediatek-cpufreq-mcupm",
+		.of_match_table = mcupm_cpufreq_of_match,
+	},
+};
+module_platform_driver(mcupm_cpufreq_platdrv);
+
+MODULE_DESCRIPTION("MediaTek MT6885 MCUPM CPU DVFS driver");
+MODULE_LICENSE("GPL");
