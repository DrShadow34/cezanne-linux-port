 required:
diff --git a/drivers/iio/adc/mt6577_auxadc.c b/drivers/iio/adc/mt6577_auxadc.c
--- a/drivers/iio/adc/mt6577_auxadc.c
+++ b/drivers/iio/adc/mt6577_auxadc.c
@@ -4,11 +4,13 @@
  * Author: Zhiyong Tao <zhiyong.tao@mediatek.com>
  */
 
+#include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/err.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/nvmem-consumer.h>
 #include <linux/platform_device.h>
 #include <linux/property.h>
 #include <linux/iopoll.h>
@@ -33,6 +35,14 @@
 #define MT6577_AUXADC_POWER_READY_MS          1
 #define MT6577_AUXADC_SAMPLE_READY_US         25
 
+/*
+ * Efuse calibration (nvmem cell "calibration-data"): enable bit, gain and
+ * offset error, both stored + 512; voltage = (raw - OE) * 1500 / (4096 + GE)
+ */
+#define MT6577_AUXADC_CALI_EN                 BIT(20)
+#define MT6577_AUXADC_CALI_GE                 GENMASK(19, 10)
+#define MT6577_AUXADC_CALI_OE                 GENMASK(9, 0)
+
 struct mtk_auxadc_compatible {
 	bool sample_data_cali;
 	bool check_global_idle;
@@ -43,6 +53,8 @@ struct mt6577_auxadc_device {
 	struct clk *adc_clk;
 	struct mutex lock;
 	const struct mtk_auxadc_compatible *dev_comp;
+	int cali_ge;
+	int cali_oe;
 };
 
 static const struct mtk_auxadc_compatible mt8186_compat = {
@@ -60,6 +72,11 @@ static const struct mtk_auxadc_compatible mt6765_compat = {
 	.check_global_idle = false,
 };
 
+static const struct mtk_auxadc_compatible mt6885_compat = {
+	.sample_data_cali = true,
+	.check_global_idle = true,
+};
+
 #define MT6577_AUXADC_CHANNEL(idx) {				    \
 		.type = IIO_VOLTAGE,				    \
 		.indexed = 1,					    \
@@ -90,9 +107,12 @@ static const struct iio_chan_spec mt6577_auxadc_iio_channels[] = {
 #define VOLTAGE_FULL_RANGE  1500	/* VA voltage */
 #define AUXADC_PRECISE      4096	/* 12 bits */
 
-static int mt_auxadc_get_cali_data(int rawdata, bool enable_cali)
+/* raw sample -> mV, with the efuse calibration if there is one */
+static int mt6577_auxadc_to_mv(struct mt6577_auxadc_device *adc_dev, int raw)
 {
-	return rawdata;
+	int precise = AUXADC_PRECISE + adc_dev->cali_ge;
+
+	return max(raw - adc_dev->cali_oe, 0) * VOLTAGE_FULL_RANGE / precise;
 }
 
 static inline void mt6577_auxadc_mod_reg(void __iomem *reg,
@@ -197,11 +217,8 @@ static int mt6577_auxadc_read_raw(struct iio_dev *indio_dev,
 				chan->channel);
 			return *val;
 		}
-		if (adc_dev->dev_comp->sample_data_cali)
-			*val = mt_auxadc_get_cali_data(*val, true);
-
 		/* Convert adc raw data to voltage: 0 - 1500 mV */
-		*val = *val * VOLTAGE_FULL_RANGE / AUXADC_PRECISE;
+		*val = mt6577_auxadc_to_mv(adc_dev, *val);
 
 		return IIO_VAL_INT;
 
@@ -245,6 +262,27 @@ static int mt6577_auxadc_suspend(struct device *dev)
 	return 0;
 }
 
+static int mt6577_auxadc_read_cali(struct device *dev,
+				   struct mt6577_auxadc_device *adc_dev)
+{
+	u32 cali;
+	int ret;
+
+	if (!adc_dev->dev_comp->sample_data_cali)
+		return 0;
+	ret = nvmem_cell_read_u32(dev, "calibration-data", &cali);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret || !(cali & MT6577_AUXADC_CALI_EN))
+		return 0;
+
+	adc_dev->cali_ge = (int)FIELD_GET(MT6577_AUXADC_CALI_GE, cali) - 512;
+	adc_dev->cali_oe = (int)FIELD_GET(MT6577_AUXADC_CALI_OE, cali) - 512;
+	dev_dbg(dev, "calibration: gain error %d / 4096, offset error %d\n",
+		adc_dev->cali_ge, adc_dev->cali_oe);
+	return 0;
+}
+
 static void mt6577_power_off(void *data)
 {
 	struct mt6577_auxadc_device *adc_dev = data;
@@ -287,6 +325,10 @@ static int mt6577_auxadc_probe(struct platform_device *pdev)
 
 	adc_dev->dev_comp = device_get_match_data(&pdev->dev);
 
+	ret = mt6577_auxadc_read_cali(&pdev->dev, adc_dev);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "failed to read the calibration\n");
+
 	mutex_init(&adc_dev->lock);
 
 	mt6577_auxadc_mod_reg(adc_dev->reg_base + MT6577_AUXADC_MISC,
@@ -316,6 +358,7 @@ static const struct of_device_id mt6577_auxadc_of_match[] = {
 	{ .compatible = "mediatek,mt8173-auxadc", .data = &mt8173_compat },
 	{ .compatible = "mediatek,mt8186-auxadc", .data = &mt8186_compat },
 	{ .compatible = "mediatek,mt6765-auxadc", .data = &mt6765_compat },
+	{ .compatible = "mediatek,mt6885-auxadc", .data = &mt6885_compat },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, mt6577_auxadc_of_match);
