+	mutex_lock(&mtk_crtc->hw_lock);
+	if (gain != mtk_crtc->out_gain) {
+		mtk_crtc->out_gain = gain;
+		/* before the first colour update the flush programs it */
+		if (mtk_crtc->enabled && mtk_crtc->color_ready) {
+			mtk_dsi_cmd_frame_begin(mtk_crtc->cmd_dsi);
+			mtk_crtc_ctm_program(mtk_crtc);
+			mtk_dsi_cmd_frame_end(mtk_crtc->cmd_dsi, mtk_crtc->mutex);
+		}
+	}
+	mutex_unlock(&mtk_crtc->hw_lock);
