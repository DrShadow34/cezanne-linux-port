+static void mtk_dsi_idle_work(struct work_struct *work)
+{
+	struct mtk_dsi *dsi = container_of(work, struct mtk_dsi, idle_work.work);
+
+	mutex_lock(&dsi->idle_lock);
+	if (dsi->idle_cb && dsi->enabled && !dsi->idle) {
+		dsi->idle = true;
+		dsi->idle_cb(dsi->idle_cb_data, true);
+	}
+	mutex_unlock(&dsi->idle_lock);
+}
+
+/*
+ * For the panel driver: cb(data, idle) is called without any of its locks
+ * possibly held by the caller (it may run inside a backlight update), so
+ * it must only send DCS. idle_ms 0: off.
+ */
+void mtk_dsi_set_idle_cb(struct mipi_dsi_host *host,
+			 void (*cb)(void *data, bool idle), void *data,
+			 unsigned int idle_ms)
+{
+	struct mtk_dsi *dsi = host_to_dsi(host);
+
+	cancel_delayed_work_sync(&dsi->idle_work);
+	mutex_lock(&dsi->idle_lock);
+	if (dsi->idle && dsi->idle_cb)
+		dsi->idle_cb(dsi->idle_cb_data, false);
+	dsi->idle = false;
+	dsi->idle_cb = idle_ms ? cb : NULL;
+	dsi->idle_cb_data = data;
+	dsi->idle_ms = idle_ms;
+	mutex_unlock(&dsi->idle_lock);
+}
+EXPORT_SYMBOL_GPL(mtk_dsi_set_idle_cb);
