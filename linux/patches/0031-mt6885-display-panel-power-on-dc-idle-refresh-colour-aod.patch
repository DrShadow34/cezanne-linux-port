+/*
+ * DC dimming: below J10_DC_LEVEL (BSP dc_backlight_threhold) the panel stays
+ * at that level and the pipeline scales the pixels instead (the gain after
+ * the DCS, both land on the next frame). Measured with the panel's own ALS
+ * (white screen over a mirror): the output is linear in the panel level and
+ * linear in the CCORR gain, so gain = level / J10_DC_LEVEL. Under a gain of
+ * ~0.1 (J10_DC_FLOOR) the pixel steps get coarse: the panel level goes down
+ * instead. The panel PWMs at every level (camera bands up to 2047); held at
+ * 486 the flicker is shallower than at the low levels.
+ */
+#define J10_DC_LEVEL	486
+#define J10_DC_FLOOR	49
+
+#if IS_BUILTIN(CONFIG_DRM_MEDIATEK)
+void mtk_drm_set_output_gain(unsigned int gain);
+void mtk_dsi_set_idle_cb(struct mipi_dsi_host *host,
+			 void (*cb)(void *data, bool idle), void *data,
+			 unsigned int idle_ms);
+#else
+static inline void mtk_drm_set_output_gain(unsigned int gain) { }
+static inline void mtk_dsi_set_idle_cb(struct mipi_dsi_host *host,
+				       void (*cb)(void *data, bool idle),
+				       void *data, unsigned int idle_ms) { }
+#endif
+
+/*
+ * Idle refresh, like MIUI's SurfaceFlinger idle timer (3 s, 120 -> 60 Hz):
+ * the DSI host calls this once no frame went out for idle_ms and again
+ * before the next frame; in the 120 Hz mode the panel scans (and its TE
+ * runs) at 60 Hz meanwhile. Called with no panel lock possible to take.
+ */
+#define J10_IDLE_MS	1000
+
+static void j10_idle_cb(void *data, bool idle)
+{
+	struct j10_panel *ctx = data;
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	if (!READ_ONCE(ctx->powered) || !READ_ONCE(ctx->high_refresh) ||
+	    READ_ONCE(ctx->doze))
+		return;
+	/*
+	 * Not under DC dimming (panel held at J10_DC_LEVEL, pixels scaled):
+	 * there the 60 and 120 Hz gamma differ visibly on the switch.
+	 */
+	if (idle && READ_ONCE(ctx->dc_dimming) &&
+	    backlight_get_brightness(ctx->backlight) < J10_DC_LEVEL)
+		return;
+	j10_set_refresh(&dsi_ctx, !idle);
+}
+
+/* DCS 0x51, 11 bit, high byte first */
+static void j10_write_dbv(struct mipi_dsi_multi_context *dsi_ctx, u16 dbv)
+{
+	const u8 cmd[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, dbv >> 8, dbv & 0xff };
+
+	mipi_dsi_dcs_write_buffer_multi(dsi_ctx, cmd, sizeof(cmd));
+}
+
+
+static void j10_set_brightness(struct j10_panel *ctx,
+			       struct mipi_dsi_multi_context *dsi_ctx, u16 level)
+{
+	u16 dbv = level;
+	u32 gain = 4096;
+
+	if (ctx->dc_dimming && level && level < J10_DC_LEVEL) {
+		if (level >= J10_DC_FLOOR) {
+			dbv = J10_DC_LEVEL;
+			gain = DIV_ROUND_CLOSEST(level * 4096, J10_DC_LEVEL);
+		} else {
+			dbv = DIV_ROUND_CLOSEST(level * J10_DC_LEVEL, J10_DC_FLOOR);
+			gain = DIV_ROUND_CLOSEST(J10_DC_FLOOR * 4096, J10_DC_LEVEL);
+		}
+	}
+	j10_write_dbv(dsi_ctx, dbv);
+	mtk_drm_set_output_gain(gain);
+}
+
+/* sysfs hbm, else the sunlight HBM while HDR output is on */
+static int j10_hbm_wanted(struct j10_panel *ctx)
+{
+	if (ctx->hbm)
+		return ctx->hbm;
+	return ctx->hdr ? J10_HBM_SUN : J10_HBM_OFF;
+}
+
+/* DCS sequences from the BSP panel driver; called with ctx->lock held */
+static void j10_hbm_apply(struct j10_panel *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	int mode = j10_hbm_wanted(ctx);
+	u16 level = backlight_get_brightness(ctx->backlight);
+
+	if (!ctx->powered || ctx->doze || mode == ctx->hbm_applied)
+		return;
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	/* HBM shows the pixels as they are (the FOD dim layer relies on it) */
+	if (mode != J10_HBM_OFF)
+		mtk_drm_set_output_gain(4096);
+	switch (mode) {
+	case J10_HBM_SUN:
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x13);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x4c);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+					     0xe8, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+					     0x07, 0xff);
+		break;
+	case J10_HBM_FOD:
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x13);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+					     0xe0, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+					     0x07, 0xff);
+		break;
+	default:
+		/* back to the normal range at the backlight level */
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+					     0x20, 0x00);
+		j10_set_brightness(ctx, &dsi_ctx, level);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x93);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x01);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb7, 0x44);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+		break;
+	}
+	if (!dsi_ctx.accum_err)
+		ctx->hbm_applied = mode;
+}
+
+/* BSP panel_doze_enable / panel_set_nolp; called with ctx->lock held */
+static int j10_doze_set(struct j10_panel *ctx, int doze)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	const u8 aod[] = { 0x53, doze == J10_DOZE_HIGH ? 0x2a : 0x2b, 0x00 };
+
+	if (!ctx->powered)
+		return -ENODEV;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	if (doze && ctx->doze) {
+		/* brightness change only (BSP panel_set_aod_light_mode) */
+		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, aod, sizeof(aod));
+	} else if (doze) {
+		mtk_drm_set_output_gain(4096);
+		mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);	/* checksum off */
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xec, 0x20);
+		j10_set_refresh(&dsi_ctx, false);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x0b);	/* vfp diff off */
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd8, 0x50, 0x00);
+		mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, aod, sizeof(aod));
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+		mipi_dsi_msleep(&dsi_ctx, 40);
+		mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	} else if (ctx->doze) {
+		mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x0a);	/* black insertion */
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xee, 0x02);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x0b);	/* vfp diff */
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd8, 0x59, 0x70);
+		mipi_dsi_msleep(&dsi_ctx, 40);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+					     0x28, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x05);	/* checksum on */
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xec, 0x42);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+		j10_set_refresh(&dsi_ctx, ctx->high_refresh);
+		mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	}
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+
+	ctx->doze = doze;
+	if (!doze) {
+		/* the normal range at the level (53 20, ELVSS) and its gain */
+		ctx->hbm_applied = -1;
+		j10_hbm_apply(ctx);
+	}
+	return 0;
+}
