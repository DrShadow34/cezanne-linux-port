+#define MTK_GAIN_ONE	4096
+
+/* the current matrix times the output gain (SDR only), to every CCORR */
+static void mtk_crtc_ctm_program(struct mtk_crtc *mtk_crtc)
+{
+	struct drm_color_ctm ctm = mtk_crtc->cur_ctm;
+	struct drm_property_blob blob = { .data = &ctm, .length = sizeof(ctm) };
+	struct drm_crtc_state st = { .ctm = &blob };
+	u32 gain = mtk_crtc->hdr == MTK_HDR_OFF ? mtk_crtc->out_gain : MTK_GAIN_ONE;
+	int i;
+
+	if (!mtk_crtc->cur_ctm_valid)
+		return;
+	/* S31.32 sign-magnitude */
+	for (i = 0; gain != MTK_GAIN_ONE && i < ARRAY_SIZE(ctm.matrix); i++) {
+		u64 v = ctm.matrix[i];
+
+		ctm.matrix[i] = (v & BIT_ULL(63)) |
+				mul_u64_u32_shr(v & ~BIT_ULL(63), gain, 12);
+	}
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++)
+		mtk_ddp_ctm_set(mtk_crtc->ddp_comp[i], &st);
+	for (i = 0; i < mtk_crtc->dual_comp_nr; i++)
+		mtk_ddp_ctm_set(mtk_crtc->dual_comp[i], &st);
