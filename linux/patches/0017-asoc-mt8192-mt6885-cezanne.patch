+/*
+ * Two CS35L41 on one I2S (BCLK = 64 fs from the AFE): the amp at codec index
+ * i takes slot i, i.e. left then right, and runs its PLL from BCLK.
+ */
+static int mt8192_cs35l41_i2s_hw_params(struct snd_pcm_substream *substream,
+					struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	unsigned int bclk = params_rate(params) * 64;
+	struct snd_soc_dai *codec_dai;
+	int i, ret;
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		unsigned int slot = i;
+
+		ret = snd_soc_component_set_sysclk(codec_dai->component,
+						   CS35L41_CLKID_SCLK, 0, bclk,
+						   SND_SOC_CLOCK_IN);
+		if (ret)
+			return ret;
+		ret = snd_soc_dai_set_sysclk(codec_dai, 0, bclk, SND_SOC_CLOCK_IN);
+		if (ret)
+			return ret;
+		ret = snd_soc_dai_set_channel_map(codec_dai, 0, NULL, 1, &slot);
+		if (ret)
+			return ret;
+	}
+
+	return snd_soc_dai_set_sysclk(cpu_dai, 0, params_rate(params) * 128,
+				      SND_SOC_CLOCK_OUT);
+}
