+/*
+ * Card bound before the AFE component exists ends up on the ASoC unbind list,
+ * and the DT codec references are dropped right after registration, so the
+ * later rebind fails. Defer the whole probe until the AFE is registered.
+ */
+static int mt8192_mt6359_afe_ready(struct device *dev)
+{
+	struct device_node *np = of_parse_phandle(dev->of_node, "mediatek,platform", 0);
+	struct platform_device *afe_pdev;
+	bool ready;
+
+	if (!np)
+		return -EINVAL;
+	afe_pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!afe_pdev)
+		return -EPROBE_DEFER;
+	ready = snd_soc_lookup_component(&afe_pdev->dev, NULL);
+	put_device(&afe_pdev->dev);
+	return ready ? 0 : -EPROBE_DEFER;
+}
