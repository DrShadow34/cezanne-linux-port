+/*
+ * Charging on / off with the input left on (CHG_EN): inhibit-charge powers
+ * the system from VBUS without charging the battery (a charge limit), unlike
+ * online = 0 (force sleep: the battery takes the whole load).
+ */
+static int mt6360_charger_get_behaviour(struct mt6360_chg_info *mci,
+					union power_supply_propval *val)
+{
+	unsigned int regval;
+	int ret;
+
+	ret = regmap_read(mci->regmap, MT6360_PMU_CHG_CTRL2, &regval);
+	if (ret)
+		return ret;
+	val->intval = regval & MT6360_CHG_EN_MASK ?
+		      POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO :
+		      POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+	return 0;
+}
+
+static int mt6360_charger_set_behaviour(struct mt6360_chg_info *mci,
+					const union power_supply_propval *val)
+{
+	unsigned int en;
+
+	switch (val->intval) {
+	case POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO:
+		en = MT6360_CHG_EN_MASK;
+		break;
+	case POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE:
+		en = 0;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return regmap_update_bits(mci->regmap, MT6360_PMU_CHG_CTRL2,
+				  MT6360_CHG_EN_MASK, en);
+}
+
