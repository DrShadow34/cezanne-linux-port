+/* the charge limit: applied by the next update (gauge_charge_guard) */
+static int gauge_set_property(struct power_supply *psy,
+			      enum power_supply_property psp,
+			      const union power_supply_propval *val)
+{
+	struct mt6359_gauge *g = power_supply_get_drvdata(psy);
+
+	if (val->intval < 0 || val->intval > 100)
+		return -EINVAL;
+	mutex_lock(&g->lock);
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD:
+		g->thr_start = val->intval;
+		break;
+	case POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD:
+		g->thr_end = val->intval;
+		break;
+	default:
+		mutex_unlock(&g->lock);
+		return -EINVAL;
+	}
+	mutex_unlock(&g->lock);
+	mod_delayed_work(system_freezable_wq, &g->work, 0);
+	return 0;
+}
+
+static int gauge_property_is_writeable(struct power_supply *psy,
+				       enum power_supply_property psp)
+{
+	return psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD ||
+	       psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD;
+}
