diff --git a/sound/soc/codecs/cs35l41-lib.c b/sound/soc/codecs/cs35l41-lib.c
index b0fa80705..cf907bfff 100644
--- a/sound/soc/codecs/cs35l41-lib.c
+++ b/sound/soc/codecs/cs35l41-lib.c
@@ -1487,6 +1487,15 @@ int cs35l41_set_cspl_mbox_cmd(struct device *dev, struct regmap *regmap,
 			return 0;
 	}
 
+	/*
+	 * Older CSPL firmware (v0.13 on the Redmi K30 Ultra) leaves the status
+	 * mailbox at 0 and has no pause/resume: the amp just powers up and down.
+	 */
+	if (sts == 0 && (cmd == CSPL_MBOX_CMD_PAUSE || cmd == CSPL_MBOX_CMD_RESUME)) {
+		dev_dbg(dev, "mailbox cmd %u not supported by this firmware\n", cmd);
+		return 0;
+	}
+
 	if (cmd != CSPL_MBOX_CMD_OUT_OF_HIBERNATE)
 		dev_err(dev, "Failed to set mailbox cmd %u (status %u)\n", cmd, sts);
 
