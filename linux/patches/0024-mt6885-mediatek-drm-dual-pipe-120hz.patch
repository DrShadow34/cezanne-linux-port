+/*
+ * Dual pipe: split a plane at the middle of the screen. The OVLs do not
+ * scale, so source and destination move together; pipe 1 starts at its own
+ * x = 0. Only unrotated and vertically reflected planes are split right
+ * (horizontal reflection would also need the halves swapped).
+ */
+static void mtk_crtc_split_plane(const struct mtk_plane_state *state,
+				 unsigned int half,
+				 struct mtk_plane_pending_state *left,
+				 struct mtk_plane_pending_state *right)
+{
+	const struct mtk_plane_pending_state *p = &state->pending;
+	unsigned int x0 = p->x, x1 = p->x + p->width, start, cpp;
+
+	*left = *p;
+	*right = *p;
+	if (!p->enable)
+		return;
+
+	cpp = state->base.fb ? state->base.fb->format->cpp[0] : 0;
+
+	if (x0 < half)
+		left->width = min(x1, half) - x0;
+	else
+		left->enable = false;
+
+	if (x1 > half) {
+		start = max(x0, half);
+		right->x = start - half;
+		right->width = x1 - start;
+		right->addr = p->addr + (dma_addr_t)(start - x0) * cpp;
+	} else {
+		right->enable = false;
+	}
+}
+
+static void mtk_crtc_layer_config(struct mtk_crtc *mtk_crtc,
+				  struct drm_plane *plane,
+				  struct mtk_plane_state *state,
+				  struct cmdq_pkt *cmdq_handle)
+{
+	struct drm_crtc *crtc = &mtk_crtc->base;
+	struct mtk_plane_pending_state left, right;
+	struct mtk_plane_state half_state;
+	struct mtk_ddp_comp *comp;
+	unsigned int local_layer;
+
+	comp = mtk_ddp_comp_for_plane(crtc, plane, &local_layer);
+	if (!comp)
+		return;
+
+	if (!mtk_crtc->dual_comp_nr) {
+		mtk_ddp_comp_layer_config(comp, local_layer, state, cmdq_handle);
+		return;
+	}
+
+	mtk_crtc_split_plane(state, crtc->state->adjusted_mode.hdisplay / 2,
+			     &left, &right);
+	half_state = *state;
+	half_state.pending = left;
+	mtk_ddp_comp_layer_config(comp, local_layer, &half_state, cmdq_handle);
+	half_state.pending = right;
+	mtk_ddp_comp_layer_config(mtk_crtc->dual_comp[0], local_layer,
+				  &half_state, cmdq_handle);
+}
