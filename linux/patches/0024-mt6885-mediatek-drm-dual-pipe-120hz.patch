+/* second pipe of the main path; without all of its blocks run single pipe */
+static int mtk_crtc_init_dual(struct device *dev, struct mtk_drm_private *priv,
+			      struct mtk_crtc *mtk_crtc)
+{
+	const struct mtk_mmsys_driver_data *data = priv->data;
+	unsigned int i;
+
+	for (i = 0; i < mtk_crtc->ddp_comp_nr; i++)
+		if (mtk_crtc->ddp_comp[i]->id == data->dual_join)
+			break;
+	if (i == mtk_crtc->ddp_comp_nr)
+		return 0;
+	mtk_crtc->dual_join = i;
+
+	for (i = 0; i < data->dual_len; i++) {
+		if (!priv->comp_node[data->dual_path[i]] ||
+		    !priv->ddp_comp[data->dual_path[i]].dev) {
+			dev_info(dev, "pipe 1 component %d missing: single pipe\n",
+				 data->dual_path[i]);
+			return 0;
+		}
+	}
+
+	mtk_crtc->dual_comp = devm_kcalloc(dev, data->dual_len,
+					   sizeof(*mtk_crtc->dual_comp),
+					   GFP_KERNEL);
+	if (!mtk_crtc->dual_comp)
+		return -ENOMEM;
+
+	for (i = 0; i < data->dual_len; i++)
+		mtk_crtc->dual_comp[i] = &priv->ddp_comp[data->dual_path[i]];
+	mtk_crtc->dual_comp_nr = data->dual_len;
+	dev_info(dev, "dual pipe: %u blocks join at %d\n", data->dual_len,
+		 data->dual_join);
+
+	return 0;
+}
