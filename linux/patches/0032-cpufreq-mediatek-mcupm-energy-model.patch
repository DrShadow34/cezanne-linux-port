diff --git a/drivers/cpufreq/mediatek-cpufreq-mcupm.c b/drivers/cpufreq/mediatek-cpufreq-mcupm.c
index 150f86a2a..609df4507 100644
--- a/drivers/cpufreq/mediatek-cpufreq-mcupm.c
+++ b/drivers/cpufreq/mediatek-cpufreq-mcupm.c
@@ -13,7 +13,9 @@
  * Only CPU_LEVEL_2 tables (efuse bin 0x10, 2.6 GHz big cores) are included.
  */
 #include <linux/cpufreq.h>
+#include <linux/cpu.h>
 #include <linux/delay.h>
+#include <linux/energy_model.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/module.h>
@@ -201,6 +203,44 @@ static int mcupm_cpufreq_init(struct cpufreq_policy *policy)
 	return 0;
 }
 
+/*
+ * Energy model from the OPP table: P = C * V^2 * f, C being the CPU node's
+ * dynamic-power-coefficient (the same formula as dev_pm_opp_calc_power()).
+ */
+static int mcupm_cpufreq_active_power(struct device *cpu_dev, unsigned long *uW,
+				      unsigned long *kHz)
+{
+	int c = mcupm_cpu_cluster(cpu_dev->id), i;
+	const u16 *e = NULL;
+	u32 cap;
+	u64 mv;
+
+	if (of_property_read_u32(cpu_dev->of_node, "dynamic-power-coefficient", &cap))
+		return -EINVAL;
+
+	/* lowest OPP at or above *kHz; the table runs from the fastest down */
+	for (i = NR_FREQ - 1; i >= 0; i--) {
+		e = mt6885_lv2_pvt[c * NR_FREQ + i];
+		if (e[0] * 1000UL >= *kHz)
+			break;
+	}
+	if (i < 0)
+		return -EINVAL;
+
+	mv = e[1] * 625 / 100;		/* 6.25 mV steps */
+	*uW = div_u64((u64)cap * mv * mv * e[0], 1000000);
+	*kHz = e[0] * 1000UL;
+	return 0;
+}
+
+static void mcupm_cpufreq_register_em(struct cpufreq_policy *policy)
+{
+	struct em_data_callback em_cb = EM_DATA_CB(mcupm_cpufreq_active_power);
+	struct device *cpu_dev = get_cpu_device(policy->cpu);
+
+	em_dev_register_perf_domain(cpu_dev, NR_FREQ, &em_cb, policy->cpus, true);
+}
+
 static struct cpufreq_driver mcupm_cpufreq_driver = {
 	.name		= "mcupm-cpufreq",
 	.flags		= CPUFREQ_NEED_INITIAL_FREQ_CHECK | CPUFREQ_IS_COOLING_DEV,
@@ -209,6 +249,7 @@ static struct cpufreq_driver mcupm_cpufreq_driver = {
 	.fast_switch	= mcupm_cpufreq_fast_switch,
 	.get		= mcupm_cpufreq_get,
 	.init		= mcupm_cpufreq_init,
+	.register_em	= mcupm_cpufreq_register_em,
 };
 
 static int mcupm_cpufreq_probe(struct platform_device *pdev)
