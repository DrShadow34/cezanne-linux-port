+++ b/drivers/soc/mediatek/mt6885-fw-reclaim.c
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * MT6885: EMI MPU regions over memory Linux uses (cezanne port). lk covers
+ * firmware memory with EMI MPU regions, and some of that memory is RAM
+ * here: the AP-MD shared memory windows (regions 24, 25) are larger than
+ * the parts the modem driver uses, and the VPU and ADSP firmware (regions
+ * 21, 28) never runs. As lk leaves these regions only a few domains may use
+ * them (for the VPU / ADSP ones the AP only reads): the CPU works, but the
+ * GPU's writes there are dropped without a fault and its page tables or
+ * buffers there read garbage (panfrost translation and bus faults). lk
+ * leaves them unlocked, and ATF's kernel SIP call may set an unlocked
+ * region (locking it until the next boot), as MIUI's VPU driver does for
+ * region 21 on every boot.
+ *
+ * - a "mediatek,mt6885-emimpu-open" node lists <region start end> triples
+ *   (32-bit addresses, end exclusive) opened to every domain before any
+ *   device probes;
+ * - a reserved-memory node with "mediatek,mt6885-emimpu-reclaim" (mapped,
+ *   not no-map) names its region: the region is opened, one word per page
+ *   written and read back from DRAM, and only when all of them stuck is the
+ *   range freed. Any failure keeps it reserved.
+ */
+#include <linux/arm-smccc.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/sizes.h>
+#include <asm/cacheflush.h>
+
+#define MTK_SIP_EMIMPU_CONTROL	0xc200050b
+#define EMIMPU_SET		0
+#define EMIMPU_DGROUPS		2	/* 8 domains each */
+#define EMIMPU_OPEN_MAX		8
+
+/* every domain unprotected */
+static int __init fw_mpu_open(const char *name, u32 region, phys_addr_t start,
+			      phys_addr_t end)
+{
+	struct arm_smccc_res res;
+	int g;
+
+	if (region > 31 || end <= start || !IS_ALIGNED(start | end, SZ_64K))
+		return -EINVAL;
+	/* dgroup 0 last: ATF locks the region on that write */
+	for (g = EMIMPU_DGROUPS - 1; g >= 0; g--) {
+		arm_smccc_smc(MTK_SIP_EMIMPU_CONTROL, EMIMPU_SET,
+			      (start >> 16) | ((unsigned long)region << 24),
+			      ((end - 1) >> 16) | ((unsigned long)g << 24),
+			      0, 0, 0, 0, &res);
+		if (res.a0) {
+			pr_err("%s: EMI MPU region %u dgroup %d: ATF says %#lx\n",
+			       name, region, g, res.a0);
+			return -EIO;
+		}
+	}
+	return 0;
+}
+
+static u64 fw_reclaim_pattern(phys_addr_t pa)
+{
+	return 0x5ac3a55a3ca5c35aULL ^ pa;
+}
+
+/* dropped writes leave the old DRAM contents behind the cleaned line */
+static bool fw_reclaim_writable(phys_addr_t base, phys_addr_t size)
+{
+	phys_addr_t off;
+
+	for (off = 0; off < size; off += PAGE_SIZE) {
+		u64 *p = phys_to_virt(base + off);
+
+		*p = fw_reclaim_pattern(base + off);
+		dcache_clean_inval_poc((unsigned long)p, (unsigned long)(p + 1));
+	}
+	for (off = 0; off < size; off += PAGE_SIZE)
+		if (*(u64 *)phys_to_virt(base + off) != fw_reclaim_pattern(base + off))
+			return false;
+	return true;
+}
+
+static void __init fw_open_regions(struct device_node *np)
+{
+	u32 v[3 * EMIMPU_OPEN_MAX];
+	int n, i;
+
+	n = of_property_read_variable_u32_array(np, "mediatek,open-regions", v, 3,
+						ARRAY_SIZE(v));
+	for (i = 0; i + 3 <= n; i += 3)
+		if (!fw_mpu_open("emi-mpu", v[i], v[i + 1], v[i + 2]))
+			pr_info("EMI MPU region %u %#x-%#x open to every domain\n",
+				v[i], v[i + 1], v[i + 2] - 1);
+}
+
+static void __init fw_reclaim_one(struct device_node *np)
+{
+	struct reserved_mem *rmem = of_reserved_mem_lookup(np);
+	phys_addr_t end;
+	u32 region;
+
+	if (!rmem || !rmem->size || of_property_read_u32(np, "mediatek,emi-mpu-region", &region) ||
+	    of_property_read_bool(np, "no-map"))
+		return;
+	end = rmem->base + rmem->size;
+	if (fw_mpu_open(rmem->name, region, rmem->base, end))
+		return;
+	if (!fw_reclaim_writable(rmem->base, rmem->size)) {
+		pr_err("%s: writes still dropped after opening region %u, kept\n",
+		       rmem->name, region);
+		return;
+	}
+	free_reserved_area(phys_to_virt(rmem->base), phys_to_virt(end), -1, rmem->name);
+}
+
+static int __init fw_reclaim_init(void)
+{
+	struct device_node *np;
+
+	for_each_compatible_node(np, NULL, "mediatek,mt6885-emimpu-open")
+		fw_open_regions(np);
+	for_each_compatible_node(np, NULL, "mediatek,mt6885-emimpu-reclaim")
+		fw_reclaim_one(np);
+	return 0;
+}
+/* before any device probes: bus masters must not meet a closed region */
+arch_initcall(fw_reclaim_init);
