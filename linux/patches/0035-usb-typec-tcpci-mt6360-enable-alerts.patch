diff --git a/drivers/usb/typec/tcpm/tcpci.c b/drivers/usb/typec/tcpm/tcpci.c
index 6717ac914..3a7559521 100644
--- a/drivers/usb/typec/tcpm/tcpci.c
+++ b/drivers/usb/typec/tcpm/tcpci.c
@@ -814,6 +814,17 @@ irqreturn_t tcpci_irq(struct tcpci *tcpci)
 }
 EXPORT_SYMBOL_GPL(tcpci_irq);
 
+/*
+ * tcpci_init() only computes the alert mask; the chip's TCPC_ALERT_MASK is
+ * written once the interrupt is requested. Drivers that register a port and
+ * request their own irq (not the generic tcpci i2c driver) call this then.
+ */
+int tcpci_enable_alerts(struct tcpci *tcpci)
+{
+	return tcpci_write16(tcpci, TCPC_ALERT_MASK, tcpci->alert_mask);
+}
+EXPORT_SYMBOL_GPL(tcpci_enable_alerts);
+
 static irqreturn_t _tcpci_irq(int irq, void *dev_id)
 {
 	struct tcpci_chip *chip = dev_id;
diff --git a/drivers/usb/typec/tcpm/tcpci_mt6360.c b/drivers/usb/typec/tcpm/tcpci_mt6360.c
index 881ffacbf..b51240738 100644
--- a/drivers/usb/typec/tcpm/tcpci_mt6360.c
+++ b/drivers/usb/typec/tcpm/tcpci_mt6360.c
@@ -172,6 +172,14 @@ static int mt6360_tcpc_probe(struct platform_device *pdev)
 		return ret;
 	}
 
+	/* mt6360_tcpc_init() masked all alerts: enable tcpci's now */
+	ret = tcpci_enable_alerts(mti->tcpci);
+	if (ret) {
+		dev_err(mti->dev, "Failed to enable alerts\n");
+		tcpci_unregister_port(mti->tcpci);
+		return ret;
+	}
+
 	device_init_wakeup(&pdev->dev, true);
 	platform_set_drvdata(pdev, mti);
 
