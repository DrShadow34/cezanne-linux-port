+fn write_raw_sample(
+    sample: &gst::Sample,
+    path: &Path,
+    model: &str,
+    quarters: u32,
+) -> Result<(), Box<dyn std::error::Error>> {
+    let caps = sample.caps().ok_or("raw sample without caps")?;
+    let s = caps.structure(0).unwrap();
+    let format = s.get::<&str>("format")?;
+    let width = s.get::<i32>("width")? as u32;
+    let height = s.get::<i32>("height")? as u32;
+    let (order, bits) = crate::dng::RawFrame::parse_format(format)
+        .ok_or_else(|| format!("unsupported raw format {format}"))?;
+    let buffer = sample.buffer().unwrap();
+    let map = buffer.map_readable()?;
+    let stride = buffer
+        .meta::<gst_video::VideoMeta>()
+        .and_then(|meta| meta.stride().first().map(|&s| s as usize))
+        .unwrap_or(map.len() / height as usize);
+    let frame = crate::dng::RawFrame {
+        data: map.as_slice(),
+        width,
+        height,
+        stride,
+        order,
+        bits,
+    };
+    let info = crate::dng::DngInfo {
+        make: "libcamera",
+        model,
+        quarters,
+    };
+    crate::dng::write_dng(path, &frame, &info)?;
+    Ok(())
+}
