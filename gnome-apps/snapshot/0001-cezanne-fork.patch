+//! Device orientation from iio-sensor-proxy and display rotation from Mutter.
+//!
+//! Both are quarter turns counter-clockwise, like Mutter's monitor
+//! transforms (an accelerometer reading of "left-up" makes GNOME rotate the
+//! display by one quarter).  When the display rotation is locked the two
+//! differ, and the camera controls turn in place by the difference; pictures
+//! are tagged with the device orientation either way.
+
+use std::cell::{Cell, RefCell};
+use std::rc::{Rc, Weak};
+
+use gtk::prelude::*;
+use gtk::{gio, glib};
+
+type Callback = Box<dyn Fn(u32, u32)>;
+
+#[derive(Default)]
+struct State {
+    device: Cell<u32>,
+    display: Cell<u32>,
+    sensor: RefCell<Option<gio::DBusProxy>>,
+    mutter: RefCell<Option<gio::DBusProxy>>,
+    claimed: Cell<bool>,
+    wanted: Cell<bool>,
+    callback: RefCell<Option<Callback>>,
+}
+
+impl State {
+    fn notify(&self) {
+        if let Some(callback) = &*self.callback.borrow() {
+            callback(self.device.get(), self.display.get());
+        }
+    }
+
+    fn read_device(&self) {
+        let Some(proxy) = &*self.sensor.borrow() else {
+            return;
+        };
+        let orientation = proxy
+            .cached_property("AccelerometerOrientation")
+            .and_then(|v| v.get::<String>());
+        let quarters = match orientation.as_deref() {
+            Some("normal") => 0,
+            Some("left-up") => 1,
+            Some("bottom-up") => 2,
+            Some("right-up") => 3,
+            // flat or unknown: keep the last orientation
+            _ => return,
+        };
+        if self.device.replace(quarters) != quarters {
+            log::debug!("Device orientation: {orientation:?}");
+            self.notify();
+        }
+    }
+
+    fn set_display(&self, quarters: u32) {
+        if self.display.replace(quarters) != quarters {
+            log::debug!("Display rotation: {quarters} quarter turns");
+            self.notify();
+        }
+    }
+}
+
+/// Watches the orientations while claimed; see [`OrientationMonitor::set_active`].
+#[derive(Clone, Default)]
+pub struct OrientationMonitor(Rc<State>);
+
+impl std::fmt::Debug for OrientationMonitor {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("OrientationMonitor")
+            .field("device", &self.0.device.get())
+            .field("display", &self.0.display.get())
+            .finish()
+    }
+}
+
+impl OrientationMonitor {
+    /// `callback` gets (device, display) quarter turns on every change.
+    pub fn new(callback: impl Fn(u32, u32) + 'static) -> Self {
+        let this = Self::default();
+        this.0.callback.replace(Some(Box::new(callback)));
+
+        let weak = Rc::downgrade(&this.0);
+        glib::spawn_future_local(async move {
+            let proxy = gio::DBusProxy::for_bus_future(
+                gio::BusType::System,
+                gio::DBusProxyFlags::NONE,
+                None,
+                "net.hadess.SensorProxy",
+                "/net/hadess/SensorProxy",
+                "net.hadess.SensorProxy",
+            )
+            .await;
+            let Some(state) = weak.upgrade() else { return };
+            match proxy {
+                Ok(proxy) => {
+                    let weak = Rc::downgrade(&state);
+                    proxy.connect_local("g-properties-changed", false, move |_| {
+                        if let Some(state) = weak.upgrade() {
+                            state.read_device();
+                        }
+                        None
+                    });
+                    state.sensor.replace(Some(proxy));
+                    Self::update_claim(&state);
+                }
+                Err(err) => log::info!("No iio-sensor-proxy: {err}"),
+            }
+        });
+
+        let weak = Rc::downgrade(&this.0);
+        glib::spawn_future_local(async move {
+            let proxy = gio::DBusProxy::for_bus_future(
+                gio::BusType::Session,
+                gio::DBusProxyFlags::DO_NOT_LOAD_PROPERTIES,
+                None,
+                "org.gnome.Mutter.DisplayConfig",
+                "/org/gnome/Mutter/DisplayConfig",
+                "org.gnome.Mutter.DisplayConfig",
+            )
+            .await;
+            let Some(state) = weak.upgrade() else { return };
+            match proxy {
+                Ok(proxy) => {
+                    let weak = Rc::downgrade(&state);
+                    proxy.connect_local("g-signal", false, move |args| {
+                        let signal = args[2].get::<String>().unwrap_or_default();
+                        if signal == "MonitorsChanged" {
+                            Self::read_display(weak.clone());
+                        }
+                        None
+                    });
+                    state.mutter.replace(Some(proxy));
+                    Self::read_display(Rc::downgrade(&state));
+                }
+                Err(err) => log::info!("No Mutter display config: {err}"),
+            }
+        });
+
+        this
+    }
+
+    /// Claims the accelerometer while active (it stays powered while
+    /// claimed).
+    pub fn set_active(&self, active: bool) {
+        self.0.wanted.set(active);
+        Self::update_claim(&self.0);
+    }
+
+    fn update_claim(state: &Rc<State>) {
+        let want = state.wanted.get();
+        if want == state.claimed.get() {
+            return;
+        }
+        let Some(proxy) = state.sensor.borrow().clone() else {
+            return;
+        };
+        state.claimed.set(want);
+        let method = if want {
+            "ClaimAccelerometer"
+        } else {
+            "ReleaseAccelerometer"
+        };
+        let weak = Rc::downgrade(state);
+        glib::spawn_future_local(async move {
+            if let Err(err) = proxy
+                .call_future(method, None, gio::DBusCallFlags::NONE, -1)
+                .await
+            {
+                log::warn!("{method} failed: {err}");
+            } else if let Some(state) = weak.upgrade() {
+                state.read_device();
+            }
+        });
+    }
+
+    fn read_display(weak: Weak<State>) {
+        let Some(proxy) = weak.upgrade().and_then(|s| s.mutter.borrow().clone()) else {
+            return;
+        };
+        glib::spawn_future_local(async move {
+            let reply = proxy
+                .call_future("GetCurrentState", None, gio::DBusCallFlags::NONE, -1)
+                .await;
+            let Some(state) = weak.upgrade() else { return };
+            let reply = match reply {
+                Ok(reply) => reply,
+                Err(err) => {
+                    log::warn!("GetCurrentState failed: {err}");
+                    return;
+                }
+            };
+            // (serial, monitors, logical_monitors a(iiduba(ssss)a{sv}), props)
+            let logical = reply.child_value(2);
+            let mut transform = None;
+            for i in 0..logical.n_children() {
+                let monitor = logical.child_value(i);
+                let t = monitor.child_value(3).get::<u32>();
+                let primary = monitor.child_value(4).get::<bool>().unwrap_or(false);
+                if primary || transform.is_none() {
+                    transform = t;
+                }
+            }
+            // flipped transforms (4..7) do not happen on a phone
+            if let Some(t) = transform {
+                state.set_display(t % 4);
+            }
+        });
+    }
+}
