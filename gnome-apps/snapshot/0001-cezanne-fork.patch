+const PIPEWIRE_PROVIDER: &str = "pipewiredeviceprovider";
+const LIBCAMERA_PROVIDER: &str = "libcameraprovider";
+
+/// libcamera's own provider when `libcamerasrc` is installed: it exposes the
+/// camera controls and raw streams that PipeWire does not.  APERTURE_BACKEND
+/// = "pipewire" or "libcamera" overrides the choice.
+fn provider_name() -> &'static str {
+    match std::env::var("APERTURE_BACKEND").as_deref() {
+        Ok("pipewire") => PIPEWIRE_PROVIDER,
+        Ok("libcamera") => LIBCAMERA_PROVIDER,
+        _ if gst::DeviceProviderFactory::find(LIBCAMERA_PROVIDER).is_some() => {
+            LIBCAMERA_PROVIDER
+        }
+        _ => PIPEWIRE_PROVIDER,
+    }
+}
