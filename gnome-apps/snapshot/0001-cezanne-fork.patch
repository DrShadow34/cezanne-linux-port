+/// A hardware H.264 encoder fed RGB converts it to BT.709 limited range YCbCr
+/// (cezanne-venc, which writes that into the SPS too), but GStreamer's V4L2
+/// encoder copies the input's colorimetry (sRGB, RGB matrix) to its output
+/// caps, and mp4mux writes those into the file, where players take them
+/// over the SPS. Replace an RGB-matrix colorimetry on the coded caps.
+fn fix_rgb_encoder_colorimetry(element: &gst::Element) {
+    let Some(factory) = element.factory() else {
+        return;
+    };
+    if !H264_HW_ENCODERS.contains(&factory.name().as_str()) {
+        return;
+    }
+    let Some(src) = element.static_pad("src") else {
+        return;
+    };
+    src.add_probe(gst::PadProbeType::EVENT_DOWNSTREAM, |_, info| {
+        let Some(gst::PadProbeData::Event(event)) = &info.data else {
+            return gst::PadProbeReturn::Ok;
+        };
+        let gst::EventView::Caps(caps_event) = event.view() else {
+            return gst::PadProbeReturn::Ok;
+        };
+        let caps = caps_event.caps();
+        let rgb = caps
+            .structure(0)
+            .and_then(|s| s.get::<&str>("colorimetry").ok())
+            .and_then(|c| c.parse::<gst_video::VideoColorimetry>().ok())
+            .is_some_and(|c| c.matrix() == gst_video::VideoColorMatrix::Rgb);
+        if rgb {
+            let mut caps = caps.to_owned();
+            caps.make_mut().set("colorimetry", "bt709");
+            log::debug!("Recording colorimetry: bt709 (encoder converted RGB)");
+            info.data = Some(gst::PadProbeData::Event(gst::event::Caps::new(&caps)));
+        }
+        gst::PadProbeReturn::Ok
+    });
+}
