new file mode 100644
index 0000000..60f9935
--- /dev/null
+++ b/src/flash.rs
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Rear flash LEDs, through the LED class (`/sys/class/leds/*:flash-*`).
+//!
+//! All flash LEDs are driven together in torch mode: the camera has no
+//! strobe synchronisation, so a "flash" picture is taken with the torch lit
+//! and the exposure settled under it.
+
+use std::path::PathBuf;
+
+fn leds() -> Vec<PathBuf> {
+    let Ok(dir) = std::fs::read_dir("/sys/class/leds") else {
+        return Vec::new();
+    };
+    let mut leds: Vec<PathBuf> = dir
+        .flatten()
+        .filter(|e| e.file_name().to_string_lossy().contains(":flash"))
+        .map(|e| e.path())
+        .collect();
+    leds.sort();
+    leds
+}
+
+/// Whether there is a flash LED this user can drive.
+pub fn available() -> bool {
+    leds().iter().any(|led| {
+        std::fs::OpenOptions::new()
+            .write(true)
+            .open(led.join("brightness"))
+            .is_ok()
+    })
+}
+
+/// Lights all flash LEDs at `level` (fraction of their torch maximum), or
+/// switches them off with `None`.
+pub fn set(level: Option<f64>) {
+    for led in leds() {
+        let max = std::fs::read_to_string(led.join("max_brightness"))
+            .ok()
+            .and_then(|s| s.trim().parse::<u32>().ok())
+            .unwrap_or(1);
+        let value = level.map_or(0, |l| ((l.clamp(0.0, 1.0) * max as f64).round() as u32).max(1));
+        if let Err(err) = std::fs::write(led.join("brightness"), value.to_string()) {
+            log::warn!("Flash {}: {err}", led.display());
+        }
+    }
+}
+
+static SIGNAL_PATHS: std::sync::OnceLock<Vec<std::ffi::CString>> = std::sync::OnceLock::new();
+
+extern "C" fn switch_off_and_die(signal: libc::c_int) {
+    // async-signal-safe: open/write/close, then the default action
+    if let Some(paths) = SIGNAL_PATHS.get() {
+        for path in paths {
+            // SAFETY: plain syscalls on a NUL-terminated path
+            unsafe {
+                let fd = libc::open(path.as_ptr(), libc::O_WRONLY);
+                if fd >= 0 {
+                    libc::write(fd, b"0".as_ptr().cast(), 1);
+                    libc::close(fd);
+                }
+            }
+        }
+    }
+    // SAFETY: restoring the default handler and re-raising is signal-safe
+    unsafe {
+        libc::signal(signal, libc::SIG_DFL);
+        libc::raise(signal);
+    }
+}
+
+/// Switches the flash LEDs off when the process gets SIGTERM or SIGINT.
+pub fn install_signal_guard() {
+    let paths = leds()
+        .into_iter()
+        .filter_map(|led| {
+            std::ffi::CString::new(led.join("brightness").into_os_string().into_encoded_bytes()).ok()
+        })
+        .collect();
+    if SIGNAL_PATHS.set(paths).is_err() {
+        return;
+    }
+    for signal in [libc::SIGTERM, libc::SIGINT] {
+        // SAFETY: the handler only uses async-signal-safe calls
+        unsafe {
+            libc::signal(signal, switch_off_and_die as libc::sighandler_t);
+        }
+    }
+}
diff --git a/src/hdr.rs b/src/hdr.rs
new file mode 100644
index 0000000..4070c5e
--- /dev/null
+++ b/src/hdr.rs
@@ -0,0 +1,353 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Picture post-processing on the Redmi K30 Ultra, in place and in the
+//! background (`cezanne-photo`): noise reduction, and HDR and portrait with
+//! the monochrome sensor.  While either is on with a camera that supports
+//! it, `cezanne-mono` streams the mono sensor; a picture also takes an
+//! exposure bracket there, which then widens the picture's dynamic range
+//! and/or gives the depth for the portrait blur.
+
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+
+use gtk::prelude::*;
+use gtk::{gio, glib};
+
+const MONO_HELPER: &str = "cezanne-mono";
+const PHOTO_HELPER: &str = "cezanne-photo";
+/// cezanne-upscaled (package cezanne-upscale): upscaling and segmentation
+const APU_SOCKET: &str = "/run/cezanne-upscale.sock";
+
+/// Whether the post-processing helper is installed (noise reduction).
+pub fn processing_available() -> bool {
+    glib::find_program_in_path(PHOTO_HELPER).is_some()
+}
+
+/// Whether HDR can work: both helpers installed.
+pub fn available() -> bool {
+    glib::find_program_in_path(MONO_HELPER).is_some() && processing_available()
+}
+
+/// Noise reduction level (0 off .. 3 strong) for the "denoise" setting;
+/// "auto" by the analogue gain of the picture.
+pub fn denoise_level(setting: &str, gain: Option<f64>) -> u32 {
+    match setting {
+        "low" => 1,
+        "medium" => 2,
+        "high" => 3,
+        "auto" => match gain {
+            Some(g) if g >= 12.0 => 3,
+            Some(g) if g >= 5.0 => 2,
+            Some(g) if g >= 2.0 => 1,
+            _ => 0,
+        },
+        _ => 0,
+    }
+}
+
+/// The cameras whose pictures the mono frames can improve: the main and the
+/// ultrawide camera (the mono sensor sees a part of the latter's view).
+pub fn supports(camera: &aperture::Camera) -> bool {
+    matches!(camera.model().as_deref(), Some("imx682" | "hi1337"))
+}
+
+/// The stereo pair (portrait by depth, the mono-guided low light noise
+/// reduction): the main camera, whose field of view the mono sensor's
+/// matches.
+pub fn supports_stereo(camera: &aperture::Camera) -> bool {
+    camera.model().as_deref() == Some("imx682")
+}
+
+/// The APU's subject mask for portraits (cezanne-upscaled's segment job):
+/// no mono frame needed, any camera.
+pub fn segmenter_available() -> bool {
+    processing_available() && Path::new(APU_SOCKET).exists()
+}
+
+/// Portrait: the APU's mask on any camera, else depth from the stereo pair.
+pub fn supports_portrait(camera: &aperture::Camera) -> bool {
+    supports_stereo(camera) || segmenter_available()
+}
+
+/// What a portrait keeps sharp: the APU's mask of the salient object or of
+/// the people in the picture (one network each); depth from the stereo pair
+/// when the mask finds none.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Subject {
+    Objects,
+    People,
+}
+
+impl Subject {
+    fn arg(self) -> &'static str {
+        match self {
+            Self::Objects => "objects",
+            Self::People => "people",
+        }
+    }
+}
+
+struct Helper {
+    process: gio::Subprocess,
+    stdin: gio::OutputStream,
+    stdout: gio::DataInputStream,
+}
+
+/// The running `cezanne-mono`.
+#[derive(Default)]
+pub struct MonoStream {
+    helper: RefCell<Option<Helper>>,
+}
+
+impl std::fmt::Debug for MonoStream {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("MonoStream")
+            .field("running", &self.is_running())
+            .finish()
+    }
+}
+
+impl MonoStream {
+    pub fn is_running(&self) -> bool {
+        self.helper.borrow().is_some()
+    }
+
+    pub fn start(&self) {
+        if self.is_running() {
+            return;
+        }
+        let process = match gio::Subprocess::newv(
+            &[MONO_HELPER.as_ref()],
+            gio::SubprocessFlags::STDIN_PIPE | gio::SubprocessFlags::STDOUT_PIPE,
+        ) {
+            Ok(p) => p,
+            Err(err) => {
+                log::warn!("HDR: cannot start {MONO_HELPER}: {err}");
+                return;
+            }
+        };
+        let (Some(stdin), Some(stdout)) = (process.stdin_pipe(), process.stdout_pipe()) else {
+            return;
+        };
+        log::debug!("HDR: mono stream started");
+        self.helper.replace(Some(Helper {
+            process,
+            stdin,
+            stdout: gio::DataInputStream::new(&stdout),
+        }));
+    }
+
+    /// Stops the stream: the helper exits when its input closes.
+    pub fn stop(&self) {
+        if let Some(helper) = self.helper.take() {
+            let _ = helper.stdin.close(gio::Cancellable::NONE);
+            helper.process.wait_async(gio::Cancellable::NONE, |_| ());
+            log::debug!("HDR: mono stream stopped");
+        }
+    }
+
+    /// Takes a bracket to `<prefix>-0/1/2.pgm`; true once it is written.
+    pub async fn capture(&self, prefix: &Path) -> bool {
+        let (stdin, stdout) = match &*self.helper.borrow() {
+            Some(h) => (h.stdin.clone(), h.stdout.clone()),
+            None => return false,
+        };
+        let command = format!("capture {}\n", prefix.display());
+        if stdin
+            .write_all_future(command.into_bytes(), glib::Priority::DEFAULT)
+            .await
+            .is_err()
+        {
+            return false;
+        }
+        loop {
+            match stdout.read_line_utf8_future(glib::Priority::DEFAULT).await {
+                Ok(Some(line)) if line.starts_with("done ") => return true,
+                Ok(Some(_)) => continue,
+                _ => return false,
+            }
+        }
+    }
+}
+
+/// The bracket's file prefix for a picture: in the cache directory.
+pub fn bracket_prefix(picture: &Path) -> PathBuf {
+    let dir = glib::user_cache_dir().join("snapshot-hdr");
+    let _ = std::fs::create_dir_all(&dir);
+    let stem = picture
+        .file_stem()
+        .map(|s| s.to_string_lossy().into_owned())
+        .unwrap_or_else(|| "picture".into());
+    dir.join(stem)
+}
+
+/// Markers of the pictures being processed (`<picture name>.marker`, the
+/// picture's path inside); `cezanne-photo` deletes its marker when done.
+fn markers_dir() -> PathBuf {
+    let dir = glib::user_cache_dir().join("snapshot-hdr").join("processing");
+    let _ = std::fs::create_dir_all(&dir);
+    dir
+}
+
+/// Brackets older than this are left over.
+const MARKER_MAX_AGE: std::time::Duration = std::time::Duration::from_secs(180);
+/// A marker without the helper's pid this old: the helper never started.
+const MARKER_START_AGE: std::time::Duration = std::time::Duration::from_secs(30);
+
+/// The helper writing a marker still runs (its pid, appended to the marker,
+/// is alive), or has not had time to start yet.
+fn marker_live(marker: &Path) -> Option<PathBuf> {
+    let content = std::fs::read_to_string(marker).ok()?;
+    let mut lines = content.lines().filter(|l| !l.is_empty());
+    let picture = PathBuf::from(lines.next()?);
+    let live = match lines.next().and_then(|pid| pid.trim().parse::<u32>().ok()) {
+        Some(pid) => Path::new(&format!("/proc/{pid}")).exists(),
+        None => std::fs::metadata(marker)
+            .and_then(|m| m.modified())
+            .ok()
+            .and_then(|t| t.elapsed().ok())
+            .is_some_and(|age| age < MARKER_START_AGE),
+    };
+    live.then_some(picture)
+}
+
+/// Brackets left behind (a bracket taken while the app closed, or a helper
+/// that died), older than MARKER_MAX_AGE.
+fn remove_stale_brackets() {
+    let Some(dir) = markers_dir().parent().map(Path::to_owned) else {
+        return;
+    };
+    for e in std::fs::read_dir(dir).into_iter().flatten().flatten() {
+        let stale = e
+            .metadata()
+            .ok()
+            .and_then(|m| m.modified().ok())
+            .and_then(|t| t.elapsed().ok())
+            .is_some_and(|age| age > MARKER_MAX_AGE);
+        if stale && e.path().extension().is_some_and(|x| x == "pgm") {
+            let _ = std::fs::remove_file(e.path());
+        }
+        // upscale-<pid>-in/out.png of a helper that is gone
+        let name = e.file_name().to_string_lossy().into_owned();
+        if let Some(pid) = name
+            .strip_prefix("upscale-")
+            .and_then(|rest| rest.split('-').next())
+            && !Path::new(&format!("/proc/{pid}")).exists()
+        {
+            let _ = std::fs::remove_file(e.path());
+        }
+    }
+}
+
+/// Pictures still being processed (by an earlier run of the app too).
+pub fn pending() -> Vec<(PathBuf, PathBuf)> {
+    remove_stale_brackets();
+    let Ok(dir) = std::fs::read_dir(markers_dir()) else {
+        return Vec::new();
+    };
+    dir.flatten()
+        .filter_map(|e| {
+            let marker = e.path();
+            match marker_live(&marker) {
+                Some(picture) => Some((picture, marker)),
+                None => {
+                    let _ = std::fs::remove_file(&marker);
+                    None
+                }
+            }
+        })
+        .collect()
+}
+
+/// Until the marker is gone (or its helper died).
+pub async fn wait_gone(marker: &Path) {
+    while marker.exists() && marker_live(marker).is_some() {
+        glib::timeout_future(std::time::Duration::from_millis(1000)).await;
+    }
+}
+
+/// Whether an AI upscaler is installed: the APU's (cezanne-upscaled's
+/// socket) or the GPU's (realesrgan-ncnn-vulkan, cezanne-photo's fallback).
+pub fn upscaler_available() -> bool {
+    processing_available()
+        && (Path::new(APU_SOCKET).exists()
+            || glib::find_program_in_path("realesrgan-ncnn-vulkan").is_some())
+}
+
+/// Post-processes the picture in place: noise reduction at `denoise`
+/// (0: none; guided by the mono frame with `lowlight`), portrait and/or HDR
+/// with the bracket at `bracket`.  The helper
+/// goes on if the app closes; it deletes the marker and the bracket when
+/// done.
+pub async fn process(
+    picture: PathBuf,
+    denoise: u32,
+    bracket: Option<PathBuf>,
+    hdr: bool,
+    portrait: Option<Subject>,
+    lowlight: bool,
+    upscale: u32,
+    quality: u32,
+) {
+    let name = picture
+        .file_name()
+        .map(|n| n.to_string_lossy().into_owned())
+        .unwrap_or_default();
+    let marker = markers_dir().join(format!("{name}.marker"));
+    let _ = std::fs::write(&marker, picture.as_os_str().as_encoded_bytes());
+
+    let mut args: Vec<std::ffi::OsString> = vec![
+        PHOTO_HELPER.into(),
+        "--marker".into(),
+        marker.clone().into(),
+        "--quality".into(),
+        quality.to_string().into(),
+    ];
+    if denoise > 0 {
+        args.push("--denoise".into());
+        args.push(denoise.to_string().into());
+        if let (true, Some(prefix)) = (lowlight, &bracket) {
+            args.push("--lowlight".into());
+            args.push(prefix.into());
+        }
+    }
+    if let Some(subject) = portrait {
+        // without a bracket (no mono frame: not the main camera) the APU's
+        // mask only; the prefix then names no files
+        args.push("--portrait".into());
+        args.push(bracket.clone().unwrap_or_else(|| picture.with_extension("no-bracket")).into());
+        args.push("--subject".into());
+        args.push(subject.arg().into());
+    }
+    if let Some(prefix) = &bracket {
+        if hdr {
+            args.push("--hdr".into());
+            args.push(prefix.into());
+        }
+    }
+    if upscale > 1 {
+        args.push("--upscale".into());
+        args.push(upscale.to_string().into());
+    }
+    args.push(picture.clone().into());
+    let args: Vec<&std::ffi::OsStr> = args.iter().map(|a| a.as_os_str()).collect();
+    match gio::Subprocess::newv(&args, gio::SubprocessFlags::NONE) {
+        Ok(process) => match process.wait_check_future().await {
+            Ok(()) => log::debug!(
+                "Processed {} (denoise {denoise}, HDR {}, portrait {:?}, upscale {upscale})",
+                picture.display(),
+                hdr && bracket.is_some(),
+                portrait
+            ),
+            Err(err) => log::warn!("{PHOTO_HELPER} on {}: {err}", picture.display()),
+        },
+        Err(err) => {
+            log::warn!("Cannot start {PHOTO_HELPER}: {err}");
+            let _ = std::fs::remove_file(&marker);
+            if let Some(prefix) = bracket {
+                for i in 0..3 {
+                    let _ = std::fs::remove_file(format!("{}-{i}.pgm", prefix.display()));
+                }
+            }
+        }
+    }
+}
