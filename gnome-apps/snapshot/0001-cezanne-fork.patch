diff --git a/data/resources/style.css b/data/resources/style.css
index 638e11c..fc97245 100644
--- a/data/resources/style.css
+++ b/data/resources/style.css
@@ -78,12 +78,60 @@ button.gallerycontrols.circular {
   min-height: 24px;
 }
 
+/* in its own layout slot right above the lens switch */
 camera .recording-label {
-  padding: 12px 24px;
+  padding: 6px 18px;
   border-radius: 500px;
-  margin-bottom: 100px;
 }
 
-camera.portrait .recording-label {
-  margin-bottom: 24px;
+/* Device orientation with the display rotation locked: controls turn in place */
+camera .rotatable,
+camera .rotatable-toggles > toggle {
+  transition: transform 250ms ease-out;
+}
+
+camera.rotate-cw .rotatable,
+camera.rotate-cw .rotatable-toggles > toggle {
+  transform: rotate(90deg);
+}
+
+camera.rotate-ccw .rotatable,
+camera.rotate-ccw .rotatable-toggles > toggle {
+  transform: rotate(-90deg);
+}
+
+camera.rotate-180 .rotatable,
+camera.rotate-180 .rotatable-toggles > toggle {
+  transform: rotate(180deg);
+}
+
+/* rear lens selector over the viewfinder */
+camera .lens-toggles {
+  background-color: alpha(black, 0.45);
+  color: white;
+}
+
+camera .lens-toggles > toggle {
+  min-width: 34px;
+  min-height: 34px;
+  font-weight: bold;
+}
+
+camera .hdr-button {
+  font-weight: bold;
+  padding-left: 8px;
+  padding-right: 8px;
+}
+
+camera .hdr-button:checked {
+  background: none;
+  color: #f6d32d;
+}
+
+/* picture still being post-processed (noise reduction, HDR) */
+.processing-spinner {
+  color: white;
+  background-color: alpha(black, 0.5);
+  border-radius: 9999px;
+  padding: 5px;
 }
