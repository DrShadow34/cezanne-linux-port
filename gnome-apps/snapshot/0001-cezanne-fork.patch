+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Camera settings sheet: libcamera controls of the current camera.
+//!
+//! Rows are built from the `libcamerasrc` property specs, so a control only
+//! needs its property name in a group below: booleans become switches,
+//! numbers spin rows (with UI ranges, the specs allow anything), enums combo
+//! rows.  Changes apply to the next requests while streaming.
+
+use adw::prelude::*;
+use gettextrs::gettext;
+use gtk::glib;
+
+struct Control {
+    name: &'static str,
+    title: &'static str,
+    /// UI range and step for numeric controls.
+    range: Option<(f64, f64, f64)>,
+    digits: u32,
+    /// Only editable while this boolean control is false (manual mode).
+    manual_of: Option<&'static str>,
+}
+
+const fn ctl(name: &'static str, title: &'static str) -> Control {
+    Control { name, title, range: None, digits: 0, manual_of: None }
+}
+
+const fn num(
+    name: &'static str,
+    title: &'static str,
+    min: f64,
+    max: f64,
+    step: f64,
+    digits: u32,
+    manual_of: Option<&'static str>,
+) -> Control {
+    Control { name, title, range: Some((min, max, step)), digits, manual_of }
+}
+
+fn groups() -> Vec<(String, Vec<Control>)> {
+    vec![
+        (
+            gettext("Exposure"),
+            vec![
+                ctl("ae-enable", "Automatic Exposure"),
+                num("exposure-value", "Exposure Compensation (EV)", -2.0, 2.0, 0.1, 1, None),
+                num("exposure-time", "Exposure Time (µs)", 50.0, 1_000_000.0, 100.0, 0, Some("ae-enable")),
+                num("analogue-gain", "Analogue Gain", 1.0, 16.0, 0.1, 1, Some("ae-enable")),
+                ctl("ae-metering-mode", "Metering"),
+                ctl("ae-flicker-mode", "Flicker Avoidance"),
+                num("ae-flicker-period", "Flicker Period (µs)", 0.0, 20_000.0, 1.0, 0, None),
+            ],
+        ),
+        (
+            gettext("White Balance"),
+            vec![
+                ctl("awb-enable", "Automatic White Balance"),
+                ctl("awb-mode", "Illuminant"),
+                num("colour-temperature", "Colour Temperature (K)", 2000.0, 10_000.0, 100.0, 0, Some("awb-enable")),
+            ],
+        ),
+        (
+            gettext("Image"),
+            vec![
+                num("brightness", "Brightness", -1.0, 1.0, 0.05, 2, None),
+                num("contrast", "Contrast", 0.0, 2.0, 0.05, 2, None),
+                num("saturation", "Saturation", 0.0, 2.0, 0.05, 2, None),
+                num("sharpness", "Sharpness", 0.0, 10.0, 0.5, 1, None),
+                num("gamma", "Gamma", 1.0, 3.0, 0.1, 1, None),
+            ],
+        ),
+        (
+            gettext("Focus"),
+            vec![
+                ctl("af-mode", "Focus Mode"),
+                num("lens-position", "Lens Position (dioptres)", 0.0, 15.0, 0.1, 1, None),
+            ],
+        ),
+    ]
+}
+
+fn spin_value(v: &glib::Value) -> Option<f64> {
+    v.get::<f32>()
+        .map(f64::from)
+        .or_else(|_| v.get::<f64>())
+        .or_else(|_| v.get::<i32>().map(f64::from))
+        .or_else(|_| v.get::<i64>().map(|x| x as f64))
+        .or_else(|_| v.get::<u32>().map(f64::from))
+        .ok()
+}
+
+fn to_value(pspec: &glib::ParamSpec, x: f64) -> glib::Value {
+    match pspec.value_type() {
+        t if t == f32::static_type() => (x as f32).to_value(),
+        t if t == f64::static_type() => x.to_value(),
+        t if t == i64::static_type() => (x as i64).to_value(),
+        t if t == u32::static_type() => (x as u32).to_value(),
+        _ => (x as i32).to_value(),
+    }
+}
+
+fn control_row(src: &gst::Element, c: &Control) -> Option<adw::PreferencesRow> {
+    use gst::prelude::*;
+
+    let pspec = src.find_property(c.name)?;
+    let value = src.property_value(c.name);
+    let ty = pspec.value_type();
+
+    if ty == bool::static_type() {
+        let row = adw::SwitchRow::builder()
+            .title(gettext(c.title))
+            .active(value.get::<bool>().unwrap_or(false))
+            .build();
+        row.connect_active_notify(glib::clone!(
+            #[weak]
+            src,
+            move |row| src.set_property(c_name(row), row.is_active())
+        ));
+        row.set_widget_name(c.name);
+        return Some(row.upcast());
+    }
+
+    if let Some(class) = glib::EnumClass::with_type(ty) {
+        let values: Vec<glib::EnumValue> = class.values().to_vec();
+        let model = gtk::StringList::new(
+            &values.iter().map(|v| v.nick()).collect::<Vec<_>>(),
+        );
+        let current = value.get::<&glib::EnumValue>().ok().map(|v| v.value());
+        let row = adw::ComboRow::builder()
+            .title(gettext(c.title))
+            .model(&model)
+            .build();
+        if let Some(pos) = values.iter().position(|v| Some(v.value()) == current) {
+            row.set_selected(pos as u32);
+        }
+        row.set_widget_name(c.name);
+        row.connect_selected_notify(glib::clone!(
+            #[weak]
+            src,
+            move |row| {
+                if let Some(v) = values.get(row.selected() as usize) {
+                    src.set_property_from_str(c_name(row), v.nick());
+                }
+            }
+        ));
+        return Some(row.upcast());
+    }
+
+    let (min, max, step) = c.range?;
+    let current = spin_value(&value).unwrap_or(min).clamp(min, max);
+    let row = adw::SpinRow::builder()
+        .title(gettext(c.title))
+        .adjustment(&gtk::Adjustment::new(current, min, max, step, step * 10.0, 0.0))
+        .digits(c.digits)
+        .build();
+    row.set_widget_name(c.name);
+    row.connect_value_notify(glib::clone!(
+        #[weak]
+        src,
+        move |row| {
+            if let Some(pspec) = src.find_property(c_name(row)) {
+                src.set_property_from_value(c_name(row), &to_value(&pspec, row.value()));
+            }
+        }
+    ));
+    Some(row.upcast())
+}
+
+/// Property name stored in the row's widget name.
+fn c_name(row: &impl IsA<gtk::Widget>) -> &'static str {
+    let name = row.as_ref().widget_name();
+    groups()
+        .into_iter()
+        .flat_map(|(_, cs)| cs)
+        .find(|c| c.name == name.as_str())
+        .map(|c| c.name)
+        .unwrap_or("")
+}
+
+/// Presents the settings for the camera shown by `viewfinder`.
+pub fn present(
+    parent: &impl IsA<gtk::Widget>,
+    viewfinder: &aperture::Viewfinder,
+    settings: &gtk::gio::Settings,
+) {
+    let page = adw::PreferencesPage::new();
+
+    let Some(src) = viewfinder.camera_source() else {
+        let status = adw::StatusPage::builder()
+            .icon_name("camera-web-symbolic")
+            .title(gettext("No Camera Controls"))
+            .description(gettext(
+                "Camera settings and RAW capture need the libcamera backend (gst-plugin-libcamera)",
+            ))
+            .build();
+        let dialog = adw::Dialog::builder()
+            .title(gettext("Camera Settings"))
+            .child(&status)
+            .content_width(360)
+            .build();
+        dialog.present(Some(parent));
+        return;
+    };
+
+    let capture = adw::PreferencesGroup::builder().title(gettext("Capture")).build();
+    let raw = adw::SwitchRow::builder()
+        .title(gettext("Save RAW Photos"))
+        .subtitle(gettext("Also save the sensor data as a DNG file"))
+        .active(viewfinder.raw_capture())
+        .build();
+    raw.connect_active_notify(glib::clone!(
+        #[weak]
+        viewfinder,
+        #[weak]
+        settings,
+        move |row| {
+            viewfinder.set_raw_capture(row.is_active());
+            let _ = settings.set_boolean("save-raw", row.is_active());
+        }
+    ));
+    capture.add(&raw);
+
+    // file format and JPEG quality
+    let format_row = adw::ComboRow::builder()
+        .title(gettext("Format"))
+        .subtitle(gettext("PNG is lossless and larger"))
+        .model(&gtk::StringList::new(&["JPEG", "PNG"]))
+        .selected(u32::from(settings.string("picture-format") == "png"))
+        .build();
+    let quality_row = adw::SpinRow::builder()
+        .title(gettext("JPEG Quality"))
+        .adjustment(&gtk::Adjustment::new(
+            f64::from(settings.int("jpeg-quality")),
+            50.0,
+            100.0,
+            1.0,
+            5.0,
+            0.0,
+        ))
+        .sensitive(settings.string("picture-format") != "png")
+        .build();
+    format_row.connect_selected_notify(glib::clone!(
+        #[weak]
+        settings,
+        #[weak]
+        quality_row,
+        move |row| {
+            let png = row.selected() == 1;
+            let _ = settings.set_string("picture-format", if png { "png" } else { "jpeg" });
+            quality_row.set_sensitive(!png);
+        }
+    ));
+    quality_row.connect_value_notify(glib::clone!(
+        #[weak]
+        settings,
+        move |row| {
+            let _ = settings.set_int("jpeg-quality", row.value() as i32);
+        }
+    ));
+    capture.add(&format_row);
+    capture.add(&quality_row);
+
+    if crate::hdr::upscaler_available() {
+        let row = adw::ComboRow::builder()
+            .title(gettext("AI Upscaling"))
+            .subtitle(gettext(
+                "With the 64MP button only: Real-ESRGAN, minutes per picture in the background",
+            ))
+            .model(&gtk::StringList::new(&[
+                &gettext("2× (64 MP on the main camera)"),
+                &gettext("4× (256 MP, very large files)"),
+            ]))
+            .selected(u32::from(settings.int("upscale-factor") >= 4))
+            .build();
+        row.connect_selected_notify(glib::clone!(
+            #[weak]
+            settings,
+            move |row| {
+                let _ = settings.set_int("upscale-factor", if row.selected() == 1 { 4 } else { 2 });
+            }
+        ));
+        capture.add(&row);
+    }
+    if crate::hdr::processing_available() {
+        const LEVELS: [&str; 5] = ["off", "auto", "low", "medium", "high"];
+        let names = [
+            gettext("Off"),
+            gettext("Auto"),
+            gettext("Low"),
+            gettext("Medium"),
+            gettext("High"),
+        ];
+        let names: Vec<&str> = names.iter().map(|s| s.as_str()).collect();
+        let current = settings.string("denoise");
+        let row = adw::ComboRow::builder()
+            .title(gettext("Noise Reduction"))
+            .subtitle(gettext("Auto: by the sensor gain, for low light"))
+            .model(&gtk::StringList::new(&names))
+            .selected(LEVELS.iter().position(|l| *l == current.as_str()).unwrap_or(1) as u32)
+            .build();
+        row.connect_selected_notify(glib::clone!(
+            #[weak]
+            settings,
+            move |row| {
+                if let Some(level) = LEVELS.get(row.selected() as usize) {
+                    let _ = settings.set_string("denoise", level);
+                }
+            }
+        ));
+        capture.add(&row);
+    }
+    page.add(&capture);
+
+    let mut manual: Vec<(adw::PreferencesRow, &'static str)> = Vec::new();
+    let mut switches: Vec<(adw::SwitchRow, &'static str)> = Vec::new();
+    for (title, controls) in groups() {
+        let group = adw::PreferencesGroup::builder().title(title).build();
+        let mut any = false;
+        for c in &controls {
+            let Some(row) = control_row(&src, c) else {
+                continue;
+            };
+            if let Some(sw) = row.downcast_ref::<adw::SwitchRow>() {
+                switches.push((sw.clone(), c.name));
+            }
+            if let Some(of) = c.manual_of {
+                manual.push((row.clone(), of));
+            }
+            group.add(&row);
+            any = true;
+        }
+        if any {
+            page.add(&group);
+        }
+    }
+    // Manual values are only editable with their automatic mode off.
+    for (row, of) in manual {
+        if let Some((sw, _)) = switches.iter().find(|(_, n)| *n == of) {
+            sw.bind_property("active", &row, "sensitive")
+                .invert_boolean()
+                .sync_create()
+                .build();
+        }
+    }
+
+    let dialog = adw::PreferencesDialog::builder()
+        .title(gettext("Camera Settings"))
+        .build();
+    dialog.add(&page);
+    dialog.present(Some(parent));
+}
