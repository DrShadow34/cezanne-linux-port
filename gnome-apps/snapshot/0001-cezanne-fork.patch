+    /// The largest size first, with size ranges fixed to their maximum: for
+    /// libcamera cameras, whose processed stream covers the full sensor field
+    /// of view only at its largest size (smaller sizes are crops).
+    pub(crate) fn largest_size_first(caps: &gst::Caps) -> gst::Caps {
+        let max_dim = |s: &gst::StructureRef, field: &str| -> i32 {
+            s.get::<i32>(field)
+                .or_else(|_| s.get::<gst::IntRange<i32>>(field).map(|r| r.max()))
+                .unwrap_or(0)
+        };
+        let mut structures: Vec<gst::Structure> = caps
+            .iter()
+            .map(|s| {
+                let mut s = s.to_owned();
+                let (w, h) = (max_dim(&s, "width"), max_dim(&s, "height"));
+                if w > 0 && h > 0 {
+                    s.set("width", w);
+                    s.set("height", h);
+                }
+                s
+            })
+            .collect();
+        structures.sort_by_key(|s| {
+            let w = s.get::<i32>("width").unwrap_or(0) as i64;
+            let h = s.get::<i32>("height").unwrap_or(0) as i64;
+            std::cmp::Reverse(w * h)
+        });
+        let mut best_caps = gst::Caps::new_empty();
+        for s in structures {
+            best_caps.merge_structure(s);
+        }
+        best_caps
+    }
 }
 
