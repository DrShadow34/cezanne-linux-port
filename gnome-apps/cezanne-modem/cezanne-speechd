SPEAKERS = (('Speakers Switch', 'on'), ('Earpiece Switch', 'on'),
            ('Top PCM Source', 'DSP'), ('Top Analog PCM Volume', '17'),
            ('Top DSP RX2 Source', 'ASPRX1'))
AMP_USECASE = '/usr/local/bin/cezanne-amp-usecase'
