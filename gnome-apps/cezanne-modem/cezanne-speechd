DEV = '/dev/ccci_aud'
STATE = '/sys/devices/platform/cezanne-ccci/state'
SHM_SIZE = 0xd000
MAGIC = 0xffffffff
ACK = 0x8000

MSG_DL_GAIN = 0x2f00		# param16: gain, 0 = 0 dB, 0x8000 = mute
MSG_UL_GAIN = 0x2f01
MSG_UL_MUTE = 0x2f02
MSG_DL_MUTE = 0x2f03
MSG_UL_SOURCE_MUTE = 0x2f08
MSG_DL_MUTE_CODEC = 0x2f09
MSG_DL_MUTE_DYNAMIC = 0x2f0a
MSG_SPH_ENH = 0x2f23		# param16: speech enhancement on / off
MSG_SPH_ON = 0x2f20
MSG_SPH_OFF = 0x2f21
MSG_SPH_INFO = 0x2f7b		# the info again, after the call setup
MSG_MD_ALIVE_ACK = 0x2fa0	# answers the modem's "alive" (0xafa0)
TYPE_SPH_INFO = 0x19
MD_NAMES = {0xaf70: 'speech status', 0xaf75: 'RAT info', 0xaf78: 'EPOF',
            0xafa0: 'MD alive'}

