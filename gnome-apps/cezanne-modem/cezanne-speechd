CALL_VOLUME = os.path.join(os.environ.get('STATE_DIRECTORY', '/var/lib/cezanne-speechd'),
                           'call-volume')
CALL_VOLUME_DEFAULT = 80
DL_GAIN_MIN = -40 * 4
DL_GAIN_MAX = 6 * 4
CALLAUDIO = ('org.mobian_project.CallAudio', '/org/mobian_project/CallAudio')
# the AP path: uplink from DL2 (Playback_2), downlink to UL_MONO_1
# (Capture_Mono_1); the two PCMs become nodes in the user's sound server
