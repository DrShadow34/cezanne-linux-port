AMP_ROUTES = ('I2S3_CH1 PCM_2_CAP_CH1', 'I2S3_CH2 PCM_2_CAP_CH1')
HP_ROUTES = ('ADDA_DL_CH1 PCM_2_CAP_CH1', 'ADDA_DL_CH2 PCM_2_CAP_CH1')
# the UCM Earpiece device (top amplifier alone, ASP, amp gain 0); the
# sound server's own settings come back after the call
