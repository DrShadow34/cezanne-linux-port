#!/usr/bin/env python3
# cezanne-modemd: userspace side of the cezanne modem (kernel driver
# cezanne-ccci). Serves the MD's NVRAM file service and RPC requests, then
# boots the MD and keeps serving; logs system / status messages. Once the MD
# is ready it powers the SIM (vendor init + AT+CFUN=4) on the AT port and
# then hands that port and the data links to ModemManager (udev rule
# 78-cezanne-modem.rules).
#
#   cezanne-modemd [--root DIR] [--no-boot] [--run SECONDS] [-v]
import argparse
import os
import select
import struct
import sys
import time

sys.path.insert(0, '/usr/lib/cezanne-modem')
from cezanne_modem import ccci, fs, rpc  # noqa: E402

SYS = '/sys/devices/platform/cezanne-ccci'
AT_PORT = '/dev/wwan0at0'
AT_READY = '/run/cezanne-modem/at-ready'
# MIUI's RIL sends ESIMS / EBOOT before powering the radio; CFUN=4 then
# brings the SIM up with RF off, the low-power state ModemManager expects.
# (command, seconds to keep retrying it): the AT task starts a moment after
# the handshake, the SMS task (CMGF) only after the SIM is up.
AT_INIT = (('AT', 30), ('AT+CMEE=1', 0), ('AT+ESIMS=1', 0), ('AT+EBOOT=0', 0),
           ('AT+CFUN=4', 0), ('AT+CMGF=0', 30))
AT_TIMEOUT = 10


def log(*a):
    print(*a, flush=True)


def wait_driver(timeout=30):
    end = time.time() + timeout
    while not os.path.exists(SYS + '/state') or not os.path.exists('/dev/ccci_fs'):
        if time.time() > end:
            sys.exit('cezanne-ccci driver not loaded')
        time.sleep(0.2)


class AtInit:
    """runs AT_INIT on the AT port without blocking the main loop; poll
    fd while it runs, call tick() at least every 200 ms"""
    def __init__(self):
        self.fd = None
        self.step = 0
        self.created = time.time()

    def start(self):
        """open the port; False while udev has not made the node yet"""
        try:
            self.fd = os.open(AT_PORT, os.O_RDWR | os.O_NONBLOCK)
        except OSError:
            if time.time() - self.created < 10:
                return False
            log('AT port did not appear')
            self.finish()
            return True
        self.begin()
        return True

    def begin(self):
        self.step_start = time.time()
        self.send()

    def send(self):
        self.buf = b''
        self.sent = time.time()
        try:
            os.write(self.fd, AT_INIT[self.step][0].encode() + b'\r')
        except OSError as e:		# port removed under us
            log('AT port:', e)
            self.finish()

    def next(self):
        self.step += 1
        if self.step < len(AT_INIT):
            self.begin()
        else:
            self.finish()

    def tick(self):
        if self.fd is None:
            return
        cmd, retry = AT_INIT[self.step]
        now = time.time()
        if now - self.step_start > max(retry, AT_TIMEOUT):
            log('%s: no success' % cmd)
            self.next()
        elif retry and now - self.sent > 1:
            self.send()

    def readable(self):
        try:
            self.buf += os.read(self.fd, 4096)
        except BlockingIOError:
            return
        if b'\r\nOK\r\n' in self.buf:
            self.next()
        elif b'ERROR' in self.buf and not AT_INIT[self.step][1]:
            log('%s: %s' % (AT_INIT[self.step][0], self.buf.decode(errors='replace').strip()))
            self.next()

    def finish(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None
        open(AT_READY, 'w').close()
        # let ModemManager see the AT port and the data links now
        for dev in ['/sys/class/wwan/wwan0at0'] + net_links():
            try:
                with open(dev + '/uevent', 'w') as f:
                    f.write('change')
            except OSError as e:
                log('udev change:', e)
        log('AT port handed to ModemManager (%.1f s)' % (time.time() - self.created))


def net_links():
    """the modem's network links (DPMAIF, one per MD interface)"""
    links = []
    for name in os.listdir('/sys/class/net'):
        path = '/sys/class/net/' + name
        if '/cezanne-ccci/' in os.path.realpath(path):
            links.append(path)
    return links


def at_ready(on):
    if not on:
        try:
            os.unlink(AT_READY)
        except FileNotFoundError:
            pass


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--root', default='/var/lib/cezanne-modem')
    ap.add_argument('--no-boot', action='store_true')
    ap.add_argument('--run', type=float, default=0)
    ap.add_argument('-v', action='store_true', help='log every FS request')
    a = ap.parse_args()
    if not os.path.isdir(os.path.join(a.root, fs.DRIVES['Z'])):
        sys.exit('no NVRAM in %s (run cezanne-modem-nvram-import)' % a.root)
    wait_driver()

    fss = fs.FsServer(a.root, log=log)
    rpcs = rpc.RpcServer(log=log)
    ports = {}
    for name in ('ccci_fs', 'ccci_rpc', 'ccci_sys', 'ccci_status'):
        ports[os.open('/dev/' + name, os.O_RDWR | os.O_NONBLOCK)] = name
    state_fd = open(SYS + '/state')
    poll = select.poll()
    for fd in ports:
        poll.register(fd, select.POLLIN)
    poll.register(state_fd, select.POLLPRI | select.POLLERR)

    state = state_fd.read().strip()
    log('modem state', state)
    # the flag outlives a restart of this service: then ModemManager may
    # already own the port and the radio must not be set back to CFUN=4
    if state != 'ready':
        at_ready(False)
    init = AtInit() if state == 'ready' and not os.path.exists(AT_READY) else None
    init_started = False
    if not a.no_boot and state in ('off', 'exception'):
        with open(SYS + '/boot', 'w') as f:
            f.write('1\n')
    nfs = 0
    t0 = time.time()
    while not a.run or time.time() - t0 < a.run:
        if init and not init_started:
            init_started = init.start()
            if init_started and init.fd is not None:
                poll.register(init.fd, select.POLLIN)
        if init and init_started:
            fd0 = init.fd
            init.tick()
            if init.fd is None:
                if fd0 is not None:
                    poll.unregister(fd0)
                init = None
        for fd, ev in poll.poll(200 if init else 1000):
            if init and fd == init.fd:
                init.readable()
                if init.fd is None:
                    poll.unregister(fd)
                    init = None
                continue
            if fd == state_fd.fileno():
                state_fd.seek(0)
                s = state_fd.read().strip()
                if s != state:
                    log('modem state', s, '(%d FS requests)' % nfs)
                    if state == 'ready':
                        at_ready(False)
                    if init and init.fd is not None:
                        poll.unregister(init.fd)	# the port is gone
                        os.close(init.fd)
                    init = None
                    if s == 'ready':
                        init, init_started = AtInit(), False
                    state = s
                continue
            name = ports[fd]
            while True:
                try:
                    pkt = os.read(fd, 65536)
                except BlockingIOError:
                    break
                if len(pkt) < 16:
                    continue
                if name == 'ccci_fs':
                    nfs += 1
                    if a.v:
                        opc = struct.unpack_from('<I', pkt, 16)[0]
                        log('fs', fs.OPS[opc].__name__ if opc in fs.OPS else hex(opc))
                    out = fss.packet(pkt)
                elif name == 'ccci_rpc':
                    out = rpcs.packet(pkt)
                else:
                    d0, ln, ch, seq, rsv = ccci.header(pkt)
                    log('%s: ch %d %#x %#x %#x %s' % (name, ch, d0, ln, rsv, pkt[16:48].hex()))
                    out = []
                for p in out:
                    os.write(fd, p)


main()
