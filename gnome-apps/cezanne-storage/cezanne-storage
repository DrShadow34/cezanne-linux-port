        self.nav.add(Adw.NavigationPage(child=view, title='Storage', tag='main'))

        # a result per unit: redraw at most four times a second meanwhile
        self.update_id = 0
        self.scan.connect('update', lambda s: self._queue_update())
        self.scan.connect('done', lambda s: self.update())
        self.packages.load(self.update)
        self.scan.probe_root(self.start)	# then scan, as root when allowed

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text))

    def _queue_update(self):
        if not self.update_id:
            self.update_id = GLib.timeout_add(250, self._timed_update)

    def _timed_update(self):
        self.update_id = 0
        self.update()
        return GLib.SOURCE_REMOVE

    def start(self):
        if self.scan.running or self.scan.root is None:
            return
        self.refresh.set_sensitive(False)
        self.scan.start()
        self.update()

    def update(self):
        st = os.statvfs('/')
        total = st.f_blocks * st.f_frsize
        free = st.f_bavail * st.f_frsize
        used = total - st.f_bfree * st.f_frsize
        self.used.set_label(human(used))
        self.of.set_label(f'used of {human(total)}')
        self.free.set_label(f'{human(free)} free')
        cats = self.model.compute() if self.packages.ready else dict(self.scan.cats)
        if not self.packages.ready:
            cats.pop('apps', None)
        counted = sum(cats.get(c[0], 0) for c in CATEGORIES) or 1
        for cid, _, _, _ in CATEGORIES:
            v = cats.get(cid, 0)
            if cid == 'apps' and not self.packages.ready:
                continue
            self.rows[cid].set_size(v, v / counted)
        m = self.model
        known = self.packages.ready and bool(m.logical)
        for cid, _, _, _ in CATEGORIES:
            self.rows[cid].set_disk(m.disk.get(cid, 0), m.logical.get(cid, 0) if known else 0)
        disk, logical = sum(m.disk.values()), sum(m.logical.values())
        self.comp_row.set_visible(known)
        self.more.set_visible(known)
        if known:
            self.comp_row.set_subtitle(f'{human(logical)} of files in {human(disk)} on disk '
                                       f'({disk / logical * 100:.0f} %), {human(logical - disk)} saved')
        # the used space is what the files take on disk, when measured
        shares = m.disk if known else cats
        self.bar.set_parts(used / total if total else 0,
                           [(color, shares.get(cid, 0)) for cid, _, _, color in CATEGORIES])
        running = self.scan.running
        self.spinner.set_visible(running)
        self.refresh.set_sensitive(not running)
        self.status.set_label(f'Calculating… {self.scan.progress * 100:.0f} %' if running else '')
        note = []
        if known:
            note.append('Sizes are the files’ sizes before compression; Compression shows what '
                        'they take on disk.')
        elif counted > used * 1.05:
            note.append(f'Sizes are the files’ sizes ({human(counted)} in all); btrfs compression stores '
                        f'them in less space, so they add up to more than the {human(used)} used.')
        if not running and self.scan.unreadable:
            n = len(self.scan.unreadable)
            note.append(f'{n} folder{"s" if n > 1 else ""} this account cannot read (other users, the '
                        'administrator’s) are not counted.')
        self.note.set_label('\n\n'.join(note))
        self.note.set_visible(bool(note))
        page = self.nav.get_visible_page()
        if not running and isinstance(page, CategoryPage):
            page.fill()

    def open_category(self, cid):
        if not self.scan.cats:
            return
        self.nav.push(CategoryPage(self, cid))

    def clear(self, folders, title):
        folders = [f for f in folders if clearable(f)]
        if not folders:
            return
        where = ', '.join(tilde(f) for f in folders)
        dialog = Adw.AlertDialog(heading=f'Clear {title}?',
                                 body=f'Everything inside {where} is deleted. Apps rebuild their cache when '
                                      'they need it, so they may be slower at first.')
        dialog.add_response('cancel', 'Cancel')
        dialog.add_response('clear', 'Clear')
        dialog.set_response_appearance('clear', Adw.ResponseAppearance.DESTRUCTIVE)

        def response(d, r):
            if r != 'clear':
                return
            left, freed = [len(folders)], [0]

            def one(n):
                freed[0] += n
                left[0] -= 1
                if not left[0]:
                    self.toast(f'{human(freed[0])} freed')
                    self.start()
            for f in folders:
                clear_folder(f, one)
        dialog.connect('response', response)
        dialog.present(self)

    def empty_trash(self):
        dialog = Adw.AlertDialog(heading='Empty the trash?',
                                 body='Everything in the trash is deleted for good.')
