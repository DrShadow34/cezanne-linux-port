class CategoryPage(Adw.NavigationPage):
    def __init__(self, win, cid):
        name = next(c[1] for c in CATEGORIES if c[0] == cid)
        super().__init__(title=name)
        self.win, self.cid = win, cid
        self.view = Adw.ToolbarView()
        self.view.add_top_bar(Adw.HeaderBar())
        self.set_child(self.view)
        self.fill()

    def fill(self):
        page = Adw.PreferencesPage()
        m = self.win.model
        if m.logical.get(self.cid):
            g = self._group(page)
            g.add(size_row('On disk', f'{m.disk[self.cid] / m.logical[self.cid] * 100:.0f} % of '
                           f'{human(m.logical[self.cid])}, with btrfs compression', m.disk[self.cid]))
        pages = {'apps': self._apps, 'games': self._games, 'cache': self._cache, 'trash': self._trash_page,
                 'system': self._system}
        pages.get(self.cid, self._typed)(page)
        self.view.set_content(page)

    def _disk(self, group):
        """a group's size on disk, as a subtitle (root scans)"""
        scan = self.win.scan
        return on_disk(scan.disk.get(self.cid, {}).get(group, 0), scan.logical.get(self.cid, {}).get(group, 0))

    def _group(self, page, title=None, description=None):
        g = Adw.PreferencesGroup(title=title or '', description=description or '')
        page.add(g)
        return g

    def _typed(self, page):
        scan = self.win.scan
        groups = scan.groups.get(self.cid, {})
        g = self._group(page, 'Folders')
        for folder, v in sorted(groups.items(), key=lambda kv: -kv[1])[:15]:
            if v < 100_000:
                break
            row = size_row(tilde(folder) if folder != 'Home' else 'Home folder', self._disk(folder), v,
                           activatable=folder != 'Home')
            if folder != 'Home':
                row.connect('activated', lambda r, f=folder: self._open(f))
            g.add(row)
        g = self._group(page, 'Largest files')
        for size, path in sorted(scan.top.get(self.cid, []), reverse=True)[:40]:
            row = size_row(os.path.basename(path), tilde(os.path.dirname(path)), size, activatable=True)
            row.connect('activated', lambda r, p=path: self._open(p))
            more = Gtk.MenuButton(icon_name='view-more-symbolic', valign=Gtk.Align.CENTER,
                                  tooltip_text='More')
            more.add_css_class('flat')
            menu = Gio.Menu()
            menu.append('Show in Folder', 'file.folder')
            menu.append('Move to Trash', 'file.trash')
            more.set_menu_model(menu)
            actions = Gio.SimpleActionGroup()
            for n, cb in (('folder', self._folder), ('trash', self._to_trash)):
                a = Gio.SimpleAction(name=n)
                a.connect('activate', lambda a, p, cb=cb, path=path, row=row, g=g: cb(path, row, g))
                actions.add_action(a)
            more.insert_action_group('file', actions)
            row.add_suffix(more)
            g.add(row)

    def _open(self, path):
        Gtk.FileLauncher(file=Gio.File.new_for_path(path)).launch(self.win, None, None)

    def _folder(self, path, row, group):
        Gtk.FileLauncher(file=Gio.File.new_for_path(path)).open_containing_folder(self.win, None, None)

    def _to_trash(self, path, row, group):
        try:
            Gio.File.new_for_path(path).trash(None)
        except GLib.Error as e:
            self.win.toast(e.message)
            return
        group.remove(row)
        self.win.toast(f'“{os.path.basename(path)}” moved to the trash')

    def _apps(self, page):
        g = self._group(page)
        for e in self.win.model.apps:
            row = size_row(e.name, f'App {human(e.code)}  ·  Data {human(e.data)}'
                           + (f'  ·  Cache {human(e.cache)}' if e.cache else ''), e.total, activatable=True)
            img = Gtk.Image(pixel_size=32)
            if e.icon:
                img.set_from_gicon(e.icon)
            else:
                img.set_from_icon_name('application-x-executable-symbolic')
            row.add_prefix(img)
            row.connect('activated', lambda r, e=e: self._app(e))
            g.add(row)

    def _app(self, e):
        dialog = Adw.Dialog(title=e.name, content_width=420)
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup()
        for title, v in (('App', e.code), ('Data', e.data), ('Cache', e.cache)):
            if v or title != 'Cache':
                g.add(size_row(title, None, v))
        page.add(g)
        if e.data_folders:
            g = Adw.PreferencesGroup(title='Data folders')
            for name, v in sorted(e.data_folders, key=lambda x: -x[1])[:20]:
                g.add(size_row(name, None, v))
            page.add(g)
        actions = Adw.PreferencesGroup()
        folders = [f for f in e.cache_folders if clearable(f)]
        if folders:
            b = Adw.ButtonRow(title='Clear Cache', start_icon_name='edit-clear-all-symbolic')
            b.connect('activated', lambda r: (dialog.close(), self.win.clear(folders, f'the cache of {e.name}')))
            actions.add(b)
        if e.app:
            b = Adw.ButtonRow(title='Open', start_icon_name='external-link-symbolic')
            b.connect('activated', lambda r: (dialog.close(), e.app.launch([], None)))
            actions.add(b)
        page.add(actions)
        view = Adw.ToolbarView(content=page)
        view.add_top_bar(Adw.HeaderBar())
        dialog.set_child(view)
        dialog.present(self.win)

    def _games(self, page):
        names, dirs = steam_games()

        def game(g):
            kind, _, name = g.partition('/')
            if kind == 'compatdata':
                name = dirs.get(name, f'Proton prefix {name}')
            return names.get(name, name)
        games = collections.Counter()
        for g, v in self.win.scan.groups.get('games', {}).items():
            games[game(g)] += v
        group = self._group(page, description='Steam library: the games and their Proton prefixes')
        steamapps = os.path.join(HOME, '.local', 'share', 'Steam', 'steamapps', 'common')
        inv = {v: k for k, v in names.items()}
        disk, logical = collections.Counter(), collections.Counter()
        for g, v in self.win.scan.disk.get('games', {}).items():
            disk[game(g)] += v
            logical[game(g)] += self.win.scan.logical['games'][g]
        for name, v in games.most_common():
            row = size_row(name, on_disk(disk[name], logical[name]), v, activatable=True)
            row.connect('activated', lambda r, d=inv.get(name, name): self._open(os.path.join(steamapps, d)))
            group.add(row)

    def _cache(self, page):
        groups = self.win.scan.groups.get('cache', {})
        user = self._group(page, 'Apps’ cache', 'Cleared caches are rebuilt by the apps when needed')
        system = self._group(page, 'System cache', 'Cleared by the administrator (pacman -Sc for packages)')
        for folder, v in sorted(groups.items(), key=lambda kv: -kv[1]):
            if v < 1_000_000:
                continue
            if folder == 'Steam':
                name = 'Steam (shaders, downloads)'
            elif folder.startswith((os.path.join(HOME, '.cache') + '/', '/var/')):
                name = os.path.basename(folder)
            else:	# a cache folder inside an app's data: the app's name
                name = cache_owner(folder)
            where = tilde(folder) if folder != 'Steam' else None
            disk = self._disk(folder)
            row = size_row(name, ' · '.join(x for x in (where, disk) if x) or None, v)
            if clearable(folder):
                b = Gtk.Button(label='Clear', valign=Gtk.Align.CENTER)
                b.connect('clicked', lambda b, f=folder, n=name: self.win.clear([f], n))
                row.add_suffix(b)
            (user if folder == 'Steam' or folder.startswith(HOME + '/') else system).add(row)

    def _trash_page(self, page):
        v = self.win.scan.cats.get('trash', 0)
        g = self._group(page)
        g.add(size_row('In the trash', None, v))
        actions = self._group(page)
        b = Adw.ButtonRow(title='Empty Trash', start_icon_name='user-trash-symbolic', sensitive=v > 0)
        b.add_css_class('destructive-action')
        b.connect('activated', lambda r: self.win.empty_trash())
        actions.add(b)

    def _system(self, page):
        g = self._group(page, 'Folders')
        groups = dict(self.win.scan.groups.get('system', {}))
        app_code = sum(e.code for e in self.win.model.apps)
        if '/usr' in groups:
            groups['/usr'] = max(0, groups['/usr'] - app_code)
        for folder, v in sorted(groups.items(), key=lambda kv: -kv[1])[:12]:
            if v < 100_000:
                break
            g.add(size_row(folder, self._disk(folder), v))
        pk = self.win.packages
        g = self._group(page, 'Largest packages', 'Installed size of the system’s packages (apps are under Apps)')
        sizes = sorted(((v, n) for n, v in pk.sizes.items() if n not in pk.apps), reverse=True)[:25]
        for v, n in sizes:
            g.add(size_row(n, None, v))


class CompressionPage(Adw.NavigationPage):
    """what btrfs compression saves: in all, by category, by method"""

    def __init__(self, win):
        super().__init__(title='Compression')
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        m, scan = win.model, win.scan
        disk, logical = sum(m.disk.values()), sum(m.logical.values())
        opt = root_compression()
        g = Adw.PreferencesGroup(title='File system', description=(
            f'btrfs compresses new files when they are written (compress={opt}); what does not '
            'compress is stored as it is' if opt else 'btrfs, compressed as the files were written'))
        g.add(size_row('Files', 'Their size before compression', logical))
        g.add(size_row('On disk', f'{disk / logical * 100:.0f} % of their size' if logical else None, disk))
        g.add(size_row('Saved', None, logical - disk))
        page.add(g)
        g = Adw.PreferencesGroup(title='By category')
        for cid, name, icon, _ in CATEGORIES:
            d, l = m.disk.get(cid, 0), m.logical.get(cid, 0)
            if not l:
                continue
            g.add(self._share_row(name, d, l, icon, cid))
        page.add(g)
        g = Adw.PreferencesGroup(title='By method', description='None: written uncompressed, as btrfs found '
                                 'the data did not compress (media, archives) or before compression was on')
        for comp, (d, l) in sorted(scan.algo.items(), key=lambda kv: -kv[1][1]):
            if l:
                g.add(self._share_row(COMPRESSION.get(comp, str(comp)), d, l))
        page.add(g)
        view.set_content(page)
        self.set_child(view)

    @staticmethod
    def _share_row(title, disk, logical, icon=None, cid=None):
        row = Adw.ActionRow(title=GLib.markup_escape_text(title),
                            subtitle=f'{human(disk)} on disk of {human(logical)}')
        if icon:
            img = Gtk.Image(icon_name=icon, valign=Gtk.Align.CENTER)
            img.add_css_class('cat-icon')
            img.add_css_class('cat-' + cid)
            row.add_prefix(img)
        lbl = Gtk.Label(label=f'{disk / logical * 100:.0f} %', valign=Gtk.Align.CENTER)
        lbl.add_css_class('numeric')
        lbl.add_css_class('dim-label')
        row.add_suffix(lbl)
        return row


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        about = Gio.SimpleAction(name='about')
        about.connect('activate', self._about)
        self.add_action(about)

    def do_startup(self):
        Adw.Application.do_startup(self)
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        win = self.get_active_window() or Storage(self)
        win.present()

    def _about(self, *a):
        Adw.AboutDialog(application_name='Storage', application_icon=APP_ID, version=VERSION,
                        developer_name='arch-port', license_type=Gtk.License.MIT_X11,
                        comments='What fills the phone’s storage').present(self.get_active_window())


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
