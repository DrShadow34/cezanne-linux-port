# folders split into units for the workers (their own entries one unit,
# each subfolder another): the big ones, so no unit takes much longer
SPLIT = ['/', '/usr', '/usr/lib', '/usr/share', '/var', '/var/lib', '/home', HOME,
         os.path.join(HOME, '.local'), os.path.join(HOME, '.local', 'share'), os.path.join(HOME, 'Documents'),
         os.path.join(HOME, '.cache'), os.path.join(HOME, '.local', 'share', 'Steam'),
         os.path.join(HOME, '.local', 'share', 'Steam', 'steamapps')]


def human(n):
    for unit in ('B', 'kB', 'MB', 'GB', 'TB'):
        if n < 1000 or unit == 'TB':
            return f'{n:.0f} {unit}' if unit in ('B', 'kB') or n >= 100 else f'{n:.1f} {unit}'
        n /= 1000


def on_disk(disk, logical):
    """'1.2 GB on disk · 43 %': what files take on disk, as a share of
    their size"""
    return f'{human(disk)} on disk · {disk / logical * 100:.0f} %' if logical else None


def root_compression():
    """the root file system's compress= mount option, or ''"""
    try:
        with open('/proc/self/mountinfo') as f:
            for line in f:
                pre, post = line.split(' - ', 1)
                if pre.split()[4] == '/':
                    opts = post.split()[2].split(',')
                    return next((o.split('=', 1)[1] for o in opts if o.startswith('compress')), '')
    except (OSError, IndexError):
        pass
    return ''


def plan_units(skip):
    units = []

    def plan(d):
        units.append('files:' + d)
        try:
            with os.scandir(d) as it:
                subs = [e.path for e in it if e.is_dir(follow_symlinks=False)]
        except OSError:
            return
        for p in subs:
            if p in skip:
                continue
            if p in SPLIT:
                plan(p)
            else:
                units.append('tree:' + p)
    plan('/')
    return units


class Scan(GObject.Object):
    """the workers and the totals they send"""
    __gsignals__ = {
        'update': (GObject.SignalFlags.RUN_FIRST, None, ()),
        'done': (GObject.SignalFlags.RUN_FIRST, None, ()),
    }

    def __init__(self):
        super().__init__()
        self.running = False
        self.root = None	# workers as root (sizes on disk); None: not known yet
        self._reset()
        self.total_units = self.done_units = 0

    def _reset(self):
        self.cats = collections.Counter()
        self.groups = collections.defaultdict(collections.Counter)
        self.top = collections.defaultdict(list)
        self.unreadable = []
        self.entries = 0
        self.disk = collections.defaultdict(collections.Counter)
        self.logical = collections.defaultdict(collections.Counter)
        self.algo = collections.defaultdict(lambda: [0, 0])

    def probe_root(self, done):
        """may the workers run as root? Only the installed script with its
        policy (else pkexec would ask for the administrator's password):
        an empty worker through pkexec, done() once known"""
        if os.path.realpath(__file__) != ROOT_EXEC or not os.path.exists(POLICY):
            self.root = False
            done()
            return
        try:
            p = Gio.Subprocess.new(['pkexec', ROOT_EXEC, '--root-worker'],
                                   Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_SILENCE
                                   | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            self.root = False
            done()
            return
        p.get_stdin_pipe().close(None)

        def finished(p, res):
            try:
                self.root = p.wait_check_finish(res)
            except GLib.Error:
                self.root = False	# not the active session, no polkit
            done()
        p.wait_check_async(None, finished)

    def start(self):
        self._reset()
        self.running = True
        try:
            with open(WEIGHTS_FILE) as f:
                self.weights = json.load(f)
        except (OSError, ValueError):
            self.weights = {}
        self.new_weights = {}
        units = plan_units(skipped_mounts())
        # the biggest units first (last scan's entry counts), so none is left for the end
        units.sort(key=lambda u: -self.weights.get(u, 1000 if u.startswith('tree:') else 0))
        self.queue = collections.deque(units)
        self.total_units = len(units)
        self.done_units = 0
        self.workers = []
        argv = (['pkexec', ROOT_EXEC, '--root-worker'] if self.root
                else [sys.executable, os.path.abspath(__file__), '--scan-worker'])
        # the root workers spend their time in Python (a tree search per file): every core
        for _ in range((os.cpu_count() or 4) if self.root else min(6, os.cpu_count() or 4)):
            p = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE)
            w = (p, Gio.DataInputStream.new(p.get_stdout_pipe()))
            self.workers.append(w)
            self._feed(w)

    @property
    def progress(self):
        return self.done_units / self.total_units if self.total_units else 1.0

    def _feed(self, w):
        p, out = w
        if not self.queue:
            p.get_stdin_pipe().close(None)
            self.workers.remove(w)
            if not self.workers:
                self._finished()
            return
        p.get_stdin_pipe().write_all((self.queue.popleft() + '\n').encode(), None)
        out.read_line_async(GLib.PRIORITY_DEFAULT, None, self._line, w)

    def _line(self, out, res, w):
        try:
            line, _ = out.read_line_finish_utf8(res)
        except GLib.Error:
            line = None
        if not line:	# the worker died: its unit is lost, go on without it
            self.workers.remove(w)
            if not self.workers:
                self._finished()
            return
        r = json.loads(line)
        for k, v in r['cats'].items():
            self.cats[k] += v
        for cat, groups in r['groups'].items():
            for g, v in groups.items():
                self.groups[cat][g] += v
        for cat, files in r['top'].items():
            merged = self.top[cat] + [tuple(f) for f in files]
            self.top[cat] = heapq.nlargest(TOP_FILES, merged)
        for key in ('disk', 'logical'):
            mine = getattr(self, key)
            for cat, groups in r.get(key, {}).items():
                for g, v in groups.items():
                    mine[cat][g] += v
        for comp, (d, l) in r.get('algo', {}).items():
            a = self.algo[int(comp)]
            a[0] += d
            a[1] += l
        self.unreadable += r['unreadable']
        self.entries += r['entries']
        self.new_weights[r['unit']] = r['entries']
        self.done_units += 1
        self.emit('update')
        self._feed(w)

    def _finished(self):
        self.running = False
        try:
            os.makedirs(os.path.dirname(WEIGHTS_FILE), exist_ok=True)
            with open(WEIGHTS_FILE, 'w') as f:
                json.dump(self.new_weights, f)
        except OSError:
            pass
        self.emit('done')


class Packages:
    """pacman's database: every package's installed size; the packages with
    an app in the app grid"""

    def __init__(self):
        self.sizes = {}
        self.apps = {}	# package -> Gio.DesktopAppInfo
        self.ready = False

    def load(self, done):
        def work():
            sizes = {}
            db = '/var/lib/pacman/local'
            for d in os.listdir(db):
                try:
                    with open(os.path.join(db, d, 'desc')) as f:
                        lines = f.read().split('\n')
                except OSError:
                    continue
                name = size = None
                for i, l in enumerate(lines):
                    if l == '%NAME%':
                        name = lines[i + 1]
                    elif l == '%SIZE%':
                        size = int(lines[i + 1])
                if name:
                    sizes[name] = size or 0
            desktop = sorted(os.path.join('/usr/share/applications', f)
                             for f in os.listdir('/usr/share/applications') if f.endswith('.desktop'))
            owners = {}
            try:
                out = subprocess.run(['pacman', '-Qo', *desktop], capture_output=True, text=True).stdout
                for l in out.splitlines():
                    path, _, rest = l.partition(' is owned by ')
                    if rest:
                        owners.setdefault(rest.split()[0], []).append(path)
            except OSError:
                pass
            GLib.idle_add(self._loaded, sizes, owners, done)
        threading.Thread(target=work, daemon=True).start()

    def _loaded(self, sizes, owners, done):
        self.sizes = sizes
        for pkg, files in owners.items():
            for path in files:
                app = Gio.DesktopAppInfo.new_from_filename(path)
                if app and app.should_show():
                    self.apps[pkg] = app
                    break
        self.ready = True
        done()
        return False


class AppEntry:
    def __init__(self, key, name, icon=None, app=None):
        self.key, self.name, self.icon, self.app = key, name, icon, app
        self.code = self.data = self.cache = 0
        self.data_folders = []
        self.cache_folders = []

    @property
    def total(self):
        return self.code + self.data


def steam_games():
    """installdir -> name, appid -> installdir from Steam's app manifests"""
    names, dirs = {}, {}
    apps = os.path.join(HOME, '.local', 'share', 'Steam', 'steamapps')
    try:
        manifests = [f for f in os.listdir(apps) if f.startswith('appmanifest_') and f.endswith('.acf')]
    except OSError:
        return names, dirs
    for m in manifests:
        fields = {}
        try:
            with open(os.path.join(apps, m), errors='replace') as f:
                for l in f:
                    parts = l.strip().split('"')
                    if len(parts) >= 4:
                        fields.setdefault(parts[1], parts[3])
        except OSError:
            continue
        if 'installdir' in fields:
            names[fields['installdir']] = fields.get('name', fields['installdir'])
            if 'appid' in fields:
                dirs[fields['appid']] = fields['installdir']
    return names, dirs


class Model:
    """the categories as the pages show them, from the scan and the
    package database"""

    def __init__(self, scan, packages):
        self.scan, self.packages = scan, packages
        self.apps = []
        self.cats = {}
        self.disk = {}		# category -> bytes on disk (root scans)
        self.logical = {}	# category -> the same files' bytes

    def compute(self):
        scan, pk = self.scan, self.packages
        cats = dict(scan.cats)
        # apps: the packages with an app, their data folders, /opt, Flatpak
        apps = {}
        keys = {}
        for pkg, app in pk.apps.items():
            e = AppEntry(pkg, app.get_display_name(), app.get_icon(), app)
            e.code = pk.sizes.get(pkg, 0)
            apps[pkg] = e
            exe = os.path.basename(app.get_executable() or '')
            app_id = (app.get_id() or '').removesuffix('.desktop')
            for k in (pkg, exe, app_id, app_id.rsplit('.', 1)[-1], app.get_display_name()):
                if k:
                    keys.setdefault(norm(k), e)
        other = AppEntry('other', 'Other app data')
        for g, v in scan.groups.get('apps', {}).items():
            kind, _, name = g.partition(':')
            if kind == 'data':
                e = keys.get(norm(ALIASES.get(name, name))) or other
                e.data += v
                e.data_folders.append((name, v))
            else:	# /opt/<name>, Flatpak: one entry each
                key = g if kind == 'opt' else 'flatpak'
                e = apps.setdefault(key, AppEntry(key, name or 'Flatpak' if kind != 'opt' else name))
                e.data += v
        if other.data:
            apps['other'] = other
        for folder, v in scan.groups.get('cache', {}).items():
            e = keys.get(norm(cache_owner(folder)))
            if e:
                e.cache += v
                e.cache_folders.append(folder)
        app_code = sum(e.code for e in apps.values())
        cats['apps'] = sum(e.total for e in apps.values())
        # the app packages were walked as part of /usr (System)
        cats['system'] = max(0, cats.get('system', 0) - app_code)
        self.apps = sorted((e for e in apps.values() if e.total), key=lambda e: -e.total)
        self.cats = cats
        # on disk: as measured per category; the app packages' part of /usr
        # (moved from System to Apps above) at System's share
        disk = {c: sum(g.values()) for c, g in scan.disk.items()}
        logical = {c: sum(g.values()) for c, g in scan.logical.items()}
        if logical:
            share = disk.get('system', 0) / logical['system'] if logical.get('system') else 1
            disk['apps'] = disk.get('apps', 0) + app_code * share
            logical['apps'] = logical.get('apps', 0) + app_code
            disk['system'] = max(0, disk.get('system', 0) - app_code * share)
            logical['system'] = max(0, logical.get('system', 0) - app_code)
        self.disk, self.logical = disk, logical
        return cats


