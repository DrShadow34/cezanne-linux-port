def tilde(path):
    return '~' + path[len(HOME):] if path == HOME or path.startswith(HOME + '/') else path


def clear_folder(folder, done):
    """delete what is inside a folder (not the folder), off the main loop;
    done(freed bytes)"""
    def work():
        freed = 0
        try:
            entries = list(os.scandir(folder))
        except OSError:
            entries = []
        for e in entries:
            try:
                if e.is_dir(follow_symlinks=False):
                    t = walk(e.path, True, set())
                    freed += sum(t.cats.values())
                    shutil.rmtree(e.path, ignore_errors=True)
                else:
                    freed += e.stat(follow_symlinks=False).st_blocks * 512
                    os.unlink(e.path)
            except OSError:
                pass
        GLib.idle_add(done, freed)
    threading.Thread(target=work, daemon=True).start()


