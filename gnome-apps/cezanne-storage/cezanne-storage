class UsageBar(Gtk.DrawingArea):
    """the used space, split in the categories' shares; the rest is free"""

    def __init__(self):
        super().__init__(content_height=22, hexpand=True)
        self.parts = []
        self.used = 0.0
        self.set_draw_func(self._draw)

    def set_parts(self, used_fraction, parts):
        self.used = used_fraction
        self.parts = parts
        self.queue_draw()

    def _draw(self, area, cr, w, h):
        r = h / 2
        cr.new_sub_path()
        cr.arc(r, r, r, 1.5708, 4.7124)
        cr.arc(w - r, r, r, 4.7124, 1.5708)
        cr.close_path()
        cr.clip()
        fg = self.get_color()
        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.1)
        cr.paint()
        total = sum(v for _, v in self.parts) or 1
        x = 0.0
        for color, v in self.parts:
            seg = w * self.used * v / total
            c = Gdk.RGBA()
            c.parse(color)
            cr.set_source_rgba(c.red, c.green, c.blue, 1)
            cr.rectangle(x, 0, seg + 0.5, h)
            cr.fill()
            x += seg


