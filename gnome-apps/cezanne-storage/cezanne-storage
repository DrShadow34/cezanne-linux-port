def clearable(folder):
    """a cache folder of this user that may be emptied: one app's, not
    ~/.cache as a whole"""
    return (folder.startswith(HOME + '/') and folder not in PROTECTED_CACHE
            and folder != os.path.join(HOME, '.cache') and os.path.isdir(folder))


def cache_owner(folder):
    """the app name a cache folder belongs to (for matching it to an app)"""
    if not folder.startswith(HOME + '/'):
        return os.path.basename(folder)
    parts = folder[len(HOME) + 1:].split('/')
    if parts[0] == '.cache':
        return parts[1] if len(parts) > 1 else ''
    if parts[0] == '.var' and len(parts) > 2:
        return parts[2]
    return app_folder(parts)[0]
VIRTUAL_FS = {'proc', 'sysfs', 'devtmpfs', 'devpts', 'tmpfs', 'cgroup', 'cgroup2', 'securityfs', 'debugfs',
