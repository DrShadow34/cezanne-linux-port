def norm(name):
    """a name for matching folders to apps: lower case, letters and digits"""
    return ''.join(c for c in name.lower() if c.isalnum())


def skipped_mounts():
    """mount points under / that are not the root's file system (virtual file
    systems, other disks); btrfs subvolumes of the root's device are walked"""
    mounts = []
    try:
        with open('/proc/self/mountinfo') as f:
            for line in f:
                pre, post = line.split(' - ', 1)
                fields = pre.split()
                fstype, source = post.split()[:2]
                mounts.append((fields[4].replace('\\040', ' '), fstype, source))
    except OSError:
        return set()
    root = next((m for m in mounts if m[0] == '/'), None)
    return {p for p, fstype, source in mounts
            if p != '/' and (fstype in VIRTUAL_FS or root is None or source != root[2])}


def app_folder(parts):
    """the app data folder of a hidden home path (parts of the path below
    the home directory): (match name, its path)"""
    top = parts[0]
    if top in ('.config', '.var') and len(parts) > 1:
        return parts[1], os.path.join(HOME, *parts[:2])
    if top == '.local' and len(parts) > 2 and parts[1] in ('share', 'state', 'lib'):
        return parts[2], os.path.join(HOME, *parts[:3])
    if top == '.local' and len(parts) > 1:
        return parts[1], os.path.join(HOME, *parts[:2])
    return top[1:], os.path.join(HOME, top)


def dir_context(path):
    """(category, group) of what lies in a folder; category 'typed': each
    file by its extension (the folders of the home directory)"""
    if path == HOME or path.startswith(HOME + '/'):
        rel = path[len(HOME) + 1:]
        parts = rel.split('/') if rel else []
        if not parts:
            return 'typed', 'Home'
        top = parts[0]
        if not top.startswith('.'):
            return 'typed', os.path.join(HOME, *parts[:2])
        if top == '.cache':
            return 'cache', os.path.join(HOME, *parts[:2])
        if parts[:3] == ['.local', 'share', 'Trash']:
            return 'trash', 'Trash'
        if parts[:3] == ['.local', 'share', 'Steam']:
            s = parts[3:]
            if len(s) >= 3 and s[0] == 'steamapps' and s[1] in ('common', 'compatdata'):
                return 'games', s[1] + '/' + s[2]
            if s[:2] in (['steamapps', 'shadercache'], ['steamapps', 'downloading'], ['steamapps', 'temp']) \
                    or s[:1] in (['appcache'], ['depotcache'], ['logs']):
                return 'cache', 'Steam'
            return 'apps', 'data:steam'
        if top == '.var' and len(parts) >= 3 and parts[1] == 'app':
            if len(parts) >= 4 and parts[3] == 'cache':
                return 'cache', os.path.join(HOME, *parts[:4])
            return 'apps', 'data:' + parts[2]
        if parts[:3] == ['.local', 'share', 'flatpak']:
            return 'apps', 'flatpak'
        name, folder = app_folder(parts)
        for i, p in enumerate(parts[1:], 1):
            if p in CACHE_NAMES:
                return 'cache', os.path.join(HOME, *parts[:i + 1])
        return 'apps', 'data:' + name
    if path.startswith('/home/'):
        return 'system', 'Other users'
    if path == '/opt' or path.startswith('/opt/'):
        p = path.split('/')
        return 'apps', 'opt:' + (p[2] if len(p) > 2 else '')
    if path.startswith(('/var/cache/', '/var/tmp')) or path == '/var/cache':
        return 'cache', '/'.join(path.split('/')[:4])
    if path.startswith('/var/lib/flatpak'):
        return 'apps', 'flatpak'
    p = path.split('/')
    if len(p) > 2 and p[1] == 'var':
        return 'system', '/var/' + p[2]
    return 'system', '/' + p[1] if len(p) > 1 and p[1] else '/'


# btrfs' tree search (linux/btrfs.h, btrfs_tree.h), the v1 ioctl's 4096 bytes
TREE_SEARCH = 0xd0009411
SEARCH_KEY = struct.Struct('<7Q4I4Q')	# btrfs_ioctl_search_key
SEARCH_HEADER = struct.Struct('<3Q2I')	# btrfs_ioctl_search_header
EXTENT_DATA_KEY = 108
EXTENT_HEAD = struct.Struct('<QQBBHB')	# btrfs_file_extent_item up to its type
EXTENT_DISK = struct.Struct('<4Q')	# disk_bytenr, disk_num_bytes, offset, num_bytes
REGULAR_EXTENT = EXTENT_HEAD.size + EXTENT_DISK.size
U64 = (1 << 64) - 1
COMPRESSION = {0: 'None', 1: 'zlib', 2: 'LZO', 3: 'zstd'}


def file_extents(dfd, ino):
    """(compression type, bytes on disk, bytes of file) per extent of an
    inode in the subvolume of the folder dfd (needs root). A compressed
    extent shared by several file ranges counts in proportion to the part
    each references; holes count nothing."""
    offset = 0
    while True:
        buf = bytearray(4096)
        SEARCH_KEY.pack_into(buf, 0, 0, ino, ino, offset, U64, 0, U64,
                             EXTENT_DATA_KEY, EXTENT_DATA_KEY, 4096, 0, 0, 0, 0, 0)
        try:
            fcntl.ioctl(dfd, TREE_SEARCH, buf)
        except OSError:
            return
        n = SEARCH_KEY.unpack_from(buf, 0)[9]
        pos = SEARCH_KEY.size
        for _ in range(n):
            _, _, offset, _, length = SEARCH_HEADER.unpack_from(buf, pos)
            item = pos + SEARCH_HEADER.size
            _, ram, comp, _, _, kind = EXTENT_HEAD.unpack_from(buf, item)
            if kind == 0:		# inline: the data is in the item
                yield comp, length - EXTENT_HEAD.size, ram
            else:
                bytenr, disk, _, num = EXTENT_DISK.unpack_from(buf, item + EXTENT_HEAD.size)
                if bytenr:
                    yield comp, (disk * num // ram if comp and ram else num), num
            pos = item + length
        # the kernel stops at the first item that does not fit: only then more
        if n == 0 or len(buf) - pos >= SEARCH_HEADER.size + REGULAR_EXTENT:
            return
        offset += 1


class Totals:
    """what one walk found: bytes per category and group, the largest
    files per file type, entries, unreadable folders; with extents (root),
    bytes on disk and of the same files per category and group and per
    compression type"""

    def __init__(self):
        self.cats = collections.Counter()
        self.groups = collections.defaultdict(collections.Counter)
        self.top = collections.defaultdict(list)
        self.entries = 0
        self.unreadable = []
        self.disk = collections.defaultdict(collections.Counter)
        self.logical = collections.defaultdict(collections.Counter)
        self.algo = collections.defaultdict(lambda: [0, 0])

    def extents(self, cat, group, dfd, ino):
        for comp, disk, logical in file_extents(dfd, ino):
            self.disk[cat][group] += disk
            self.logical[cat][group] += logical
            a = self.algo[comp]
            a[0] += disk
            a[1] += logical

    def add(self, cat, group, size):
        self.cats[cat] += size
        self.groups[cat][group] += size

    def file(self, cat, size, path):
        h = self.top[cat]
        if len(h) < TOP_FILES:
            heapq.heappush(h, (size, path))
        elif size > h[0][0]:
            heapq.heapreplace(h, (size, path))

    def json(self):
        return {'cats': self.cats, 'groups': self.groups, 'top': self.top, 'entries': self.entries,
                'unreadable': self.unreadable[:20], 'disk': self.disk, 'logical': self.logical,
                'algo': self.algo}


def walk(root, recursive, skip, extents=False):
    """the totals of a folder's entries (and everything below it when
    recursive), in inode order: btrfs keeps inodes by number, so the
    metadata reads run nearly sequentially; extents: also what the files
    take on disk (root only)"""
    t = Totals()
    seen = set()
    stack = [root]
    while stack:
        d = stack.pop()
        try:
            with os.scandir(d) as it:
                ents = sorted(it, key=lambda e: e.inode())
        except OSError:
            t.unreadable.append(d)
            continue
        cat, group = dir_context(d)
        dfd = -1
        if extents:
            try:
                dfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
            except OSError:
                pass
        try:
            stack.extend(reversed(_walk_dir(t, d, ents, cat, group, dfd, seen, skip, recursive)))
        finally:
            if dfd >= 0:
                os.close(dfd)
    return t


def _walk_dir(t, d, ents, cat, group, dfd, seen, skip, recursive):
    """one folder's entries into t; its subfolders to walk"""
    subdirs = []
    for e in ents:
        try:
            st = e.stat(follow_symlinks=False)
        except OSError:
            continue
        t.entries += 1
        isdir = e.is_dir(follow_symlinks=False)
        if st.st_nlink > 1 and not isdir:
            if (st.st_dev, st.st_ino) in seen:
                continue
            seen.add((st.st_dev, st.st_ino))
        size = st.st_blocks * 512
        if isdir:
            if e.path in skip:
                continue
            c, g = dir_context(e.path)
            t.add(c if c != 'typed' else 'documents', g, size)
            if recursive:
                subdirs.append(e.path)
            continue
        if cat == 'typed':
            if e.name.startswith('.') and d == HOME:
                c, g = 'apps', 'data:dotfiles'	# ~/.bashrc and the like
            else:
                c, g = EXT_CATEGORY.get(e.name.rpartition('.')[2].lower(), 'documents'), group
                t.file(c, size, e.path)
        else:
            c, g = cat, group
        t.add(c, g, size)
        if dfd >= 0 and stat.S_ISREG(st.st_mode) and st.st_size:
            t.extents(c, g, dfd, st.st_ino)
    return subdirs


def scan_worker(root):
    """--scan-worker / --root-worker: units ('tree:PATH' or 'files:PATH') on
    stdin, one JSON line of totals per unit on stdout. As root (through
    pkexec), with the extents, for the home folder of pkexec's caller."""
    global HOME
    if root:
        if os.geteuid() != 0 or 'PKEXEC_UID' not in os.environ:
            sys.exit('--root-worker runs through pkexec')
        HOME = pwd.getpwuid(int(os.environ['PKEXEC_UID'])).pw_dir
    skip = skipped_mounts()
    for line in sys.stdin:
        kind, _, path = line.rstrip('\n').partition(':')
        t = walk(path, kind == 'tree', skip, extents=root)
        out = t.json()
        out['unit'] = line.rstrip('\n')
        sys.stdout.write(json.dumps(out) + '\n')
        sys.stdout.flush()


if __name__ == '__main__' and sys.argv[1:2] in (['--scan-worker'], ['--root-worker']):
    scan_worker(sys.argv[1] == '--root-worker')
    sys.exit(0)

