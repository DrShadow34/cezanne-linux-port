            trash = os.path.join(HOME, '.local', 'share', 'Trash')
            subs = [os.path.join(trash, s) for s in ('files', 'info', 'expunged')]
            subs = [f for f in subs if os.path.isdir(f)]
            left, freed = [len(subs)], [0]

            def one(n):
                freed[0] += n
                left[0] -= 1
                if not left[0]:
                    self.toast(f'{human(freed[0])} freed')
                    self.start()
            for f in subs:
