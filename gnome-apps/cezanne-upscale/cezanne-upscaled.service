[Unit]
Description=AI upscaling on the APU (Real-ESRGAN x4plus on the MDLA)
Requires=cezanne-upscaled.socket

[Service]
ExecStart=/usr/lib/cezanne-upscale/cezanne-upscaled
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
