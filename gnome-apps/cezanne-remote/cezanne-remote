CARRIER = 38000
CAT_AC, CAT_TV = 1, 2

LIRC_SET_SEND_CARRIER = 0x40046913	# _IOW('i', 0x13, __u32)
LIRC_MAX_ENTRIES = 1023			# lirc_dev: LIRCBUF_SIZE, odd count
LIRC_MAX_US = 500000			# IR_MAX_DURATION per entry

# IRext AC: ir_decode key codes and the state's enumerations
AC_KEY_POWER, AC_KEY_MODE, AC_KEY_TEMP_UP, AC_KEY_TEMP_DOWN = 0, 1, 2, 3
AC_KEY_SPEED, AC_KEY_SWING = 9, 10
AC_MODES = ['Cool', 'Heat', 'Auto', 'Fan', 'Dry']
AC_SPEEDS = ['Auto', 'Low', 'Medium', 'High']
AC_TEMP_MIN = 16

# sizes (Preferences): buttons and spacing in percent; phone-sized defaults
SIZE_DEFAULT, SPACING_DEFAULT = 150, 125
SIZE_RANGE, SPACING_RANGE = (100, 175), (50, 175)


def find(dirs, name):
    for d in dirs:
        if d and os.path.exists(os.path.join(d, name)):
            return os.path.join(d, name)
    raise FileNotFoundError(name)


def sanitize(durations):
    """a code LIRC takes: no zero entries (a zero pulse or space joins its
    neighbours), none over 500 ms, starting and ending on a pulse; None when
    nothing is left (IRext stores keys a remote lacks as "0")"""
    seq = []
    for i, v in enumerate(durations or ()):
        if v <= 0:
            continue
        kind = i % 2		# 0 pulse, 1 space
        if seq and seq[-1][0] == kind:
            seq[-1][1] += v
        else:
            seq.append([kind, v])
    while seq and seq[0][0] == 1:
        seq.pop(0)
    while seq and seq[-1][0] == 1:
        seq.pop()
    out = [min(v, LIRC_MAX_US) for _, v in seq]
    return out if out and len(out) <= LIRC_MAX_ENTRIES else None


class AcStatus(ctypes.Structure):
    """IRext t_remote_ac_status (enums are ints)"""
    _fields_ = [('power', ctypes.c_int), ('temp', ctypes.c_int), ('mode', ctypes.c_int),
                ('wind_dir', ctypes.c_int), ('wind_speed', ctypes.c_int),
                ('display', ctypes.c_uint8), ('sleep', ctypes.c_uint8), ('timer', ctypes.c_uint8),
                ('change_wind_direction', ctypes.c_uint8)]


class AcDecoder:
    """IRext's decoder: one remote open at a time (the library keeps a global
    context), so every call opens the binary again"""

    def __init__(self):
        self.lib = ctypes.CDLL(find(LIB_DIRS, 'libirdecode.so'))
        self.lock = threading.Lock()

    def _open(self, binary):
        self._buf = (ctypes.c_uint8 * len(binary)).from_buffer_copy(binary)
        if self.lib.ir_binary_open(CAT_AC, 1, self._buf, len(binary)) != 0:
            raise ValueError('IRext cannot parse this remote')

    def capabilities(self, binary):
        """{'modes': [mode...], mode: {'temps': (lo, hi) or None, 'speeds': [...]},
        'swing': bool}"""
        with self.lock:
            self._open(binary)
            try:
                caps = {}
                m = ctypes.c_uint8()
                self.lib.get_supported_mode(ctypes.byref(m))
                caps['modes'] = [i for i in range(len(AC_MODES)) if m.value >> i & 1]
                for mode in caps['modes']:
                    lo, hi, sp = ctypes.c_int8(), ctypes.c_int8(), ctypes.c_uint8()
                    self.lib.get_temperature_range(mode, ctypes.byref(lo), ctypes.byref(hi))
                    self.lib.get_supported_wind_speed(mode, ctypes.byref(sp))
                    caps[mode] = {
                        'temps': (lo.value + AC_TEMP_MIN, hi.value + AC_TEMP_MIN) if lo.value >= 0 else None,
                        'speeds': [i for i in range(len(AC_SPEEDS)) if sp.value >> i & 1],
                    }
                sw = ctypes.c_uint8()
                self.lib.get_supported_swing(caps['modes'][0] if caps['modes'] else 0, ctypes.byref(sw))
                caps['swing'] = sw.value != 0
                return caps
            finally:
                self.lib.ir_close()

    def encode(self, binary, key, state):
        with self.lock:
            self._open(binary)
            try:
                st = AcStatus(0 if state['power'] else 1, state['temp'] - AC_TEMP_MIN, state['mode'],
                              0 if state['swing'] else 1, state['speed'], 0, 0, 0, 0)
                out = (ctypes.c_uint16 * 2048)()
                n = self.lib.ir_decode(key, out, ctypes.byref(st))
                return list(out[:n])
            finally:
                self.lib.ir_close()


class Blaster:
    """sends pulse / space durations (microseconds) on the LIRC transmitter,
    one code at a time, off the UI thread"""

    def __init__(self, on_error):
        self.on_error = on_error
        self.lock = threading.Lock()

    def send(self, durations):
        durations = sanitize(durations)
        if not durations:
            self.on_error('No code for this key on this remote')
            return
        threading.Thread(target=self._send, args=(durations,), daemon=True).start()

    def _send(self, durations):
        with self.lock:
            try:
                fd = os.open(LIRC, os.O_WRONLY)
                try:
                    fcntl.ioctl(fd, LIRC_SET_SEND_CARRIER, struct.pack('I', CARRIER))
                    os.write(fd, array.array('I', durations).tobytes())
                finally:
                    os.close(fd)
            except OSError as e:
                GLib.idle_add(self.on_error, 'IR transmitter: %s' % e.strerror)


class Db:
    def __init__(self):
        self.db = sqlite3.connect(find(DATA_DIRS, 'remotes.db'), check_same_thread=False)

    def brands(self, category):
        return self.db.execute("select b.id, b.name from brand b where b.category = ? "
                               "order by b.priority, lower(b.name)", (category,)).fetchall()

    def remotes(self, brand):
        """(id, label): IRext's remote number for ACs, the protocol for TVs"""
        return [(rid, 'IRext %s' % name if proto == 'new_ac' else proto)
                for rid, proto, name in self.db.execute(
                    "select id, protocol, name from remote where brand = ? order by position", (brand,))]

    def tv_keys(self, remote):
        """the remote's keys that have a usable code"""
        keys = {}
        for k, c in self.db.execute("select key, code from tv_key where remote = ?", (remote,)):
            d = sanitize(array.array('I', zlib.decompress(c)).tolist())
            if d:
                keys[k] = d
        return keys

    def ac_binary(self, remote):
        return self.db.execute("select data from ac_binary where remote = ?", (remote,)).fetchone()[0]


class State:
    def __init__(self):
        try:
            with open(STATE_FILE) as f:
                self.d = json.load(f)
        except (OSError, ValueError):
            self.d = {}

    def get(self, key, default=None):
        return self.d.get(key, default)

    def set(self, key, value):
        self.d[key] = value
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        tmp = STATE_FILE + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(self.d, f)
        os.replace(tmp, STATE_FILE)


class Sizer:
    """button and spacing sizes: CSS from the size factor, container spacing
    from the spacing factor (both from Preferences, applied live)"""

    def __init__(self, state):
        self.state = state
        self.size = state.get('ui_size', SIZE_DEFAULT)
        self.spacing = state.get('ui_spacing', SPACING_DEFAULT)
        self.spaced = []	# (widget, base spacing)
        self.css = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def space(self, widget, base):
        """register a Box / Grid whose spacing follows the setting"""
        self.spaced.append((widget, base))
        return widget

    def set(self, size=None, spacing=None):
        if size is not None:
            self.size = int(size)
            self.state.set('ui_size', self.size)
        if spacing is not None:
            self.spacing = int(spacing)
            self.state.set('ui_spacing', self.spacing)
        self.apply()

    def apply(self):
        s, sp = self.size / 100, self.spacing / 100
        t = 1 + (s - 1) * 0.7		# text grows a bit less than the buttons

        def px(v):
            return '%dpx' % round(v * s)
        self.css.load_from_string("""
            .remote-page { font-size: %d%%; }
            .remote-page button.key { min-width: %s; min-height: %s; border-radius: %s; }
            .remote-page button.key image { -gtk-icon-size: %s; }
            .remote-page button.key.pill { min-width: %s; border-radius: 999px; }
            .remote-page button.power { min-width: %s; min-height: %s; border-radius: 999px; }
            .remote-page button.power image { -gtk-icon-size: %s; }
            .remote-page button.round { min-width: %s; min-height: %s; border-radius: 999px; }
            .remote-page button.round image { -gtk-icon-size: %s; }
            .remote-page button.picker image { -gtk-icon-size: %s; }
            .remote-page .ac-temp { font-size: %s; font-weight: 800; font-feature-settings: "tnum";
                                    min-width: %s; }
            .remote-page button.ac-power { min-width: %s; min-height: %s; }
            .remote-page toggle { min-height: %s; }
        """ % (round(100 * t), px(56), px(52), px(12), px(18), px(96), px(76), px(76), px(28),
               px(58), px(58), px(20), px(16), px(46), px(112), px(200), px(52), px(38)))
        for w, base in self.spaced:
            v = round(base * sp)
            if isinstance(w, Gtk.Grid):
                w.set_row_spacing(v)
                w.set_column_spacing(v)
            else:
                w.set_spacing(v)


def brand_row(title, brands, selected, on_changed):
    """searchable brand list"""
    names = Gtk.StringList.new([n for _, n in brands])
    row = Adw.ComboRow(title=title, model=names, enable_search=True)
    row.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, 'string'))
    ids = [b for b, _ in brands]
    if selected in ids:
        row.set_selected(ids.index(selected))
    row.connect('notify::selected', lambda r, _: on_changed(ids[r.get_selected()]))
    return row, ids


class RemotePicker(Adw.ActionRow):
    """which of the brand's remotes: previous / next, and a test button"""

    def __init__(self, on_changed, on_test=None, test_label=None):
        super().__init__(title='Remote')
        self.on_changed = on_changed
        self.remotes, self.pos = [], 0
        self.prev = Gtk.Button(icon_name='go-previous-symbolic', valign=Gtk.Align.CENTER,
                               tooltip_text='Previous remote')
        self.next = Gtk.Button(icon_name='go-next-symbolic', valign=Gtk.Align.CENTER,
                               tooltip_text='Next remote')
        for b in (self.prev, self.next):
            b.add_css_class('flat')
            b.add_css_class('picker')
            self.add_suffix(b)
        self.prev.connect('clicked', lambda _: self.select(self.pos - 1))
        self.next.connect('clicked', lambda _: self.select(self.pos + 1))
        if on_test:
            t = Gtk.Button(label=test_label, valign=Gtk.Align.CENTER)
            t.connect('clicked', lambda _: on_test())
            self.add_suffix(t)

    def set_remotes(self, remotes, pos):
        self.remotes = remotes
        self.select(min(max(pos, 0), max(len(remotes) - 1, 0)), notify=False)

    def select(self, pos, notify=True):
        if not self.remotes:
            self.set_subtitle('No remotes')
            return
        self.pos = pos % len(self.remotes)
        self.set_subtitle('%d of %d · %s' % (self.pos + 1, len(self.remotes),
                                              self.remotes[self.pos][1]))
        self.prev.set_sensitive(len(self.remotes) > 1)
        self.next.set_sensitive(len(self.remotes) > 1)
        if notify:
            self.on_changed()

    @property
    def remote(self):
        return self.remotes[self.pos][0] if self.remotes else None


class Page(Gtk.ScrolledWindow):
    """a scrolling page whose sizes follow the Preferences"""

    def __init__(self, app):
        # sizes are picked to fit a phone at the largest setting; should a
        # page still be wider, it scrolls instead of widening the window
        super().__init__(hscrollbar_policy=Gtk.PolicyType.AUTOMATIC)
        self.app = app
        self.add_css_class('remote-page')
        self.box = app.sizer.space(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=12,
                                           margin_bottom=24, margin_start=12, margin_end=12), 18)
        self.set_child(Adw.Clamp(maximum_size=640, child=self.box))

    def row(self, base=12, **kw):
        return self.app.sizer.space(Gtk.Box(halign=Gtk.Align.CENTER, **kw), base)


class TvPage(Page):
