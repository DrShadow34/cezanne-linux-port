DATA_DIRS = [os.environ.get('CEZANNE_REMOTE_DATA'), '/usr/share/cezanne-remote', HERE]
LIB_DIRS = [os.environ.get('CEZANNE_REMOTE_LIB'), '/usr/lib/cezanne-remote', HERE]
