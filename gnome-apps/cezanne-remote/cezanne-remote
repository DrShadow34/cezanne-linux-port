        self.brand = sel if sel in ids else ids[0]
        self.picker = RemotePicker(self.remote_changed, lambda: self.press('vol+'), 'Test')
        self.picker.set_tooltip_text('Find the right remote: "Test" sends volume up')
        group.add(self.brand_row)
        group.add(self.picker)
        box.append(group)

        # power, input, mute
        top = self.row(24)
        top.append(self.key('input', icon='video-display-symbolic', tooltip='Input'))
        top.append(self.key('power', icon='system-shutdown-symbolic', css=('destructive-action', 'power'),
                            tooltip='Power'))
        top.append(self.key('mute', icon='audio-volume-muted-symbolic', tooltip='Mute'))
        box.append(top)

        # navigation
        pad = app.sizer.space(Gtk.Grid(halign=Gtk.Align.CENTER), 6)
        pad.attach(self.key('up', icon='go-up-symbolic'), 1, 0, 1, 1)
        pad.attach(self.key('left', icon='go-previous-symbolic'), 0, 1, 1, 1)
        pad.attach(self.key('ok', label='OK', css=('suggested-action',)), 1, 1, 1, 1)
        pad.attach(self.key('right', icon='go-next-symbolic'), 2, 1, 1, 1)
        pad.attach(self.key('down', icon='go-down-symbolic'), 1, 2, 1, 1)
        box.append(pad)

        nav = self.row(12)
        nav.append(self.key('back', icon='edit-undo-symbolic', tooltip='Back'))
        nav.append(self.key('home', icon='go-home-symbolic', tooltip='Home'))
        nav.append(self.key('menu', icon='open-menu-symbolic', tooltip='Menu'))
        nav.append(self.key('set', icon='emblem-system-symbolic', tooltip='Settings'))
        box.append(nav)

        vol = self.row(12)
        vol.append(self.key('vol-', icon='audio-volume-low-symbolic', css=('pill',), tooltip='Volume down'))
        vol.append(self.key('vol+', icon='audio-volume-high-symbolic', css=('pill',), tooltip='Volume up'))
        box.append(vol)

        digits = app.sizer.space(Gtk.Grid(halign=Gtk.Align.CENTER, margin_top=6), 6)
        for i in range(9):
            digits.attach(self.key(str(i + 1), label=str(i + 1), css=('flat',)), i % 3, i // 3, 1, 1)
        digits.attach(self.key('0', label='0', css=('flat',)), 1, 3, 1, 1)
        exp = Gtk.Expander(label='Numbers', child=digits, halign=Gtk.Align.CENTER,
                           expanded=app.state.get('tv_digits', False))
        exp.connect('notify::expanded', lambda e, _: app.state.set('tv_digits', e.get_expanded()))
        box.append(exp)

        self.load_brand(app.state.get('tv_remote', {}).get(str(self.brand), 0))

    def key(self, name, label=None, icon=None, css=(), tooltip=None):
        b = Gtk.Button(label=label) if label else Gtk.Button(icon_name=icon)
        b.add_css_class('key')
        for c in css:
            b.add_css_class(c)
        if tooltip:
            b.set_tooltip_text(tooltip)
        b.connect('clicked', lambda _: self.press(name))
        self.buttons[name] = b
        return b

    def press(self, name):
        self.app.blaster.send(self.keys.get(name))

    def brand_changed(self, brand):
        self.brand = brand
        self.app.state.set('tv_brand', brand)
        self.load_brand(self.app.state.get('tv_remote', {}).get(str(brand), 0))

    def load_brand(self, pos):
        self.picker.set_remotes(self.app.db.remotes(self.brand), pos)
        self.remote_changed(save=False)

    def remote_changed(self, save=True):
        remote = self.picker.remote
        self.keys = self.app.db.tv_keys(remote) if remote else {}
        for name, b in self.buttons.items():
            b.set_sensitive(name in self.keys)
        if save:
            pos = self.app.state.get('tv_remote', {})
            pos[str(self.brand)] = self.picker.pos
            self.app.state.set('tv_remote', pos)


class AcPage(Page):
    DEFAULT = {'power': False, 'mode': 0, 'temp': 24, 'speed': 0, 'swing': False}

    def __init__(self, app):
        super().__init__(app)
        self.binary, self.caps, self.st = None, None, dict(self.DEFAULT)
        self.updating = False
        box = self.box

        group = Adw.PreferencesGroup()
        brands = app.db.brands(CAT_AC)
        sel = app.state.get('ac_brand')
        if sel is None:
            sel = next((b for b, n in brands if n.upper() == 'AUX'), brands[0][0])
        self.brand_row, ids = brand_row('Brand', brands, sel, self.brand_changed)
        self.brand = sel if sel in ids else ids[0]
        self.picker = RemotePicker(self.remote_changed)
        group.add(self.brand_row)
        group.add(self.picker)
        box.append(group)

        # temperature with - / +, the power button under it
        temp = self.row(16)
        self.minus = Gtk.Button(icon_name='list-remove-symbolic', valign=Gtk.Align.CENTER,
                                tooltip_text='Colder')
        self.plus = Gtk.Button(icon_name='list-add-symbolic', valign=Gtk.Align.CENTER,
                               tooltip_text='Warmer')
        for b in (self.minus, self.plus):
            b.add_css_class('round')
        self.temp_label = Gtk.Label()
        self.temp_label.add_css_class('ac-temp')
        self.minus.connect('clicked', lambda _: self.change_temp(-1))
        self.plus.connect('clicked', lambda _: self.change_temp(1))
        temp.append(self.minus)
        temp.append(self.temp_label)
        temp.append(self.plus)
        box.append(temp)

        self.power = Gtk.Button(halign=Gtk.Align.CENTER)
        self.power.add_css_class('pill')
        self.power.add_css_class('ac-power')
        self.power.connect('clicked', lambda _: self.toggle_power())
        box.append(self.power)

        # mode and fan as full-width choices, so they stay readable when large
        self.modes = Adw.ToggleGroup(homogeneous=True, hexpand=True)
        self.speeds = Adw.ToggleGroup(homogeneous=True, hexpand=True)
        self.mode_box = self.choice('Mode', self.modes)
        self.speed_box = self.choice('Fan', self.speeds)
        box.append(self.mode_box)
        box.append(self.speed_box)
        swing = Adw.PreferencesGroup()
        self.swing_row = Adw.SwitchRow(title='Swing')
        swing.add(self.swing_row)
        box.append(swing)
        self.modes.connect('notify::active', lambda g, _: self.set_field('mode', g.get_active_name(), AC_KEY_MODE))
        self.speeds.connect('notify::active', lambda g, _: self.set_field('speed', g.get_active_name(), AC_KEY_SPEED))
        self.swing_row.connect('notify::active', lambda r, _: self.set_field('swing', r.get_active(), AC_KEY_SWING))

        note = Gtk.Label(label='IR is one-way: this is the state last sent, not read from the unit.',
                         wrap=True, justify=Gtk.Justification.CENTER)
        note.add_css_class('dim-label')
        note.add_css_class('caption')
        box.append(note)

        self.load_brand(app.state.get('ac_remote', {}).get(str(self.brand), 0))

    def choice(self, title, group):
        b = self.app.sizer.space(Gtk.Box(orientation=Gtk.Orientation.VERTICAL), 6)
        label = Gtk.Label(label=title, xalign=0)
        label.add_css_class('heading')
        b.append(label)
        b.append(group)
        return b

    def brand_changed(self, brand):
        self.brand = brand
        self.app.state.set('ac_brand', brand)
        self.load_brand(self.app.state.get('ac_remote', {}).get(str(brand), 0))

    def load_brand(self, pos):
        self.picker.set_remotes(self.app.db.remotes(self.brand), pos)
        self.remote_changed(save=False)

    def remote_changed(self, save=True):
        remote = self.picker.remote
        if save:
            pos = self.app.state.get('ac_remote', {})
            pos[str(self.brand)] = self.picker.pos
            self.app.state.set('ac_remote', pos)
        self.binary = self.app.db.ac_binary(remote) if remote else None
        try:
            self.caps = self.app.ac.capabilities(self.binary) if self.binary else None
        except ValueError as e:
            self.caps = None
            self.app.toast(str(e))
        saved = self.app.state.get('ac_state', {}).get(str(remote))
        self.st = dict(self.DEFAULT, **(saved or {}))
        self.fit_state()
        self.refresh()

    def fit_state(self):
        """keep the state within what this remote supports"""
        c = self.caps
        if not c or not c['modes']:
            return
        if self.st['mode'] not in c['modes']:
            self.st['mode'] = c['modes'][0]
        m = c[self.st['mode']]
        if m['temps']:
            self.st['temp'] = min(max(self.st['temp'], m['temps'][0]), m['temps'][1])
        if m['speeds'] and self.st['speed'] not in m['speeds']:
            self.st['speed'] = m['speeds'][0]

    def refresh(self):
        """show the state; rebuild the mode / fan choices for this remote"""
        self.updating = True
        c, st = self.caps, self.st
        ok = c is not None and bool(c['modes'])
        for w in (self.minus, self.plus, self.power, self.mode_box, self.speed_box, self.swing_row):
            w.set_sensitive(ok)
        if ok:
            m = c[st['mode']]
            self.modes.remove_all()
            for i in c['modes']:
                self.modes.add(Adw.Toggle(label=AC_MODES[i], name=str(i)))
            self.modes.set_active_name(str(st['mode']))
            self.speeds.remove_all()
            for i in m['speeds']:
                self.speeds.add(Adw.Toggle(label=AC_SPEEDS[i], name=str(i)))
            self.speed_box.set_visible(bool(m['speeds']))
            if m['speeds']:
                self.speeds.set_active_name(str(st['speed']))
            self.swing_row.set_visible(c['swing'])
            self.swing_row.set_active(st['swing'])
            if m['temps']:
                self.temp_label.set_label('%d °C' % st['temp'])
                self.minus.set_sensitive(st['temp'] > m['temps'][0])
                self.plus.set_sensitive(st['temp'] < m['temps'][1])
            else:
                self.temp_label.set_label('—')
                self.minus.set_sensitive(False)
                self.plus.set_sensitive(False)
        else:
            self.temp_label.set_label('—')
        on = st['power']
        self.power.set_label('Turn off' if on else 'Turn on')
        self.power.remove_css_class('destructive-action' if not on else 'suggested-action')
        self.power.add_css_class('destructive-action' if on else 'suggested-action')
        self.temp_label.set_opacity(1.0 if on else 0.5)
        self.updating = False

    def save(self):
        remote = self.picker.remote
        states = self.app.state.get('ac_state', {})
        states[str(remote)] = self.st
        self.app.state.set('ac_state', states)

    def send(self, key):
        if not self.binary:
            return
        try:
            self.app.blaster.send(self.app.ac.encode(self.binary, key, self.st))
        except ValueError as e:
            self.app.toast(str(e))

    def toggle_power(self):
        self.st['power'] = not self.st['power']
        self.save()
        self.refresh()
        # the power key sends the state with power on / off
        self.send(AC_KEY_POWER)

    def change_temp(self, d):
        m = self.caps[self.st['mode']]
        if not m['temps']:
            return
        self.st['temp'] = min(max(self.st['temp'] + d, m['temps'][0]), m['temps'][1])
        self.after_change(AC_KEY_TEMP_UP if d > 0 else AC_KEY_TEMP_DOWN)

    def set_field(self, field, value, key):
        if self.updating or value is None:
            return
        if field in ('mode', 'speed'):
            value = int(value)
        if self.st[field] == value:
            return
        self.st[field] = value
        self.fit_state()
        self.after_change(key)

    def after_change(self, key):
        self.save()
        self.refresh()
        # an AC only listens while on; changes while off are kept for later
        if self.st['power']:
            self.send(key)


def size_row(title, subtitle, lo, hi, value, on_change):
    """a slider in percent, snapping to 5 %"""
    row = Adw.PreferencesRow(activatable=False)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=12, margin_bottom=6,
                  margin_start=12, margin_end=12)
    head = Gtk.Label(label=title, xalign=0)
    sub = Gtk.Label(label=subtitle, xalign=0, wrap=True)
    sub.add_css_class('dim-label')
    sub.add_css_class('caption')
    adj = Gtk.Adjustment(lower=lo, upper=hi, step_increment=5, page_increment=25, value=value)
    scale = Gtk.Scale(adjustment=adj, hexpand=True, draw_value=True, digits=0,
                      value_pos=Gtk.PositionType.RIGHT)
    scale.set_format_value_func(lambda s, v: '%d %%' % v)
    for m in range(lo, hi + 1, 25):
        scale.add_mark(m, Gtk.PositionType.BOTTOM, None)

    def changed(a):
        v = round(a.get_value() / 5) * 5
        if v != a.get_value():
            a.set_value(v)
            return
        on_change(v)
    adj.connect('value-changed', changed)
    for w in (head, sub, scale):
        box.append(w)
    row.set_child(box)
    return row, adj


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.window = None
        for name, cb in (('preferences', self.show_preferences), ('about', self.show_about)):
            a = Gio.SimpleAction(name=name)
            a.connect('activate', lambda *_, cb=cb: cb())
            self.add_action(a)
        self.set_accels_for_action('app.preferences', ['<Control>comma'])

    def do_activate(self):
        if self.window:
            self.window.present()
            return
        self.state = State()
        self.sizer = Sizer(self.state)
        self.db = Db()
        self.ac = AcDecoder()
        self.blaster = Blaster(self.toast)

        self.window = Adw.ApplicationWindow(application=self, title='Remote Control',
                                            default_width=420, default_height=760)
        self.toasts = Adw.ToastOverlay()
        stack = Adw.ViewStack()
        stack.add_titled_with_icon(TvPage(self), 'tv', 'TV', 'video-display-symbolic')
        stack.add_titled_with_icon(AcPage(self), 'ac', 'Air Conditioner', 'weather-few-clouds-symbolic')
        stack.set_visible_child_name(self.state.get('page', 'tv'))
        stack.connect('notify::visible-child-name',
                      lambda s, _: self.state.set('page', s.get_visible_child_name()))

        menu = Gio.Menu()
        menu.append('Preferences', 'app.preferences')
        menu.append('About Remote Control', 'app.about')
        header = Adw.HeaderBar(title_widget=Adw.WindowTitle(title='Remote Control'))
        header.pack_end(Gtk.MenuButton(icon_name='open-menu-symbolic', menu_model=menu,
                                       primary=True, tooltip_text='Main Menu'))
        bar = Adw.ViewSwitcherBar(stack=stack, reveal=True)
        view = Adw.ToolbarView(content=stack)
        view.add_top_bar(header)
        view.add_bottom_bar(bar)
        self.toasts.set_child(view)
        self.window.set_content(self.toasts)
        self.sizer.apply()
        self.window.maximize()	# a phone app
        self.window.present()

    def show_preferences(self):
        dlg = Adw.PreferencesDialog(title='Preferences')
        page = Adw.PreferencesPage(title='Display', icon_name='preferences-desktop-display-symbolic')
        group = Adw.PreferencesGroup(title='Size', description='Changes show behind this dialog right away.')
        size, size_adj = size_row('Buttons', 'Size of the keys, controls and text', *SIZE_RANGE,
                                  self.sizer.size, lambda v: self.sizer.set(size=v))
        space, space_adj = size_row('Spacing', 'Room between the keys', *SPACING_RANGE,
                                    self.sizer.spacing, lambda v: self.sizer.set(spacing=v))
        group.add(size)
        group.add(space)
        reset = Adw.ButtonRow(title='Restore Defaults')
        reset.connect('activated', lambda _: (size_adj.set_value(SIZE_DEFAULT),
                                              space_adj.set_value(SPACING_DEFAULT)))
        group.add(reset)
        page.add(group)
        dlg.add(page)
        dlg.present(self.window)

    def show_about(self):
        about = Adw.AboutDialog(application_name='Remote Control', application_icon=APP_ID,
                                version=VERSION, developer_name='cezanne port',
                                comments='TV and air conditioner remote for the IR blaster.',
                                license_type=Gtk.License.MIT_X11,
                                website='https://github.com/irext')
        about.add_credit_section('IR codes and decoder', ['IRext https://github.com/irext'])
        about.present(self.window)

    def toast(self, text):
        if self.window:
            self.toasts.add_toast(Adw.Toast(title=text))
        return False


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
