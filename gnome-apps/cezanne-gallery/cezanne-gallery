        self.toolbar = Adw.ToolbarView(content=self.pager, extend_content_to_top_edge=True,
                                       extend_content_to_bottom_edge=True)
        self.toolbar.add_top_bar(self.header)
        self.toolbar.add_bottom_bar(bar)
        self.set_child(self.toolbar)

        actions = Gio.SimpleActionGroup()
        for name, cb in (('wallpaper', self._wallpaper), ('folder', self._folder),
                         ('upscale', lambda: gallery.upscale(self.item))):
            a = Gio.SimpleAction(name=name)
            a.connect('activate', lambda a, p, cb=cb: cb())
            actions.add_action(a)
        self.upscale_action = actions.lookup_action('upscale')
        self.insert_action_group('viewer', actions)
        # the menu entry follows a running upscale while the viewer shows
        self.up_handler = 0
        self.connect('showing', self._showing)
        self.connect('hidden', self._hidden)
        keys = Gtk.EventControllerKey()
        keys.connect('key-pressed', self._key)
        self.add_controller(keys)
        self.pager.set_items(items, index)

    def _showing(self, page):
        if not self.up_handler:
            self.up_handler = self.gallery.connect('notify::upscaling',
                                                   lambda g, p: self._changed(self.pager))
        self._changed(self.pager)

    def _hidden(self, page):
        if self.up_handler:
            self.gallery.disconnect(self.up_handler)
            self.up_handler = 0

    def _page(self, item):
        page = MediaPage(self.gallery, item)
        page.connect('tap', lambda p: self._toggle_bars())
        page.set_chrome(self.toolbar.get_reveal_top_bars() if hasattr(self, 'toolbar') else True)
        return page

    @property
    def item(self):
        return self.pager.items[self.pager.index] if self.pager.items else None

    def _changed(self, pager):
        it = self.item
        if not it:
            return
        d = GLib.DateTime.new_from_unix_local(int(it.time))
        self.title.set_title(d.format('%-d %B %Y'))
        self.title.set_subtitle(d.format('%H:%M'))
        fav = it.path in self.gallery.settings.favorites
        self.fav.set_icon_name('starred-symbolic' if fav else 'non-starred-symbolic')
        self.upscale_action.set_enabled(not self.gallery.upscaling and can_upscale(self.gallery, it))

    def _toggle_bars(self):
        show = not self.toolbar.get_reveal_top_bars()
        self.toolbar.set_reveal_top_bars(show)
        self.toolbar.set_reveal_bottom_bars(show)
        for page in self.pager.pages.values():
            page.set_chrome(show)

    def _key(self, ctl, keyval, code, state):
        if keyval in (Gdk.KEY_Right, Gdk.KEY_Page_Down):
            self.pager.go(1)
        elif keyval in (Gdk.KEY_Left, Gdk.KEY_Page_Up):
            self.pager.go(-1)
        elif keyval == Gdk.KEY_Escape:
            self.gallery.nav.pop()
        else:
            return False
        return True

    def _favorite(self):
        it = self.item
        favs = self.gallery.settings.favorites
        favs.symmetric_difference_update({it.path})
        self.gallery.settings.save()
        self._changed(self.pager)
        self.gallery.refresh_views()

    def _open_with(self):
        Gtk.FileLauncher(file=Gio.File.new_for_path(self.item.path), always_ask=True).launch(
            self.gallery, None, None)

    def _folder(self):
        Gtk.FileLauncher(file=Gio.File.new_for_path(self.item.path)).open_containing_folder(
            self.gallery, None, None)

    def _wallpaper(self):
        uri = self.item.uri
        bg = Gio.Settings(schema_id='org.gnome.desktop.background')
        bg.set_string('picture-uri', uri)
        bg.set_string('picture-uri-dark', uri)
        self.gallery.toast('Wallpaper set')

    def _details(self):
        DetailsDialog(self.gallery, self.item).present(self.gallery)

    def _delete(self):
        it = self.item
        self.gallery.delete([it])
        items = [x for x in self.pager.items if x is not it]
        if not items:
            self.gallery.nav.pop()
            return
        self.pager.set_items(items, min(self.pager.index, len(items) - 1))


class DetailsDialog(Adw.Dialog):
    """date, file, size, resolution, camera settings"""

    def __init__(self, gallery, item):
        super().__init__(title='Details', content_width=420)
        page = Adw.PreferencesPage()
        rows = []
        d = GLib.DateTime.new_from_unix_local(int(item.time))
        rows.append(('Taken' if item.time != item.mtime else 'Modified', d.format('%A, %-d %B %Y, %H:%M')))
        rows.append(('File', item.name))
        rows.append(('Folder', item.folder.replace(HOME, '~', 1)))
        try:
            size = os.stat(item.path).st_size
            if item.raw:
                rows.append(('Size', f'{human_size(size)} + RAW {human_size(os.stat(item.raw).st_size)}'))
            else:
                rows.append(('Size', human_size(size)))
        except OSError:
            pass
        if item.width and item.height:
            mp = item.width * item.height / 1e6
            rows.append(('Resolution', f'{item.width} × {item.height}' + (f' ({mp:.1f} MP)' if mp >= 1 else '')))
        if item.video and item.duration:
            rows.append(('Length', duration_text(item.duration)))
        if not item.video:
            rows += self._exif(item.path)
        if item.raw:
            rows.append(('RAW', os.path.basename(item.raw)))
        group = Adw.PreferencesGroup()
        for title, value in rows:
            row = Adw.ActionRow(title=title, subtitle=value, subtitle_selectable=True, use_markup=False)
            row.add_css_class('property')
            group.add(row)
        page.add(group)
        view = Adw.ToolbarView(content=page)
        view.add_top_bar(Adw.HeaderBar())
        self.set_child(view)

    @staticmethod
    def _exif(path):
        md = GExiv2.Metadata()
        try:
            md.open_path(path)
        except GLib.Error:
            return []

        def tag(name):
            try:
                return md.try_get_tag_interpreted_string(name) if md.try_has_tag(name) else None
            except GLib.Error:
                return None

        out = []
        model = tag('Exif.Image.Model') or ''
        name = CAMERAS.get(model.rsplit('/', 1)[-1])
        model = name or ' '.join(v for v in (tag('Exif.Image.Make'), model) if v)
        if model:
            out.append(('Camera', model))
        shot = [v for v in (tag('Exif.Photo.ExposureTime'), tag('Exif.Photo.FNumber'),
                            tag('Exif.Photo.FocalLength')) if v]
        iso = tag('Exif.Photo.ISOSpeedRatings')
        if iso:
            shot.append('ISO ' + iso)
        if shot:
            out.append(('Exposure', '  ·  '.join(shot)))
        return out


