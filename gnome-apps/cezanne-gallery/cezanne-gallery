        self.index.connect('failed', self._failed)
        self.index.connect('status', self._miner_status)
        self.connect('close-request', self._closing)
        self.index.start()

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text))

    # -- AI upscaling: a copy next to the photo, in the background -------
    def upscale(self, item):
        if self.upscaling or item is None:
            return
        stem, ext = os.path.splitext(item.path)
        mp = item.width * item.height / 1e6
        if item.video:
            out = f'{stem} (upscaled 2x).mp4'
            cmd = ['cezanne-video-upscale', '--scale', '2', item.path, out]
            seconds = (item.duration or 0) * 30 * mp * VIDEO_SECONDS_PER_MP_FRAME
        else:
            out = f'{stem} (upscaled 2x){ext}'
            cmd = ['cezanne-photo', '--upscale', '2', item.path, out]
            seconds = mp * UPSCALE_SECONDS_PER_MP
        try:
            proc = Gio.Subprocess.new(cmd, Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as e:
            self.toast(f'Cannot upscale: {e.message}')
            return
        minutes = max(1, round(seconds / 60))
        self.up_toast = Adw.Toast(title=f'Upscaling, about {minutes} min…', timeout=0)
        self.toasts.add_toast(self.up_toast)
        self.upscaling = True
        err = Gio.DataInputStream.new(proc.get_stderr_pipe())
        err.read_line_async(GLib.PRIORITY_DEFAULT, None, self._upscale_line, [])
        proc.wait_async(None, self._upscaled, (out, minutes))

    def _upscale_line(self, stream, res, lines):
        try:
            line, _n = stream.read_line_finish_utf8(res)
        except GLib.Error:
            line = None
        if line is None:
            return
        lines.append(line)
        m = re.search(r'(\d+) %', line)
        f = re.match(r'frame (\d+) / (\d+)', line)
        if f:
            m = [None, str(min(99, 100 * int(f.group(1)) // max(int(f.group(2)), 1)))]
        if m and self.up_toast:
            self.up_toast.set_title(f'Upscaling: {m[1]} %')
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._upscale_line, lines)

    def _upscaled(self, proc, res, data):
        out, _minutes = data
        try:
            proc.wait_finish(res)
            ok = proc.get_successful()
        except GLib.Error:
            ok = False
        self.upscaling = False
        if self.up_toast:
            self.up_toast.dismiss()
            self.up_toast = None
        if not ok:
            self.toast('Upscaling failed')
            return
        t = Adw.Toast(title='Upscaled copy saved', button_label='Show', timeout=10)
        t.connect('button-clicked', lambda t: self._show_file(out))
        self.toasts.add_toast(t)

    def _show_file(self, path):
        """the new file in the viewer, once the indexer has it"""
        items = [it for it in self.index.items if it.path == path]
        if items:
            self.open_viewer(items, 0)
        else:
            Gtk.FileLauncher(file=Gio.File.new_for_path(path)).open_containing_folder(self, None, None)

    def _failed(self, index, message):
        self.status.set_child(None)
        self.status.set_icon_name('dialog-warning-symbolic')
        self.status.set_title('The file indexer is not available')
        self.status.set_description(f'The gallery lists photos and videos through LocalSearch.\n{message}')
        self.photos_stack.set_visible_child_name('status')

    def _miner_status(self, index, status, progress):
        busy = status not in ('Idle', '')
        if busy:
            pct = f' ({progress * 100:.0f} %)' if 0 < progress < 1 else ''
            self.banner.set_title(f'Looking for new photos and videos{pct}')
        self.banner.set_revealed(busy)

    def media_folder(self, folder):
        return any(under(folder, r) for r in MEDIA_ROOTS) or folder in self.settings.shown

    def refresh_views(self):
        items = [it for it in self.index.items if it.path not in self.removed]
        groups = collections.OrderedDict()
        for it in items:
            key, name = album_of(it.folder)
            groups.setdefault(key, (name, []))[1].append(it)
        self.albums = {key: Album(key, name, its) for key, (name, its) in groups.items()}
        media = [a for a in self.albums.values() if a.key == 'camera' or self.media_folder(a.key)]
        media.sort(key=lambda a: (album_order(a.key), -a.items[0].time))
        self.others = sorted((a for a in self.albums.values() if a not in media), key=lambda a: -a.items[0].time)
        shown = []
        favs = [it for it in items if it.path in self.settings.favorites]
        if favs:
            shown.append(Album('favorites', 'Favourites', favs, kind='favorites'))
        shown += media
        if self.others:
            covers = [a.items[0] for a in self.others]
            shown.append(Album('others', 'Other folders', covers, kind='others', folders=self.others))
        self.albums_view.set_albums(shown)

        timeline = [it for a in media for it in a.items]
        timeline.sort(key=lambda it: it.time, reverse=True)
        self.photos.set_items(timeline)
        if timeline:
            self.photos_stack.set_visible_child_name('grid')
        else:
            self.status.set_child(None)
            self.status.set_title('No photos or videos')
            self.status.set_description('Pictures taken with the camera and saved to Pictures, Videos or '
                                        'Downloads show here.')
            self.photos_stack.set_visible_child_name('status')
        page = self.nav.get_visible_page()
        if isinstance(page, AlbumPage):
            album = self.albums.get(page.album.key)
            if album:
                page.update(album)
            elif page.album.kind == 'favorites':
                page.update(Album('favorites', 'Favourites', favs, kind='favorites'))

    def open_viewer(self, items, index):
        self.nav.push(Viewer(self, items, index))

    def open_album(self, album):
        if album.kind == 'others':
            self.nav.push(FolderList(self, album.folders))
        else:
            self.nav.push(AlbumPage(self, album))

    def hide_folder(self, album):
        try:
            open(os.path.join(album.key, '.nomedia'), 'a').close()
        except OSError as e:
            self.toast(f'Could not hide the folder: {e.strerror}')
            return
        self.removed.update(it.path for it in album.items)
        self.nav.pop_to_tag('main')
        self.refresh_views()
        self.toast(f'“{album.name}” hidden')

    def delete(self, items):
        self.removed.update(it.path for it in items)
        self.pending.append(items)
        self.refresh_views()
        n = len(items)
        toast = Adw.Toast(title='Moved to the trash' if n == 1 else f'{n} items moved to the trash',
                          button_label='Undo')
        toast.connect('button-clicked', lambda t: self._undo(items))
        toast.connect('dismissed', lambda t: self._trash(items))
        self.toasts.add_toast(toast)

    def _undo(self, items):
        if items in self.pending:
            self.pending.remove(items)
            self.removed.difference_update(it.path for it in items)
            self.refresh_views()

    def _trash(self, items, wait=False):
        if items not in self.pending:
            return
        self.pending.remove(items)
        for it in items:
            for path in (it.path, it.raw):
                if not path:
                    continue
                f = Gio.File.new_for_path(path)
                if wait:
                    try:
                        f.trash(None)
                    except GLib.Error:
                        pass
                else:
                    f.trash_async(GLib.PRIORITY_DEFAULT, None, None, None)
            self.thumbs.forget(it)

    def _closing(self, win):
        for items in list(self.pending):
            self._trash(items, wait=True)
        return False


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        about = Gio.SimpleAction(name='about')
        about.connect('activate', self._about)
        self.add_action(about)

    def do_startup(self):
        Adw.Application.do_startup(self)
        Gst.init(None)
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_activate(self):
        win = self.get_active_window() or Gallery(self)
        win.present()

    def _about(self, *a):
        Adw.AboutDialog(application_name='Gallery', application_icon=APP_ID, version=VERSION,
                        developer_name='arch-port', license_type=Gtk.License.MIT_X11,
                        comments='Photos and videos of the home directory, found by GNOME’s file indexer'
                        ).present(self.get_active_window())


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
