def under(path, root):
    return path == root or path.startswith(root + '/')


def album_of(folder):
    """(key, name) of the album a folder's items belong to"""
    if folder in (os.path.join(PICTURES, 'Camera'), os.path.join(VIDEOS, 'Camera')):
        return 'camera', 'Camera'
    named = {
        os.path.join(PICTURES, 'Screenshots'): 'Screenshots',
        os.path.join(VIDEOS, 'Screencasts'): 'Screen recordings',
        os.path.join(DOWNLOAD, 'Telegram Desktop'): 'Telegram',
        PICTURES: 'Pictures', VIDEOS: 'Videos', DOWNLOAD: 'Downloads', HOME: 'Home',
    }
    return folder, named.get(folder, os.path.basename(folder) or folder)


def album_order(key):
    """well-known albums first, as on Android"""
    order = {'camera': 0, os.path.join(PICTURES, 'Screenshots'): 1, os.path.join(VIDEOS, 'Screencasts'): 2,
             DOWNLOAD: 3, PICTURES: 4, VIDEOS: 5}
    return order.get(key, 10)


def upscaler_available():
    """cezanne-photo and an upscaler for it: the APU service or the GPU one"""
    return bool(GLib.find_program_in_path('cezanne-photo')) and (
        os.path.exists(UPSCALE_SOCKET) or bool(GLib.find_program_in_path('realesrgan-ncnn-vulkan')))


def video_upscaler_available():
    return os.path.exists(UPSCALE_SOCKET) and bool(GLib.find_program_in_path('cezanne-video-upscale'))


def can_upscale(gallery, item):
    """the item is a photo or a video the installed upscalers take"""
    px = (item.width or 0) * (item.height or 0)
    if item.video:
        return gallery.can_upscale_video and 0 < px <= VIDEO_UPSCALE_MAX_PIXELS
    return gallery.can_upscale and item.mime in UPSCALE_TYPES and 0 < px <= UPSCALE_MAX_PIXELS


def human_size(n):
    for unit in ('bytes', 'KB', 'MB', 'GB'):
        if n < 1000 or unit == 'GB':
            return f'{n:.0f} {unit}' if unit == 'bytes' else f'{n:.1f} {unit}'
        n /= 1000


def duration_text(s):
    s = int(s)
    return f'{s // 3600}:{s // 60 % 60:02d}:{s % 60:02d}' if s >= 3600 else f'{s // 60}:{s % 60:02d}'


def day_title(t):
    d = GLib.DateTime.new_from_unix_local(int(t))
    now = GLib.DateTime.new_now_local()
    days = (GLib.DateTime.new_local(now.get_year(), now.get_month(), now.get_day_of_month(), 0, 0, 0).to_unix()
            - GLib.DateTime.new_local(d.get_year(), d.get_month(), d.get_day_of_month(), 0, 0, 0).to_unix()) // 86400
    if days == 0:
        return 'Today'
    if days == 1:
        return 'Yesterday'
    if 1 < days < 7:
        return d.format('%A')
    return d.format('%-d %B') if d.get_year() == now.get_year() else d.format('%-d %B %Y')


def iso_time(s):
    d = GLib.DateTime.new_from_iso8601(s, GLib.TimeZone.new_local()) if s else None
    return d.to_unix() if d else None


def cover_item(items):
    """an album's cover: its newest picture, else its newest video"""
    return next((it for it in items if not it.video), items[0] if items else None)


class Item:
    """one photo or video (a RAW + JPEG pair is one item: the JPEG, .raw = the DNG)"""
    __slots__ = ('uri', 'path', 'mime', 'video', 'time', 'mtime', 'width', 'height', 'duration', 'raw',
                 'folder', 'name')

    def __init__(self, uri, path, mime, created, modified, w, h, dur):
        self.uri, self.path, self.mime = uri, path, mime
        self.video = mime.startswith('video/')
        self.mtime = modified or 0
        self.time = created or self.mtime
        self.width, self.height = w, h
        self.duration = dur
        self.raw = None
        self.folder, self.name = os.path.split(path)


class Settings:
    """folders shown in Photos besides the media folders, favourites"""

    def __init__(self):
        try:
            with open(SETTINGS_FILE) as f:
                data = json.load(f)
        except (OSError, ValueError):
            data = {}
        self.shown = set(data.get('shown', []))
        self.favorites = set(data.get('favorites', []))

    def save(self):
        os.makedirs(os.path.dirname(SETTINGS_FILE), exist_ok=True)
        tmp = SETTINGS_FILE + '.new'
        with open(tmp, 'w') as f:
            json.dump({'shown': sorted(self.shown), 'favorites': sorted(self.favorites)}, f, indent=1)
        os.replace(tmp, SETTINGS_FILE)


class Index(GObject.Object):
    """the indexer's photos and videos, re-read when it reports changes"""
    __gsignals__ = {
        'loaded': (GObject.SignalFlags.RUN_FIRST, None, ()),
        'failed': (GObject.SignalFlags.RUN_FIRST, None, (str,)),
        'status': (GObject.SignalFlags.RUN_FIRST, None, (str, float)),
    }

    def __init__(self):
        super().__init__()
        self.conn = None
        self.items = []
        self.busy = self.again = False
        self.reload_id = 0

    def start(self):
        Tsparql.SparqlConnection.bus_new_async(LOCALSEARCH, None, None, None, self._connected)
        Gio.DBusProxy.new_for_bus(Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_AUTO_START, None,
                                  LOCALSEARCH, MINER_PATH, MINER_IFACE, None, self._miner_proxy)

    def _connected(self, src, res):
        try:
            self.conn = Tsparql.SparqlConnection.bus_new_finish(res)
        except GLib.Error as e:
            self.emit('failed', e.message)
            return
        self.notifier = self.conn.create_notifier()
        self.notifier.connect('events', self._events)
        self.reload()
        # the media folders are crawled again in case the index missed them
        # (a stale database that took them for up to date); cheap when it did not
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        for d in MEDIA_ROOTS:
            if os.path.isdir(d):
                bus.call(CONTROL, MINER_PATH + '/Index', 'org.freedesktop.Tracker3.Miner.Files.Index',
                         'IndexLocation', GLib.Variant('(sasas)', (Gio.File.new_for_path(d).get_uri(), [], [])),
                         None, Gio.DBusCallFlags.NONE, -1, None, None)

    def _miner_proxy(self, src, res):
        try:
            self.miner = Gio.DBusProxy.new_for_bus_finish(res)
        except GLib.Error:
            return
        self.miner.connect('g-signal', self._miner_signal)
        self.miner.call('GetStatus', None, Gio.DBusCallFlags.NONE, -1, None, self._miner_status)

    def _miner_status(self, proxy, res):
        try:
            status, = proxy.call_finish(res).unpack()
        except GLib.Error:
            return
        self.emit('status', status, -1.0)

    def _miner_signal(self, proxy, sender, signal, params):
        if signal == 'Progress':
            status, progress, _remaining = params.unpack()
            self.emit('status', status, progress)

    def _events(self, notifier, service, graph, events):
        # a burst of changes (a crawl, a copy) is read once
        if self.reload_id:
            GLib.source_remove(self.reload_id)
        self.reload_id = GLib.timeout_add(1500, self._reload_timeout)

    def _reload_timeout(self):
        self.reload_id = 0
        self.reload()
        return False

    def reload(self):
        if self.busy:
            self.again = True
            return
        self.busy = True
        threading.Thread(target=self._query, daemon=True).start()

    def _query(self):
        rows = []
        try:
            cur = self.conn.query(QUERY, None)
            while cur.next(None):
                col = [cur.get_string(i)[0] if cur.is_bound(i) else None for i in range(7)]
                rows.append(col)
            cur.close()
        except GLib.Error as e:
            GLib.idle_add(self._done, None, e.message)
            return
        GLib.idle_add(self._done, self._items(rows), None)

    @staticmethod
    def _items(rows):
        items = []
        seen = set()	# a file whose triples sit in several graphs comes more than once
        for url, mime, created, modified, w, h, dur in rows:
            if mime in SKIP_MIME or not url.startswith('file://') or url in seen:
                continue
            seen.add(url)
            path = Gio.File.new_for_uri(url).get_path()
            if not path:
                continue
            items.append(Item(url, path, mime, iso_time(created), iso_time(modified),
                              int(w) if w else None, int(h) if h else None, float(dur) if dur else None))
        # RAW + JPEG pairs: one item
        by_stem = {}
        for it in items:
            stem, ext = os.path.splitext(it.path)
            if ext.lower() in PAIR_EXT:
                by_stem[stem] = it
        out = []
        for it in items:
            stem, ext = os.path.splitext(it.path)
            if ext.lower() in RAW_EXT and stem in by_stem:
                by_stem[stem].raw = it.path
                continue
            out.append(it)
        out.sort(key=lambda it: it.time, reverse=True)
        return out

    def _done(self, items, error):
        self.busy = False
        if error:
            self.emit('failed', error)
        else:
            self.items = items
            self.emit('loaded')
        if self.again:
            self.again = False
            self.reload()
        return False


def raw_preview_pixbuf(path, min_size):
    """the largest preview embedded in a RAW file (the smallest >= min_size
    when one is big enough), rotated as the file says"""
    md = GExiv2.Metadata()
    md.open_path(path)
    props = sorted(md.get_preview_properties() or [], key=lambda p: p.get_width() * p.get_height())
    if not props:
        return None
    big = [p for p in props if max(p.get_width(), p.get_height()) >= min_size]
    data = md.get_preview_image(big[0] if big else props[-1]).get_data()
    loader = GdkPixbuf.PixbufLoader()
    loader.write(data)
    loader.close()
    pb = loader.get_pixbuf()
    o = md.get_orientation()
    rot = {GExiv2.Orientation.ROT_90: GdkPixbuf.PixbufRotation.CLOCKWISE,
           GExiv2.Orientation.ROT_180: GdkPixbuf.PixbufRotation.UPSIDEDOWN,
           GExiv2.Orientation.ROT_270: GdkPixbuf.PixbufRotation.COUNTERCLOCKWISE}.get(o)
    return pb.rotate_simple(rot) if rot else pb


class Thumbnails:
    """freedesktop thumbnails as textures: cache lookups and RAW previews in
    worker threads (newest request first), generation through gnome-desktop's
    factory (the thumbnailer processes) on the main loop"""

    def __init__(self):
        self.factory = GnomeDesktop.DesktopThumbnailFactory.new(GnomeDesktop.DesktopThumbnailSize.LARGE)
        self.cache = collections.OrderedDict()
        self.waiting = {}	# uri -> [callbacks]
        self.items = {}
        self.queue = []
        self.cond = threading.Condition()
        self.generating = 0
        self.gen_queue = []
        for _ in range(THUMB_WORKERS):
            threading.Thread(target=self._worker, daemon=True).start()

    def get(self, item, cb):
        """the texture now, or None and cb(texture) later (None: no thumbnail)"""
        tex = self.cache.get(item.uri)
        if tex is not None:
            self.cache.move_to_end(item.uri)
            return tex
        new = item.uri not in self.waiting
        self.waiting.setdefault(item.uri, []).append(cb)
        if new:
            self.items[item.uri] = item
            with self.cond:
                self.queue.append(item)
                self.cond.notify()
        return None

    def cancel(self, item, cb):
        cbs = self.waiting.get(item.uri)
        if cbs and cb in cbs:
            cbs.remove(cb)
            if not cbs:
                del self.waiting[item.uri]
                with self.cond:
                    if item in self.queue:
                        self.queue.remove(item)

    @staticmethod
    def _path(uri, kind='large'):
        md5 = hashlib.md5(uri.encode()).hexdigest()
        if kind == 'fail':
            return os.path.join(THUMB_DIR, 'fail', 'gnome-thumbnail-factory', md5 + '.png')
        return os.path.join(THUMB_DIR, kind, md5 + '.png')

    def _worker(self):
        while True:
            with self.cond:
                while not self.queue:
                    self.cond.wait()
                item = self.queue.pop()	# newest first: what is on screen now
            GLib.idle_add(self._result, item, *self._lookup(item))

    def _lookup(self, item):
        try:
            mtime = int(os.stat(item.path).st_mtime)
        except OSError:
            return 'none', None, 0
        for path in (self._path(item.uri), self._path(item.uri, 'fail')):
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file(path)
            except GLib.Error:
                continue
            if pb.get_option('tEXt::Thumb::MTime') == str(mtime):
                return ('found', Gdk.Texture.new_for_pixbuf(pb), mtime) if 'fail' not in path else ('none', None, 0)
        if os.path.splitext(item.path)[1].lower() in RAW_EXT:
            try:
                pb = raw_preview_pixbuf(item.path, THUMB_SIZE)
            except GLib.Error:
                pb = None
            if pb:
                s = THUMB_SIZE / max(pb.get_width(), pb.get_height())
                if s < 1:
                    pb = pb.scale_simple(max(1, round(pb.get_width() * s)), max(1, round(pb.get_height() * s)),
                                         GdkPixbuf.InterpType.BILINEAR)
                try:
                    os.makedirs(os.path.dirname(self._path(item.uri)), exist_ok=True)
                    pb.savev(self._path(item.uri), 'png', ['tEXt::Thumb::URI', 'tEXt::Thumb::MTime'],
                             [item.uri, str(mtime)])
                except GLib.Error:
                    pass
                return 'found', Gdk.Texture.new_for_pixbuf(pb), mtime
        return 'generate', None, mtime

    def _result(self, item, state, tex, mtime):
        if state == 'generate':
            if self.factory.can_thumbnail(item.uri, item.mime, mtime):
                self.gen_queue.append((item, mtime))
                self._next_generation()
                return False
            tex = None
        self._deliver(item, tex)
        return False

    def _next_generation(self):
        # two thumbnailer processes at a time; the newest request first
        while self.generating < 2 and self.gen_queue:
            item, mtime = self.gen_queue.pop()
            if item.uri not in self.waiting:
                continue
            self.generating += 1
            self.factory.generate_thumbnail_async(item.uri, item.mime, None, self._generated, (item, mtime))

    def _generated(self, factory, res, data):
        item, mtime = data
        self.generating -= 1
        try:
            pb = factory.generate_thumbnail_finish(res)
        except GLib.Error:
            pb = None
        if pb:
            factory.save_thumbnail_async(pb, item.uri, mtime, None, None, None)
            self._deliver(item, Gdk.Texture.new_for_pixbuf(pb))
        else:
            factory.create_failed_thumbnail_async(item.uri, mtime, None, None, None)
            self._deliver(item, None)
        self._next_generation()

    def _deliver(self, item, tex):
        if tex is not None:
            self.cache[item.uri] = tex
            while len(self.cache) > THUMB_CACHE:
                self.cache.popitem(last=False)
        self.items.pop(item.uri, None)
        for cb in self.waiting.pop(item.uri, []):
            cb(tex)

    def forget(self, item):
        self.cache.pop(item.uri, None)


class Thumb(Gtk.Widget):
    """a square grid cell: the thumbnail cropped to fill it, the length of a
    video, a RAW / favourite mark"""
    __gtype_name__ = 'GalleryThumb'

    def __init__(self, gallery, badges=True):
        super().__init__()
        self.gallery = gallery
        self.badges = badges
        self.item = None
        self.tex = None
        self.size = CELL
        self.set_cursor_from_name('pointer')
        click = Gtk.GestureClick()
        click.connect('released', self._clicked)
        self.add_controller(click)

    def set_item(self, item, size):
        if self.item is not None and self.tex is None:
            self.gallery.thumbs.cancel(self.item, self._loaded)
        self.item = item
        self.tex = None
        if size != self.size:
            self.size = size
            self.queue_resize()
        if item is not None:
            self.tex = self.gallery.thumbs.get(item, self._loaded)
        self.queue_draw()

    def _loaded(self, tex):
        self.tex = tex
        self.queue_draw()

    def _clicked(self, gesture, n, x, y):
        if self.item is not None and self.on_activate:
            self.on_activate(self.item)

    on_activate = None

    def do_measure(self, orientation, for_size):
        return self.size, self.size, -1, -1

    def do_snapshot(self, s):
        w, h = self.get_width(), self.get_height()
        rect = Graphene.Rect().init(0, 0, w, h)
        if self.tex is None:
            c = Gdk.RGBA()
            c.parse('rgba(128,128,128,0.15)')
            s.append_color(c, rect)
        else:
            tw, th = self.tex.get_width(), self.tex.get_height()
            k = max(w / tw, h / th)
            dw, dh = tw * k, th * k
            s.push_clip(rect)
            s.append_scaled_texture(self.tex, Gsk.ScalingFilter.TRILINEAR,
                                    Graphene.Rect().init((w - dw) / 2, (h - dh) / 2, dw, dh))
            s.pop()
        if self.item is None or not self.badges:
            return
        marks = []
        if self.item.video:
            marks.append('▶ ' + duration_text(self.item.duration) if self.item.duration else '▶')
        if self.item.raw:
            marks.append('RAW')
        if self.item.path in self.gallery.settings.favorites:
            marks.insert(0, '♥')
        if marks:
            self._badge(s, '  '.join(marks), w, h)

    def _badge(self, s, text, w, h):
        layout = self.create_pango_layout(text)
        attrs = Pango.AttrList()
        attrs.insert(Pango.attr_weight_new(Pango.Weight.BOLD))
        attrs.insert(Pango.attr_scale_new(0.8))
        layout.set_attributes(attrs)
        lw, lh = (v / Pango.SCALE for v in layout.get_size())
        bw, bh = lw + 10, lh + 2
        x, y = w - bw - 4, h - bh - 4
        bg = Gdk.RGBA()
        bg.parse('rgba(0,0,0,0.55)')
        r = Gsk.RoundedRect()
        r.init_from_rect(Graphene.Rect().init(x, y, bw, bh), 6)
        s.push_rounded_clip(r)
        s.append_color(bg, Graphene.Rect().init(x, y, bw, bh))
        s.pop()
        s.save()
        s.translate(Graphene.Point().init(x + 5, y + 1))
        white = Gdk.RGBA()
        white.parse('white')
        s.append_layout(layout, white)
        s.restore()


