class MediaGrid(Gtk.Widget):
    """a scrolling grid of thumbnails; with headers, one line per day first
    (the timeline). Lines of cells in a ListView: GridView has no sections."""
    __gtype_name__ = 'GalleryMediaGrid'

    def __init__(self, gallery, headers):
        super().__init__()
        self.gallery = gallery
        self.headers = headers
        self.items = []
        self.width = 0
        self.columns = 4
        self.cell = CELL
        self.store = Gio.ListStore(item_type=Row)
        factory = Gtk.SignalListItemFactory()
        factory.connect('setup', self._setup)
        factory.connect('bind', self._bind)
        factory.connect('unbind', self._unbind)
        self.view = Gtk.ListView(model=Gtk.NoSelection(model=self.store), factory=factory)
        self.view.add_css_class('gallery-grid')
        self.scroller = Gtk.ScrolledWindow(child=self.view, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.scroller.set_parent(self)

    def do_dispose(self):
        self.scroller.unparent()

    def do_measure(self, orientation, for_size):
        return self.scroller.measure(orientation, for_size)

    def do_size_allocate(self, w, h, baseline):
        self.scroller.allocate(w, h, baseline, None)
        if w != self.width:
            self.width = w
            GLib.idle_add(self._relayout)

    def set_items(self, items):
        self.items = items
        self._relayout()

    def _relayout(self):
        if not self.width:
            return False
        self.columns = max(3, (self.width + GAP) // (CELL + GAP))
        self.cell = (self.width - GAP * (self.columns - 1)) // self.columns
        rows = []
        day = None
        line = []
        for it in self.items:
            if self.headers:
                d = time.localtime(it.time)[:3]
                if d != day:
                    if line:
                        rows.append(Row(items=line))
                        line = []
                    rows.append(Row(header=day_title(it.time)))
                    day = d
            line.append(it)
            if len(line) == self.columns:
                rows.append(Row(items=line))
                line = []
        if line:
            rows.append(Row(items=line))
        self.store.splice(0, self.store.get_n_items(), rows)
        return False

    def _setup(self, factory, li):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        header = Gtk.Label(xalign=0)
        header.add_css_class('date-header')
        cells = Gtk.Box(spacing=GAP, margin_bottom=GAP)
        box.append(header)
        box.append(cells)
        li.set_child(box)
        li.set_activatable(False)
        li.set_focusable(False)

    def _bind(self, factory, li):
        row = li.get_item()
        box = li.get_child()
        header, cells = box.get_first_child(), box.get_last_child()
        header.set_visible(row.header is not None)
        cells.set_visible(row.header is None)
        if row.header is not None:
            header.set_label(row.header)
            return
        thumbs = []
        c = cells.get_first_child()
        while c:
            thumbs.append(c)
            c = c.get_next_sibling()
        while len(thumbs) < len(row.items):
            t = Thumb(self.gallery)
            t.on_activate = self._activate
            cells.append(t)
            thumbs.append(t)
        for t in thumbs[len(row.items):]:
            t.set_item(None, self.cell)
            cells.remove(t)
        for t, it in zip(thumbs, row.items):
            t.set_item(it, self.cell)

    def _unbind(self, factory, li):
        cells = li.get_child().get_last_child()
        c = cells.get_first_child()
        while c:
            c.set_item(None, self.cell)
            c = c.get_next_sibling()

    def _activate(self, item):
        self.gallery.open_viewer(self.items, self.items.index(item))


class ImageView(Gtk.Widget):
    """an image fitted to the page, zoomed by pinching or double tapping and
    panned by the pager's drag while zoomed"""
    __gtype_name__ = 'GalleryImageView'
    __gsignals__ = {'tap': (GObject.SignalFlags.RUN_FIRST, None, ())}
    MAX_ZOOM = 8.0

    def __init__(self):
        super().__init__()
        self.tex = None
        self.zoom = 1.0
        self.pan = [0.0, 0.0]
        self.tap_id = 0
        self.anim = None
        pinch = Gtk.GestureZoom()
        pinch.connect('begin', self._pinch_begin)
        pinch.connect('scale-changed', self._pinch)
        pinch.connect('end', self._pinch_end)
        self.add_controller(pinch)
        click = Gtk.GestureClick()
        click.connect('pressed', self._pressed)
        click.connect('released', self._released)
        self.add_controller(click)

    @property
    def zoomed(self):
        return self.zoom > 1.01

    def set_texture(self, tex):
        self.tex = tex
        self.queue_draw()

    def _fit(self):
        if not self.tex:
            return 1.0
        return min(self.get_width() / self.tex.get_width(), self.get_height() / self.tex.get_height())

    def _clamp(self):
        if not self.tex:
            return
        s = self._fit() * self.zoom
        for i, (view, size) in enumerate(((self.get_width(), self.tex.get_width()),
                                          (self.get_height(), self.tex.get_height()))):
            room = max(0.0, (size * s - view) / 2)
            self.pan[i] = min(room, max(-room, self.pan[i]))

    def zoom_at(self, zoom, x, y):
        """zoom keeping the image point under (x, y) where it is"""
        zoom = min(self.MAX_ZOOM, max(1.0, zoom))
        k = zoom / self.zoom
        cx, cy = self.get_width() / 2 + self.pan[0], self.get_height() / 2 + self.pan[1]
        cx, cy = x - (x - cx) * k, y - (y - cy) * k
        self.zoom = zoom
        self.pan = [cx - self.get_width() / 2, cy - self.get_height() / 2]
        self._clamp()
        self.queue_draw()

    def pan_begin(self):
        self.pan_start = list(self.pan)

    def pan_by(self, dx, dy):
        self.pan = [self.pan_start[0] + dx, self.pan_start[1] + dy]
        self._clamp()
        self.queue_draw()

    def reset(self):
        self.zoom = 1.0
        self.pan = [0.0, 0.0]
        self.queue_draw()

    def _pinch_begin(self, g, seq):
        g.set_state(Gtk.EventSequenceState.CLAIMED)	# no page swipe while pinching
        self.pinch_zoom = self.zoom

    def _pinch(self, g, scale):
        ok, x, y = g.get_bounding_box_center()
        if ok:
            self.zoom_at(self.pinch_zoom * scale, x, y)

    def _pinch_end(self, g, seq):
        if self.zoom < 1.05:
            self.reset()

    def _pressed(self, g, n, x, y):
        if n == 2:
            if self.tap_id:
                GLib.source_remove(self.tap_id)
                self.tap_id = 0
            self._animate_zoom(1.0 if self.zoomed else 2.5, x, y)

    def _released(self, g, n, x, y):
        if n == 1 and not self.tap_id:
            self.tap_id = GLib.timeout_add(250, self._tap)

    def _tap(self):
        self.tap_id = 0
        self.emit('tap')
        return False

    def _animate_zoom(self, target, x, y):
        start = self.zoom
        if target == 1.0:
            x, y = self.get_width() / 2 + self.pan[0], self.get_height() / 2 + self.pan[1]
        self.anim = Adw.TimedAnimation.new(self, 0.0, 1.0, 200, Adw.CallbackAnimationTarget.new(
            lambda v: self.zoom_at(start + (target - start) * v, x, y)))
        self.anim.set_easing(Adw.Easing.EASE_OUT_CUBIC)
        self.anim.play()

    def do_measure(self, orientation, for_size):
        return 0, 0, -1, -1

    def do_size_allocate(self, w, h, baseline):
        self._clamp()

    def do_snapshot(self, s):
        if not self.tex:
            return
        w, h = self.get_width(), self.get_height()
        k = self._fit() * self.zoom
        dw, dh = self.tex.get_width() * k, self.tex.get_height() * k
        x, y = (w - dw) / 2 + self.pan[0], (h - dh) / 2 + self.pan[1]
        s.append_scaled_texture(self.tex, Gsk.ScalingFilter.TRILINEAR, Graphene.Rect().init(x, y, dw, dh))


class VideoPlayer(Gtk.Widget):
    """a video with its own playbin: decoded in hardware (VA, else V4L2),
    then converted in system memory for gtk4paintablesink. GTK's own video
    widget takes the decoders' dmabufs as they are, and those import into
    GL green / black on the G77 (MediaTek-tiled and VA NV12 alike)."""
    __gtype_name__ = 'GalleryVideoPlayer'
    __gsignals__ = {'tap': (GObject.SignalFlags.RUN_FIRST, None, ())}

    def __init__(self, path):
        super().__init__()
        self.set_layout_manager(Gtk.BinLayout())
        sinkbin = Gst.parse_bin_from_description(
            'videoflip video-direction=auto ! videoconvert ! video/x-raw,format=RGBx ! gtk4paintablesink name=sink',
            True)
        self.picture = Gtk.Picture(paintable=sinkbin.get_by_name('sink').get_property('paintable'),
                                   can_shrink=True)
        self.play = Gst.ElementFactory.make('playbin3')
        self.play.set_property('uri', Gio.File.new_for_path(path).get_uri())
        self.play.set_property('video-sink', sinkbin)
        bus = self.play.get_bus()
        bus.add_signal_watch()
        bus.connect('message', self._message)
        self.play.set_state(Gst.State.PAUSED)	# the first frame
        self.playing = False
        self.duration = 0
        self.tick_id = 0

        overlay = Gtk.Overlay(child=self.picture)
        self.button = Gtk.Button(icon_name='media-playback-start-symbolic', halign=Gtk.Align.CENTER,
                                 valign=Gtk.Align.CENTER, width_request=64, height_request=64)
        for c in ('osd', 'circular'):
            self.button.add_css_class(c)
        self.button.connect('clicked', lambda b: self.toggle())
        overlay.add_overlay(self.button)
        self.scale = Gtk.Scale(hexpand=True, draw_value=False)
        self.scale.set_range(0, 1)
        self.scale.connect('change-value', self._seek)
        self.time = Gtk.Label(label='0:00')
        self.time.add_css_class('numeric')
        self.controls = Gtk.Box(spacing=8, valign=Gtk.Align.END, margin_start=12, margin_end=12,
                                margin_bottom=72)
        self.controls.add_css_class('video-controls')
        self.controls.append(self.scale)
        self.controls.append(self.time)
        overlay.add_overlay(self.controls)
        overlay.set_parent(self)
        click = Gtk.GestureClick()
        click.connect('released', lambda *a: self.emit('tap'))
        self.picture.add_controller(click)

    def toggle(self):
        self.set_playing(not self.playing)

    def set_playing(self, on):
        self.playing = on
        self.play.set_state(Gst.State.PLAYING if on else Gst.State.PAUSED)
        self.button.set_icon_name('media-playback-pause-symbolic' if on else 'media-playback-start-symbolic')
        self.button.set_opacity(0.0 if on else 1.0)	# out of the way while it plays; a tap still pauses
        if on and not self.tick_id:
            self.tick_id = GLib.timeout_add(250, self._tick)

    def set_chrome(self, show):
        self.controls.set_visible(show)

    def _tick(self):
        ok, pos = self.play.query_position(Gst.Format.TIME)
        if not self.duration:
            ok2, dur = self.play.query_duration(Gst.Format.TIME)
            self.duration = dur if ok2 and dur > 0 else 0
        if ok and self.duration:
            self.scale.set_range(0, self.duration / Gst.SECOND)
            self.scale.set_value(pos / Gst.SECOND)
            self.time.set_label(f'{duration_text(pos / Gst.SECOND)} / {duration_text(self.duration / Gst.SECOND)}')
        if not self.playing:
            self.tick_id = 0
            return False
        return True

    def _seek(self, scale, scroll, value):
        self.play.seek_simple(Gst.Format.TIME, Gst.SeekFlags.FLUSH | Gst.SeekFlags.KEY_UNIT,
                              int(max(0, value) * Gst.SECOND))
        return False

    def _message(self, bus, msg):
        if msg.type == Gst.MessageType.EOS:
            self.set_playing(False)
            self.play.seek_simple(Gst.Format.TIME, Gst.SeekFlags.FLUSH, 0)
            self._tick()
        elif msg.type == Gst.MessageType.ASYNC_DONE:
            self._tick()
        elif msg.type == Gst.MessageType.ERROR:
            err, _dbg = msg.parse_error()
            self.time.set_label(err.message)

    def stop(self):
        if self.tick_id:
            GLib.source_remove(self.tick_id)
            self.tick_id = 0
        self.play.set_state(Gst.State.NULL)
        self.play.get_bus().remove_signal_watch()

    def do_dispose(self):
        self.stop()
        child = self.get_first_child()
        if child:
            child.unparent()


class MediaPage(Gtk.Widget):
    """one item in the viewer: the image (thumbnail first, then the full
    picture through glycin) or a video player"""
    __gtype_name__ = 'GalleryMediaPage'
    __gsignals__ = {'tap': (GObject.SignalFlags.RUN_FIRST, None, ())}

    def __init__(self, gallery, item):
        super().__init__()
        self.set_layout_manager(Gtk.BinLayout())
        self.item = item
        self.cancel = Gio.Cancellable()
        if item.video:
            self.image = None
            self.video = VideoPlayer(item.path)
            self.video.connect('tap', lambda *a: self.emit('tap'))
            self.video.set_parent(self)
            return
        self.video = None
        self.image = ImageView()
        self.image.connect('tap', lambda *a: self.emit('tap'))
        self.image.set_parent(self)
        tex = gallery.thumbs.cache.get(item.uri)
        if tex:
            self.image.set_texture(tex)
        loader = Gly.Loader.new(Gio.File.new_for_path(item.path))
        loader.load_async(self.cancel, self._loaded)

    @property
    def zoomed(self):
        return self.image is not None and self.image.zoomed

    def _loaded(self, loader, res):
        try:
            image = loader.load_finish(res)
            image.next_frame_async(self.cancel, self._frame)
        except GLib.Error as e:
            if not e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.CANCELLED):
                self._fallback()

    def _frame(self, image, res):
        try:
            frame = image.next_frame_finish(res)
        except GLib.Error as e:
            if not e.matches(Gio.io_error_quark(), Gio.IOErrorEnum.CANCELLED):
                self._fallback()
            return
        self.image.set_texture(GlyGtk4.frame_get_texture(frame))

    def _fallback(self):
        # a format glycin does not read (DNG): the embedded preview
        path = self.item.path

        def work():
            try:
                pb = raw_preview_pixbuf(path, 0)
            except GLib.Error:
                pb = None
            if pb:
                tex = Gdk.Texture.new_for_pixbuf(pb)
                GLib.idle_add(lambda: self.cancel.is_cancelled() or self.image.set_texture(tex))
        threading.Thread(target=work, daemon=True).start()

    def leave(self):
        """not the current page any more"""
        if self.image:
            self.image.reset()
        if self.video:
            self.video.set_playing(False)

    def set_chrome(self, show):
        if self.video:
            self.video.set_chrome(show)

    def do_dispose(self):
        self.cancel.cancel()
        child = self.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            child.unparent()
            child = nxt


class Pager(Gtk.Widget):
    """the viewer's pages side by side: the current one and its neighbours,
    swiped with a drag (or panning the current image while it is zoomed)"""
    __gtype_name__ = 'GalleryPager'
    __gsignals__ = {'changed': (GObject.SignalFlags.RUN_FIRST, None, ())}
    SPACING = 16

    def __init__(self, make_page):
        super().__init__()
        self.set_overflow(Gtk.Overflow.HIDDEN)
        self.make_page = make_page
        self.items = []
        self.index = 0
        self.pages = {}
        self.offset = 0.0
        self.anim = None
        self.panning = False
        drag = Gtk.GestureDrag()
        drag.connect('drag-begin', self._begin)
        drag.connect('drag-update', self._update)
        drag.connect('drag-end', self._end)
        drag.connect('cancel', lambda g, seq: self._settle(0))
        self.add_controller(drag)

    @property
    def current(self):
        return self.pages.get(self.index)

    def set_items(self, items, index):
        for p in self.pages.values():
            p.unparent()
        self.pages = {}
        self.items = items
        self.index = index
        self.offset = 0.0
        self._fill()
        self.emit('changed')

    def _fill(self):
        want = {i for i in (self.index - 1, self.index, self.index + 1) if 0 <= i < len(self.items)}
        for i in list(self.pages):
            if i not in want:
                self.pages.pop(i).unparent()
        for i in sorted(want):
            if i not in self.pages:
                page = self.make_page(self.items[i])
                page.set_parent(self)
                self.pages[i] = page
        self.queue_allocate()

    def go(self, step):
        if 0 <= self.index + step < len(self.items):
            self._settle(-step * (self.get_width() + self.SPACING), step)

    def _begin(self, g, x, y):
        if self.anim:
            self.anim.skip()
        page = self.current
        self.panning = page is not None and page.zoomed
        if self.panning:
            page.image.pan_begin()
        self.start = self.offset
        self.track = [(time.monotonic(), 0.0)]

    def _update(self, g, dx, dy):
        if self.panning:
            self.current.image.pan_by(dx, dy)
            return
        if abs(dx) > 8 or abs(self.offset) > 0:
            g.set_state(Gtk.EventSequenceState.CLAIMED)
        off = self.start + dx
        if (off > 0 and self.index == 0) or (off < 0 and self.index == len(self.items) - 1):
            off /= 3	# nothing that way: resist
        self.offset = off
        self.track = (self.track + [(time.monotonic(), dx)])[-6:]
        self.queue_allocate()

    def _end(self, g, dx, dy):
        if self.panning:
            self.panning = False
            return
        (t0, x0), (t1, x1) = self.track[0], self.track[-1]
        v = (x1 - x0) / (t1 - t0) if t1 > t0 else 0.0
        w = self.get_width() + self.SPACING
        step = 0
        if (self.offset < -w / 4 or v < -400) and self.index + 1 < len(self.items):
            step = 1
        elif (self.offset > w / 4 or v > 400) and self.index > 0:
            step = -1
        self._settle(-step * w, step)

    def _settle(self, target, step=0):
        start = self.offset

        def move(v):
            self.offset = start + (target - start) * v
            self.queue_allocate()

        self.anim = Adw.TimedAnimation.new(self, 0.0, 1.0, 220, Adw.CallbackAnimationTarget.new(move))
        self.anim.set_easing(Adw.Easing.EASE_OUT_CUBIC)
        self.anim.connect('done', lambda a: self._settled(step))
        self.anim.play()

    def _settled(self, step):
        self.anim = None
        if step:
            old = self.current
            self.index += step
            self.offset = 0.0
            if old:
                old.leave()
            self._fill()
            self.emit('changed')

    def do_measure(self, orientation, for_size):
        return 0, 0, -1, -1

    def do_size_allocate(self, w, h, baseline):
        for i, page in self.pages.items():
            x = (i - self.index) * (w + self.SPACING) + self.offset
            page.allocate(w, h, baseline, Gsk.Transform.new().translate(Graphene.Point().init(x, 0)))

    def do_dispose(self):
        for p in self.pages.values():
            p.unparent()
        self.pages = {}


