#!/usr/bin/env python3
# cezanne-gnssd: GNSS location service for the Redmi K30 Ultra (cezanne).
# Serves NMEA (GGA + RMC, one per fix) on a Unix socket that GeoClue reads
# ([network-nmea] nmea-socket=); the GNSS DSPs run only while a client is
# connected (switched off IDLE s after the last one leaves). Orbits: the
# satellites' own navigation messages (decoded, cached), the IGS download
# where there is network. GeoClue only
# connects when it starts, so its connection is kept in systemd's file
# descriptor store and taken back after a restart of this service. Broadcast
# orbits come from the IGS (BKG mirror, cached); the rough start position
# is the last fix, else the system time zone's coordinates (zone1970.tab).
#   cezanne-gnssd            service
#   cezanne-gnssd --run N    receiver in the foreground for N s, fixes and
#                            NMEA on stdout (testing; no socket)
#   ... --offline            no download: the cached orbit file (if any, used
#                            for aiding even when days old) and the
#                            satellites' own messages
#   ... --log FILE           every DSP frame (utc link dir id hex)
#   ... --mode MODE          continuous / balanced / low (else the config)
# /etc/cezanne-gnss.conf: [receiver] mode = balanced (default; at rest the
# receiver tracks in short bursts), low (longer pauses) or continuous.
import argparse
import array
import configparser
import itertools
import json
import os
import socket
import select
import sys
import threading
import time

sys.path.insert(0, '/usr/lib/cezanne-gnss')
from cezanne_gnss import dsp, ephem, nmea, orbits		# noqa: E402
from cezanne_gnss.receiver import Receiver		# noqa: E402

CONF = '/etc/cezanne-gnss.conf'
SOCK = '/run/cezanne-gnss/nmea.sock'
STATE = '/var/lib/cezanne-gnss/last-fix.json'
CACHE = '/var/cache/cezanne-gnss'
FIRMWARE = '/usr/lib/firmware/mediatek/cezanne'
IDLE = 30		# s without clients before the DSPs go off
SPEED = 30.0		# m/s assumed travel since the last fix (start uncertainty)


def log(text):
    print(text, flush=True)


def mode():
    c = configparser.ConfigParser()
    c.read(CONF)
    return c.get('receiver', 'mode', fallback='balanced')


def tz_position():
    """(lat, lon) of the system time zone from zone1970.tab, or None"""
    try:
        zone = os.path.realpath('/etc/localtime').split('/zoneinfo/', 1)[1]
        for line in open('/usr/share/zoneinfo/zone1970.tab'):
            f = line.split('\t')
            if len(f) > 2 and f[2].strip() == zone:
                c = f[1]
                k = next(i for i in range(1, len(c)) if c[i] in '+-')
                deg = lambda s, n: (-1 if s[0] == '-' else 1) * (int(s[1:1 + n]) + int(s[1 + n:3 + n]) / 60)
                return deg(c[:k], 2), deg(c[k:], 3)
    except (OSError, IndexError, StopIteration, ValueError):
        pass
    return None


def start_position():
    """(ECEF, uncertainty m, clock Hz) to start from"""
    try:
        s = json.load(open(STATE))
        unc = min(2e6, 30 + SPEED * max(0, time.time() - s['time']))
        return orbits.geo2ecef(s['lat'], s['lon'], s['alt']), unc, s.get('clock_hz', 0.0)
    except (OSError, ValueError, KeyError):
        pass
    tz = tz_position()
    if tz:
        return orbits.geo2ecef(tz[0], tz[1], 200.0), 300e3, 0.0
    return None


def save(fix):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + '.new', 'w') as f:
        json.dump(dict(lat=fix['lat'], lon=fix['lon'], alt=fix['alt'], time=time.time(),
                       clock_hz=fix['clock_hz']), f)
    os.replace(STATE + '.new', STATE)


class Session:
    """one receiver run in a thread; orbits refreshed in the background
    (the receiver reloads the file when it changes)"""

    def __init__(self, on_fix):
        self.stop = threading.Event()
        self.on_fix = on_fix
        self.fix, self.last_save, self.t0 = None, 0, time.monotonic()
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def _fix(self, fix):
        if not self.fix:
            log(f'first fix after {time.monotonic() - self.t0:.0f} s, {len(fix["used"])} satellites')
        if time.monotonic() - self.last_save > 60:
            save(fix)
            self.last_save = time.monotonic()
        self.fix = fix
        self.on_fix(fix)

    def _orbits(self):
        while not self.stop.wait(600):
            ephem.refresh(CACHE)

    def _run(self):
        nav = ephem.refresh(CACHE)
        start = start_position()
        if not start:
            log('no start position')
            return
        pos, unc, clock = start
        lat, lon, _ = orbits.ecef2geo(pos)
        log(f'receiver on: start {lat:.2f} {lon:.2f} +- {unc / 1000:.0f} km, clock {clock:+.0f} Hz')
        threading.Thread(target=self._orbits, daemon=True).start()
        if not nav:
            log('no downloaded orbits: from the satellites only')
        Receiver(nav, pos, unc, clock, FIRMWARE, on_fix=self._fix, on_state=log, cache=CACHE,
                 mode=mode()).run(self.stop)
        if self.fix:
            save(self.fix)
        log('receiver off')

    def close(self):
        self.stop.set()
        self.thread.join()


def notify(text, fds=()):
    """sd_notify, with file descriptors for the store"""
    addr = os.environ.get('NOTIFY_SOCKET')
    if not addr:
        return
    if addr[0] == '@':
        addr = '\0' + addr[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as n:
        anc = [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', fds))] if fds else []
        n.sendmsg([text.encode()], anc, 0, addr)


def stored():
    """client connections handed back by systemd's fd store: {socket: name}"""
    out = {}
    if os.environ.get('LISTEN_PID') == str(os.getpid()):
        names = os.environ.get('LISTEN_FDNAMES', '').split(':')
        for i in range(int(os.environ.get('LISTEN_FDS', '0'))):
            if i < len(names) and names[i].startswith('client'):
                out[socket.socket(fileno=3 + i)] = names[i]
    return out


def serve():
    os.makedirs(os.path.dirname(SOCK), exist_ok=True)
    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o666)
    srv.listen(4)
    clients, lock = stored(), threading.Lock()	# socket -> its name in the fd store
    serial = itertools.count(int(time.time()))
    session, idle_since = None, None

    def drop(c):
        with lock:
            name = clients.pop(c, None)
        if name:
            notify(f'FDSTOREREMOVE=1\nFDNAME={name}')
            c.close()
            log(f'client left ({len(clients)})')

    def send(fix):
        data = (nmea.gga(fix) + nmea.rmc(fix)).encode()
        with lock:
            socks = list(clients)
        for c in socks:
            try:
                c.sendall(data)
            except OSError:
                drop(c)

    log(f'listening on {SOCK}' + (f', {len(clients)} client(s) kept over the restart' if clients else ''))
    while True:
        with lock:
            socks = [srv] + list(clients)
        r, _, _ = select.select(socks, [], [], 1.0)
        for s in r:
            if s is srv:
                c, _ = srv.accept()
                name = f'client{next(serial)}'
                with lock:
                    clients[c] = name
                notify(f'FDSTORE=1\nFDNAME={name}', [c.fileno()])
                log(f'client connected ({len(clients)})')
            else:
                try:
                    gone = not s.recv(256)
                except OSError:
                    gone = True
                if gone:
                    drop(s)
        with lock:
            n = len(clients)
        if n and not session:
            session, idle_since = Session(send), None
        elif n:
            idle_since = None
        elif session:
            idle_since = idle_since or time.monotonic()
            if time.monotonic() - idle_since > IDLE:
                session.close()
                session = None


def run(seconds, offline=False, log_file=None, mode_name=None):
    nav = ephem.cached(CACHE) if offline else ephem.refresh(CACHE)
    if log_file:
        dsp.LOG = open(log_file, 'w', buffering=1)
    start = start_position()
    if not start:
        log('no start position')
        return 1
    pos, unc, clock = start
    t0 = time.monotonic()

    def fix(f):
        sats = ' '.join(f'{q}{n}/{f["cn"][(q, n)]}' for q, n in f['used'])
        speed = 'speed -' if f['speed'] is None else f'speed {f["speed"]:.1f} m/s'
        log(f'{time.monotonic() - t0:5.1f} s  {f["lat"]:.6f} {f["lon"]:.6f} {f["alt"]:.0f} m  acc {f["acc"]:.0f} m  '
            f'rms {f["rms"]:.0f} m  {speed}  {sats}')
        sys.stdout.write(nmea.gga(f) + nmea.rmc(f))

    stop = threading.Event()
    rx = Receiver(nav, pos, unc, clock, FIRMWARE, on_fix=fix, on_state=log, cache=CACHE,
                  mode=mode_name or mode())
    rx.run(stop, seconds)
    if rx.pos_unc < 100:		# had a fix
        lat, lon, alt = orbits.ecef2geo(rx.pos)
        save(dict(lat=lat, lon=lon, alt=alt, clock_hz=rx.clock_hz))
    return 0


if __name__ == '__main__':
    ap = argparse.ArgumentParser()
    ap.add_argument('--run', type=float, metavar='SECONDS')
    ap.add_argument('--offline', action='store_true')
    ap.add_argument('--log')
    ap.add_argument('--mode', choices=('continuous', 'balanced', 'low'))
    a = ap.parse_args()
    sys.exit(run(a.run, a.offline, a.log, a.mode) if a.run else serve())
